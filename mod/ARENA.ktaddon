{"payload":"{\"kind\":\"addon\",\"name\":\"KING ARENA\",\"hours\":0,\"intro\":true,\"code\":\"/* KING TOWER · mod \\\"KING ARENA\\\" (2026-11-05): l'arena a ondate dentro KING TOWER.\\n   Apre il gioco in una finestra sopra KING TOWER; monete in comune con il 3D; serve il codice d'acquisto (una installazione). */\\n(function () {\\n  const MOD = 'ARENA', PAGINA = 'https://admin2d.itch.io/king-arena';\\n  const HTML = \\\"<!doctype html>\\\\r\\\\n<html lang=\\\\\\\"it\\\\\\\">\\\\r\\\\n<head>\\\\r\\\\n<meta charset=\\\\\\\"utf-8\\\\\\\">\\\\r\\\\n<meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\\\\\\\">\\\\r\\\\n<title>KING ARENA</title>\\\\r\\\\n<style>\\\\r\\\\n:root{--bg:#0e0b0a;--pan:#1d1714;--pan2:#261e19;--bd:#8a6a3a;--gold:#d8a93a;--gold2:#ffe28a;--txt:#f0e2c8;--dim:#a8977e;--red:#c0392b;--green:#3ac27a;\\\\r\\\\n  --sal:env(safe-area-inset-left,0px);--sar:env(safe-area-inset-right,0px)}\\\\r\\\\n*{box-sizing:border-box}\\\\r\\\\nhtml,body{margin:0;height:100%;background:var(--bg);color:var(--txt);font-family:Georgia,'Times New Roman',serif;overflow:hidden;user-select:none;-webkit-user-select:none;touch-action:none;-webkit-tap-highlight-color:transparent}\\\\r\\\\n#cv{position:fixed;inset:0;display:block;background:#000;width:100%;height:100%}\\\\r\\\\nbutton{font:700 15px Georgia,serif;color:var(--txt);background:linear-gradient(#4a3826,#2e2216);border:1px solid #9a7a48;border-radius:8px;padding:8px 14px;cursor:pointer}\\\\r\\\\nbutton:hover:not(:disabled){filter:brightness(1.18);color:var(--gold2)}\\\\r\\\\nbutton:disabled{opacity:.45;cursor:default}\\\\r\\\\nbutton.big{font-size:19px;padding:11px 24px;background:linear-gradient(#e8872a,#9a4a18);border-color:#f0b060;color:#fff;text-shadow:0 2px 0 rgba(0,0,0,.5)}\\\\r\\\\nbutton.on{border-color:var(--gold);background:linear-gradient(#5a4420,#3a2a14);color:var(--gold2)}\\\\r\\\\n.ov{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(8,6,5,.72);padding:14px calc(14px + var(--sar)) 14px calc(14px + var(--sal));overflow:auto;z-index:5}\\\\r\\\\n.ov.on{display:flex}\\\\r\\\\n.box{background:rgba(28,20,14,.94);border:1px solid var(--bd);border-radius:14px;padding:16px 20px;max-width:1100px;width:100%;box-shadow:0 10px 40px #000a;max-height:100%;overflow:auto}\\\\r\\\\nh1,h2,h3{margin:0 0 10px;color:#e8c47a;font-weight:normal;letter-spacing:.04em}\\\\r\\\\nh2{text-align:center}\\\\r\\\\n.sub{color:var(--dim);text-align:center;margin-bottom:12px}\\\\r\\\\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\\\\r\\\\n.center{justify-content:center}\\\\r\\\\n.small{font-size:12px;color:var(--dim)}\\\\r\\\\n/* numeri colorati: negativi rossi, positivi verdi, zero bianco */\\\\r\\\\n.np{color:#5ef08a}.nn{color:#ff5a4a}.nz{color:#fff}\\\\r\\\\n/* ===== menu: lo stesso pannello di KING TOWER 2D e 3D ===== */\\\\r\\\\n#menu{background:linear-gradient(90deg,rgba(8,6,5,.55) 0%,rgba(8,6,5,.2) 45%,rgba(8,6,5,0) 100%);justify-content:flex-start;align-items:center;padding-left:calc(3vw + var(--sal))}\\\\r\\\\n.mcard{width:min(380px,92vw);max-height:100%;overflow:auto;background:rgba(28,20,14,.82);border:1px solid #8a6a3a;border-radius:14px;padding:12px 16px;box-shadow:0 8px 30px rgba(0,0,0,.7)}\\\\r\\\\n.mcard .logo{display:block;width:78%;height:auto;margin:0 auto;filter:drop-shadow(0 4px 10px rgba(0,0,0,.6))}\\\\r\\\\n.mcard .tag{text-align:center;font-style:italic;color:#c9a46a;margin:2px 0 8px;font-size:14px}\\\\r\\\\n.mcard .menu{display:flex;flex-direction:column;gap:6px}\\\\r\\\\n.mcard .mgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px}\\\\r\\\\n.mcard button{width:100%;font-size:15px;padding:7px 8px}\\\\r\\\\n.mcard button.mbig{font-size:19px;padding:10px;background:linear-gradient(#e8872a,#9a4a18);border-color:#f0b060;color:#fff}\\\\r\\\\n.mcard .foot{text-align:center;font-size:12px;color:var(--dim);margin-top:8px}\\\\r\\\\n/* sul telefono il pannello resta a SINISTRA, più stretto: la guardia si vede a destra */\\\\r\\\\n\\\\r\\\\nbody.mob .mcard{width:min(330px,52vw);padding:8px 12px}body.mob .mcard .logo{max-height:22vh;width:auto;margin:0 auto}body.mob .mcard .tag{display:none}\\\\r\\\\nbody.mob .mcard button{font-size:13px;padding:5px 6px}body.mob .mcard button.mbig{font-size:16px;padding:7px}\\\\r\\\\n/* icone in alto a destra: carrello e aiuto */\\\\r\\\\n#icons{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));right:calc(12px + var(--sar));display:flex;gap:8px;z-index:6}\\\\r\\\\n#icons button{width:38px;height:38px;border-radius:50%;padding:0;font-size:18px;display:flex;align-items:center;justify-content:center;background:rgba(23,18,15,.92)}\\\\r\\\\nbody:not(.inmenu) #icons{display:none}\\\\r\\\\nbody.mob #menu{padding-top:52px}\\\\r\\\\n/* carte */\\\\r\\\\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}\\\\r\\\\n.card{background:var(--pan2);border:2px solid #3a2c22;border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:6px;position:relative;animation:cardIn .35s ease-out both}\\\\r\\\\n.card:nth-child(2){animation-delay:.08s}.card:nth-child(3){animation-delay:.16s}\\\\r\\\\n@keyframes cardIn{from{transform:translateY(30px) rotateY(80deg);opacity:0}to{transform:none;opacity:1}}\\\\r\\\\n.card .ic{height:60px;display:flex;align-items:center;justify-content:center;font-size:44px}\\\\r\\\\n.card .nm{font-size:17px;text-align:center}\\\\r\\\\n.card .ds{font-size:13px;color:#d8c8b0;flex:1;line-height:1.4}\\\\r\\\\n.t0{color:#e8dcc8}.t1{color:#5aa0ff}.t2{color:#c070ff}.t3{color:#ff8a4a}\\\\r\\\\n.b0{border-color:#5a4a3a!important}.b1{border-color:#3a6ab0!important}.b2{border-color:#7a3ab0!important}.b3{border-color:#d0702a!important;box-shadow:0 0 14px #d0702a55}\\\\r\\\\n/* lista dei 30 parametri in alto a destra durante la partita */\\\\r\\\\n#hud-st{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));right:calc(8px + var(--sar));width:190px;background:rgba(15,11,9,.72);border:1px solid #5a4630;border-radius:8px;font-size:11px;z-index:4;display:none}\\\\r\\\\n#hud-st .hd{display:flex;justify-content:space-between;align-items:center;padding:3px 6px;color:var(--gold2);cursor:pointer}\\\\r\\\\n#hud-st .lst{max-height:min(62vh,520px);overflow:auto;padding:0 6px 4px}\\\\r\\\\n#hud-st .lst div{display:flex;gap:4px;justify-content:space-between;border-bottom:1px solid #ffffff0d;padding:1px 0}\\\\r\\\\n#hud-st .lst div span{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\\\\r\\\\n#hud-st.closed .lst{display:none}#hud-st.closed{width:auto}\\\\r\\\\n#pausebtn{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);display:none;z-index:4;padding:4px 10px;font-size:13px;margin-top:52px}\\\\r\\\\nbody.mob.playing #pausebtn{display:block}\\\\r\\\\n#throwbtn{position:fixed;right:calc(18px + var(--sar));bottom:calc(18px + env(safe-area-inset-bottom,0px));width:78px;height:78px;border-radius:50%;font-size:26px;line-height:1;display:none;z-index:4;background:rgba(60,30,10,.75);border:2px solid #f0b060}\\\\r\\\\n#throwbtn small{font-size:11px}\\\\r\\\\nbody.mob.playing.canthrow #throwbtn{display:block}\\\\r\\\\n.stats{background:var(--pan2);border-radius:10px;padding:8px;font-size:13px;columns:2 220px}\\\\r\\\\n.stats div{display:flex;gap:6px;justify-content:space-between;padding:2px 0;border-bottom:1px solid #ffffff0d;break-inside:avoid}\\\\r\\\\n.stats div span{flex:1}\\\\r\\\\n/* scelta, skin, livelli */\\\\r\\\\n.grid{display:grid;gap:8px}\\\\r\\\\n#skins{grid-template-columns:repeat(auto-fill,minmax(92px,1fr))}\\\\r\\\\n.sk{background:var(--pan2);border:2px solid #3a2c22;border-radius:10px;padding:4px;text-align:center;cursor:pointer;position:relative;font-size:11px}\\\\r\\\\n.sk canvas{width:80px;height:80px;display:block;margin:0 auto}\\\\r\\\\n.sk.sel{border-color:var(--gold);box-shadow:0 0 10px #d8a93a88}.sk.lock canvas{filter:grayscale(1) brightness(.4)}\\\\r\\\\n.sk .lk{position:absolute;top:4px;right:6px}\\\\r\\\\n#weps{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}\\\\r\\\\n.wp{background:var(--pan2);border:2px solid #3a2c22;border-radius:10px;padding:6px;text-align:center;cursor:pointer;font-size:12px}\\\\r\\\\n.wp .ic{font-size:30px;height:40px;display:flex;align-items:center;justify-content:center}\\\\r\\\\n.wp.sel{border-color:var(--gold)}\\\\r\\\\n#lvgrid{grid-template-columns:repeat(auto-fill,minmax(54px,1fr))}\\\\r\\\\n.lv{background:var(--pan2);border:1px solid #3a2c22;border-radius:6px;padding:6px 0;text-align:center;cursor:pointer;font-size:13px}\\\\r\\\\n.lv.lock{opacity:.35;cursor:default}.lv.done{border-color:#3a8a3a}.lv.sel{border-color:var(--gold);color:var(--gold2)}\\\\r\\\\n#relics{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}\\\\r\\\\n.rl{background:var(--pan2);border:1px solid #3a2c22;border-radius:8px;padding:6px;font-size:12px;text-align:center}\\\\r\\\\n.rl .ic{font-size:28px}.rl.no{opacity:.35}\\\\r\\\\n#toast{position:fixed;left:50%;top:14%;transform:translateX(-50%);background:#000c;border:1px solid var(--gold);padding:8px 16px;border-radius:8px;display:none;z-index:9;pointer-events:none}\\\\r\\\\n#story{background:#000;padding:0;flex-direction:column}\\\\r\\\\n#st-cv{width:min(100vw,calc(100vh*16/9 - 60px));aspect-ratio:16/9;display:block}\\\\r\\\\n#st-txt{min-height:52px;max-width:900px;text-align:center;font-size:clamp(14px,2.4vw,20px);padding:8px 16px;color:#ffe8c0}\\\\r\\\\n#unlock{background:rgba(0,0,0,.8);flex-direction:column;z-index:8}#un-cv{width:min(420px,80vw);height:min(420px,60vh)}\\\\r\\\\n#un-txt{font-size:22px;color:var(--gold2)}\\\\r\\\\nlabel.sl{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:6px 0}\\\\r\\\\nlabel.sl input[type=range]{width:55%}\\\\r\\\\n#admin .box{max-width:900px}\\\\r\\\\n#admin .row{margin:4px 0}#admin input,#admin select{background:#1a120c;color:var(--txt);border:1px solid #8a6a3a;border-radius:5px;padding:5px}\\\\r\\\\n#admin h3{margin:12px 0 4px;font-size:15px;color:var(--gold)}\\\\r\\\\n#admin button{font-size:13px;padding:5px 9px}\\\\r\\\\n</style>\\\\r\\\\n</head>\\\\r\\\\n<body class=\\\\\\\"inmenu\\\\\\\">\\\\r\\\\n<canvas id=\\\\\\\"cv\\\\\\\"></canvas>\\\\r\\\\n<div id=\\\\\\\"icons\\\\\\\"><button id=\\\\\\\"b-chat\\\\\\\" title=\\\\\\\"Chat\\\\\\\">💬</button><button id=\\\\\\\"b-cart\\\\\\\" title=\\\\\\\"Carrello\\\\\\\">🛒</button><button id=\\\\\\\"b-help\\\\\\\" title=\\\\\\\"Come si gioca\\\\\\\">?</button></div>\\\\r\\\\n<div id=\\\\\\\"hud-st\\\\\\\"><div class=\\\\\\\"hd\\\\\\\" id=\\\\\\\"hud-hd\\\\\\\"><b>Parametri</b><span>▾</span></div><div class=\\\\\\\"lst\\\\\\\"></div></div>\\\\r\\\\n<button id=\\\\\\\"pausebtn\\\\\\\">❚❚ Pausa</button>\\\\r\\\\n\\\\r\\\\n<!-- Menu (come KING TOWER) -->\\\\r\\\\n<div id=\\\\\\\"menu\\\\\\\" class=\\\\\\\"ov on\\\\\\\"><div class=\\\\\\\"mcard\\\\\\\">\\\\r\\\\n  <img class=\\\\\\\"logo\\\\\\\" id=\\\\\\\"logo\\\\\\\" src=\\\\\\\"data:image/webp;base64,\\\\\\\" alt=\\\\\\\"KING ARENA\\\\\\\">\\\\r\\\\n  <div class=\\\\\\\"tag\\\\\\\">Il Re ti ha chiuso nella sua arena.</div>\\\\r\\\\n  <div class=\\\\\\\"menu\\\\\\\">\\\\r\\\\n    <button class=\\\\\\\"mbig\\\\\\\" id=\\\\\\\"m-play\\\\\\\">Gioca</button>\\\\r\\\\n    <button id=\\\\\\\"m-cont\\\\\\\">Continua</button>\\\\r\\\\n    <button id=\\\\\\\"m-levels\\\\\\\">Livelli</button>\\\\r\\\\n    <button id=\\\\\\\"m-mp\\\\\\\">Multigiocatore</button>\\\\r\\\\n    <div class=\\\\\\\"mgrid\\\\\\\">\\\\r\\\\n      <button id=\\\\\\\"m-skins\\\\\\\">Skin</button><button id=\\\\\\\"m-relics\\\\\\\">Oggetti dei boss</button>\\\\r\\\\n      <button id=\\\\\\\"m-opts\\\\\\\">Impostazioni</button><button id=\\\\\\\"m-help\\\\\\\">Come si gioca</button>\\\\r\\\\n      <button id=\\\\\\\"m-story\\\\\\\">Storia</button><button id=\\\\\\\"m-admin\\\\\\\">Admin</button>\\\\r\\\\n    </div>\\\\r\\\\n    <button id=\\\\\\\"m-kt\\\\\\\">Torna a KING TOWER</button>\\\\r\\\\n  </div>\\\\r\\\\n  <div class=\\\\\\\"foot\\\\\\\" id=\\\\\\\"m-rec\\\\\\\"></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Scelta: arma iniziale, difficoltà -->\\\\r\\\\n<div id=\\\\\\\"select\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\">\\\\r\\\\n  <h2>Prepara la guardia</h2>\\\\r\\\\n  <div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"sel-info\\\\\\\"></div>\\\\r\\\\n  <h3>Arma iniziale</h3><div class=\\\\\\\"grid\\\\\\\" id=\\\\\\\"weps\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><span class=\\\\\\\"small\\\\\\\">Difficoltà:</span>\\\\r\\\\n    <button data-d=\\\\\\\"0\\\\\\\">Facile</button><button data-d=\\\\\\\"1\\\\\\\">Normale</button><button data-d=\\\\\\\"2\\\\\\\">Difficile</button></div>\\\\r\\\\n  <div class=\\\\\\\"small\\\\\\\" style=\\\\\\\"text-align:center;margin-top:6px\\\\\\\" id=\\\\\\\"sel-diff\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><button id=\\\\\\\"s-back\\\\\\\">Indietro</button><button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"s-go\\\\\\\">Combatti!</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Skin -->\\\\r\\\\n<div id=\\\\\\\"skinsov\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\">\\\\r\\\\n  <h2>Skin</h2><div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"sk-info\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"grid\\\\\\\" id=\\\\\\\"skins\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><button data-back>Indietro</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Livelli -->\\\\r\\\\n<div id=\\\\\\\"levels\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\">\\\\r\\\\n  <h2>Livelli</h2><div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"lv-info\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" id=\\\\\\\"lv-pages\\\\\\\" style=\\\\\\\"margin-bottom:8px\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"grid\\\\\\\" id=\\\\\\\"lvgrid\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><button data-back>Indietro</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Oggetti dei boss -->\\\\r\\\\n<div id=\\\\\\\"relicsov\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\">\\\\r\\\\n  <h2>Oggetti dei boss</h2><div class=\\\\\\\"sub\\\\\\\">Si vincono sconfiggendo i boss e valgono per sempre, in tutte le partite.</div>\\\\r\\\\n  <div class=\\\\\\\"grid\\\\\\\" id=\\\\\\\"relics\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><button data-back>Indietro</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Impostazioni -->\\\\r\\\\n<div id=\\\\\\\"opts\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:520px\\\\\\\">\\\\r\\\\n  <h2>Impostazioni</h2>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\">Volume <input type=\\\\\\\"range\\\\\\\" id=\\\\\\\"o-vol\\\\\\\" min=\\\\\\\"0\\\\\\\" max=\\\\\\\"1\\\\\\\" step=\\\\\\\"0.05\\\\\\\"></label>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\">Musica <input type=\\\\\\\"range\\\\\\\" id=\\\\\\\"o-mus\\\\\\\" min=\\\\\\\"0\\\\\\\" max=\\\\\\\"1\\\\\\\" step=\\\\\\\"0.05\\\\\\\"></label>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\">Effetti <input type=\\\\\\\"range\\\\\\\" id=\\\\\\\"o-sfx\\\\\\\" min=\\\\\\\"0\\\\\\\" max=\\\\\\\"1\\\\\\\" step=\\\\\\\"0.05\\\\\\\"></label>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\">Musica accesa <input type=\\\\\\\"checkbox\\\\\\\" id=\\\\\\\"o-muson\\\\\\\"></label>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\">Lo schermo trema <input type=\\\\\\\"checkbox\\\\\\\" id=\\\\\\\"o-shake\\\\\\\"></label>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\">Numeri dei danni <input type=\\\\\\\"checkbox\\\\\\\" id=\\\\\\\"o-nums\\\\\\\"></label>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><button data-back>Indietro</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Carte: livello bonus e boss -->\\\\r\\\\n<div id=\\\\\\\"lvup\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\">\\\\r\\\\n  <h2 id=\\\\\\\"lv-t\\\\\\\">Sei arrivato al livello bonus!</h2><div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"lv-sub\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"cards\\\\\\\" id=\\\\\\\"lv-cards\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"margin-top:12px\\\\\\\"><button id=\\\\\\\"lv-roll\\\\\\\" style=\\\\\\\"display:none\\\\\\\"></button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Fine livello -->\\\\r\\\\n<div id=\\\\\\\"lvdone\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:620px;text-align:center\\\\\\\">\\\\r\\\\n  <h2 id=\\\\\\\"ld-t\\\\\\\"></h2><div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"ld-s\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"ld-go\\\\\\\">Continua</button><button id=\\\\\\\"ld-exit\\\\\\\">Esci</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Rialzati -->\\\\r\\\\n<div id=\\\\\\\"revive\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:480px;text-align:center\\\\\\\">\\\\r\\\\n  <h2>Sei caduto!</h2><div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"rv-txt\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"rv-yes\\\\\\\">Rialzati (🪙 100)</button><button id=\\\\\\\"rv-no\\\\\\\">No</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Pausa -->\\\\r\\\\n<div id=\\\\\\\"pause\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:760px\\\\\\\">\\\\r\\\\n  <h2>Pausa</h2>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"p-res\\\\\\\">Riprendi</button><button id=\\\\\\\"p-menu\\\\\\\">Esci (non salva)</button></div>\\\\r\\\\n  <label class=\\\\\\\"sl\\\\\\\" style=\\\\\\\"max-width:360px;margin:8px auto\\\\\\\">Volume <input type=\\\\\\\"range\\\\\\\" id=\\\\\\\"p-vol\\\\\\\" min=\\\\\\\"0\\\\\\\" max=\\\\\\\"1\\\\\\\" step=\\\\\\\"0.05\\\\\\\"></label>\\\\r\\\\n  <div class=\\\\\\\"stats\\\\\\\" id=\\\\\\\"p-stats\\\\\\\"></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Fine partita -->\\\\r\\\\n<div id=\\\\\\\"end\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:620px;text-align:center\\\\\\\">\\\\r\\\\n  <h1 id=\\\\\\\"e-t\\\\\\\" style=\\\\\\\"font-size:40px\\\\\\\"></h1>\\\\r\\\\n  <div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"e-s\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"e-retry\\\\\\\">Riprova</button><button id=\\\\\\\"e-again\\\\\\\">Nuova partita</button><button id=\\\\\\\"e-menu\\\\\\\">Menu</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Aiuto -->\\\\r\\\\n<div id=\\\\\\\"help\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:720px\\\\\\\">\\\\r\\\\n  <h2>Come si gioca</h2>\\\\r\\\\n  <p><b>Muoviti</b> con WASD o le frecce, con il joystick o trascinando il dito. <b>Le armi attaccano da sole</b>: tu pensi a schivare.</p>\\\\r\\\\n  <p><b>1000 livelli</b>, ognuno con <b>10 ondate</b>. All'ondata 10 arriva il <b>boss</b> del livello: mercanti, banchieri, diavoli… 100 boss ricchi, tutti diversi.</p>\\\\r\\\\n  <p>I mostri lasciano a terra le <b>gemme di esperienza</b>: riempiono la barra e ogni volta che è piena sali di un livello. A ogni livello <b>tutti i 30 parametri crescono dello 0,25%</b>.</p>\\\\r\\\\n  <p>Ogni <b>5 livelli</b> arriva il <b>livello bonus</b>: il gioco si ferma e scegli una carta su tre (armi, potenziamenti, oggetti). I parametri salgono solo con le carte.</p>\\\\r\\\\n  <p>Dopo ogni boss scegli un <b>oggetto del boss</b>: vale per sempre. A fine livello <b>Continua</b> salva, <b>Esci</b> no.</p>\\\\r\\\\n  <p>Monete di KING TOWER per ogni livello: <b>1 a Normale, 2 a Difficile</b>. Con 100 monete puoi rialzarti una volta. Esc o P mette in pausa.</p>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button data-back>Ho capito</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Carrello -->\\\\r\\\\n<div id=\\\\\\\"cartov\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:520px;text-align:center\\\\\\\">\\\\r\\\\n  <h2>🛒 Carrello</h2><div class=\\\\\\\"sub\\\\\\\" id=\\\\\\\"cart-txt\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button data-back>Chiudi</button></div>\\\\r\\\\n</div></div>\\\\r\\\\n\\\\r\\\\n<!-- Storia -->\\\\r\\\\n<div id=\\\\\\\"story\\\\\\\" class=\\\\\\\"ov\\\\\\\"><canvas id=\\\\\\\"st-cv\\\\\\\" width=\\\\\\\"960\\\\\\\" height=\\\\\\\"540\\\\\\\"></canvas><div id=\\\\\\\"st-txt\\\\\\\"></div>\\\\r\\\\n  <div class=\\\\\\\"row center\\\\\\\"><button id=\\\\\\\"st-next\\\\\\\">Avanti ▶</button><button id=\\\\\\\"st-skip\\\\\\\">Salta</button></div></div>\\\\r\\\\n\\\\r\\\\n<!-- Skin sbloccata -->\\\\r\\\\n<div id=\\\\\\\"unlock\\\\\\\" class=\\\\\\\"ov\\\\\\\"><canvas id=\\\\\\\"un-cv\\\\\\\" width=\\\\\\\"420\\\\\\\" height=\\\\\\\"420\\\\\\\"></canvas><div>Skin sbloccata!</div><div id=\\\\\\\"un-txt\\\\\\\"></div></div>\\\\r\\\\n\\\\r\\\\n<!-- Multigiocatore -->\\\\r\\\\n<div id=\\\\\\\"mpov\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" id=\\\\\\\"mp-box\\\\\\\" style=\\\\\\\"max-width:640px\\\\\\\"></div></div>\\\\r\\\\n\\\\r\\\\n<!-- Admin -->\\\\r\\\\n<div id=\\\\\\\"admin\\\\\\\" class=\\\\\\\"ov\\\\\\\"><div class=\\\\\\\"box\\\\\\\" id=\\\\\\\"adm-box\\\\\\\"></div></div>\\\\r\\\\n\\\\r\\\\n<div id=\\\\\\\"ask\\\\\\\" class=\\\\\\\"ov\\\\\\\" style=\\\\\\\"z-index:9\\\\\\\"><div class=\\\\\\\"box\\\\\\\" style=\\\\\\\"max-width:440px;text-align:center\\\\\\\"><div id=\\\\\\\"ask-t\\\\\\\" style=\\\\\\\"margin-bottom:14px\\\\\\\"></div><div class=\\\\\\\"row center\\\\\\\"><button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"ask-y\\\\\\\">Sì</button><button id=\\\\\\\"ask-n\\\\\\\">No</button></div></div></div>\\\\r\\\\n<button id=\\\\\\\"throwbtn\\\\\\\">🧨<br><small>Lancia</small></button>\\\\r\\\\n<div id=\\\\\\\"toast\\\\\\\"></div>\\\\r\\\\n\\\\r\\\\n<script>/* Copiato da KING TOWER (sorgenti/game.html) - non modificare qui: rigenerare con tools/estrai-da-king-tower.sh */\\\\n/* ===== Costanti e utilità ===== */\\\\nconst W=480,H=270,B=24,GY=222,STEP=12;           // B = un \\\\\\\"blocco\\\\\\\" in pixel interni\\\\nconst SIGHT=5*B, SPEAR_R=1.7*B, RIFLE_R=4*B;       // regole: vista 5 blocchi, lancia 2, fucile 4\\\\nconst ARENA=1000, MIN_TIME=300;                   // sala boss, durata minima livello (s)\\\\n/* 6.3: difficoltà ritarata con il giocatore finto (Facile al massimo 2000 morti, Normale 3000, Difficile 4000-5000 su tutta la torre):\\\\n   cnt = quanti nemici; in Difficile i nemici colpiscono più forte man mano che il giocatore diventa più forte (skin migliori) */\\\\nconst DIFF2={cnt:[.55,1,1.25],mul:[1,1,1.5],exp:[0,0,.93]};\\\\nconst diffDmg=()=>{const d=save.diff|0;if(G.daily||G.sr||G.net||G.demo||G.sbx||!G.p)return 1;return DIFF2.mul[d]*Math.pow(Math.max(1,G.p.max/100),DIFF2.exp[d]);};\\\\nconst $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];\\\\nconst clamp=(v,a,b)=>v<a?a:v>b?b:v, lerp=(a,b,t)=>a+(b-a)*t;\\\\nfunction rng(seed){let s=(seed>>>0)||1;return()=>{s^=s<<13;s>>>=0;s^=s>>>17;s^=s<<5;s>>>=0;return s/4294967296;};}\\\\nfunction hash(n){n=Math.imul(n^61,0x45d9f3b);n^=n>>>16;n=Math.imul(n,0x45d9f3b);n^=n>>>16;return (n>>>0)/4294967296;}\\\\nfunction fmt(n){n=Math.round(n);const u=['','K','M','B','T'];let i=0,v=n;while(v>=10000&&i<4){v/=1000;i++;}return (i?Math.floor(v*10)/10:v)+u[i];}\\\\nfunction mmss(t){t=Math.max(0,Math.floor(t));return String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');}\\\\nconst isBossLevel=n=>n%5===0;\\\\nconst blockStart=n=>Math.floor((n-1)/5)*5+1;       // livello successivo al boss precedente\\\\nconst save={skin:0,diff:1};const G={};\\\\n/* ===== Skin: 100 aspetti umani generati dai dati ===== */\\\\nconst ARCH=[\\\\n {n:'Guardia Ribelle',head:'hair',cape:1,main:[8,10,34],dark:[8,10,22],trim:[30,8,55]},\\\\n {n:'Mantello',head:'hair',cape:1,main:[14,35,30],dark:[14,35,18],trim:[40,70,58]},\\\\n {n:'Cappuccio',head:'hood',cape:1,main:[225,25,26],dark:[225,25,16],trim:[40,50,50]},\\\\n {n:'Cavaliere',head:'helm',cape:0,main:[210,10,52],dark:[210,12,32],trim:[48,60,70]},\\\\n {n:'Assassino',head:'hood',cape:1,main:[0,0,88],dark:[0,0,62],trim:[355,70,40]},\\\\n {n:'Ranger',head:'hood',cape:1,main:[110,35,28],dark:[110,35,17],trim:[40,50,50]},\\\\n {n:'Mercenario',head:'band',cape:0,main:[28,40,34],dark:[28,40,20],trim:[40,50,55]},\\\\n {n:'Nobile Caduto',head:'hat',cape:1,main:[225,60,38],dark:[225,60,24],trim:[44,70,58]},\\\\n {n:'Corazziere',head:'helm',cape:1,main:[40,55,50],dark:[40,55,32],trim:[48,80,70]},\\\\n {n:'Sovrano',head:'crown',cape:1,main:[0,50,30],dark:[0,50,18],trim:[44,80,62]},\\\\n];\\\\nconst TINT=['Cenere','Brace','Bosco','Notte','Porpora','Ambra','Ghiaccio','Ruggine','Smeraldo','Corona'];\\\\nfunction skinPal(i){const a=ARCH[i%10],t=Math.floor(i/10),h=a.main[1]===0&&a.main[0]===0?0:(t*36);\\\\n  const col=(c,dh)=>`hsl(${(c[0]+dh+360)%360} ${c[1]}% ${c[2]}%)`,dh=(a.main[1]<15?0:t*32);\\\\n  const tones=['#c89a76','#e0b48c','#a87656','#8a5c3e','#d8a98a'];\\\\n  return{skin:tones[(i*7+3)%5],hair:['#2a1a12','#5a3a20','#171210','#8a6a3a','#c9c9c9'][(i*3+1)%5],\\\\n    main:col(a.main,dh),dark:col(a.dark,dh),trim:col(a.trim,dh/2),cape:col([a.main[0],Math.max(a.main[1],35),a.main[2]-6<20?24:a.main[2]-6],dh+(a.cape?0:0)),\\\\n    boots:'#2b2018',head:a.head,hasCape:!!a.cape,name:a.n+' '+TINT[t],base:i===0};}\\\\nconst IRON={skin:'#c89a76',hair:'#2a1a12',main:'#7d8794',dark:'#4b525c',trim:'#b8c0c8',cape:'#7a1626',boots:'#2b2420',head:'helm',hasCape:false,plume:'#a01c1c'};\\\\n/* Guardie in più colori: armatura, pennacchio, asta e punta della lancia */\\\\nconst gp=(main,dark,trim,plume,cape,shaft,tip)=>({skin:'#c89a76',hair:'#2a1a12',main,dark,trim,cape,boots:'#2b2420',head:'helm',hasCape:false,plume,armor:true,shaft,tip});\\\\nconst GUARD_PALS=[\\\\n  Object.assign({},IRON,{armor:true,shaft:'#6b4a2a',tip:'#d0d6dc'}),\\\\n  gp('#5b7ea8','#37506f','#a8c4e6','#2f5aa8','#1f3a6a','#4a5a6a','#cfe0f2'),\\\\n  gp('#6a8a4a','#43592e','#b8d08a','#3f7a2a','#2f4a24','#5a4a2a','#d8e0b8'),\\\\n  gp('#a8683a','#6e4122','#e0a468','#c8742a','#5a2e16','#4a2e1a','#e8c898'),\\\\n  gp('#4a4458','#2a2634','#8a7aa8','#7a3aa8','#2a1a3a','#2a2430','#b8a8d0'),\\\\n  gp('#c0c8d0','#8a929c','#f0f4f8','#e8e8e8','#8a929c','#7a6a5a','#ffffff'),\\\\n  gp('#a03a3a','#662222','#e08a8a','#c02a2a','#4a1616','#5a3a22','#f0c8c8'),\\\\n];\\\\nconst GOLD={skin:'#c89a76',hair:'#2a1a12',main:'#d8a93a',dark:'#8a6a1c',trim:'#ffe28a',cape:'#7a1626',boots:'#4a3410',head:'helm',hasCape:false,plume:'#d8a93a'};\\\\nconst NOBLE={skin:'#d6aa88',hair:'#bdbdbd',main:'#7a1626',dark:'#4a0c18',trim:'#d8a93a',cape:'#4a0c18',boots:'#1a1210',head:'hat',hasCape:true};\\\\nconst KING={skin:'#d6aa88',hair:'#c9c9c9',main:'#d8a93a',dark:'#8a6a1c',trim:'#ffe28a',cape:'#8e1b1b',boots:'#4a3410',head:'crown',hasCape:true};\\\\nfunction pStats(s){const k=Math.floor(s/3);return{maxHp:Math.round(100*Math.pow(1.05,s)),mace:25*Math.pow(1.1,k),clip:3+5*k};}\\\\n\\\\nconst DEG=Math.PI/180, ease=t=>t<0?0:t>1?1:t*t*(3-2*t), sstep=ease;\\\\nconst lerpN=(a,b,t)=>a+(b-a)*t;\\\\n\\\\n/* disegno \\\\\\\"mondo\\\\\\\" a pixel interi (coordinate di gioco) */\\\\nfunction R(g,x,y,w,h,c){g.fillStyle=c;g.fillRect(Math.round(x),Math.round(y),w,h);}\\\\nfunction Ln(g,x0,y0,x1,y1,c,t=1){const n=Math.max(Math.abs(x1-x0),Math.abs(y1-y0),1);g.fillStyle=c;\\\\n  for(let i=0;i<=n;i++)g.fillRect(Math.round(x0+(x1-x0)*i/n-t/2),Math.round(y0+(y1-y0)*i/n-t/2),t,t);}\\\\n\\\\n/* ---- colori ---- */\\\\nconst _rgb={};\\\\nfunction hsl2rgb(h,s,l){h=((h%360)+360)%360;s/=100;l/=100;const k=n=>(n+h/30)%12,a=s*Math.min(l,1-l),\\\\n  f=n=>l-a*Math.max(-1,Math.min(k(n)-3,Math.min(9-k(n),1)));return[Math.round(255*f(0)),Math.round(255*f(8)),Math.round(255*f(4))];}\\\\nfunction toRGB(c){let v=_rgb[c];if(v)return v;let m;\\\\n  if(c[0]==='#'){let s=c.slice(1);if(s.length===3)s=s[0]+s[0]+s[1]+s[1]+s[2]+s[2];const n=parseInt(s,16);v=[n>>16&255,n>>8&255,n&255];}\\\\n  else if((m=/hsl\\\\\\\\(\\\\\\\\s*([-\\\\\\\\d.]+)[ ,]+([\\\\\\\\d.]+)%[ ,]+([\\\\\\\\d.]+)%/.exec(c)))v=hsl2rgb(+m[1],+m[2],+m[3]);\\\\n  else if((m=/rgba?\\\\\\\\(\\\\\\\\s*(\\\\\\\\d+)[ ,]+(\\\\\\\\d+)[ ,]+(\\\\\\\\d+)/.exec(c)))v=[+m[1],+m[2],+m[3]];else v=[128,128,128];\\\\n  return _rgb[c]=v;}\\\\nconst rgbs=v=>'rgb('+v.map(x=>Math.max(0,Math.min(255,Math.round(x)))).join(',')+')';\\\\nfunction mix(a,b,t){const A=toRGB(a),B=toRGB(b);return rgbs([A[0]+(B[0]-A[0])*t,A[1]+(B[1]-A[1])*t,A[2]+(B[2]-A[2])*t]);}\\\\nconst _rp={};\\\\n/* cinque toni di un colore: luce, chiaro, base, scuro, ombra */\\\\nfunction ramp(c){return _rp[c]||(_rp[c]={h:mix(c,'#fff6e6',.55),l:mix(c,'#fff6e6',.26),b:c,d:mix(c,'#0a0610',.34),dd:mix(c,'#0a0610',.62)});}\\\\n\\\\n/* ---- tele fuori schermo e pennelli ---- */\\\\nfunction hdCanvas(w,h){const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.imageSmoothingEnabled=false;return[c,x];}\\\\n/* v14: i pennelli disegnano forme pulite (senza scalini) sulle tele ad alta risoluzione.\\\\n   BR.pix=true ripristina il disegno a pixel originale (usato per la testa, che resta com'era). */\\\\nconst BR={pix:false};\\\\nfunction px(c,x,y,w,h,col){c.fillStyle=col;if(BR.pix)c.fillRect(Math.round(x),Math.round(y),w,h);else c.fillRect(x,y,w,h);}\\\\nfunction thick(c,x0,y0,x1,y1,t,col){c.fillStyle=col;const h=t/2;\\\\n  if(BR.pix){const n=Math.max(Math.abs(x1-x0),Math.abs(y1-y0),1);\\\\n    for(let i=0;i<=n;i++)c.fillRect(Math.round(x0+(x1-x0)*i/n-h),Math.round(y0+(y1-y0)*i/n-h),t,t);return;}\\\\n  // inviluppo dei due quadrati di lato t agli estremi: la stessa forma del tratto a pixel, ma liscia\\\\n  const ax=Math.min(x0,x1),bx=Math.max(x0,x1),ay=Math.min(y0,y1),by=Math.max(y0,y1);\\\\n  if(ax===bx||ay===by){c.fillRect(ax-h,ay-h,bx-ax+t,by-ay+t);return;}\\\\n  const s=(x1-x0)*(y1-y0)>0;c.beginPath();\\\\n  if(s){c.moveTo(ax-h,ay-h);c.lineTo(ax+h,ay-h);c.lineTo(bx+h,by-h);c.lineTo(bx+h,by+h);c.lineTo(bx-h,by+h);c.lineTo(ax-h,ay+h);}\\\\n  else{c.moveTo(ax-h,by+h);c.lineTo(ax-h,by-h);c.lineTo(bx-h,ay-h);c.lineTo(bx+h,ay-h);c.lineTo(bx+h,ay+h);c.lineTo(ax+h,by+h);}\\\\n  c.closePath();c.fill();}\\\\nfunction disc(c,cx,cy,r,col){c.fillStyle=col;\\\\n  if(BR.pix){for(let y=-r;y<=r;y++){const w=Math.floor(Math.sqrt(Math.max(0,r*r-y*y+r*.45)));c.fillRect(Math.round(cx-w),Math.round(cy+y),w*2+1,1);}return;}\\\\n  c.beginPath();c.arc(cx+.5,cy+.5,Math.max(.5,r+.5),0,6.2832);c.fill();}\\\\nfunction ell(c,cx,cy,rx,ry,col){c.fillStyle=col;\\\\n  if(BR.pix){for(let y=-ry;y<=ry;y++){const w=Math.floor(rx*Math.sqrt(Math.max(0,1-(y*y)/(ry*ry+.6)))+.4);c.fillRect(Math.round(cx-w),Math.round(cy+y),w*2+1,1);}return;}\\\\n  c.beginPath();c.ellipse(cx+.5,cy+.5,Math.max(.5,rx+.5),Math.max(.5,ry+.5),0,0,6.2832);c.fill();}\\\\n/* arto a tre toni (cilindro): scuro sotto, base, luce in alto a sinistra */\\\\nfunction limb(c,x0,y0,x1,y1,w,rp){thick(c,x0,y0,x1,y1,w,rp.d);if(w>2)thick(c,x0-.5,y0-.5,x1-.5,y1-.5,w-1,rp.b);\\\\n  if(w>=4)thick(c,x0-w*.22,y0-w*.24,x1-w*.22,y1-w*.24,Math.max(1,Math.floor(w/3)),rp.l);}\\\\n/* poligono pieno senza antialiasing */\\\\nfunction poly(c,pts,col){\\\\n  if(!BR.pix){c.fillStyle=col;c.beginPath();c.moveTo(pts[0][0],pts[0][1]);for(let i=1;i<pts.length;i++)c.lineTo(pts[i][0],pts[i][1]);c.closePath();c.fill();return;}\\\\n  let y0=1e9,y1=-1e9;for(const p of pts){y0=Math.min(y0,p[1]);y1=Math.max(y1,p[1]);}\\\\n  c.fillStyle=col;y0=Math.floor(y0);y1=Math.ceil(y1);\\\\n  for(let y=y0;y<=y1;y++){const yy=y+.5,xs=[];for(let i=0;i<pts.length;i++){const a=pts[i],b=pts[(i+1)%pts.length];\\\\n    if((a[1]<=yy&&b[1]>yy)||(b[1]<=yy&&a[1]>yy))xs.push(a[0]+(yy-a[1])/(b[1]-a[1])*(b[0]-a[0]));}\\\\n    xs.sort((p,q)=>p-q);for(let i=0;i+1<xs.length;i+=2){const xa=Math.round(xs[i]),xb=Math.round(xs[i+1]);if(xb>xa)c.fillRect(xa,y,xb-xa,1);}}}\\\\n/* rumore deterministico per le texture */\\\\nfunction hrnd(seed){let s=(seed>>>0)||1;return()=>{s^=s<<13;s>>>=0;s^=s>>>17;s^=s<<5;s>>>=0;return s/4294967296;};}\\\\n\\\\n/* ---- cache degli sprite con contorno ---- */\\\\n/* v14: ogni sprite è disegnato su una tela di almeno 400 pixel per lato lungo (minimo 3 pixel reali per pixel HD),\\\\n   così personaggi, skin, oggetti e arredi hanno sempre più di 200 pixel di dettaglio.\\\\n   La cache è a uso recente (LRU) con un tetto di memoria: le animazioni a 50-100 frame non la fanno esplodere. */\\\\nconst SPR=new Map(),SPR_MIN=400,SPR_QMIN=3,SPR_QMAX=10;\\\\nconst SPR_BUDGET=(/Android|iPhone|iPad|Mobile/i.test(navigator.userAgent)?24:72)*1e6;let SPR_USED=0;\\\\nconst sprQ=(w,h)=>Math.max(SPR_QMIN,Math.min(SPR_QMAX,Math.ceil(SPR_MIN/Math.max(w,h,1))));\\\\nfunction outlined(src,col,q){const w=src.width,h=src.height,[o,x]=hdCanvas(w,h);q=q||1;\\\\n  // contorno spesso 1 pixel HD, preso in 8 direzioni per restare tondo anche ad alta risoluzione\\\\n  for(const[dx,dy]of[[1,0],[-1,0],[0,1],[0,-1],[.7,.7],[-.7,.7],[.7,-.7],[-.7,-.7]])x.drawImage(src,dx*q,dy*q);\\\\n  x.globalCompositeOperation='source-in';x.fillStyle=col||'#0a0706';x.fillRect(0,0,w,h);\\\\n  x.globalCompositeOperation='source-over';x.drawImage(src,0,0);return o;}\\\\nfunction sprGet(key,w,h,fn,outline){let s=SPR.get(key);\\\\n  if(s){SPR.delete(key);SPR.set(key,s);return s;}                 // in fondo alla coda = usato di recente\\\\n  const q=sprQ(w,h),W2=Math.ceil(w*q),H2=Math.ceil(h*q);\\\\n  let[cv,cx]=hdCanvas(W2,H2);\\\\n  cx.imageSmoothingEnabled=true;cx.save();cx.scale(q,q);const pix=BR.pix;BR.pix=false;\\\\n  try{fn(cx);}catch(e){console.error(e);}BR.pix=pix;cx.restore();\\\\n  if(outline!==false)cv=outlined(cv,outline,q);\\\\n  s={c:cv,w,h,q,px:W2*H2};SPR.set(key,s);SPR_USED+=s.px;\\\\n  while(SPR_USED>SPR_BUDGET&&SPR.size>1){const k=SPR.keys().next().value;SPR_USED-=SPR.get(k).px;SPR.delete(k);}\\\\n  return s;}\\\\n/* riporta uno sprite in cache nel gioco: (ox,oy) = origine HD dentro lo sprite */\\\\nfunction sprDraw(g,s,x,y,ox,oy,o){o=o||{};g.save();g.translate(x,y);\\\\n  if(o.rot)g.rotate(o.rot);\\\\n  const sc=o.scale||1;if(o.face<0)g.scale(-sc,sc);else if(sc!==1)g.scale(sc,sc);\\\\n  if(o.alpha!=null)g.globalAlpha=o.alpha;\\\\n  g.imageSmoothingEnabled=true;g.imageSmoothingQuality='high';\\\\n  g.drawImage(s.c,-ox*.5,-oy*.5,s.w*.5,s.h*.5);g.restore();}\\\\n/* ===== Personaggi umani HD: scheletro, ombreggiature, armi ===== */\\\\nconst HU={L1:17,L2:16,T:21,UA:11,FA:10,OX:104,OY:146,CW:208,CH:156};\\\\nconst sn=Math.sin,cs=Math.cos;\\\\n\\\\nfunction palRamps(p){\\\\n  if(p._r)return p._r;\\\\n  const dk=(c,t)=>ramp(mix(c,'#06040a',t));\\\\n  return p._r={main:ramp(p.main),dark:ramp(p.dark),trim:ramp(p.trim),skin:ramp(p.skin),hair:ramp(p.hair),\\\\n    boots:ramp(p.boots||'#2b2420'),cape:ramp(p.cape),plume:ramp(p.plume||p.trim),\\\\n    main2:dk(p.main,.38),dark2:dk(p.dark,.3),boots2:dk(p.boots||'#2b2420',.3),skin2:dk(p.skin,.22),\\\\n    tab:ramp(p.tab||(p.armor?p.cape:p.dark)),leather:ramp('#5a3a22')};\\\\n}\\\\nfunction palKey(p){return p._k||(p._k=[p.main,p.dark,p.trim,p.cape,p.head,p.hair,p.skin,p.plume,p.hasCape?1:0,p.base?1:0,p.kind,p.visor?1:0,p.fur?1:0,p.beard?1:0,p.tab,p.armor?1:0,p.shaft,p.tip,p.boots].join('|'));}\\\\n\\\\n/* ---- posa: angoli degli arti (0 = giù, positivo = in avanti, π = su) ---- */\\\\nfunction humanPose(pose,wep,ph,pr,fr){\\\\n  const s=sn(ph),c=cs(ph);\\\\n  const S={lean:0,tilt:0,breath:0,fl:[.12,.07],bl:[-.15,.07],fa:[.12,.32],ba:[-.08,.22],expr:'n',fly:0,hands:null,wdir:0,wrel:-.9,sit:false,lie:false};\\\\n  const mx=Math.max;\\\\n  switch(pose){\\\\n    case'idle':S.breath=s*.9;S.fa=[.14+.03*s,.34];S.ba=[-.09+.02*s,.22];break;\\\\n    case'walk':S.fl=[.5*s,.12+.8*mx(0,c)];S.bl=[-.5*s,.12+.8*mx(0,-c)];\\\\n      S.fa=[-.42*s+.1,.35+.4*mx(0,s)];S.ba=[.42*s-.05,.3+.4*mx(0,-s)];S.lean=.06;S.fly=.35;break;\\\\n    case'run':S.fl=[.95*s+.12,.45+1.4*mx(0,c)];S.bl=[-.95*s+.12,.45+1.4*mx(0,-c)];\\\\n      S.fa=[-.95*s+.2,1.3];S.ba=[.95*s+.1,1.3];S.lean=.27;S.fly=1;break;\\\\n    case'jump':{ // tre pose chiave fuse in modo continuo (fr da 0 a 2)\\\\n      const K=[{fl:[1.05,1.5],bl:[-.4,.9],fa:[2.5,.4],ba:[1.6,.5],lean:.08,fly:.7},{fl:[.85,1.6],bl:[.15,1.3],fa:[2.1,.5],ba:[1.1,.4],lean:.1,fly:.5},{fl:[.35,.5],bl:[-.3,.3],fa:[2.7,.3],ba:[2.3,.4],lean:-.05,fly:-.2}];\\\\n      const q=clamp(fr||0,0,2),i=Math.min(1,Math.floor(q)),u=sstep(q-i),A=K[i],Bk=K[i+1],l2=(a,b)=>[lerpN(a[0],b[0],u),lerpN(a[1],b[1],u)];\\\\n      S.fl=l2(A.fl,Bk.fl);S.bl=l2(A.bl,Bk.bl);S.fa=l2(A.fa,Bk.fa);S.ba=l2(A.ba,Bk.ba);S.lean=lerpN(A.lean,Bk.lean,u);S.fly=lerpN(A.fly,Bk.fly,u);\\\\n      break;}\\\\n    case'attack':{S.fl=[.55,.35];S.bl=[-.5,.3];S.ba=[-.6,.5];S.expr='atk';\\\\n      const a=pr<.28?lerpN(.5,3.0,sstep(pr/.28)):pr<.55?lerpN(3.0,.85,sstep((pr-.28)/.27)):lerpN(.85,.35,sstep((pr-.55)/.45));\\\\n      const b=pr<.28?lerpN(.6,.9,pr/.28):pr<.55?lerpN(.9,.1,(pr-.28)/.27):.3;\\\\n      S.fa=[a,b];S.wrel=pr<.55?-.25:-.5;\\\\n      S.lean=pr<.28?lerpN(0,-.22,pr/.28):pr<.55?lerpN(-.22,.32,(pr-.28)/.27):lerpN(.32,.1,(pr-.55)/.45);break;}\\\\n    case'shoot':{const k=sstep((pr-.3)/.4);S.fl=[.45,.25];S.bl=[-.45,.2];S.fa=[lerpN(1.52,1.7,k),0];S.ba=[-.4,.4];S.wrel=-.08;S.lean=lerpN(-.03,-.1,k);S.expr='atk';break;}\\\\n    case'hurt':S.lean=-.32+s*.04;S.tilt=-.3+c*.05;S.fa=[-.9+s*.12,.5];S.ba=[2.0-s*.15,.8];S.fl=[.35,.7];S.bl=[-.55,.4];S.expr='hurt';break;\\\\n    case'alert':S.fa=[2.3,.7];S.ba=[.0,.3];S.expr='alert';S.breath=s*.6;break;\\\\n    case'caged':S.fa=[2.9+s*.12,.2+mx(0,c)*.3];S.ba=[2.9-s*.12,.2+mx(0,-c)*.3];S.breath=s*.5;S.expr='hurt';break;\\\\n    case'ko':S.fa=[.35,.2];S.ba=[-.25,.2];S.fl=[.4,.1];S.bl=[-.3,.1];S.expr='ko';S.lie=true;break;\\\\n    case'sit':S.sit=true;S.fl=[1.5,1.5];S.bl=[1.42,1.5];S.fa=[.95,1.0];S.ba=[.85,1.0];S.breath=s*.7;break;\\\\n    case'sitpoint':S.sit=true;S.fl=[1.5,1.5];S.bl=[1.42,1.5];S.fa=[1.55,0];S.ba=[.85,1.0];S.expr='atk';break;\\\\n    case'sitatk':{S.sit=true;S.fl=[1.5,1.5];S.bl=[1.42,1.5];S.ba=[.85,1.0];S.expr='atk';\\\\n      S.fa=[pr<.7?lerpN(.9,3.0,sstep(pr/.7)):lerpN(3.0,.9,sstep((pr-.7)/.3)),.5];S.wrel=-.3;S.lean=pr<.7?-.12:.12;break;}\\\\n    case'sithurt':S.sit=true;S.fl=[1.5,1.5];S.bl=[1.42,1.5];S.fa=[.95,1.0];S.ba=[.85,1.0];S.expr='hurt';S.lean=-.2;S.tilt=-.2;break;\\\\n  }\\\\n  /* armi a due mani: posizione delle mani rispetto alle spalle e direzione dell'arma (angolo di schermo) */\\\\n  const lerp2=(a,b,t)=>[lerpN(a[0],b[0],t),lerpN(a[1],b[1],t)];\\\\n  if((wep==='spear'||wep==='halberd')&&pose!=='ko'&&pose!=='caged'){\\\\n    let f=[11,9],b=[2,13],w=-.3;\\\\n    if(pose==='attack'){\\\\n      if(pr<.35){const u=sstep(pr/.35);f=lerp2([11,9],[3,10],u);b=lerp2([2,13],[-3,12],u);w=lerpN(-.3,-.12,u);}\\\\n      else if(pr<.62){const u=sstep((pr-.35)/.27);f=lerp2([3,10],[24,6],u);b=lerp2([-3,12],[9,9],u);w=lerpN(-.12,-.04,u);}\\\\n      else{const u=sstep((pr-.62)/.38);f=lerp2([24,6],[11,9],u);b=lerp2([9,9],[2,13],u);w=lerpN(-.04,-.3,u);}\\\\n      S.lean=pr<.35?lerpN(0,-.08,pr/.35):pr<.62?.2:.08;\\\\n    }else if(pose==='alert'){f=[9,3];b=[2,11];w=-.95;}\\\\n    S.hands={f,b};S.wdir=w;\\\\n  }else if((wep==='rifle'||wep==='crossbow'||wep==='bow')&&pose!=='ko'&&pose!=='caged'){\\\\n    let f=[11,9],b=[3,10],w=-.35;\\\\n    if(pose==='shoot'){const k=sstep((pr-.4)/.3);f=[lerpN(14,12,k),6];b=[lerpN(4,3,k),8];w=lerpN(-.02,-.16,k);S.lean=-.05;}\\\\n    S.hands={f,b};S.wdir=w;\\\\n  }else if(wep==='gold'&&pose!=='ko'&&pose!=='caged'){\\\\n    let f=[10,8],b=[3,12],w=-1.35;\\\\n    if(pose==='attack'){\\\\n      if(pr<.62){const u=sstep(pr/.62);f=lerp2([10,8],[5,-24],u);b=lerp2([3,12],[0,-17],u);w=lerpN(-1.35,-2.75,u);S.lean=lerpN(0,-.18,u);}\\\\n      else{const u=sstep((pr-.62)/.38);f=lerp2([5,-24],[18,12],u);b=lerp2([0,-17],[9,9],u);w=lerpN(-2.75,1.05,u);S.lean=lerpN(-.18,.4,u);}\\\\n    }\\\\n    S.hands={f,b};S.wdir=w;\\\\n  }\\\\n  return S;\\\\n}\\\\n\\\\n/* cinematica inversa a due segmenti: restituisce gomito e mano */\\\\nfunction ik(sx,sy,tx,ty,l1,l2,dir){let dx=tx-sx,dy=ty-sy,d=Math.hypot(dx,dy),m=l1+l2-.6;if(d>m){dx*=m/d;dy*=m/d;d=m;}\\\\n  if(d<3){dx=3;dy=0;d=3;}\\\\n  const a=Math.atan2(dy,dx),b=Math.acos(Math.max(-1,Math.min(1,(l1*l1+d*d-l2*l2)/(2*l1*d)))),g=a+dir*b;\\\\n  return{ex:sx+l1*cs(g),ey:sy+l1*sn(g),hx:sx+dx,hy:sy+dy};}\\\\n\\\\n/* ---- armi ---- */\\\\nfunction drawWeapon(c,type,x,y,a,p){\\\\n  if(typeof drawWeapon2==='function'&&drawWeapon2(c,type,x,y,a,p))return;   // 2.2: armi nuove\\\\n  const dx=cs(a),dy=sn(a),nx=-dy,ny=dx;\\\\n  if(type==='mace'||type==='gold'){\\\\n    const G=type==='gold',L=G?44:34,hr=G?8:6,wood=ramp(G?'#a8761a':'#6b4a2a'),st=ramp(G?'#e8b83a':'#9aa4ae'),sp=ramp(G?'#ffe28a':'#c8d0d8'),tr=ramp(G?'#ffe28a':'#b8861c');\\\\n    limb(c,x-6*dx,y-6*dy,x+L*dx,y+L*dy,3,wood);\\\\n    for(let i=0;i<3;i++){const k=1+i*4;px(c,x+dx*k-1,y+dy*k-1,3,2,tr.b);}\\\\n    px(c,x-6*dx-1,y-6*dy-1,3,3,tr.l);\\\\n    const ex=x+(L+hr-3)*dx,ey=y+(L+hr-3)*dy;\\\\n    for(let i=0;i<8;i++){const aa=i*Math.PI/4+.3,r0=hr-1,r1=hr+(G?5:4);thick(c,ex+cs(aa)*r0,ey+sn(aa)*r0,ex+cs(aa)*r1,ey+sn(aa)*r1,2,sp.b);px(c,ex+cs(aa)*r1,ey+sn(aa)*r1,1,1,sp.h);}\\\\n    disc(c,ex,ey,hr,st.d);disc(c,ex-1,ey-1,hr-1,st.b);disc(c,ex-2,ey-2,Math.max(1,hr-4),st.l);px(c,ex-3,ey-3,2,2,st.h);\\\\n    thick(c,x+dx*(L-3),y+dy*(L-3),x+dx*(L-3),y+dy*(L-3),3,tr.d);\\\\n  }else if(type==='cane'){\\\\n    const g=ramp('#d8a93a'),w=ramp('#2a1a10');\\\\n    thick(c,x-8*dx,y-8*dy,x+26*dx,y+26*dy,2,w.b);disc(c,x+28*dx,y+28*dy,3,g.d);disc(c,x+28*dx-1,y+28*dy-1,2,g.b);px(c,x+28*dx-2,y+28*dy-2,1,1,g.h);\\\\n  }else if(type==='spear'){\\\\n    const sh=ramp(p&&p.shaft||'#6b4a2a'),tp=ramp(p&&p.tip||'#d0d6dc'),rd=ramp(p&&p.plume||'#a01c1c');\\\\n    const x1=x+36*dx,y1=y+36*dy;\\\\n    thick(c,x-16*dx,y-16*dy,x1,y1,2,sh.d);thick(c,x-16*dx-.5,y-16*dy-.5,x1-.5,y1-.5,1,sh.l);\\\\n    poly(c,[[x1+nx*3.2,y1+ny*3.2],[x1+dx*11,y1+dy*11],[x1-nx*3.2,y1-ny*3.2],[x1-dx*2,y1-dy*2]],tp.d);\\\\n    poly(c,[[x1+nx*2,y1+ny*2],[x1+dx*10,y1+dy*10],[x1-nx*1,y1-ny*1],[x1-dx*1,y1-dy*1]],tp.b);\\\\n    thick(c,x1,y1,x1+dx*9,y1+dy*9,1,tp.h);\\\\n    thick(c,x1-dx*3-nx*3,y1-dy*3-ny*3,x1-dx*3+nx*3,y1-dy*3+ny*3,2,sh.l);\\\\n    poly(c,[[x1-dx*4,y1-dy*4],[x1-dx*10+nx*4,y1-dy*10+ny*4+3],[x1-dx*9-nx*3,y1-dy*9-ny*3+4],[x1-dx*4,y1-dy*4+1]],rd.b);\\\\n  }else if(type==='rifle'){\\\\n    const bl=ramp('#4a4f58'),wd=ramp('#6b4a2a'),br=ramp('#b8861c');\\\\n    thick(c,x-15*dx,y-15*dy,x-1*dx,y-1*dy,4,wd.d);thick(c,x-15*dx-.5,y-15*dy-.5,x-1*dx-.5,y-1*dy-.5,3,wd.b);\\\\n    thick(c,x-2*dx,y-2*dy,x+26*dx,y+26*dy,2,bl.d);thick(c,x-2*dx-.4,y-2*dy-.4,x+26*dx-.4,y+26*dy-.4,1,bl.l);\\\\n    px(c,x+dx*8-1,y+dy*8+1,3,3,wd.d);px(c,x-1,y-1,3,2,br.b);px(c,x+26*dx-1,y+26*dy-1,3,3,bl.h);\\\\n    px(c,x+dx*4-1,y+dy*4+3,1,3,bl.dd);\\\\n  }else if(type==='pistol'){\\\\n    const bl=ramp('#4a4f58'),gr=ramp('#2c2622'),hl=ramp('#aeb6c0');\\\\n    // punto (t lungo la canna, u verso il basso) ruotato secondo la direzione del colpo\\\\n    const P=(t,u)=>[x+(2+t)*dx-u*dy*0+(-u)*nx*0, y-1+(2+t)*dy+u];\\\\n    const L=(t0,u0,t1,u1,w,col)=>{const a=P(t0,u0),b=P(t1,u1);thick(c,a[0],a[1],b[0],b[1],w,col);};\\\\n    // slitta: ombra, corpo e luce\\\\n    L(0,1,20,1,7,bl.d);L(0,0,20,0,6,bl.b);L(2,-2,17,-2,1,hl.l);\\\\n    // canna sporgente e mirino\\\\n    L(20,1,25,1,3,bl.dd);px(c,x+(2+24)*dx,y-1+(2+24)*dy-1,1,1,hl.h);\\\\n    L(18,-4,19,-4,2,bl.dd);\\\\n    // impugnatura inclinata verso il basso\\\\n    L(5,4,2,15,7,gr.d);L(4.5,4,1.5,14,5,gr.b);L(3,7,3,12,1,gr.l);\\\\n    // grilletto e ponticello del ponte\\\\n    L(8,4,9,9,1,bl.dd);L(8,9,14,9,1,bl.dd);L(14,4,14,9,1,bl.dd);\\\\n  }}\\\\n/* compatibilità: arma singola disegnata sulla tela principale (usata nell'introduzione) */\\\\nfunction weaponDraw(g,hx,hy,a,type,thrust,pal){\\\\n  const key='w|'+type+'|'+Math.round(a*20);\\\\n  const s=sprGet(key,120,120,cx=>drawWeapon(cx,type,26,60,a,pal));\\\\n  g.save();g.translate(Math.round(hx*2)/2,Math.round(hy*2)/2);g.drawImage(s.c,-13,-30,60,60);g.restore();\\\\n}\\\\n\\\\n/* ---- testa ---- */\\\\nconst HEAD_ROWS=[[-3,4],[-5,5],[-6,6],[-6,6],[-6,6],[-6,6],[-6,6],[-6,6],[-6,6],[-6,6],[-5,6],[-4,5],[-3,4],[-2,3],[0,2]];\\\\nfunction drawHead(c,x,y,p,RP,S){\\\\n  // la testa resta disegnata a pixel come nella v13 (solo più grande e nitida)\\\\n  const pix0=BR.pix;BR.pix=true;try{drawHeadPix(c,x,y,p,RP,S);}finally{BR.pix=pix0;}\\\\n}\\\\nfunction drawHeadPix(c,x,y,p,RP,S){\\\\n  const sk=RP.skin,ex=S.expr;\\\\n  // collo\\\\n  px(c,x-3,y+5,6,6,sk.d);px(c,x-3,y+5,6,2,sk.dd);\\\\n  // volto\\\\n  HEAD_ROWS.forEach((r,i)=>{const yy=y-8+i;px(c,x+r[0],yy,r[1]-r[0]+1,1,sk.b);px(c,x+r[0],yy,2,1,sk.d);});\\\\n  px(c,x-2,y-6,6,3,sk.l);px(c,x+2,y-4,3,2,sk.l);               // luce su fronte e zigomo\\\\n  px(c,x-3,y+3,8,3,sk.d);px(c,x-1,y+5,4,1,sk.dd);                // ombra della mascella\\\\n  px(c,x+6,y,2,3,sk.b);px(c,x+7,y+1,1,2,sk.l);                    // naso\\\\n  px(c,x+6,y+3,1,1,sk.d);\\\\n  // orecchio\\\\n  px(c,x-5,y-1,3,4,sk.d);px(c,x-4,y,1,2,sk.dd);\\\\n  const ink='#17100c',wh='#efe8dc',br=p.hair?RP.hair.d:ink;\\\\n  if(p.visor&&p.head==='helm'){px(c,x-1,y-3,8,5,RP.main.d);px(c,x+1,y-1,6,2,'#06040a');px(c,x+5,y+2,2,3,RP.main.dd);}\\\\n  else if(ex==='alert'){   // 5.8: faccia arrabbiata quando ti nota (sopracciglia a V, occhi stretti, denti)\\\\n    px(c,x+0,y-1,3,2,wh);px(c,x+1,y-1,1,2,ink);px(c,x+4,y-1,3,2,wh);px(c,x+5,y-1,1,2,ink);\\\\n    px(c,x-1,y-4,2,1,br);px(c,x+1,y-3,2,1,br);px(c,x+4,y-3,2,1,br);px(c,x+6,y-4,2,1,br);\\\\n    px(c,x+2,y+3,5,2,'#3a1410');px(c,x+3,y+3,3,1,'#efe8dc');px(c,x-2,y+0,1,2,'#c0503a');}\\\\n  else if(ex==='funny'){   // 5.8: faccia buffa prima di cadere nella crepa (occhi diversi, lingua fuori)\\\\n    px(c,x-1,y-3,4,4,wh);px(c,x+1,y-2,1,1,ink);px(c,x+4,y-2,2,2,wh);px(c,x+4,y-2,1,1,ink);\\\\n    px(c,x+2,y+2,4,3,'#3a1410');px(c,x+3,y+4,2,3,'#e06a7a');px(c,x-1,y-5,3,1,br);px(c,x+5,y-6,3,1,br);}\\\\n  else if(ex==='hurt'){px(c,x+0,y-1,3,1,ink);px(c,x+4,y-1,3,1,ink);px(c,x-1,y-3,4,1,br);px(c,x+3,y-4,4,1,br);px(c,x+3,y+3,4,1,'#4a1c18');px(c,x+4,y+4,2,1,'#4a1c18');}\\\\n  else if(ex==='ko'){thick(c,x,y-2,x+2,y,1,ink);thick(c,x+2,y-2,x,y,1,ink);thick(c,x+4,y-2,x+6,y,1,ink);thick(c,x+6,y-2,x+4,y,1,ink);px(c,x+3,y+3,3,1,'#4a1c18');px(c,x+4,y+4,1,1,'#4a1c18');}\\\\n  else{ // sguardo normale / deciso\\\\n    px(c,x+0,y-2,3,3,wh);px(c,x+2,y-2,1,3,ink);px(c,x+1,y-1,1,1,'#5a3a22');\\\\n    px(c,x+4,y-2,3,3,wh);px(c,x+6,y-2,1,3,ink);px(c,x+5,y-1,1,1,'#5a3a22');\\\\n    if(ex==='atk'){px(c,x-1,y-4,4,1,br);px(c,x+3,y-5,4,1,br);px(c,x+2,y-4,1,1,br);}\\\\n    else{px(c,x-1,y-4,4,1,br);px(c,x+3,y-4,4,1,br);}\\\\n    px(c,x+3,y+3,4,1,'#6b3a30');px(c,x+3,y+4,2,1,sk.d);\\\\n  }\\\\n  if(p.beard){const bc=RP.hair;px(c,x-2,y+2,9,4,bc.b);px(c,x-1,y+5,7,2,bc.b);px(c,x+1,y+7,4,1,bc.d);px(c,x-2,y+2,2,4,bc.d);px(c,x+2,y+4,4,1,bc.l);px(c,x+3,y+2,3,1,sk.d);}\\\\n  // copricapo\\\\n  switch(p.head){\\\\n    case'helm':{const m=RP.main;\\\\n      for(let i=-11;i<=-2;i++){const t=(i+11)/9,w=Math.round(4+7*Math.sqrt(Math.min(1,t*1.3)));px(c,x-6,y+i,w+6>12?13:w+6,1,m.b);}\\\\n      px(c,x-7,y-8,14,4,m.b);px(c,x-7,y-8,14,1,m.h);px(c,x-6,y-10,6,2,m.l);px(c,x-7,y-5,14,1,m.dd);\\\\n      px(c,x-7,y-4,6,10,m.d);px(c,x-6,y-4,2,9,m.b);px(c,x-7,y+5,5,2,m.dd);              // paragnatide\\\\n      px(c,x+6,y-6,2,9,m.l);px(c,x+7,y-5,1,8,m.h);                                       // nasale\\\\n      px(c,x+4,y-5,4,1,m.dd);px(c,x-2,y-9,1,4,m.d);px(c,x+2,y-9,1,4,m.d);              // bordi e cresta\\\\n      thick(c,x-6,y-9,x+6,y-9,1,RP.trim.b);\\\\n      const pl=RP.plume;poly(c,[[x-1,y-11],[x+2,y-13],[x-3,y-17],[x-9,y-15],[x-12,y-9],[x-8,y-10],[x-4,y-11]],pl.b);\\\\n      poly(c,[[x,y-11],[x-3,y-15],[x-8,y-13],[x-10,y-10]],pl.l);thick(c,x-10,y-12,x-3,y-15,1,pl.h);px(c,x-11,y-8,2,3,pl.d);break;}\\\\n    case'hood':{const d=RP.dark;\\\\n      poly(c,[[x-8,y+9],[x-9,y-4],[x-5,y-11],[x+2,y-12],[x+6,y-8],[x+6,y-5],[x+1,y-7],[x-3,y-3],[x-4,y+7]],d.b);\\\\n      poly(c,[[x-8,y+9],[x-9,y-4],[x-6,y-9],[x-4,y-3],[x-5,y+8]],d.d);\\\\n      thick(c,x-5,y-11,x+5,y-9,2,d.l);px(c,x-3,y-8,6,1,d.dd);px(c,x-2,y-6,7,3,mix(p.skin,'#000',.35));\\\\n      poly(c,[[x-9,y+9],[x-12,y+14],[x+3,y+13],[x+7,y+9],[x+3,y+6],[x-4,y+7]],d.b);thick(c,x-10,y+12,x+3,y+11,1,d.d);break;}\\\\n    case'hat':{const t=RP.trim,k='#1a1210';\\\\n      px(c,x-11,y-9,23,3,k);px(c,x-11,y-9,23,1,'#3a2a24');px(c,x-8,y-8,18,1,t.dd);\\\\n      px(c,x-6,y-18,13,10,k);px(c,x-6,y-18,13,1,'#3a2a24');px(c,x-6,y-11,13,2,t.b);px(c,x-6,y-11,13,1,t.h);\\\\n      poly(c,[[x-5,y-16],[x-12,y-20],[x-14,y-14],[x-9,y-15]],'#e8e0d0');thick(c,x-13,y-15,x-6,y-17,1,'#fff');\\\\n      px(c,x-7,y-6,3,8,RP.hair.b);px(c,x-8,y-3,3,6,RP.hair.l);break;}\\\\n    case'crown':{const g=ramp('#ffd45c');\\\\n      px(c,x-6,y-9,13,3,RP.hair.b);px(c,x-7,y-6,4,9,RP.hair.b);px(c,x-6,y-7,3,5,RP.hair.l);\\\\n      px(c,x-6,y-12,14,4,g.b);px(c,x-6,y-12,14,1,g.h);px(c,x-6,y-9,14,1,g.dd);\\\\n      for(let i=0;i<5;i++){const cx0=x-6+i*3;poly(c,[[cx0,y-12],[cx0+1.5,y-17],[cx0+3,y-12]],g.b);px(c,cx0+1,y-16,1,1,g.h);}\\\\n      px(c,x-1,y-11,2,2,'#e02a2a');px(c,x-5,y-11,1,2,'#3a7ae0');px(c,x+4,y-11,1,2,'#3ac27a');break;}\\\\n    case'band':{const h=RP.hair,rb=ramp('#a52a2a');\\\\n      px(c,x-7,y-10,15,5,h.b);px(c,x-8,y-6,5,10,h.b);px(c,x-6,y-10,6,2,h.l);px(c,x+4,y-9,3,3,h.b);\\\\n      px(c,x-7,y-5,15,3,rb.b);px(c,x-7,y-5,15,1,rb.l);px(c,x-7,y-3,15,1,rb.d);\\\\n      poly(c,[[x-7,y-5],[x-12,y-2],[x-13,y+2],[x-9,y-1],[x-7,y-2]],rb.b);break;}\\\\n    default:{const h=RP.hair; // capelli\\\\n      px(c,x-7,y-10,15,5,h.b);px(c,x-8,y-6,5,11,h.b);px(c,x-9,y-2,3,8,h.d);\\\\n      px(c,x-5,y-11,9,2,h.l);px(c,x-3,y-11,4,1,h.h);px(c,x+3,y-8,5,3,h.b);px(c,x+5,y-6,3,2,h.b);\\\\n      px(c,x+4,y-8,2,1,h.l);px(c,x-6,y-7,2,5,h.d);px(c,x-1,y-8,3,1,h.d);px(c,x+7,y-5,1,2,h.d);}\\\\n  }\\\\n}\\\\n\\\\n/* ---- arto: manica + avambraccio + mano ---- */\\\\nfunction drawArm(c,sh,A,far,RP,kind){\\\\n  const sl=far?RP.dark2:RP.dark,br=far?RP.main2:(kind==='plate'?RP.main:RP.dark),gl=far?RP.boots2:RP.boots;\\\\n  limb(c,sh[0],sh[1],A.ex,A.ey,5,sl);limb(c,A.ex,A.ey,A.hx,A.hy,5,br);\\\\n  disc(c,A.ex,A.ey,2,far?RP.main2.b:RP.trim.b);px(c,A.ex-1,A.ey-1,1,1,far?RP.main2.l:RP.trim.h);\\\\n  if(kind==='plate'){const mx=(A.ex+A.hx)/2,my=(A.ey+A.hy)/2;px(c,mx-1,my-1,2,2,far?RP.main2.l:RP.trim.b);}\\\\n  disc(c,A.hx,A.hy,2,gl.b);px(c,A.hx-1,A.hy-1,1,1,gl.l);px(c,A.hx,A.hy+1,2,1,gl.dd);\\\\n}\\\\nfunction drawFoot(c,ax,ay,far,RP,kind){\\\\n  const b=far?RP.boots2:RP.boots;\\\\n  px(c,ax-3,ay-3,6,6,b.b);px(c,ax-3,ay-3,2,6,b.l);px(c,ax,ay,10,4,b.b);px(c,ax+8,ay+1,3,3,b.b);\\\\n  px(c,ax-3,ay+3,14,2,b.dd);px(c,ax,ay,9,1,b.l);px(c,ax+9,ay+1,1,1,b.h);px(c,ax-3,ay-4,6,2,far?RP.main2.b:RP.trim.b);\\\\n}\\\\nfunction drawLeg(c,hx,hy,Lg,far,RP,kind){\\\\n  const kx=hx+Lg.kx,ky=hy+Lg.ky,ax=hx+Lg.ax,ay=hy+Lg.ay;\\\\n  limb(c,hx,hy,kx,ky,8,far?RP.dark2:RP.dark);\\\\n  limb(c,kx,ky,ax,ay-2,kind==='plate'?7:6,kind==='plate'?(far?RP.main2:RP.main):(far?RP.boots2:RP.boots));\\\\n  if(kind==='plate'){disc(c,kx+1,ky,3,far?RP.main2.b:RP.main.b);px(c,kx,ky-2,2,1,far?RP.main2.l:RP.main.h);}\\\\n  else{px(c,kx-1,ky-1,3,3,far?RP.boots2.l:RP.boots.l);}\\\\n  drawFoot(c,ax,ay,far,RP,kind);\\\\n}\\\\n\\\\n/* ---- busto ---- */\\\\nfunction drawTorso(c,hx,hy,Sx,Sy,RP,p,kind,S){\\\\n  const n=HU.T+3;\\\\n  const hw=t=>5.4+3.4*sstep(Math.min(1,t*1.25));\\\\n  for(let i=0;i<=n;i++){const t=i/n,cx=lerpN(hx,Sx,t),cy=lerpN(hy,Sy,t),w=hw(t),x0=Math.round(cx-w),ww=Math.round(w*2);\\\\n    const base=kind==='plate'?RP.dark:RP.main;\\\\n    px(c,x0,cy,ww,2,base.d);px(c,x0+1,cy,ww-2,2,base.b);\\\\n    if(kind==='plate'&&t>.3){px(c,x0,cy,ww,2,RP.main.d);px(c,x0+1,cy,ww-3,2,RP.main.b);px(c,x0+1,cy,2,2,RP.main.l);px(c,x0+ww-3,cy,2,2,RP.main.d);\\\\n      if(t>.86)px(c,x0+2,cy,ww-4,2,RP.main.l);}\\\\n    else{px(c,x0+1,cy,2,2,base.l);px(c,x0+ww-3,cy,2,2,base.d);}\\\\n  }\\\\n  const at=t=>[lerpN(hx,Sx,t),lerpN(hy,Sy,t)];\\\\n  if(kind==='plate'){\\\\n    let a=at(.62);px(c,a[0]-hw(.62),a[1],hw(.62)*2,1,RP.main.dd);              // giunzione piastre\\\\n    a=at(.78);px(c,a[0]-hw(.78)+1,a[1],hw(.78)*2-2,1,RP.main.dd);\\\\n    for(let i=0;i<4;i++){a=at(.4+i*.17);px(c,a[0]+2,a[1]-1,1,1,RP.trim.h);}    // rivetti\\\\n    a=at(.5);thick(c,a[0]+2,a[1],a[0]+2,at(.95)[1],1,RP.main.h);                // cresta centrale\\\\n    a=at(.96);px(c,a[0]-5,a[1],11,2,RP.trim.b);px(c,a[0]-5,a[1],11,1,RP.trim.h); // gorgiera\\\\n  }else{\\\\n    const a=at(.94);poly(c,[[a[0]-3,a[1]],[a[0]+4,a[1]],[a[0]+1,a[1]+7]],RP.skin.d);px(c,a[0]-4,a[1],9,1,RP.trim.b);\\\\n    const b=at(.55);px(c,b[0]-hw(.55)+1,b[1],hw(.55)*2-2,1,RP.main.dd);\\\\n  }\\\\n  // cinghia diagonale + borsa\\\\n  const s0=at(.96),s1=at(.12);thick(c,s0[0]+2,s0[1]+1,s1[0]-3,s1[1],3,RP.boots.d);thick(c,s0[0]+1,s0[1]+1,s1[0]-4,s1[1],1,RP.boots.l);\\\\n  const m=at(.55);px(c,m[0]-1,m[1]-1,3,3,RP.trim.b);px(c,m[0],m[1],1,1,RP.trim.h);\\\\n  // cintura\\\\n  const b0=at(.1);px(c,b0[0]-hw(.1)-.5,b0[1]-1,hw(.1)*2+1,4,RP.boots.d);px(c,b0[0]-hw(.1)-.5,b0[1]-1,hw(.1)*2+1,1,RP.boots.l);\\\\n  px(c,b0[0]+2,b0[1]-1,4,4,RP.trim.b);px(c,b0[0]+3,b0[1],2,2,RP.trim.dd);px(c,b0[0]+2,b0[1]-1,4,1,RP.trim.h);\\\\n  px(c,b0[0]-6,b0[1]+3,4,5,RP.leather.b);px(c,b0[0]-6,b0[1]+3,4,1,RP.leather.l);px(c,b0[0]-5,b0[1]+4,1,3,RP.leather.d);   // borsa alla cintura\\\\n}\\\\nfunction drawSkirt(c,hx,hy,RP,p,ph){\\\\n  const sw=sn(ph*2)*1.2,t=RP.tab,L=p.armor?17:12;\\\\n  poly(c,[[hx-4,hy],[hx+7,hy],[hx+8+sw,hy+L-3],[hx+3+sw,hy+L],[hx-3+sw,hy+L-2]],t.b);\\\\n  poly(c,[[hx-4,hy],[hx+1,hy],[hx-1+sw,hy+L-1],[hx-3+sw,hy+L-2]],t.l);\\\\n  px(c,hx+6,hy+2,2,L-6,t.d);thick(c,hx-3+sw,hy+L-2,hx+8+sw,hy+L-3,1,p.armor?RP.trim.b:t.dd);\\\\n  if(p.armor){for(let i=0;i<3;i++)px(c,hx-1+i*3+sw*.5,hy+4+i,1,6,t.d);}\\\\n}\\\\nfunction drawPauldron(c,x,y,r,RP,far){\\\\n  const m=far?RP.main2:RP.main;disc(c,x,y,r,m.dd);disc(c,x,y,r-1,m.d);disc(c,x-1,y-1,r-1,m.b);disc(c,x-2,y-2,Math.max(1,r-3),m.l);\\\\n  px(c,x-r+1,y+r-2,r*2-2,1,far?m.dd:RP.trim.b);px(c,x-2,y-r+1,2,1,m.h);if(!far)px(c,x+2,y,1,1,RP.trim.h);\\\\n}\\\\n\\\\n/* ---- figura completa ---- */\\\\nfunction renderHuman(c,o,S,ph){\\\\n  const p=o.pal,RP=palRamps(p),kind=p.kind||'plate',wep=o.weapon||'none',{L1,L2,T,UA,FA}=HU;\\\\n  const leg=(t,f)=>{const kx=L1*sn(t),ky=L1*cs(t),a=t-f;return{kx,ky,ax:kx+L2*sn(a),ay:ky+L2*cs(a)};};\\\\n  const FL=leg(S.fl[0],S.fl[1]),BL=leg(S.bl[0],S.bl[1]);\\\\n  const hx=0,hy=-(Math.max(FL.ay,BL.ay)+4);\\\\n  const Sx=hx+sn(S.lean)*T,Sy=hy-cs(S.lean)*T-S.breath;\\\\n  const Ns=[Sx+2,Sy+3],Fs=[Sx-3,Sy+3];\\\\n  const hd=[Sx+2-S.tilt*6,Sy-9+Math.abs(S.tilt)*2];\\\\n  const arm=(sh,a)=>{const ex=sh[0]+UA*sn(a[0]),ey=sh[1]+UA*cs(a[0]),b=a[0]+a[1],hx_=ex+FA*sn(b),hy_=ey+FA*cs(b);return{ex,ey,hx:hx_,hy:hy_,fs:Math.atan2(hy_-ey,hx_-ex)};};\\\\n  let AF,AB;\\\\n  if(S.hands){AF=ik(Ns[0],Ns[1],Ns[0]+S.hands.f[0],Ns[1]+S.hands.f[1],UA,FA,1);AB=ik(Fs[0],Fs[1],Fs[0]+S.hands.b[0]+3,Fs[1]+S.hands.b[1],UA,FA,1);}\\\\n  else{AF=arm(Ns,S.fa);AB=arm(Fs,S.ba);}\\\\n  const wa=S.hands?S.wdir:(AF.fs+S.wrel);\\\\n  // mantello\\\\n  if(p.hasCape){const f=S.fly,sw=sn(ph*2)*1.3,bx=Sx-8-f*20-sw,by=hy+16-f*17+(S.sit?-6:0),rc=RP.cape;\\\\n    poly(c,[[Sx-3,Sy-1],[Sx+3,Sy+1],[bx+9,by-1],[bx-7,by+3]],rc.d);\\\\n    poly(c,[[Sx-3,Sy-1],[Sx+1,Sy+1],[bx+4,by-1],[bx-6,by+2]],rc.b);\\\\n    poly(c,[[Sx-3,Sy-1],[Sx-1,Sy],[bx-1,by-1],[bx-6,by+2]],rc.l);\\\\n    thick(c,Sx-2,Sy+3,bx+1,by-1,1,rc.dd);thick(c,Sx-2,Sy+8,bx-3,by,1,rc.d);\\\\n    thick(c,bx-7,by+3,bx+9,by-1,2,mix(p.cape,'#000',.5));\\\\n  }\\\\n  if(o.cos)cosDraw(c,o.cos,'back',{Sx,Sy,Ns,Fs});\\\\n  const twoH=!!S.hands;\\\\n  if(!twoH)drawArm(c,Fs,AB,true,RP,kind);\\\\n  drawLeg(c,hx-1,hy,BL,true,RP,kind);\\\\n  drawTorso(c,hx,hy,Sx,Sy,RP,p,kind,S);\\\\n  if(kind==='plate'||p.armor){drawPauldron(c,Fs[0]-1,Fs[1]-1,4,RP,true);}\\\\n  drawSkirt(c,hx,hy,RP,p,ph);\\\\n  drawLeg(c,hx+1,hy,FL,false,RP,kind);\\\\n  if(p.fur){ // mantella di pelliccia del re\\\\n    const fu=ramp('#f0e8d8');for(let i=0;i<12;i++){const a=Math.PI+i*.28;disc(c,Sx+2+Math.cos(a)*8,Sy+1-Math.sin(a)*3,3,i%2?fu.b:fu.l);}\\\\n    px(c,Sx-8,Sy+2,18,3,fu.b);for(let i=0;i<5;i++)px(c,Sx-7+i*4,Sy+4,2,2,fu.d);\\\\n  }\\\\n  drawHead(c,Math.round(hd[0]),Math.round(hd[1]),p,RP,S);\\\\n  if(o.cos){const hh={hx:Math.round(hd[0]),hy:Math.round(hd[1])};cosDraw(c,o.cos,'face',hh);cosDraw(c,o.cos,'head',hh);}\\\\n  if(p.base){const rs=ramp('#9a1c24');px(c,Sx-4,Sy-3,10,4,rs.b);px(c,Sx-4,Sy-3,10,1,rs.l);px(c,Sx-4,Sy,10,1,rs.d);\\\\n    poly(c,[[Sx-4,Sy-1],[Sx-10-S.fly*5,Sy+2+S.fly*2],[Sx-12-S.fly*6,Sy+10-S.fly*4],[Sx-6,Sy+6]],rs.b);thick(c,Sx-6,Sy+1,Sx-11-S.fly*5,Sy+8-S.fly*3,1,rs.d);}\\\\n  if(twoH)drawArm(c,Fs,AB,true,RP,kind);\\\\n  if(kind==='plate'||p.armor)drawPauldron(c,Ns[0]+1,Ns[1],6,RP,false);\\\\n  else{const mc=RP.main;disc(c,Ns[0]+1,Ns[1],4,mc.d);disc(c,Ns[0],Ns[1]-1,3,mc.b);}\\\\n  if(o.cos)cosDraw(c,o.cos,'sh',{Sx,Sy,Ns,Fs});\\\\n  if(wep!=='none'&&!S.lie)drawWeapon(c,wep,AF.hx,AF.hy,wa,p);\\\\n  if(o.cos&&wep!=='none'&&!S.lie){const wl=wep==='mace'?37:wep==='pistol'?12:0;if(wl)cosDraw(c,o.cos,'wep',{tx:AF.hx+wl*cs(wa),ty:AF.hy+wl*sn(wa),hx:AF.hx,hy:AF.hy});}\\\\n  drawArm(c,Ns,AF,false,RP,kind);\\\\n}\\\\n\\\\n/* ---- frame di animazione quantizzati per la cache ---- */\\\\n/* v14: ogni animazione ha da 50 a 100 frame (prima 2-16) */\\\\nconst ANIM_N={walk:72,run:72,idle:64,sit:64,alert:60,attack:80,sitatk:64,shoot:50,sitpoint:50,jump:60,hurt:50,caged:50};\\\\nfunction humanFrame(o){\\\\n  const pose=o.pose||'idle',t=o.t||0,rate=o.rate||1,pr=o.pr||0,N=ANIM_N[pose]||1;\\\\n  let f=0,ph=0,prq=0,fr=o.fr||0;\\\\n  if(pose==='walk'){f=Math.floor(t*1.9*rate*N)%N;ph=f/N*Math.PI*2;}\\\\n  else if(pose==='run'){f=Math.floor(t*2.7*rate*N)%N;ph=f/N*Math.PI*2;}\\\\n  else if(pose==='idle'||pose==='sit'){f=Math.floor(t*.8*N)%N;ph=f/N*Math.PI*2;}\\\\n  else if(pose==='alert'){f=Math.floor(t*2.4*N)%N;ph=f/N*Math.PI*2;}\\\\n  else if(pose==='hurt'||pose==='caged'){f=Math.floor(t*3*N)%N;ph=f/N*Math.PI*2;}\\\\n  else if(pose==='attack'||pose==='sitatk'||pose==='shoot'||pose==='sitpoint'){f=Math.min(N-1,Math.floor(pr*N));prq=f/(N-1);}\\\\n  else if(pose==='jump'){ // salto continuo: fr può essere frazionario (0 = spinta, 1 = volo, 2 = discesa)\\\\n    const u=clamp(typeof o.jp==='number'?o.jp:fr/2,0,1);f=Math.round(u*(N-1));fr=f/(N-1)*2;}\\\\n  return{pose,f,ph,pr:prq,fr};\\\\n}\\\\nfunction humanSprite(o){\\\\n  const p=o.pal,F=humanFrame(o),wep=o.weapon||'none';\\\\n  const ex=o.funny?'f':o.alert&&F.pose!=='hurt'&&F.pose!=='ko'?'a':'';\\\\n  const key=['h',palKey(p),F.pose,F.f,wep,ex,o.cos?cosKey(o.cos):''].join('|');\\\\n  const s=sprGet(key,HU.CW,HU.CH,c=>{\\\\n    const S=humanPose(F.pose,wep,F.ph,F.pr,F.fr);if(ex==='f')S.expr='funny';else if(ex&&S.expr==='n')S.expr='alert';\\\\n    c.translate(HU.OX,HU.OY);renderHuman(c,o,S,F.ph);});\\\\n  return{s,F};\\\\n}\\\\n/* Disegna una figura umana. (x,y) = piedi. o: face,t,pose,pr,pal,weapon,alert,scale,koT,flip,rate,fr,shadow */\\\\nfunction drawHuman(g,x,y,o){\\\\n  const{s,F}=humanSprite(o),sc=o.scale||1;\\\\n  if(o.shadow&&F.pose!=='jump'){g.save();g.globalAlpha=.34;g.fillStyle='#000';g.beginPath();g.ellipse(Math.round(x),Math.round(y)+.5,10*sc,2.4*sc,0,0,6.283);g.fill();g.restore();}\\\\n  let rot=0,oy=0;\\\\n  if(F.pose==='ko'){const k=Math.min(1,(o.koT||0)/.15);rot=(o.flip?-1:1)*(Math.PI/2)*k;oy=-4.5*k*sc;}\\\\n  sprDraw(g,s,x,y+oy,HU.OX,HU.OY,{face:o.face||1,scale:sc,rot:rot*(o.face<0?-1:1)});\\\\n}\\\\nfunction drawStars(g,x,y,t){for(let i=0;i<3;i++){const a=t*6+i*2.1,sx=x+Math.cos(a)*8,sy=y+Math.sin(a)*2.4;\\\\n  R(g,sx,sy,3,3,'#ffe28a');R(g,sx+1,sy-1,1,5,'#fff6c8');R(g,sx-1,sy+1,5,1,'#fff6c8');}}\\\\n\\\\nfunction drawDog(g,x,y,o){\\\\n  const t=o.t||0,pose=o.pose||'idle',iron=o.iron,red=o.red;\\\\n  g.save();g.translate(Math.round(x),Math.round(y));g.scale(o.face||1,1);\\\\n  if(pose==='ko'){const k=Math.min(1,(o.koT||0)/.15);g.translate(0,-3*k);g.rotate((o.flip?-1:1)*Math.PI*.5*k);g.translate(0,0);}\\\\n  const fur=iron?'#5c636b':'#7a5a3c',dk=iron?'#363c43':'#4a3524',lt=iron?'#9aa4ae':'#a07c56';\\\\n  const run=pose==='run'?Math.sin(t*16)*3:0,att=pose==='attack';\\\\n  R(g,-9,-11,18,7,fur);R(g,-9,-6,18,2,dk);R(g,-8,-12,16,1,lt);\\\\n  // zampe\\\\n  R(g,-9+run,-5,3,5,dk);R(g,-5-run,-5,3,5,fur);R(g,3+run,-5,3,5,dk);R(g,6-run,-5,3,5,fur);\\\\n  // testa\\\\n  const hx=att?10:8,hy=att?-12:-14;\\\\n  R(g,hx-1,hy,8,6,fur);R(g,hx+5,hy+2,4,3,lt);R(g,hx+1,hy-2,2,3,dk);\\\\n  R(g,hx+3,hy+1,2,2,red?'#e02020':'#fff');R(g,hx+4,hy+2,1,1,red?'#ff6060':'#111');\\\\n  R(g,hx+9,hy+2,1,2,'#111');\\\\n  if(att||iron){R(g,hx+5,hy+5,4,1,'#fff');R(g,hx+6,hy+6,1,1,iron?'#c8d0d8':'#fff');R(g,hx+8,hy+6,1,1,iron?'#c8d0d8':'#fff');}\\\\n  R(g,-11,-13+(run?Math.sin(t*16)*1:0),3,3,dk);                       // coda\\\\n  R(g,5,-10,4,2,'#8e1b1b');                                           // collare\\\\n  if(iron){R(g,-5,-12,4,4,'#8a939c');R(g,1,-12,4,4,'#8a939c');R(g,-9,-11,2,3,'#363c43');}\\\\n  g.restore();\\\\n}\\\\n\\\\n/* Trono con pile di monete e nobile */\\\\nfunction drawThrone(g,x,y){\\\\n  R(g,x-17,y-46,34,46,'#5a1620');R(g,x-17,y-46,34,3,'#d8a93a');R(g,x-14,y-42,28,36,'#7a1c2a');\\\\n  R(g,x-13,y-12,26,12,'#8e2434');R(g,x-18,y-16,6,16,'#4a0f18');R(g,x+12,y-16,6,16,'#4a0f18');R(g,x-18,y-17,6,2,'#d8a93a');R(g,x+12,y-17,6,2,'#d8a93a');\\\\n  R(g,x-20,y-6,40,6,'#3a0c12');R(g,x-20,y-6,40,1,'#d8a93a');\\\\n  R(g,x-8,y-52,16,6,'#d8a93a');R(g,x-2,y-56,4,4,'#d8a93a');\\\\n}\\\\nfunction drawCoins(g,x,y){\\\\n  for(let k=0;k<4;k++){const h=4+k%2*3;for(let j=0;j<h;j+=2){R(g,x+k*5-1,y-j-3,5,2,j%4?'#c89a2a':'#f2c94c');}}\\\\n}\\\\nfunction drawNoble(g,n,t){\\\\n  const x=n.x,y=n.y;\\\\n  drawCoins(g,x-52,y);drawCoins(g,x+32,y);\\\\n  g.save();\\\\n  if(n.state==='fallen'){const k=Math.min(1,n.fallT/.4);drawThrone(g,x,y);\\\\n    drawHuman(g,x+k*26,y-k*0,{face:-1,pal:NOBLE,pose:'ko',koT:n.fallT,t,flip:1,weapon:'none'});g.restore();return;}\\\\n  drawThrone(g,x,y);\\\\n  const att=n.state==='attack';\\\\n  const pose=n.hurt>0?'hurt':att?'attack':'idle';\\\\n  // seduto: gambe corte nascoste dal trono\\\\n  g.save();g.beginPath();g.rect(x-30,y-80,60,64);g.clip();\\\\n  drawHuman(g,x,y-2,{face:-1,pal:NOBLE,pose,pr:att?clamp(n.atkT/n.windup,0,1):0,t,weapon:'none',alert:att});\\\\n  g.restore();\\\\n  if(att){const pr=clamp(n.atkT/n.windup,0,1);const a=lerp(-140,30,ease((pr-.1)/.7))*DEG;const hx=x-6,hy=y-22;\\\\n    // bastone da passeggio: si legge come telegrafo\\\\n    Ln(g,hx,hy,hx-Math.cos(a)*22,hy+Math.sin(a)*22,'#d8a93a',2);}\\\\n  if(n.desp&&Math.floor(t*12)%2===0){R(g,x-22,y-60,44,2,'rgba(255,200,80,.5)');}\\\\n  g.restore();\\\\n}\\\\nfunction drawCage(g,x,y,h){\\\\n  const w=26;R(g,x-w/2,y-h,w,3,'#3a3f46');\\\\n  for(let i=0;i<=4;i++)R(g,x-w/2+i*6,y-h,2,h,'#6a727b');\\\\n  R(g,x-w/2,y-4,w,4,'#3a3f46');R(g,x-w/2,y-h,w,1,'#9aa4ae');\\\\n}\\\\n\\\\n/* Oggetti */\\\\nfunction drawGavel(g,x,y,gold){const c=gold?'#ffd45c':'#8a5a30',d=gold?'#b8861c':'#5a3c22';\\\\n  Ln(g,x-3,y+4,x+3,y-3,'#5a3c22',2);R(g,x-1,y-6,8,5,c);R(g,x-1,y-2,8,1,d);R(g,x-4,y+3,6,2,gold?'#b8861c':'#6a4a30');}\\\\nfunction drawDoc(g,x,y,t){R(g,x-4,y-9,9,10,'#e8d8b0');R(g,x-4,y-9,9,1,'#fff3cf');R(g,x-3,y-7,7,1,'#8a6a40');R(g,x-3,y-5,7,1,'#8a6a40');R(g,x-3,y-3,4,1,'#8a6a40');R(g,x+1,y-3,3,3,'#a01c1c');\\\\n  if(Math.sin(t*5)>.4){R(g,x+5,y-12,1,3,'#fff');R(g,x+4,y-11,3,1,'#fff');}}\\\\nfunction drawMag(g,x,y){R(g,x-4,y-8,3,8,'#c8962a');R(g,x-4,y-10,3,3,'#e0b060');R(g,x+1,y-8,3,8,'#c8962a');R(g,x+1,y-10,3,3,'#e0b060');R(g,x-4,y-2,8,2,'#3a3f46');}\\\\nfunction drawHeart(g,x,y,s){g.fillStyle='#e02a2a';g.fillRect(x+1*s,y,2*s,s);g.fillRect(x+4*s,y,2*s,s);g.fillRect(x,y+s,7*s,2*s);g.fillRect(x+s,y+3*s,5*s,s);g.fillRect(x+2*s,y+4*s,3*s,s);g.fillRect(x+3*s,y+5*s,s,s);g.fillStyle='#ff8a8a';g.fillRect(x+s,y+s,s,s);}\\\\nfunction drawArmorStatic(g,x,y,face,broken,t){\\\\n  if(broken){const k=Math.min(1,t);R(g,x-10,y-3,5,3,'#7d8794');R(g,x-3,y-4,7,4,'#4b525c');R(g,x+4,y-3,6,3,'#b8c0c8');R(g,x-1,y-6,4,3,'#7d8794');return;}\\\\n  drawHuman(g,x,y,{face,pal:IRON,pose:'idle',t,weapon:'none'});R(g,x-3,y-28,7,8,'#2a2f36');R(g,x-2,y-26,5,1,'#111');\\\\n}\\\\n\\\\n/* Torre finale (uscita) */\\\\nfunction drawTowerBig(g,x,y,open,t){\\\\n  const w=84,h=214;R(g,x,y-h,w,h,'#4a4540');\\\\n  for(let r=0;r<h;r+=8)for(let c=0;c<w;c+=14){R(g,x+c+((r/8)%2?7:0),y-h+r,13,7,(r+c)%3?'#58524b':'#4f4a44');}\\\\n  R(g,x-6,y-h,w+12,8,'#3a3632');for(let i=0;i<6;i++)R(g,x-6+i*16,y-h-8,10,8,'#3a3632');\\\\n  R(g,x+w/2-16,y-54,32,54,open?'#0d0b0a':'#3a2414');R(g,x+w/2-16,y-54,32,3,'#d8a93a');\\\\n  if(!open){R(g,x+w/2-1,y-54,2,54,'#2a1a0e');R(g,x+w/2-12,y-30,3,3,'#d8a93a');R(g,x+w/2+9,y-30,3,3,'#d8a93a');}\\\\n  else{for(let i=0;i<54;i+=6)R(g,x+w/2-16,y-54+i,32,1,'rgba(232,135,42,.18)');}\\\\n  for(let i=0;i<4;i++){R(g,x+w/2-6,y-92-i*38,12,18,'#101820');R(g,x+w/2-6,y-92-i*38,12,2,'#d8a93a');R(g,x+w/2-2,y-90-i*38,4,14,Math.sin(t*2+i)>-.5?'#e8872a':'#a85a1a');}\\\\n  R(g,x+6,y-170,12,52,'#a3262a');R(g,x+w-18,y-170,12,52,'#a3262a');R(g,x+10,y-150,4,4,'#d8a93a');R(g,x+w-14,y-150,4,4,'#d8a93a');\\\\n}\\\\n/* ===== Cani, trono, monete, gabbia, oggetti in HD ===== */\\\\n/* v14: cane con 72 frame di corsa, 60 di attesa (coda e respiro) e 50 di attacco */\\\\nconst DOG_N={run:72,idle:60,attack:50};\\\\nfunction dogSprite(o){\\\\n  const mode=o.mode||'idle',f=o.f|0,key='dog'+(o.iron?'I':'F')+(o.red?'R':'')+mode+f;\\\\n  return sprGet(key,132,76,c=>{\\\\n    const iron=o.iron,fur=ramp(iron?'#6b737c':'#8a6238'),bel=ramp(iron?'#8a939c':'#b48a5c'),run=mode==='run',att=mode==='attack';\\\\n    const P=f/DOG_N[mode]*Math.PI*2,ph=run?P:0,sw=a=>Math.sin(ph+a)*9,lf=a=>Math.max(0,Math.cos(ph+a))*5;\\\\n    const lunge=att?.5-.5*Math.cos(P):0,breath=mode==='idle'?Math.sin(P)*.8:0;\\\\n    const bx=58,by=40-breath-(run?Math.abs(Math.sin(P))*1.5:0); // centro corpo, suolo a y=70\\\\n    const leg=(hx,hy,a,far)=>{const R2=far?ramp(iron?'#454c54':'#5a3d22'):fur;const fx=hx+(run?sw(a):0),fy=70-(run?lf(a):0);\\\\n      const kx=(hx+fx)/2+(far?-2:2),ky=(hy+fy)/2-2;limb(c,hx,hy,kx,ky,5,R2);limb(c,kx,ky,fx,fy-1,4,R2);\\\\n      px(c,fx-2,70-(run?lf(a):0)-2,6,3,iron?'#2a2f35':'#2a1c10');};\\\\n    leg(bx-18,by+8,0,true);leg(bx+16,by+8,Math.PI,true);\\\\n    // coda\\\\n    const tw=Math.sin(run?P*1.1:att?P*2:P)*3;\\\\n    thick(c,bx-26,by-4,bx-36,by-12+tw,4,fur.d);thick(c,bx-36,by-12+tw,bx-42,by-20+tw,3,fur.b);\\\\n    // corpo\\\\n    ell(c,bx-2,by+2,27,13,fur.d);ell(c,bx-2,by,26,12,fur.b);ell(c,bx-3,by-4,22,6,fur.l);ell(c,bx,by+8,20,4,bel.b);\\\\n    ell(c,bx+20,by-1,10,11,fur.b);ell(c,bx-20,by+2,10,10,fur.b);ell(c,bx-22,by-2,6,5,fur.l);\\\\n    // pelo a ciuffi sul dorso\\\\n    for(let i=0;i<9;i++)px(c,bx-20+i*5,by-12-(i%2),2,2,fur.d);\\\\n    // collo e testa\\\\n    const hx=bx+30+lunge*6,hy=by-10+lunge*4;\\\\n    poly(c,[[bx+16,by-12],[hx,hy-6],[hx+2,hy+8],[bx+18,by+8]],fur.b);\\\\n    ell(c,hx+4,hy,12,10,fur.b);ell(c,hx+3,hy-3,10,6,fur.l);\\\\n    // muso\\\\n    poly(c,[[hx+8,hy-4],[hx+26,hy+1],[hx+26,hy+7],[hx+8,hy+9]],fur.b);px(c,hx+10,hy-3,14,2,fur.l);\\\\n    px(c,hx+8,hy+6,18,3,bel.b);px(c,hx+24,hy,4,4,'#15100c');px(c,hx+25,hy,1,1,'#aab');\\\\n    if(att||iron){px(c,hx+12,hy+7,10,3,'#fff6e6');for(let i=0;i<4;i++)px(c,hx+13+i*3,hy+9,1,3,'#fff6e6');px(c,hx+10,hy+8,12,1,'#8e1b1b');}\\\\n    // orecchio\\\\n    poly(c,[[hx-3,hy-8],[hx-1,hy-20],[hx+7,hy-8]],fur.d);poly(c,[[hx,hy-9],[hx+1,hy-16],[hx+5,hy-9]],fur.b);\\\\n    // occhio\\\\n    if(o.red){disc(c,hx+10,hy-2,3,'#701010');disc(c,hx+10,hy-2,2,'#ff2a2a');px(c,hx+10,hy-3,1,1,'#fff');px(c,hx+7,hy-6,7,2,'#2a0808');}\\\\n    else{px(c,hx+8,hy-3,4,3,'#fff6e6');px(c,hx+10,hy-3,2,3,'#1a1008');px(c,hx+7,hy-6,6,1,fur.d);}\\\\n    // collare\\\\n    px(c,bx+16,by-10,5,18,'#8e1b1b');px(c,bx+16,by-10,2,18,'#c0262c');px(c,bx+17,by-2,3,3,'#e8c25a');\\\\n    if(iron){ // armatura\\\\n      poly(c,[[bx-22,by-12],[bx+12,by-14],[bx+14,by+2],[bx-24,by+4]],'#8a939c');\\\\n      for(let i=0;i<4;i++){px(c,bx-20+i*9,by-12,2,15,'#aab4be');px(c,bx-21+i*9,by-12,1,15,'#454c54');}\\\\n      px(c,bx-22,by-13,36,2,'#c8d0d8');px(c,bx-22,by+2,38,2,'#454c54');\\\\n      poly(c,[[hx-1,hy-6],[hx+12,hy-9],[hx+14,hy-3],[hx-1,hy+2]],'#8a939c');px(c,hx,hy-7,12,2,'#c8d0d8');\\\\n      poly(c,[[hx+3,hy-9],[hx+6,hy-17],[hx+9,hy-9]],'#c8d0d8');\\\\n    }\\\\n    leg(bx-14,by+10,Math.PI,false);leg(bx+20,by+10,0,false);\\\\n  });\\\\n}\\\\nfunction drawDog(g,x,y,o){\\\\n  const t=o.t||0,pose=o.pose||'idle';\\\\n  const mode=pose==='run'?'run':pose==='attack'?'attack':'idle',N=DOG_N[mode];\\\\n  const f=Math.floor(t*(mode==='run'?2.25:mode==='attack'?2:.8)*N)%N;\\\\n  const s=dogSprite({iron:o.iron,red:o.red,mode,f});\\\\n  const ko=pose==='ko'?Math.min(1,(o.koT||0)/.15):0;\\\\n  g.save();g.translate(Math.round(x),Math.round(y));\\\\n  if(o.face<0)g.scale(-1,1);\\\\n  g.fillStyle='rgba(0,0,0,.28)';g.fillRect(-14,-1,28,2);\\\\n  if(ko){g.translate(0,-3*ko);g.rotate((o.flip?-1:1)*Math.PI*.5*ko);}\\\\n  g.drawImage(s.c,-58*.5,-70*.5,s.w*.5,s.h*.5);g.restore();\\\\n}\\\\n\\\\n/* trono */\\\\nfunction throneSprite(){return sprGet('throne',150,170,c=>{\\\\n  const rd=ramp('#7a1c2a'),dk=ramp('#4a0f18'),go=ramp('#d8a93a');\\\\n  // schienale ad arco\\\\n  poly(c,[[34,150],[34,52],[44,30],[75,18],[106,30],[116,52],[116,150]],dk.d);\\\\n  poly(c,[[40,150],[40,54],[48,36],[75,26],[102,36],[110,54],[110,150]],rd.b);\\\\n  poly(c,[[48,150],[48,58],[54,44],[75,34],[96,44],[102,58],[102,150]],rd.d);\\\\n  // trapunta a rombi\\\\n  for(let yy=56;yy<140;yy+=14)for(let xx=52;xx<100;xx+=12){const o=((yy-56)/14)%2?6:0;poly(c,[[xx+o,yy],[xx+o+5,yy+7],[xx+o,yy+14],[xx+o-5,yy+7]],rd.l);px(c,xx+o,yy+7,1,1,go.h);}\\\\n  // cornice dorata\\\\n  for(let i=0;i<=8;i++){const a=Math.PI+i/8*Math.PI;disc(c,75+Math.cos(a)*41,56+Math.sin(a)*38,2,go.b);}\\\\n  px(c,34,52,3,98,go.b);px(c,113,52,3,98,go.b);px(c,35,52,1,98,go.h);\\\\n  // corona in cima\\\\n  poly(c,[[63,22],[63,8],[69,15],[75,3],[81,15],[87,8],[87,22]],go.b);px(c,64,18,22,4,go.d);px(c,64,16,22,1,go.h);disc(c,75,6,2,'#e02a2a');\\\\n  // braccioli\\\\n  for(const sx of[-1,1]){const ax=75+sx*44;poly(c,[[ax-9,150],[ax-9,104],[ax+9,104],[ax+9,150]],dk.b);px(c,ax-11,100,22,6,go.b);px(c,ax-11,100,22,1,go.h);disc(c,ax,98,5,go.b);px(c,ax-1,95,2,2,go.h);}\\\\n  // sedile e base\\\\n  px(c,36,124,78,26,rd.l);px(c,36,124,78,3,go.l);px(c,36,146,78,4,dk.d);\\\\n  px(c,22,150,106,10,dk.d);px(c,22,150,106,2,go.b);px(c,14,160,122,10,'#2a080e');px(c,14,160,122,2,go.b);\\\\n  for(let i=0;i<10;i++)px(c,22+i*12,154,2,4,go.d);\\\\n});}\\\\nfunction drawThrone(g,x,y){const s=throneSprite();sprDraw(g,s,x,y,75,168);}\\\\nfunction coinSprite(){return sprGet('coins',110,60,c=>{\\\\n  const go=ramp('#e8b830');\\\\n  const pile=(cx,base,wd,h)=>{for(let r=0;r<h;r++){const w=wd-r*4,yy=base-r*5;if(w<5)break;for(let k=-w/2;k<w/2;k+=6){ell(c,cx+k+3,yy,4,2,r%2?go.d:go.b);px(c,cx+k+1,yy-2,3,1,go.h);}}};\\\\n  pile(30,56,44,6);pile(72,56,50,7);pile(52,56,34,5);\\\\n  for(const[ex,ey]of[[12,50],[92,50],[50,30],[70,24]])disc(c,ex,ey,3,go.l),px(c,ex-1,ey-1,2,1,go.h);\\\\n});}\\\\nfunction drawCoins(g,x,y){sprDraw(g,coinSprite(),x+22,y,55,58);}\\\\nfunction drawNoble(g,n,t){\\\\n  const x=n.x,y=n.y;\\\\n  drawCoins(g,x-76,y);drawCoins(g,x+4,y);\\\\n  g.save();\\\\n  if(n.state==='fallen'){const k=Math.min(1,n.fallT/.4);drawThrone(g,x,y);\\\\n    drawHuman(g,x+k*26,y,{face:-1,pal:NOBLE,pose:'ko',koT:n.fallT,t,flip:1,weapon:'none'});g.restore();return;}\\\\n  drawThrone(g,x,y);\\\\n  const att=n.state==='attack';\\\\n  const pose=n.hurt>0?'hurt':att?'attack':'idle';\\\\n  g.save();g.beginPath();g.rect(x-30,y-90,60,69);g.clip();\\\\n  drawHuman(g,x,y-5,{face:-1,pal:NOBLE,pose:att?'attack':(n.hurt>0?'hurt':'idle'),pr:att?clamp(n.atkT/n.windup,0,1):0,t,weapon:'none',alert:att});\\\\n  g.restore();\\\\n  if(att){const pr=clamp(n.atkT/n.windup,0,1);const a=lerp(-140,30,ease((pr-.1)/.7))*DEG;const hx=x-6,hy=y-22;\\\\n    Ln(g,hx,hy,hx-Math.cos(a)*22,hy+Math.sin(a)*22,'#d8a93a',2);}\\\\n  if(n.desp&&Math.floor(t*12)%2===0){R(g,x-22,y-60,44,2,'rgba(255,200,80,.5)');}\\\\n  g.restore();\\\\n}\\\\n\\\\n/* gabbia */\\\\nfunction cageSprite(h){return sprGet('cage'+h,70,h*2+12,c=>{\\\\n  const st=ramp('#6a727b'),H=h*2,w=52,x0=9;\\\\n  px(c,x0-2,2,w+4,6,st.d);px(c,x0-2,2,w+4,2,st.l);px(c,x0+10,0,w-20,4,st.d);disc(c,35,1,3,st.l);\\\\n  for(let i=0;i<=6;i++){const bx=x0+i*(w/6)-1;px(c,bx,6,4,H-8,st.d);px(c,bx,6,2,H-8,st.l);px(c,bx,6,1,H-8,st.h);}\\\\n  px(c,x0-2,H*.5,w+4,3,st.d);px(c,x0-2,H*.5,w+4,1,st.l);\\\\n  px(c,x0-4,H-4,w+8,8,'#3a3f46');px(c,x0-4,H-4,w+8,2,st.b);\\\\n  for(let i=0;i<4;i++)px(c,x0+2+i*15,H-2,3,3,'#aab4be');\\\\n});}\\\\nfunction drawCage(g,x,y,h){const s=cageSprite(h);sprDraw(g,s,x,y,35,h*2+6);}\\\\n\\\\n/* oggetti */\\\\nfunction itemSprite(key,w,h,fn){return sprGet(key,w,h,fn);}\\\\nfunction drawGavel(g,x,y,gold){\\\\n  const s=itemSprite('gavel2'+(gold?'G':'W'),66,66,c=>{\\\\n    const hd=ramp(gold?'#ffd45c':'#8a5a30'),hn=ramp(gold?'#d8a93a':'#5a3c22'),mt=ramp(gold?'#fff0b0':'#b8c0c8');\\\\n    // manico con fasce e ombra\\\\n    thick(c,15,54,42,24,8,hn.d);thick(c,13,52,40,22,6,hn.b);thick(c,11,51,38,21,2,hn.l);\\\\n    thick(c,21,44,29,35,1,hn.dd);thick(c,30,32,36,28,1,hn.dd);\\\\n    // fascia di metallo sotto la testa\\\\n    thick(c,31,30,39,22,3,mt.d);thick(c,31,29,39,21,1,mt.l);\\\\n    // testa del martello: faccia piena, bordo scuro e luce\\\\n    poly(c,[[24,18],[48,3],[60,24],[36,39]],hd.d);poly(c,[[24,16],[46,2],[57,20],[35,35]],hd.b);\\\\n    poly(c,[[26,15],[45,4],[49,8],[29,19]],hd.l);poly(c,[[50,5],[57,20],[54,21],[48,8]],hd.h);\\\\n    // incisioni sulla testa\\\\n    poly(c,[[30,26],[38,22],[40,25],[32,29]],hd.dd);px(c,36,15,3,3,hd.h);\\\\n    px(c,14,58,3,3,hn.dd);poly(c,[[12,60],[6,54],[11,51],[17,57]],hn.d);\\\\n    if(gold){px(c,50,4,3,3,'#fff');px(c,55,10,2,2,'#fff');px(c,58,3,1,1,'#fff');px(c,22,22,1,1,'#fff');}\\\\n  });sprDraw(g,s,x,y,33,33);\\\\n}\\\\nfunction drawDoc(g,x,y,t){const s=itemSprite('doc',34,40,c=>{\\\\n  px(c,4,2,26,34,'#4a3a22');px(c,3,1,26,34,'#e8d8b0');px(c,3,1,26,3,'#fff3cf');px(c,26,1,3,34,'#c8b88a');\\\\n  for(let i=0;i<5;i++)px(c,7,8+i*5,i===4?10:18,2,'#8a6a40');\\\\n  disc(c,22,30,4,'#a02020');disc(c,22,30,2,'#d03a3a');px(c,6,30,2,2,'#2a1a10');\\\\n});sprDraw(g,s,x,y+Math.sin((t||0)*3)*.5,17,38);}\\\\nfunction drawMag(g,x,y){const s=itemSprite('mag',34,42,c=>{\\\\n  for(const ox of[0,14]){px(c,4+ox,10,10,26,'#8a6420');px(c,4+ox,10,3,26,'#c8962a');px(c,6+ox,12,2,22,'#e0b060');px(c,4+ox,32,10,4,'#4a3410');px(c,4+ox,4,10,6,'#e0b060');px(c,6+ox,2,6,3,'#b87a30');px(c,7+ox,3,2,1,'#fff6e6');}\\\\n});sprDraw(g,s,x,y,17,40);}\\\\nfunction drawHeart(g,x,y,s){const sp=itemSprite('heart',36,32,c=>{\\\\n  const hr=ramp('#e02a2a');\\\\n  disc(c,11,11,9,hr.d);disc(c,25,11,9,hr.d);poly(c,[[1,14],[35,14],[18,32]],hr.d);\\\\n  disc(c,11,10,8,hr.b);disc(c,25,10,8,hr.b);poly(c,[[3,14],[33,14],[18,29]],hr.b);\\\\n  disc(c,9,8,3,hr.h);px(c,6,12,3,2,hr.l);px(c,26,18,2,3,hr.d);\\\\n});g.drawImage(sp.c,x,y,7*s,7*s*sp.h/sp.w);}\\\\n\\\\n/* ===== Mondo: texture, livelli, sfondi, effetti ===== */\\\\nconst P2=o=>Object.assign({skin:'#c89a76',hair:'#2a1a12',boots:'#2b2420',hasCape:false,head:'helm',plume:'#a01c1c',cape:'#2a2a2a'},o);\\\\nconst ET={\\\\n  rat:      {name:'Ratto delle segrete',lv:1,  body:'rat', mv:'dog',  hp:.35,spd:118,dmg:.45,range:14,windup:.2,pack:3},\\\\n  sword:    {name:'Spadaccino',lv:1,          mv:'spear',hp:.9, spd:70, dmg:1,  range:1.15*B,windup:.3,weapon:'sword',pal:P2({main:'#3a5a8a',dark:'#22344f',trim:'#d8c8a0',cape:'#22344f',head:'hair',kind:'cloth',hasCape:true})},\\\\n  shield:   {name:'Scudiero',lv:1,            mv:'spear',hp:1.3,spd:42, dmg:.9, range:1.3*B,windup:.5,weapon:'sword',shield:.25,pal:P2({main:'#6a7a8a',dark:'#3a444e',trim:'#d8a93a',cape:'#1f3a6a',plume:'#1f3a6a',armor:true})},\\\\n  xbow:     {name:'Balestriere',lv:10,        mv:'rifle',hp:.85,spd:46, dmg:2.2,range:5*B,  windup:.7,weapon:'crossbow',ranged:'bolt',pal:P2({main:'#7a5a3a',dark:'#4a3420',trim:'#b8c0c8',plume:'#6a4a2a',kind:'cloth'})},\\\\n  archer:   {name:'Arciere',lv:10,            mv:'rifle',hp:.75,spd:52, dmg:1.6,range:6*B,  windup:.6,weapon:'bow',ranged:'arrow',pal:P2({main:'#3a5a2a',dark:'#24381a',trim:'#c8b070',head:'hood',kind:'cloth',hasCape:true,cape:'#2a4020'})},\\\\n  bat:      {name:'Pipistrello del campanile',lv:10,body:'bat',mv:'dog',hp:.3,spd:105,dmg:.5,range:18,windup:.3},\\\\n  jailer:   {name:'Carceriere',lv:25,         mv:'spear',hp:1.8,spd:40, dmg:1.6,range:1.4*B,windup:.55,weapon:'mace',pal:P2({main:'#5a4030',dark:'#3a2818',trim:'#8a8a8a',head:'band',hair:'#3a2a1a',kind:'cloth',beard:true})},\\\\n  halberd:  {name:'Alabardiere',lv:25,        mv:'spear',hp:1.2,spd:46, dmg:1.4,range:2.4*B,windup:.65,weapon:'halberd',pal:P2({main:'#8a2a2a',dark:'#5a1a1a',trim:'#d8a93a',plume:'#d8a93a',armor:true,cape:'#5a1a1a',shaft:'#5a3a22',tip:'#e0e6ec'})},\\\\n  assassin: {name:'Assassino',lv:25,          mv:'rifle',hp:.7, spd:95, dmg:1.2,range:3.5*B,windup:.35,weapon:'dagger',ranged:'dagger',pal:P2({main:'#2a2a32',dark:'#16161c',trim:'#7a1626',head:'hood',kind:'cloth',hasCape:true,cape:'#16161c'})},\\\\n  alchemist:{name:'Alchimista',lv:50,         mv:'rifle',hp:.8, spd:44, dmg:.9, range:4.5*B,windup:.8,weapon:'flask',ranged:'potion',pal:P2({main:'#4a2a6a',dark:'#2a1640',trim:'#3ac27a',head:'hat',kind:'cloth',hasCape:true,cape:'#2a1640',beard:true,hair:'#c9c9c9'})},\\\\n  cleric:   {name:'Chierico di corte',lv:50,  mv:'spear',hp:1,  spd:44, dmg:.6, range:1.3*B,windup:.6,weapon:'staff',heal:true,pal:P2({main:'#e8e0d0',dark:'#b0a890',trim:'#d8a93a',head:'hood',kind:'cloth',hasCape:true,cape:'#c8c0b0'})},\\\\n  herald:   {name:'Araldo',lv:50,             mv:'spear',hp:1,  spd:50, dmg:.8, range:1.3*B,windup:.5,weapon:'horn',horn:true,pal:P2({main:'#1f3a6a',dark:'#7a1626',trim:'#d8a93a',head:'hat',kind:'cloth',hasCape:true,cape:'#7a1626'})},\\\\n  execu:    {name:'Boia',lv:100,              mv:'spear',hp:2.2,spd:36, dmg:3,  range:1.6*B,windup:.9,weapon:'axe',scale:1.18,heavy:true,pal:P2({main:'#2a2420',dark:'#121010',trim:'#5a1a1a',head:'hood',kind:'cloth',skin:'#a87656'})},\\\\n  knight:   {name:'Cavaliere pesante',lv:100, mv:'spear',hp:3,  spd:34, dmg:2,  range:1.5*B,windup:.6,weapon:'sword',scale:1.15,heavy:true,charge:true,pal:P2({main:'#9aa4ae',dark:'#5a626c',trim:'#d8a93a',plume:'#d8a93a',armor:true,visor:true,hasCape:true,cape:'#7a1626'})},\\\\n  armor:    {name:'Armatura incantata',lv:100,mv:'spear',hp:2.5,spd:38, dmg:1.6,range:1.3*B,windup:.6,weapon:'sword',scale:1.05,heavy:true,ghost:true,pal:P2({main:'#7d8794',dark:'#4b525c',trim:'#6ab0ff',plume:'#3a6ab0',armor:true,visor:true})},\\\\n  // aiutanti dei boss\\\\n  captain:  {name:'Capitano della Guardia Reale',helper:true,mv:'spear',hpB:.3,spd:62,dmg:2,range:1.4*B,windup:.45,weapon:'sword',shield:.5,scale:1.25,heavy:true,rally:true,pal:P2({main:'#c0c8d0',dark:'#7a1626',trim:'#ffe28a',plume:'#e02a2a',armor:true,hasCape:true,cape:'#7a1626'})},\\\\n  mage:     {name:'Mago di Corte',helper:true,mv:'rifle',hpB:.25,spd:40,dmg:1.6,range:7*B,windup:.9,weapon:'staff',ranged:'orb',fan:3,teleport:true,scale:1.15,pal:P2({main:'#2a1a5a',dark:'#160c36',trim:'#ffd45c',head:'hood',kind:'cloth',hasCape:true,cape:'#160c36',beard:true,hair:'#e8e8e8'})},\\\\n  headsman: {name:'Boia del Re',helper:true,  mv:'spear',hpB:.4,spd:34,dmg:3.2,range:1.8*B,windup:1.05,weapon:'axe',slam:true,scale:1.35,heavy:true,pal:P2({main:'#3a0c12',dark:'#120408',trim:'#d8a93a',head:'hood',kind:'cloth',skin:'#a87656'})}\\\\n};\\\\n/* ---- disegno di ratti e pipistrelli (sprite ad alta risoluzione, 40 fotogrammi) ---- */\\\\nconst RAT_N=40,BAT_N=36;\\\\nfunction ratSprite(f){return sprGet('rat22_'+f,70,40,c=>{const ph=f/RAT_N*Math.PI*2,fu=ramp('#6a5a4e'),bl=ramp('#8a7a6e');\\\\n  const leg=(x,a,far)=>{const fx=x+Math.sin(ph+a)*5,fy=34-Math.max(0,Math.cos(ph+a))*3;thick(c,x,26,fx,fy,2.4,far?fu.dd:fu.d);px(c,fx-1,fy,4,2,'#d8a0a0');};\\\\n  leg(22,0,1);leg(42,Math.PI,1);\\\\n  c.strokeStyle=fu.d;c.lineWidth=2;c.beginPath();c.moveTo(14,24);c.quadraticCurveTo(2,22+Math.sin(ph*2)*4,4,10+Math.sin(ph)*3);c.stroke();\\\\n  ell(c,32,22,16,8,fu.b);ell(c,30,19,12,4,fu.l);ell(c,34,27,11,3,bl.b);\\\\n  poly(c,[[44,16],[60,22],[44,28]],fu.b);disc(c,59,22,1.5,'#d88a8a');px(c,50,19,2,2,'#e02a2a');\\\\n  ell(c,45,14,4,5,fu.d);ell(c,45,14,2,3,'#d8a0a0');for(let i=0;i<3;i++)thick(c,58,22,66,18+i*3,.6,'#cfc6b4');\\\\n  leg(26,Math.PI,0);leg(46,0,0);});}\\\\nfunction batSprite(f){return sprGet('bat22_'+f,80,50,c=>{const ph=f/BAT_N*Math.PI*2,w=Math.sin(ph),dk=ramp('#2a2230'),mb=ramp('#4a3a52');\\\\n  const wing=s=>{const tip=[40+s*36,20-w*16],mid=[40+s*20,14-w*10];\\\\n    poly(c,[[40+s*4,22],mid,tip,[40+s*30,30-w*6],[40+s*20,28-w*3],[40+s*12,32]],mb.b);\\\\n    thick(c,40+s*4,22,mid[0],mid[1],1.4,dk.dd);thick(c,mid[0],mid[1],tip[0],tip[1],1.2,dk.dd);thick(c,mid[0],mid[1],40+s*20,28-w*3,.8,dk.d);};\\\\n  wing(-1);wing(1);ell(c,40,25,7,9,dk.b);ell(c,39,22,5,5,dk.l);poly(c,[[34,17],[36,9],[39,16]],dk.b);poly(c,[[46,17],[44,9],[41,16]],dk.b);\\\\n  px(c,36,20,2,2,'#ff3a2a');px(c,42,20,2,2,'#ff3a2a');px(c,38,27,1,2,'#fff');px(c,41,27,1,2,'#fff');});}\\\\nfunction drawShield(g,x,y,face,sc,gold){g.save();g.translate(x+face*7*sc,y-19*sc);g.scale(face*sc,sc);\\\\n  g.fillStyle='#120a06';g.beginPath();g.moveTo(-5.5,-9.5);g.lineTo(5.5,-9.5);g.lineTo(5.5,1);g.quadraticCurveTo(5,8,0,11.5);g.quadraticCurveTo(-5,8,-5.5,1);g.closePath();g.fill();\\\\n  g.fillStyle=gold?'#7a1626':'#1f3a6a';g.beginPath();g.moveTo(-4.5,-8.5);g.lineTo(4.5,-8.5);g.lineTo(4.5,1);g.quadraticCurveTo(4,7,0,10.2);g.quadraticCurveTo(-4,7,-4.5,1);g.closePath();g.fill();\\\\n  g.fillStyle=gold?'#ffe28a':'#d8a93a';g.fillRect(-.8,-8.5,1.6,18);g.fillRect(-4.5,-3,9,1.6);g.fillStyle='rgba(255,255,255,.18)';g.fillRect(-4,-8,2,8);g.restore();}\\\\n/* ---- armi nuove (pixel HD, come drawWeapon) ---- */\\\\nfunction drawWeapon2(c,type,x,y,a,p){\\\\n  const dx=cs(a),dy=sn(a),nx=-dy,ny=dx;\\\\n  switch(type){\\\\n    case'sword':{const st=ramp('#c8d0d8'),go=ramp('#d8a93a');\\\\n      thick(c,x-5*dx,y-5*dy,x+2*dx,y+2*dy,3,'#3a2414');disc(c,x-6*dx,y-6*dy,2,go.b);\\\\n      thick(c,x+2*dx+nx*5,y+2*dy+ny*5,x+2*dx-nx*5,y+2*dy-ny*5,2,go.b);\\\\n      poly(c,[[x+3*dx+nx*2,y+3*dy+ny*2],[x+30*dx+nx*1.6,y+30*dy+ny*1.6],[x+36*dx,y+36*dy],[x+30*dx-nx*1.6,y+30*dy-ny*1.6],[x+3*dx-nx*2,y+3*dy-ny*2]],st.b);\\\\n      thick(c,x+4*dx,y+4*dy,x+31*dx,y+31*dy,1,st.h);return true;}\\\\n    case'axe':{const wd=ramp('#5a3a1c'),st=ramp('#9aa4ae');\\\\n      thick(c,x-10*dx,y-10*dy,x+40*dx,y+40*dy,3,wd.b);thick(c,x-10*dx-.5,y-10*dy-.5,x+40*dx-.5,y+40*dy-.5,1,wd.l);\\\\n      const hx=x+34*dx,hy=y+34*dy;poly(c,[[hx-6*dx,hy-6*dy],[hx-12*dx+nx*16,hy-12*dy+ny*16],[hx+3*dx+nx*20,hy+3*dy+ny*20],[hx+12*dx+nx*14,hy+12*dy+ny*14],[hx+6*dx,hy+6*dy]],st.d);\\\\n      poly(c,[[hx-4*dx+nx*3,hy-4*dy+ny*3],[hx-9*dx+nx*15,hy-9*dy+ny*15],[hx+3*dx+nx*18,hy+3*dy+ny*18],[hx+9*dx+nx*13,hy+9*dy+ny*13],[hx+4*dx+nx*3,hy+4*dy+ny*3]],st.b);\\\\n      thick(c,hx-9*dx+nx*15,hy-9*dy+ny*15,hx+9*dx+nx*13,hy+9*dy+ny*13,1.4,st.h);px(c,hx-1,hy-1,3,3,'#3a3f46');return true;}\\\\n    case'halberd':{const sh=ramp(p&&p.shaft||'#5a3a22'),tp=ramp(p&&p.tip||'#e0e6ec'),x1=x+40*dx,y1=y+40*dy;\\\\n      thick(c,x-16*dx,y-16*dy,x1,y1,2,sh.d);thick(c,x-16*dx-.5,y-16*dy-.5,x1-.5,y1-.5,1,sh.l);\\\\n      poly(c,[[x1+nx*2,y1+ny*2],[x1+dx*12,y1+dy*12],[x1-nx*2,y1-ny*2]],tp.b);\\\\n      poly(c,[[x1-dx*6,y1-dy*6],[x1-dx*10-nx*12,y1-dy*10-ny*12],[x1+dx*2-nx*13,y1+dy*2-ny*13],[x1+dx*2,y1+dy*2]],tp.d);\\\\n      poly(c,[[x1-dx*7-nx*2,y1-dy*7-ny*2],[x1-dx*9-nx*10,y1-dy*9-ny*10],[x1+dx*1-nx*11,y1+dy*1-ny*11],[x1+dx*1-nx*2,y1+dy*1-ny*2]],tp.b);\\\\n      poly(c,[[x1-dx*4+nx*2,y1-dy*4+ny*2],[x1-dx*2+nx*7,y1-dy*2+ny*7],[x1+nx*2,y1+ny*2]],tp.d);return true;}\\\\n    case'crossbow':{const wd=ramp('#6b4a2a'),ir=ramp('#4a4f58');\\\\n      thick(c,x-12*dx,y-12*dy,x+16*dx,y+16*dy,3,wd.b);thick(c,x-12*dx-.5,y-12*dy-.5,x+16*dx-.5,y+16*dy-.5,1,wd.l);\\\\n      const bx=x+14*dx,by=y+14*dy;c.strokeStyle=ir.d;c.lineWidth=2;c.beginPath();c.moveTo(bx+nx*10-dx*3,by+ny*10-dy*3);c.quadraticCurveTo(bx+dx*3,by+dy*3,bx-nx*10-dx*3,by-ny*10-dy*3);c.stroke();\\\\n      thick(c,bx+nx*10-dx*3,by+ny*10-dy*3,x+4*dx,y+4*dy,.6,'#e8e0d0');thick(c,bx-nx*10-dx*3,by-ny*10-dy*3,x+4*dx,y+4*dy,.6,'#e8e0d0');\\\\n      thick(c,x+4*dx,y+4*dy,x+20*dx,y+20*dy,1,'#7a1626');return true;}\\\\n    case'bow':{const wd=ramp('#7a5028');c.strokeStyle=wd.b;c.lineWidth=2.4;c.beginPath();c.moveTo(x+nx*16-dx*2,y+ny*16-dy*2);c.quadraticCurveTo(x+dx*10,y+dy*10,x-nx*16-dx*2,y-ny*16-dy*2);c.stroke();\\\\n      c.strokeStyle=wd.l;c.lineWidth=.8;c.stroke();thick(c,x+nx*16-dx*2,y+ny*16-dy*2,x-nx*16-dx*2,y-ny*16-dy*2,.6,'#e8e0d0');\\\\n      thick(c,x-3*dx,y-3*dy,x+20*dx,y+20*dy,1,'#8a6a40');return true;}\\\\n    case'dagger':{thick(c,x-3*dx,y-3*dy,x+1*dx,y+1*dy,2,'#3a2414');thick(c,x+1*dx+nx*3,y+1*dy+ny*3,x+1*dx-nx*3,y+1*dy-ny*3,1.4,'#8a8a8a');\\\\n      poly(c,[[x+2*dx+nx*1.4,y+2*dy+ny*1.4],[x+14*dx,y+14*dy],[x+2*dx-nx*1.4,y+2*dy-ny*1.4]],'#e0e6ec');return true;}\\\\n    case'staff':{const wd=ramp('#5a3a1c');thick(c,x-18*dx,y-18*dy,x+30*dx,y+30*dy,2.4,wd.b);thick(c,x-18*dx-.5,y-18*dy-.5,x+30*dx-.5,y+30*dy-.5,.8,wd.l);\\\\n      const ox=x+33*dx,oy=y+33*dy,col=p&&p.trim||'#ffd45c';disc(c,ox,oy,5,mix(col,'#000',.3));disc(c,ox-1,oy-1,4,col);disc(c,ox-2,oy-2,1.5,'#fff');return true;}\\\\n    case'flask':{disc(c,x+3*dx,y+3*dy,4.5,'rgba(200,230,255,.55)');disc(c,x+3*dx,y+4*dy+1,3.5,'#4ac24a');px(c,x+3*dx-1.5,y+3*dy-8,3,4,'#c8c8d0');px(c,x+3*dx-2,y+3*dy-3,1.5,1.5,'#fff');return true;}\\\\n    case'horn':{const go=ramp('#d8a93a');c.strokeStyle=go.b;c.lineWidth=2.5;c.beginPath();c.moveTo(x,y);c.quadraticCurveTo(x+10*dx+nx*6,y+10*dy+ny*6,x+18*dx,y+18*dy);c.stroke();\\\\n      disc(c,x+18*dx,y+18*dy,4,go.d);disc(c,x+18*dx,y+18*dy,2.6,'#3a2414');thick(c,x+4*dx,y+4*dy,x+12*dx,y+12*dy,.8,go.h);\\\\n      px(c,x+8*dx-3,y+8*dy+2,6,8,'#7a1626');return true;}\\\\n  }\\\\n  return false;\\\\n}\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\n/* =====================================================================\\\\n   KING ARENA · grafica a cartone animato\\\\n   - 100 skin di guardie (10 elmi × 10 colori), le prime 3 libere\\\\n   - 200 nemici: 25 specie × 8 varianti (le specie di KING TOWER + 11 mostri nuovi)\\\\n   - 100 boss \\\\\\\"ricchi\\\\\\\" (mercanti, banchieri, diavoli…): 20 tipi × 5 ranghi\\\\n   Tutto disegnato dal codice; i disegni si salvano in una cache.\\\\n   ===================================================================== */\\\\nconst OUT='#1b120c';\\\\nconst TC=new Map();\\\\nfunction tSpr(key,w,h,fn){let s=TC.get(key);if(s)return s;const q=3,c=document.createElement('canvas');c.width=w*q;c.height=h*q;\\\\n  const g=c.getContext('2d');g.scale(q,q);g.lineJoin='round';g.lineCap='round';g.strokeStyle=OUT;g.lineWidth=1.3;fn(g);\\\\n  s={c,w,h};if(TC.size>2600)TC.delete(TC.keys().next().value);TC.set(key,s);return s;}\\\\nfunction tDraw(g,s,x,y,ax,ay,sc,face,rot){g.save();g.translate(x,y);if(rot)g.rotate(rot);g.scale(face<0?-sc:sc,sc);g.drawImage(s.c,-ax,-ay,s.w,s.h);g.restore();}\\\\n/* forme */\\\\nfunction tC(g,x,y,r,f,st){g.beginPath();g.arc(x,y,r,0,6.283);if(f){g.fillStyle=f;g.fill();}if(st!==false)g.stroke();}\\\\nfunction tE(g,x,y,rx,ry,f,st,rot){g.beginPath();g.ellipse(x,y,rx,ry,rot||0,0,6.283);if(f){g.fillStyle=f;g.fill();}if(st!==false)g.stroke();}\\\\nfunction tR(g,x,y,w,h,r,f,st){g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();if(f){g.fillStyle=f;g.fill();}if(st!==false)g.stroke();}\\\\nfunction tP(g,pts,f,st){g.beginPath();g.moveTo(pts[0][0],pts[0][1]);for(let i=1;i<pts.length;i++)g.lineTo(pts[i][0],pts[i][1]);g.closePath();if(f){g.fillStyle=f;g.fill();}if(st!==false)g.stroke();}\\\\nfunction tL(g,x0,y0,x1,y1,c,w){g.save();g.strokeStyle=c||OUT;g.lineWidth=w||1.3;g.beginPath();g.moveTo(x0,y0);g.lineTo(x1,y1);g.stroke();g.restore();}\\\\nfunction shade(c,k){return mix(c,k<0?'#000':'#fff',Math.abs(k));}\\\\nfunction tEyes(g,x,y,sp,r,look,blink,col){for(const dx of[-sp,sp]){if(blink){tL(g,x+dx-r,y,x+dx+r,y,OUT,1.3);continue;}\\\\n  tE(g,x+dx,y,r,r*1.15,'#fff');tC(g,x+dx+look*r*.35,y+r*.15,r*.55,col||'#1b120c',false);tC(g,x+dx+look*r*.35-r*.2,y-r*.15,r*.2,'#fff',false);}}\\\\nfunction tShadow(g,x,y,r){g.fillStyle='rgba(0,0,0,.28)';g.beginPath();g.ellipse(x,y,r,r*.38,0,0,6.283);g.fill();}\\\\nfunction tCoin(g,x,y,r){tC(g,x,y,r,'#e8b22a');g.save();g.lineWidth=.7;tC(g,x,y,r*.6,'#ffd860');g.restore();}\\\\n\\\\n/* ===================== 100 SKIN DI GUARDIE ===================== */\\\\nconst HELMS=[{n:'Elmo a cappello',k:'kettle'},{n:'Morione',k:'morion'},{n:'Pennacchio',k:'plume'},{n:'Grande elmo',k:'great'},{n:'Cotta e cappuccio',k:'coif'},\\\\n  {n:'Basco della ronda',k:'beret'},{n:'Elmo alato',k:'wing'},{n:'Barbuta',k:'barbuta'},{n:'Tricorno del capitano',k:'tricorn'},{n:'Corona di latta',k:'tin'}];\\\\nconst SCHEMES=[{n:'Rosso Reale',m:'#b8283a',d:'#7a1626',t:'#e8c050',h:'#a8b0bc'},{n:'Blu Ronda',m:'#2f5fa8',d:'#1c3a6a',t:'#e0e6ec',h:'#9aa4ae'},\\\\n  {n:'Verde Bosco',m:'#3a8a3a',d:'#24561f',t:'#e8d090',h:'#8a9a7a'},{n:'Nero Notte',m:'#2e2c38',d:'#16141c',t:'#c0392b',h:'#5a5f6a'},\\\\n  {n:'Porpora',m:'#7a3aa8',d:'#4a1f6a',t:'#ffd45c',h:'#b0a0c0'},{n:'Oro Corona',m:'#e0a82a',d:'#a8761a',t:'#fff1b0',h:'#ffd45c'},\\\\n  {n:'Ghiaccio',m:'#7ac8e8',d:'#3a88b0',t:'#ffffff',h:'#d8f0ff'},{n:'Ruggine',m:'#b8622a',d:'#7a3a14',t:'#3a2a1a',h:'#9a6a4a'},\\\\n  {n:'Smeraldo',m:'#1fb87a',d:'#0f7a4a',t:'#d8ffe8',h:'#a8d8c0'},{n:'Arcobaleno',m:'#e8486a',d:'#2f8ae0',t:'#ffe04a',h:'#c8a8ff'}];\\\\nconst TONES=['#f2c9a0','#e8b48a','#c88a5e','#9a603a','#ffd8b8','#d89a70'];\\\\nconst SKINS=[];\\\\nfor(let i=0;i<100;i++){const H=HELMS[i%10],S=SCHEMES[Math.floor(i/10)],r=rng(i*131+7);\\\\n  SKINS.push({i,n:H.n+' '+S.n,helm:H.k,m:S.m,d:S.d,t:S.t,h:S.h,tone:TONES[Math.floor(r()*6)],\\\\n    must:r()<.35,beard:r()<.18,cape:r()<.55,freck:r()<.25,eye:['#1b120c','#3a6ab0','#3a8a3a','#7a4a1a'][Math.floor(r()*4)],\\\\n    cost:i<3?0:Math.round(60+i*i*1.4+i*25)});}\\\\nconst skinOk=i=>i<3||!!(AS.skins&&AS.skins[i]);\\\\nfunction toonGuardDraw(g,s,pose,f){\\\\n  const ph=f/8*6.283,run=pose==='run',bob=run?Math.abs(Math.sin(ph))*-1.6:Math.sin(ph)*.5,hurt=pose==='hurt',win=pose==='win';\\\\n  const cx=24,base=52;\\\\n  // mantello\\\\n  if(s.cape){tP(g,[[cx-8,30+bob],[cx+8,30+bob],[cx+11+(run?-3:0),48],[cx-11-(run?3:0),48]],s.d);}\\\\n  // gambe e stivali\\\\n  const lg=run?Math.sin(ph)*4:0;\\\\n  tR(g,cx-7+lg,43,6,8,2,'#3a2a20');tR(g,cx+1-lg,43,6,8,2,'#3a2a20');\\\\n  tE(g,cx-4+lg,base-1,4.2,2.4,'#2a1a12');tE(g,cx+4-lg,base-1,4.2,2.4,'#2a1a12');\\\\n  // corpo (tunica con lo stemma)\\\\n  g.save();g.translate(0,bob);\\\\n  tR(g,cx-9,29,18,16,6,s.m);\\\\n  g.save();g.beginPath();g.rect(cx-9,29,18,16);g.clip();g.fillStyle=shade(s.m,-.18);g.fillRect(cx+3,29,7,16);g.restore();\\\\n  tR(g,cx-9,39,18,3,1.5,'#4a3020');tR(g,cx-1.6,38.6,3.2,3.8,1,s.t);\\\\n  // stemma: piccola corona\\\\n  tP(g,[[cx-3.5,36],[cx-3.5,32.5],[cx-1.8,34],[cx,32],[cx+1.8,34],[cx+3.5,32.5],[cx+3.5,36]],s.t);\\\\n  // braccia e mani\\\\n  const ar=win?-8:run?Math.sin(ph+3.14)*3:0;\\\\n  tE(g,cx-11,33+ar*.3,3,5,s.m,true,.3);tE(g,cx+11,33-ar*.3,3,5,s.m,true,-.3);\\\\n  tC(g,cx-12,37+(win?-12:ar*.4),2.6,s.tone);tC(g,cx+12,37+(win?-12:-ar*.4),2.6,s.tone);\\\\n  // testa\\\\n  const hy=19;tC(g,cx,hy,11,s.tone);\\\\n  g.fillStyle='rgba(255,120,120,.35)';g.beginPath();g.arc(cx-6.5,hy+4,2.2,0,6.283);g.arc(cx+6.5,hy+4,2.2,0,6.283);g.fill();\\\\n  if(s.freck){g.fillStyle='rgba(120,60,30,.5)';for(const[a,b]of[[-6,2],[-5,3.5],[-7,3.5],[6,2],[5,3.5],[7,3.5]])g.fillRect(cx+a,hy+b,.8,.8);}\\\\n  const blink=!hurt&&f===5&&pose==='idle';\\\\n  if(hurt){tL(g,cx-6,hy-1,cx-2,hy+2);tL(g,cx-2,hy-1,cx-6,hy+2);tL(g,cx+2,hy-1,cx+6,hy+2);tL(g,cx+6,hy-1,cx+2,hy+2);}\\\\n  else if(s.helm!=='great')tEyes(g,cx+1.5,hy+1,4,2.6,1,blink,s.eye);\\\\n  if(s.must){g.fillStyle=s.tone==='#ffd8b8'?'#c9a060':'#4a2a1a';g.beginPath();g.ellipse(cx-2.5,hy+6,3,1.4,.3,0,6.283);g.ellipse(cx+3.5,hy+6,3,1.4,-.3,0,6.283);g.fill();}\\\\n  else if(s.helm!=='great'){g.beginPath();g.arc(cx+1.5,hy+5.5,hurt?1.8:2.4,hurt?3.6:.3,hurt?5.8:2.8);g.stroke();}\\\\n  if(s.beard){g.fillStyle='#5a3a20';g.beginPath();g.ellipse(cx+1,hy+8.5,5,3,0,0,3.14);g.fill();g.stroke();}\\\\n  helmDraw(g,s,cx,hy);\\\\n  g.restore();\\\\n}\\\\nfunction helmDraw(g,s,cx,hy){const H=s.h,T=s.t;\\\\n  switch(s.helm){\\\\n    case'kettle':tE(g,cx,hy-5,15,3.5,H);g.beginPath();g.arc(cx,hy-6,10,3.14,6.283);g.closePath();g.fillStyle=H;g.fill();g.stroke();tR(g,cx-10,hy-8,20,2.4,1,T);break;\\\\n    case'morion':tP(g,[[cx-15,hy-3],[cx-9,hy-7],[cx+9,hy-7],[cx+15,hy-3],[cx+10,hy-5],[cx-10,hy-5]],H);g.beginPath();g.arc(cx,hy-6,9.5,3.14,6.283);g.closePath();g.fillStyle=H;g.fill();g.stroke();\\\\n      tP(g,[[cx-6,hy-14],[cx,hy-21],[cx+6,hy-14]],shade(H,-.15));break;\\\\n    case'plume':g.beginPath();g.arc(cx,hy-3,11.5,3.14,6.283);g.closePath();g.fillStyle=H;g.fill();g.stroke();tR(g,cx-12,hy-4,24,3,1.5,T);\\\\n      g.fillStyle=s.m;g.beginPath();g.moveTo(cx,hy-13);g.quadraticCurveTo(cx-14,hy-26,cx-10,hy-12);g.quadraticCurveTo(cx-4,hy-20,cx,hy-13);g.fill();g.stroke();break;\\\\n    case'great':tR(g,cx-11.5,hy-12,23,24,7,H);tR(g,cx-8,hy-1,16,3,1.5,'#1b120c',false);g.fillStyle='#ffe28a';g.fillRect(cx-6,hy-.3,4,1.6);g.fillRect(cx+2,hy-.3,4,1.6);\\\\n      for(let i=0;i<3;i++){g.fillStyle='#1b120c';g.fillRect(cx-4+i*3,hy+5,1.2,3);}tR(g,cx-1,hy-12,2,10,1,T);break;\\\\n    case'coif':g.beginPath();g.arc(cx,hy,13,3.4,6.02);g.lineTo(cx+12,hy+9);g.lineTo(cx+9,hy+9);g.arc(cx,hy,9.5,0.4,-3.54,true);g.lineTo(cx-12,hy+9);g.closePath();g.fillStyle=H;g.fill();g.stroke();\\\\n      g.fillStyle='rgba(0,0,0,.2)';for(let i=0;i<5;i++)for(let j=0;j<3;j++)g.fillRect(cx-8+i*4,hy-11+j*3,1,1);break;\\\\n    case'beret':tE(g,cx-2,hy-8,12,5,s.m,true,-.15);tC(g,cx-2,hy-12,1.6,T);g.fillStyle=T;g.beginPath();g.moveTo(cx+6,hy-10);g.quadraticCurveTo(cx+16,hy-20,cx+13,hy-8);g.closePath();g.fill();g.stroke();break;\\\\n    case'wing':g.beginPath();g.arc(cx,hy-3,11.5,3.14,6.283);g.closePath();g.fillStyle=H;g.fill();g.stroke();\\\\n      for(const k of[-1,1]){g.fillStyle='#fff';g.beginPath();g.moveTo(cx+k*10,hy-6);g.quadraticCurveTo(cx+k*20,hy-16,cx+k*17,hy-3);g.quadraticCurveTo(cx+k*14,hy-6,cx+k*10,hy-3);g.fill();g.stroke();}\\\\n      tR(g,cx-12,hy-4,24,2.6,1.3,T);break;\\\\n    case'barbuta':g.beginPath();g.arc(cx,hy-1,12.5,3.14,6.283);g.lineTo(cx+12.5,hy+8);g.lineTo(cx+4,hy+8);g.lineTo(cx+4,hy+1);g.lineTo(cx-4,hy+1);g.lineTo(cx-4,hy+8);g.lineTo(cx-12.5,hy+8);g.closePath();g.fillStyle=H;g.fill();g.stroke();\\\\n      tR(g,cx-1,hy-14,2,8,1,T);break;\\\\n    case'tricorn':tP(g,[[cx-15,hy-5],[cx,hy-10],[cx+15,hy-5],[cx+9,hy-16],[cx,hy-13],[cx-9,hy-16]],s.d);tL(g,cx-14,hy-5.5,cx+14,hy-5.5,T,1.6);tC(g,cx+7,hy-9,2,T);break;\\\\n    case'tin':tP(g,[[cx-10,hy-6],[cx-10,hy-15],[cx-5,hy-10],[cx,hy-17],[cx+5,hy-10],[cx+10,hy-15],[cx+10,hy-6]],H);tC(g,cx,hy-9,1.6,s.m);tC(g,cx-6,hy-8,1.2,s.m);tC(g,cx+6,hy-8,1.2,s.m);break;\\\\n  }}\\\\nfunction guardSprite(i,pose,f){const s=SKINS[i]||SKINS[0];return tSpr('gd|'+i+'|'+pose+'|'+f,48,58,g=>toonGuardDraw(g,s,pose,f));}\\\\n/* il protagonista è la guardia di KING TOWER: le 100 skin sono tavolozze per drawHuman */\\\\nconst HELM_HEAD={kettle:['helm',0],morion:['helm',1],plume:['helm',1],great:['helm',0,1],coif:['hood',0],beret:['hat',1],wing:['helm',1],barbuta:['helm',0,1],tricorn:['hat',0],tin:['crown',0]};\\\\nconst GPAL=new Map();\\\\nfunction guardPal(i){if(GPAL.has(i))return GPAL.get(i);const s=SKINS[i]||SKINS[0],h=HELM_HEAD[s.helm]||['helm',0];\\\\n  const p=P2({main:s.m,dark:s.d,trim:s.t,cape:s.d,head:h[0],armor:h[0]==='helm',visor:!!h[2],plume:h[1]?s.t:s.m,hasCape:s.cape,beard:s.beard,hair:s.must?'#4a2a1a':'#2a1a12',skin:s.tone,kind:h[0]==='helm'?undefined:'cloth'});\\\\n  GPAL.set(i,p);return p;}\\\\nfunction drawToonGuard(g,x,y,o){const pose=o.pose==='win'?'attack':o.pose||'idle';\\\\n  drawHuman(g,x,y,{face:o.face||1,t:o.t||0,pose,pr:o.pose==='win'?.5:0,pal:guardPal(o.skin|0),weapon:o.weapon||'none',scale:.82*(o.scale||1),shadow:o.shadow!==false});}\\\\n\\\\n/* ===================== 200 NEMICI ===================== */\\\\n/* 25 specie: 14 di KING TOWER (disegnate con la sua grafica) e 11 mostri nuovi a cartone */\\\\nconst SPECIES=[\\\\n {id:'guard',n:'Guardia',g:'f',kt:'guard'},{id:'rat',n:'Ratto delle segrete',g:'m',kt:'rat'},{id:'skel',n:'Scheletro',g:'m',toon:'skel',hp:.8,spd:62,dmg:1,range:20,windup:.4},\\\\n {id:'slime',n:'Melma',g:'f',toon:'slime',hp:1.1,spd:40,dmg:.9,range:16,windup:.5,split:1},{id:'sword',n:'Spadaccino',g:'m',kt:'sword'},\\\\n {id:'ghost',n:'Fantasma del prigioniero',g:'m',toon:'ghost',hp:.7,spd:56,dmg:.9,range:18,windup:.35,ghost:1},\\\\n {id:'dog',n:'Cane da guardia',g:'m',kt:'dog'},{id:'spider',n:'Ragno delle cantine',g:'m',toon:'spider',hp:.55,spd:120,dmg:.6,range:15,windup:.2},\\\\n {id:'shield',n:'Scudiero',g:'m',kt:'shield'},{id:'archer',n:'Arciere',g:'m',kt:'archer'},{id:'bat',n:'Pipistrello',g:'m',kt:'bat'},\\\\n {id:'imp',n:'Folletto',g:'m',toon:'imp',hp:.6,spd:80,dmg:.8,range:4.5*B,windup:.6,ranged:'orb',teleport:1},\\\\n {id:'book',n:'Libro volante',g:'m',toon:'book',hp:.7,spd:48,dmg:.9,range:5*B,windup:.7,ranged:'page',fly:1},\\\\n {id:'xbow',n:'Balestriere',g:'m',kt:'xbow'},{id:'jailer',n:'Carceriere',g:'m',kt:'jailer'},\\\\n {id:'candle',n:'Spirito della candela',g:'m',toon:'candle',hp:.8,spd:58,dmg:1.1,range:18,windup:.4,trail:'fire'},\\\\n {id:'mimic',n:'Forziere mordace',g:'m',toon:'mimic',hp:1.6,spd:70,dmg:1.6,range:20,windup:.35,charge:1,rich:1},\\\\n {id:'halberd',n:'Alabardiere',g:'m',kt:'halberd'},{id:'assassin',n:'Assassino',g:'m',kt:'assassin'},\\\\n {id:'gargoyle',n:'Gargoyle',g:'m',toon:'gargoyle',hp:1.3,spd:72,dmg:1.3,range:20,windup:.5,fly:1,charge:1},\\\\n {id:'portrait',n:'Quadro maledetto',g:'m',toon:'portrait',hp:1.2,spd:30,dmg:1,range:6*B,windup:.8,ranged:'eye',fan:3},\\\\n {id:'alchemist',n:'Alchimista',g:'m',kt:'alchemist'},{id:'golem',n:'Golem di pietra',g:'m',toon:'golem',hp:3,spd:32,dmg:2.2,range:24,windup:.8,slam:1,heavy:1},\\\\n {id:'execu',n:'Boia',g:'m',kt:'execu'},{id:'knight',n:'Cavaliere pesante',g:'m',kt:'knight'}];\\\\nconst VARIANTS=[\\\\n {n:['',''],tint:null},\\\\n {n:['corazzato','corazzata'],tint:'#8a96a4',hp:1.8,spd:.85,armor:1},\\\\n {n:['rapido','rapida'],tint:'#e8d84a',spd:1.45,hp:.8},\\\\n {n:['velenoso','velenosa'],tint:'#5ad04a',poison:1},\\\\n {n:['gigante','gigante'],tint:null,scale:1.35,hp:2.6,dmg:1.4,spd:.85},\\\\n {n:['infuocato','infuocata'],tint:'#ff6a1a',fire:1,dmg:1.25},\\\\n {n:['ghiacciato','ghiacciata'],tint:'#7ad0ff',ice:1,hp:1.3},\\\\n {n:['d\\\\\\\\'oro','d\\\\\\\\'oro'],tint:'#ffcc33',gold:1,hp:2,coins:4}];\\\\nconst ENEMIES=[];\\\\nfor(let v=0;v<8;v++)for(let s=0;s<25;s++){const S=SPECIES[s],V=VARIANTS[v],i=v*25+s;\\\\n  ENEMIES.push({i,s,v,n:v?S.n+' '+V.n[S.g==='f'?1:0]:S.n,lv:v===0?1+Math.floor(s*.25):Math.round(10+((v-1)*25+s)*5.5),sp:S,va:V});}\\\\n/* specie in ordine di comparsa: le prime 25 nei primi livelli */\\\\nfunction enemyPool(n){const out=[];for(const e of ENEMIES)if(e.lv<=n)out.push(e);if(!out.length)out.push(ENEMIES[0]);return out;}\\\\n/* tipo di KING TOWER con i suoi valori (per le specie kt) */\\\\nfunction enemyTp(E){const S=E.sp;if(S.kt){const b=S.kt==='guard'?XTP.guard:S.kt==='dog'?XTP.dog:ET[S.kt];return Object.assign({},b,{name:E.n});}\\\\n  return Object.assign({},S,{name:E.n,body:'toon'});}\\\\n/* colori della variante su una tavolozza di KING TOWER */\\\\nfunction tintPal(p,c){if(!c||!p)return p;const o=Object.assign({},p);for(const k of['main','dark','cape','trim'])if(o[k])o[k]=mix(o[k],c,k==='trim'?.25:.55);return o;}\\\\n/* --- disegno dei mostri nuovi --- */\\\\n/* --- i mostri nuovi disegnati come i nemici di KING TOWER: toni di luce e ombra (ramp) e contorno scuro --- */\\\\nfunction eye2(c,x,y,r,col){disc(c,x,y,r,'#f4ecd8');disc(c,x+r*.25,y+r*.1,r*.55,col||'#1a1210');px(c,x-r*.3,y-r*.4,Math.max(1,r*.35),Math.max(1,r*.35),'#fff');}\\\\nfunction monDraw(c,kind,col,f,atk){const ph=f/8*6.283,b=Math.sin(ph),R=ramp(col),bone=ramp('#e8dcc0'),wood=ramp('#8a5a2a'),gold=ramp('#d8a93a'),stone=ramp('#8a8478');\\\\n  switch(kind){\\\\n    case'skel':{const lg=Math.sin(ph)*3;\\\\n      limb(c,21,38,20+lg,50,3,bone);limb(c,27,38,28-lg,50,3,bone);ell(c,20+lg,51,3,1.5,bone.d);ell(c,28-lg,51,3,1.5,bone.d);\\\\n      ell(c,24,38,6,2.5,bone.d);thick(c,24,24,24,38,2.5,bone.d);\\\\n      for(let i=0;i<4;i++){thick(c,18,25+i*3.2,30,25+i*3.2,1.8,i%2?bone.b:bone.l);}\\\\n      const ay=atk?-10:0;limb(c,18,25,13,33+ay,2.6,bone);limb(c,30,25,35,33,2.6,bone);\\\\n      thick(c,13,33+ay,10,10+ay,2,wood.d);poly(c,[[8,12+ay],[10,1+ay],[12,12+ay]],'#c8ccd2');poly(c,[[9,11+ay],[10,4+ay],[10.6,11+ay]],'#f0f4f8');thick(c,6,13+ay,14,13+ay,2,R.d);\\\\n      disc(c,24,15,8.5,bone.d);disc(c,23.4,14.4,7.8,bone.b);ell(c,21.5,11.5,4,2.6,bone.l);ell(c,24,21,5,2.5,bone.b);\\\\n      disc(c,20.5,15.5,2.6,'#1a1210');disc(c,27.5,15.5,2.6,'#1a1210');disc(c,20.8,15.7,1.1,R.l);disc(c,27.8,15.7,1.1,R.l);poly(c,[[24,17.5],[22.8,19.5],[25.2,19.5]],'#1a1210');\\\\n      for(let i=0;i<4;i++)px(c,20.3+i*2.3,21.5,1.4,2.2,'#1a1210');break;}\\\\n    case'slime':{const sq=1+b*.08,w=15/sq,h=21*sq;\\\\n      ell(c,24,49,w,4,R.dd);c.beginPath();c.moveTo(24-w,50);c.quadraticCurveTo(24-w-1,50-h,24,50-h);c.quadraticCurveTo(24+w+1,50-h,24+w,50);c.closePath();c.fillStyle=R.d;c.fill();\\\\n      c.beginPath();c.moveTo(24-w+3,48);c.quadraticCurveTo(24-w+2,51-h,24-2,51-h);c.quadraticCurveTo(24+w-4,51-h,24+w-4,46);c.closePath();c.fillStyle=R.b;c.fill();\\\\n      ell(c,24-w*.45,48-h*.7,3,5,R.l);ell(c,24-w*.5,48-h*.78,1.4,2.4,R.h);for(let i=0;i<3;i++)disc(c,20+i*5,44-((f*2+i*5)%10),1.2,R.l);\\\\n      eye2(c,20,40-b,2.6);eye2(c,28,40-b,2.6);thick(c,21,45-b,27,45-b,1.4,R.dd);break;}\\\\n    case'ghost':{const y=26+b*2,G=ramp('#dfe8ff');\\\\n      c.beginPath();c.moveTo(11,y+18);c.lineTo(11,y);c.arc(24,y,13,Math.PI,0);c.lineTo(37,y+18);for(let i=0;i<5;i++)c.quadraticCurveTo(34.4-i*5.2,y+(i%2?13:22),31.8-i*5.2,y+18);c.closePath();\\\\n      c.save();c.globalAlpha=.92;c.fillStyle=G.d;c.fill();c.restore();ell(c,22,y-2,10,11,G.b);ell(c,19,y-6,4,5,G.l);ell(c,18,y-8,1.6,2.4,G.h);\\\\n      ell(c,19.5,y,2.6,4,'#1a1430');ell(c,28.5,y,2.6,4,'#1a1430');disc(c,19.5,y+1,1,R.l);disc(c,28.5,y+1,1,R.l);ell(c,24,y+8,2.4,3.2,'#1a1430');\\\\n      for(let i=0;i<4;i++)ell(c,9-i*1.5,y+10+i*3,1.6,1.1,'#7a7f88');disc(c,4,y+23,3,ramp('#5a5f66').b);break;}\\\\n    case'spider':{for(let i=0;i<4;i++)for(const k of[-1,1]){const a=Math.sin(ph+i*1.6+(k>0?1:0))*3,kx=24+k*(13+i*2),ky=30+i*4+a;limb(c,24+k*4,40,kx,ky,2,R);limb(c,kx,ky,24+k*(17+i*2.4),46+i*1.5,1.8,R);}\\\\n      ell(c,24,41,11,8,R.d);ell(c,23,39,9,6,R.b);ell(c,21,37,4,2.4,R.l);poly(c,[[24,36],[27,40],[24,44],[21,40]],'#c0392b');\\\\n      disc(c,24,30,7,R.d);disc(c,23.5,29.5,6,R.b);disc(c,22,28,2,R.l);for(const[x,y,r]of[[21,29,1.6],[27,29,1.6],[22.5,26.5,1],[25.5,26.5,1]]){disc(c,x,y,r,'#ff3a2a');px(c,x-.4,y-.6,.8,.8,'#fff');}\\\\n      thick(c,22,34,21,37,1.2,'#f0e8d8');thick(c,26,34,27,37,1.2,'#f0e8d8');break;}\\\\n    case'imp':{const y=b*2,S=ramp(col);for(const k of[-1,1]){c.fillStyle=S.dd;c.beginPath();c.moveTo(24+k*6,28+y);c.quadraticCurveTo(24+k*22,14+y+b*4,24+k*19,34+y);c.quadraticCurveTo(24+k*13,30+y,24+k*6,32+y);c.fill();thick(c,24+k*6,28+y,24+k*19,16+y+b*4,1.2,S.d);}\\\\n      limb(c,20,40+y,18,50,3,S);limb(c,28,40+y,30,50,3,S);ell(c,24,35+y,8,8,S.d);ell(c,23,34+y,7,7,S.b);ell(c,21,31+y,3,2.6,S.l);\\\\n      thick(c,30,40+y,38,42+y,1.4,S.d);thick(c,38,42+y,40,32+y,1.4,S.d);poly(c,[[39,31+y],[42,27+y],[42.5,33+y]],S.dd);\\\\n      thick(c,15,30+y,13,20+y,1.6,'#5a3a22');poly(c,[[11,20+y],[13,14+y],[15,20+y]],'#c8ccd2');\\\\n      disc(c,24,20+y,9.5,S.d);disc(c,23.5,19.5,8.6,S.b);ell(c,21,16+y,3.4,2.4,S.l);poly(c,[[16,15+y],[13,4+y],[19.5,12+y]],'#f0e8d0');poly(c,[[31,15+y],[34,4+y],[28.5,12+y]],'#f0e8d0');\\\\n      eye2(c,20.5,20+y,2.4,'#c08a00');eye2(c,27.5,20+y,2.4,'#c08a00');for(let i=0;i<4;i++)poly(c,[[20+i*2,25+y],[21+i*2,27+y],[22+i*2,25+y]],'#fff');thick(c,19.5,25+y,28.5,25+y,1,S.dd);break;}\\\\n    case'book':{const y=24+b*3,o=Math.abs(Math.sin(ph*2))*.5,C=ramp(col);\\\\n      for(const k of[-1,1]){c.fillStyle=k<0?C.b:C.d;c.beginPath();c.moveTo(24,y);c.lineTo(24+k*17,y-6-o*8);c.lineTo(24+k*17,y+11-o*6);c.lineTo(24,y+15);c.closePath();c.fill();}\\\\n      thick(c,24+(-17),y-6-o*8,24-17,y+11-o*6,1.5,gold.b);c.fillStyle='#f4ecd8';c.beginPath();c.moveTo(24,y+1);c.lineTo(38,y-3.5-o*8);c.lineTo(38,y+9.5-o*6);c.lineTo(24,y+13);c.fill();\\\\n      for(let i=0;i<4;i++)thick(c,27,y+2+i*2.6,35,y-1.2+i*2.6-o*7,.7,'#9a8a6a');thick(c,24,y,24,y+15,1.6,C.dd);\\\\n      eye2(c,16,y+3,2.8,'#7a1626');poly(c,[[12,y+10],[15,y+7.5],[18,y+10],[16,y+12]],'#c0392b');for(let i=0;i<3;i++)poly(c,[[12.5+i*2,y+8.6],[13.5+i*2,y+10.4],[14.5+i*2,y+8.6]],'#fff');break;}\\\\n    case'candle':{const W=ramp('#efe4c8');ell(c,24,50,9,2.4,W.d);c.fillStyle=W.d;c.fillRect(15,30,18,20);c.fillStyle=W.b;c.fillRect(17,30,14,20);c.fillStyle=W.l;c.fillRect(18,31,3,18);\\\\n      ell(c,24,30,9,2.6,W.l);for(const x of[17,22,30])ell(c,x,33+(x%5),1.4,3.2,W.b);\\\\n      const fl=1+Math.sin(ph*2)*.15;c.save();c.translate(24,24);c.scale(1,fl);c.beginPath();c.moveTo(0,-15);c.quadraticCurveTo(11,-2,0,5);c.quadraticCurveTo(-11,-2,0,-15);c.fillStyle=R.d;c.fill();\\\\n      c.beginPath();c.moveTo(0,-11);c.quadraticCurveTo(7,-1,0,4);c.quadraticCurveTo(-7,-1,0,-11);c.fillStyle=R.b;c.fill();c.beginPath();c.moveTo(0,-6);c.quadraticCurveTo(4,0,0,3);c.quadraticCurveTo(-4,0,0,-6);c.fillStyle='#fff6c0';c.fill();c.restore();\\\\n      eye2(c,20.5,39,2.2);eye2(c,27.5,39,2.2);thick(c,21,44,27,44,1.2,'#5a3a20');break;}\\\\n    case'mimic':{const o=atk?7:Math.max(0,b)*3;ell(c,24,50,15,3,'rgba(0,0,0,.3)');\\\\n      c.fillStyle=wood.d;c.fillRect(9,32,30,18);c.fillStyle=wood.b;c.fillRect(10,33,28,15);for(let i=0;i<3;i++){c.fillStyle=wood.l;c.fillRect(10,35+i*5,28,1);}\\\\n      c.fillStyle=gold.d;c.fillRect(9,32,30,3);c.fillRect(13,32,3,18);c.fillRect(32,32,3,18);c.fillStyle=gold.l;c.fillRect(9,32,30,1);\\\\n      c.save();c.translate(9,32);c.rotate(-o*.07);c.fillStyle=wood.d;c.fillRect(0,-11,30,11);c.fillStyle=wood.b;c.fillRect(1,-10,28,8);c.fillStyle=wood.l;c.fillRect(1,-10,28,2);c.fillStyle=gold.b;c.fillRect(0,-3,30,3);c.fillRect(4,-11,3,11);c.fillRect(23,-11,3,11);c.restore();\\\\n      c.fillStyle='#5a0c16';c.fillRect(11,32-o,26,o+1);for(let i=0;i<7;i++){poly(c,[[11+i*3.7,32],[12.8+i*3.7,35.5],[14.6+i*3.7,32]],'#f4ecd8');poly(c,[[11+i*3.7,32-o],[12.8+i*3.7,28.5-o],[14.6+i*3.7,32-o]],'#f4ecd8');}\\\\n      if(o>3)ell(c,26,33,5,2,'#e8486a');disc(c,24,41,3,gold.b);disc(c,24,41,1.4,gold.dd);eye2(c,19,27-o*.6,2.4,'#c0392b');eye2(c,30,27-o*.6,2.4,'#c0392b');break;}\\\\n    case'gargoyle':{const y=b*3,S=ramp(col);for(const k of[-1,1]){c.fillStyle=S.dd;c.beginPath();c.moveTo(24+k*6,28+y);c.lineTo(24+k*23,14+y+b*6);c.lineTo(24+k*20,24+y);c.lineTo(24+k*22,32+y);c.lineTo(24+k*16,30+y);c.lineTo(24+k*17,38+y);c.closePath();c.fill();thick(c,24+k*6,28+y,24+k*23,14+y+b*6,1.6,S.d);}\\\\n      limb(c,19,40+y,18,48+y,3.4,S);limb(c,29,40+y,30,48+y,3.4,S);ell(c,24,35+y,9,9,S.d);ell(c,23,34+y,8,8,S.b);ell(c,20.5,31+y,3,3,S.l);\\\\n      disc(c,24,21+y,9,S.d);disc(c,23.5,20.5,8.2,S.b);ell(c,21,17+y,3,2.4,S.l);poly(c,[[16,16+y],[12,5+y],[20,13+y]],S.l);poly(c,[[31,16+y],[35,5+y],[28,13+y]],S.l);\\\\n      eye2(c,20.5,20+y,2.2,'#ff4a2a');eye2(c,27.5,20+y,2.2,'#ff4a2a');poly(c,[[19,26+y],[21,29+y],[23,26+y]],'#f4ecd8');poly(c,[[25,26+y],[27,29+y],[29,26+y]],'#f4ecd8');\\\\n      px(c,18,36+y,3,1.4,S.dd);px(c,26,40+y,4,1.4,S.dd);break;}\\\\n    case'portrait':{const y=b*1.5;c.fillStyle=gold.d;c.fillRect(7,9+y,34,40);c.fillStyle=gold.b;c.fillRect(8,10+y,32,38);c.fillStyle=gold.l;c.fillRect(8,10+y,32,2);c.fillRect(8,10+y,2,38);\\\\n      c.fillStyle='#2a1a22';c.fillRect(12,14+y,24,30);c.fillStyle=R.d;c.fillRect(13,34+y,22,10);c.fillStyle=R.b;c.fillRect(15,35+y,18,9);\\\\n      disc(c,24,26+y,7,'#c89a76');disc(c,23.5,25.5+y,6,'#e0b48c');ell(c,24,19.5+y,7,3,'#3a2414');eye2(c,21.5,26+y,1.9,'#c0392b');eye2(c,26.5,26+y,1.9,'#c0392b');thick(c,22,30+y,26,30+y,1,'#7a1626');\\\\n      for(const[x,yy]of[[8,10],[40,10],[8,48],[40,48]])disc(c,x,yy+y,2.2,gold.l);break;}\\\\n    case'golem':{const lg=Math.sin(ph)*2.5,S=stone;limb(c,18+lg,40,18+lg,50,7,S);limb(c,30-lg,40,30-lg,50,7,S);\\\\n      ell(c,24,31,15,13,S.d);ell(c,23,30,14,12,S.b);ell(c,19,25,6,4,S.l);\\\\n      const ay=atk?-8:0;limb(c,10,26,7,38+ay,7,S);limb(c,38,26,41,38,7,S);disc(c,7,40+ay,4.5,S.d);disc(c,41,40,4.5,S.d);\\\\n      c.fillStyle=S.d;c.fillRect(16,8,16,14);c.fillStyle=S.b;c.fillRect(17,9,14,12);c.fillStyle=S.l;c.fillRect(17,9,14,2);\\\\n      disc(c,21,15,1.8,col);disc(c,27,15,1.8,col);px(c,19,30,8,1.6,col);px(c,24,26,1.6,8,col);px(c,13,33,3,2,'#4a7a2a');px(c,30,22,4,2,'#4a7a2a');break;}\\\\n  }}\\\\nfunction monCols(c){return c;}\\\\nconst MON_BASE={skel:'#e04a2a',slime:'#4ac25a',ghost:'#8ab0ff',spider:'#4a3a5a',imp:'#d84a3a',book:'#7a3a2a',candle:'#ff9a2a',mimic:'#c0392b',gargoyle:'#7a7f88',portrait:'#5a2a6a',golem:'#8a8070'};\\\\nfunction monSprite(kind,v,f,atk){const V=VARIANTS[v],c=V.tint&&V.tint!=='#8a96a4'?mix(MON_BASE[kind],V.tint,.6):MON_BASE[kind];\\\\n  return sprGet('mn2|'+kind+'|'+v+'|'+f+'|'+(atk?1:0),48,56,g=>{g.lineJoin='round';g.lineCap='round';monDraw(g,kind,c,f,atk);if(v===1)armorPlates(g);});}\\\\nfunction armorPlates(c){const I=ramp('#9aa4ae');for(const x of[17,31]){poly(c,[[x-5,30],[x,23],[x+5,30],[x,33]],I.b);poly(c,[[x-3,29],[x,25],[x,31]],I.l);}}\\\\n/* segni della variante sopra il mostro (anche sopra i nemici di KING TOWER) */\\\\nfunction varOverlay(g,v,f){const ph=f/8*6.283;\\\\n  if(v===1){g.save();g.fillStyle='#b8c0c8';for(const[x,y]of[[16,30],[32,30]])tP(g,[[x-4,y],[x,y-6],[x+4,y]],'#b8c0c8');g.restore();}\\\\n  if(v===3){for(let i=0;i<3;i++)tC(g,14+i*10,10+((f*3+i*7)%14),1.6+i*.3,'rgba(90,208,74,.8)',false);}\\\\n  if(v===5){for(let i=0;i<3;i++){const x=14+i*10,y=10+Math.sin(ph+i)*2;g.fillStyle='rgba(255,140,30,.85)';g.beginPath();g.moveTo(x,y-6);g.quadraticCurveTo(x+4,y,x,y+3);g.quadraticCurveTo(x-4,y,x,y-6);g.fill();}}\\\\n  if(v===6){g.fillStyle='rgba(220,245,255,.9)';for(const[x,y]of[[12,22],[36,18],[24,8]]){tP(g,[[x,y-4],[x+2,y],[x,y+4],[x-2,y]],'rgba(220,245,255,.9)',false);}}\\\\n  if(v===7){g.fillStyle='rgba(255,255,220,'+(.4+.4*Math.sin(ph))+')';tP(g,[[36,10],[37.5,13],[41,14],[37.5,15],[36,18],[34.5,15],[31,14],[34.5,13]],g.fillStyle,false);}}\\\\nfunction drawToonMon(g,e){const f=Math.floor(e.t*(e.moving?10:5))%8,atk=e.st==='wind'||e.st==='rec';const s=monSprite(e.sp.toon,e.v,f,atk);\\\\n  const fly=e.sp.fly||e.sp.toon==='ghost'||e.sp.toon==='book';g.fillStyle='rgba(0,0,0,.25)';g.beginPath();g.ellipse(e.x,e.y,e.r*1.1,e.r*.42,0,0,6.283);g.fill();\\\\n  sprDraw(g,s,e.x,e.y+1-(fly?6:0),24,52,{face:e.face,scale:.62*e.scale});if(e.v>1){const o=tSpr('vo|'+e.v+'|'+f,48,56,gg=>varOverlay(gg,e.v,f));tDraw(g,o,e.x,e.y-(fly?6:0),24,52,.62*e.scale,1);}}\\\\n\\\\n/* ===================== 100 BOSS RICCHI ===================== */\\\\nconst BOSS_T=[\\\\n {n:'Mercante di Spezie',g:'m',b:'man',hat:'turban',c:'#c0392b',atk:['coinFan','summon','bagBomb']},\\\\n {n:'Banchiere',g:'m',b:'fat',hat:'top',c:'#2e2c38',atk:['coinFan','barThrow','goldRain']},\\\\n {n:'Usuraio',g:'m',b:'thin',hat:'cap',c:'#4a3a2a',atk:['spiral','summon','coinFan']},\\\\n {n:'Esattore delle Tasse',g:'m',b:'man',hat:'tricorn',c:'#1f3a6a',atk:['bagBomb','charge','coinFan']},\\\\n {n:'Gioielliere',g:'f',b:'man',hat:'beret',c:'#7a3aa8',atk:['orbRing','spiral','goldRain'],nf:'Gioielliera'},\\\\n {n:'Re dei Ladri',g:'m',b:'thin',hat:'hood',c:'#2a2a32',atk:['teleport','coinFan','charge']},\\\\n {n:'Pirata del Tesoro',g:'m',b:'fat',hat:'pirate',c:'#7a1626',atk:['barThrow','charge','bagBomb']},\\\\n {n:'Diavolo dell\\\\\\\\'Avarizia',g:'m',b:'devil',hat:'horns',c:'#c0281a',atk:['orbRing','goldRain','teleport']},\\\\n {n:'Demone delle Monete',g:'m',b:'devil',hat:'horns',c:'#6a1a5a',atk:['spiral','coinFan','summon']},\\\\n {n:'Golem d\\\\\\\\'Oro',g:'m',b:'golem',hat:'none',c:'#d8a93a',atk:['slam','barThrow','charge']},\\\\n {n:'Alchimista dell\\\\\\\\'Oro',g:'m',b:'thin',hat:'wizard',c:'#3a5a2a',atk:['bagBomb','orbRing','teleport']},\\\\n {n:'Collezionista',g:'f',b:'man',hat:'feather',c:'#1f6a5a',atk:['summon','spiral','coinFan'],nf:'Collezionista'},\\\\n {n:'Tesoriere della Torre',g:'m',b:'fat',hat:'top',c:'#5a1a1a',atk:['goldRain','slam','coinFan']},\\\\n {n:'Cambiavalute',g:'m',b:'thin',hat:'cap',c:'#6a6a2a',atk:['coinFan','spiral','teleport']},\\\\n {n:'Contrabbandiere',g:'m',b:'man',hat:'pirate',c:'#3a2a1a',atk:['bagBomb','summon','charge']},\\\\n {n:'Oste Arricchito',g:'m',b:'fat',hat:'cap',c:'#8a5a2a',atk:['barThrow','slam','summon']},\\\\n {n:'Diavolo del Patto',g:'m',b:'devil',hat:'horns',c:'#1a1a1a',atk:['teleport','orbRing','spiral']},\\\\n {n:'Drago del Tesoro',g:'m',b:'dragon',hat:'none',c:'#2a8a3a',atk:['goldRain','charge','orbRing']},\\\\n {n:'Signora delle Gemme',g:'f',b:'lady',hat:'tiara',c:'#2a6ab0',atk:['orbRing','spiral','summon']},\\\\n {n:'Mammona',g:'m',b:'devil',hat:'horns',c:'#8a2a00',atk:['goldRain','slam','summon','coinFan']}];\\\\nconst BOSS_R=['','della Zecca','dei Forzieri','del Diamante','dell\\\\\\\\'Oro Nero'];\\\\nconst BOSS_RC=[null,'#b87333','#c0c8d0','#7ad0ff','#1a1214'];\\\\nconst BOSSES=[];for(let i=0;i<100;i++){const T=BOSS_T[i%20],r=Math.floor(i/20);BOSSES.push({i,T,r,n:(T.nf||T.n)+(r?' '+BOSS_R[r]:'')});}\\\\nconst bossOfLevel=n=>BOSSES[(n-1)%100];\\\\nfunction bossDraw(g,B,f,atk){const T=B.T,ph=f/8*6.283,bb=Math.sin(ph)*1.2,C=B.r?mix(T.c,BOSS_RC[B.r],.45):T.c,D=shade(C,-.3),GOLD='#e8b22a';\\\\n  const cx=40,base=92,skin=T.b==='devil'?mix('#d83a2a',C,.35):T.b==='golem'?'#d8a93a':T.b==='dragon'?C:['#f2c9a0','#e8b48a','#c88a5e'][B.i%3];\\\\n  tShadow(g,cx,base,22);\\\\n  if(T.b==='dragon'){const y=bb;tP(g,[[cx-26,base-10],[cx-38,base-30+y],[cx-20,base-22]],D);\\\\n    for(let i=0;i<9;i++)tCoin(g,cx-24+i*6,base-3,3.4);tE(g,cx,base-24+y,22,16,C);tE(g,cx,base-18+y,14,9,'#f0d890');\\\\n    for(const k of[-1,1]){g.fillStyle=D;g.beginPath();g.moveTo(cx+k*10,base-36+y);g.lineTo(cx+k*38,base-58+y+bb*4);g.lineTo(cx+k*30,base-30+y);g.closePath();g.fill();g.stroke();}\\\\n    tE(g,cx+14,base-48+y,14,11,C);tE(g,cx+24,base-44+y,8,6,shade(C,.15));tC(g,cx+28,base-46+y,1.2,OUT,false);\\\\n    tEyes(g,cx+14,base-52+y,4,3,1,false,'#ff4a2a');tP(g,[[cx+6,base-58+y],[cx+3,base-70+y],[cx+11,base-60+y]],GOLD);tP(g,[[cx+18,base-58+y],[cx+22,base-70+y],[cx+24,base-58+y]],GOLD);\\\\n    tC(g,cx,base-30+y,5,GOLD);tC(g,cx,base-30+y,2.5,'#7ad0ff');return;}\\\\n  if(T.b==='golem'){const y=bb;tR(g,cx-16,base-20,12,20,4,D);tR(g,cx+4,base-20,12,20,4,D);tR(g,cx-24,base-58+y,48,42,12,skin);\\\\n    tE(g,cx-30,base-40+(atk?-14:0),9,14,shade(skin,-.15));tE(g,cx+30,base-40,9,14,shade(skin,-.15));tR(g,cx-13,base-76+y,26,20,7,skin);\\\\n    tEyes(g,cx,base-67+y,6,3,1,false,'#c0392b');for(let i=0;i<5;i++)tCoin(g,cx-16+i*8,base-34+y,3.2);g.fillStyle='rgba(255,255,255,.35)';g.fillRect(cx-18,base-54+y,8,3);return;}\\\\n  // umani e diavoli: corpo\\\\n  const fat=T.b==='fat'?1.3:T.b==='thin'?.82:1,lady=T.b==='lady';\\\\n  const lg=Math.sin(ph)*3;tR(g,cx-10+lg,base-20,8,18,3,'#2a1a12');tR(g,cx+2-lg,base-20,8,18,3,'#2a1a12');\\\\n  tE(g,cx-6+lg,base-2,6,3,'#1a120c');tE(g,cx+6-lg,base-2,6,3,'#1a120c');\\\\n  if(T.b==='devil'){g.beginPath();g.moveTo(cx-12,base-26);g.quadraticCurveTo(cx-34,base-20+bb*3,cx-30,base-44);g.stroke();tP(g,[[cx-33,base-46],[cx-27,base-48],[cx-29,base-40]],D);}\\\\n  g.save();g.translate(0,bb);\\\\n  if(lady)tP(g,[[cx-12,base-58],[cx+12,base-58],[cx+22,base-14],[cx-22,base-14]],C);\\\\n  else tE(g,cx,base-40,20*fat,20,C);\\\\n  // vestito con bottoni d'oro e catena di monete\\\\n  g.save();g.beginPath();g.ellipse(cx,base-40,20*fat,20,0,0,6.283);g.clip();g.fillStyle=D;g.fillRect(cx+6*fat,base-62,30,44);g.restore();\\\\n  for(let i=0;i<3;i++)tC(g,cx,base-48+i*7,1.8,GOLD);\\\\n  g.save();g.strokeStyle=GOLD;g.lineWidth=1.6;g.beginPath();g.arc(cx,base-60,12,.3,2.84);g.stroke();g.restore();\\\\n  for(let i=0;i<5;i++){const a=.45+i*.56;tCoin(g,cx+Math.cos(a)*12,base-60+Math.sin(a)*12,2.6);}\\\\n  tC(g,cx,base-46,4.6,GOLD);tC(g,cx,base-46,2.4,'#c0392b');\\\\n  // braccia con bracciali d'oro e anelli\\\\n  const ar=atk?-14:Math.sin(ph+3)*2;\\\\n  for(const k of[-1,1]){const hx=cx+k*(22*fat+3),hy=base-40+(k<0?ar:0);tE(g,cx+k*(18*fat),base-46,6,10,C,true,k*.4);\\\\n    tR(g,hx-5,hy-5,10,4,2,GOLD);tR(g,hx-5,hy-1,10,3,1.5,shade(GOLD,-.2));tC(g,hx,hy+5,4.4,skin);tC(g,hx+k*2,hy+6,1.4,GOLD);}\\\\n  // sacco di monete\\\\n  if(!atk){tE(g,cx+26*fat,base-24,8,9,'#8a6a3a');g.fillStyle=GOLD;g.font='bold 9px Georgia';g.textAlign='center';g.fillText('$',cx+26*fat,base-21);}\\\\n  // testa\\\\n  const hy=base-74;tC(g,cx,hy,15,skin);\\\\n  g.fillStyle='rgba(255,100,100,.3)';g.beginPath();g.arc(cx-9,hy+5,3,0,6.283);g.arc(cx+9,hy+5,3,0,6.283);g.fill();\\\\n  tEyes(g,cx+2,hy,5.5,3.4,1,false,T.b==='devil'?'#ffd45c':'#1b120c');\\\\n  g.beginPath();g.arc(cx+2,hy+7,5,.25,2.9);g.stroke();tC(g,cx+5,hy+8.5,1.2,GOLD);\\\\n  if(T.b!=='devil'&&!lady&&B.i%3!==1){g.fillStyle='#4a2a1a';g.beginPath();g.ellipse(cx-3,hy+5,5,2,.3,0,6.283);g.ellipse(cx+7,hy+5,5,2,-.3,0,6.283);g.fill();}\\\\n  // orecchini d'oro\\\\n  tC(g,cx-14,hy+5,2,GOLD);tC(g,cx+14,hy+5,2,GOLD);\\\\n  bossHat(g,T.hat,cx,hy,C,GOLD,D);\\\\n  g.restore();}\\\\nfunction bossHat(g,h,cx,hy,C,GOLD,D){\\\\n  switch(h){\\\\n    case'turban':tE(g,cx,hy-12,16,9,'#f0e8d0');tC(g,cx,hy-14,4,GOLD);tC(g,cx,hy-14,2,'#c0392b');tP(g,[[cx,hy-17],[cx+4,hy-30],[cx+7,hy-17]],'#fff');break;\\\\n    case'top':tR(g,cx-11,hy-36,22,22,2,'#1a1a1a');tE(g,cx,hy-14,18,3.5,'#1a1a1a');tR(g,cx-11,hy-19,22,4,1,GOLD);break;\\\\n    case'cap':tE(g,cx,hy-11,15,7,D);tC(g,cx,hy-17,2.4,GOLD);break;\\\\n    case'tricorn':tP(g,[[cx-20,hy-9],[cx,hy-15],[cx+20,hy-9],[cx+12,hy-24],[cx,hy-20],[cx-12,hy-24]],D);tL(g,cx-19,hy-10,cx+19,hy-10,GOLD,2);break;\\\\n    case'beret':tE(g,cx-3,hy-12,16,6,C,true,-.15);tC(g,cx+4,hy-15,3,GOLD);tC(g,cx+4,hy-15,1.5,'#7ad0ff');break;\\\\n    case'hood':g.beginPath();g.arc(cx,hy,18,3.3,6.12);g.lineTo(cx+16,hy+10);g.lineTo(cx+13,hy+2);g.arc(cx,hy-1,13,-.2,-2.94,true);g.lineTo(cx-16,hy+10);g.closePath();g.fillStyle=D;g.fill();g.stroke();tC(g,cx,hy-15,2.4,GOLD);break;\\\\n    case'pirate':tP(g,[[cx-20,hy-9],[cx+20,hy-9],[cx+14,hy-24],[cx-14,hy-24]],'#1a1a1a');g.fillStyle='#fff';g.font='bold 9px serif';g.textAlign='center';g.fillText('☠',cx,hy-12);tL(g,cx-19,hy-9.5,cx+19,hy-9.5,GOLD,1.6);break;\\\\n    case'horns':for(const k of[-1,1]){g.beginPath();g.moveTo(cx+k*8,hy-10);g.quadraticCurveTo(cx+k*22,hy-18,cx+k*20,hy-32);g.quadraticCurveTo(cx+k*14,hy-18,cx+k*3,hy-13);g.closePath();g.fillStyle='#f0e8d0';g.fill();g.stroke();}\\\\n      tR(g,cx-9,hy-17,18,5,2,GOLD);for(let i=0;i<3;i++)tC(g,cx-5+i*5,hy-15,1.3,'#c0392b',false);break;\\\\n    case'wizard':tP(g,[[cx-16,hy-10],[cx+16,hy-10],[cx+4,hy-40]],D);for(let i=0;i<3;i++)tCoin(g,cx-6+i*6,hy-14-i*6,2.2);break;\\\\n    case'feather':tE(g,cx,hy-12,16,6,D);g.fillStyle='#e8486a';g.beginPath();g.moveTo(cx+6,hy-14);g.quadraticCurveTo(cx+28,hy-34,cx+18,hy-12);g.closePath();g.fill();g.stroke();break;\\\\n    case'tiara':tP(g,[[cx-12,hy-11],[cx-8,hy-20],[cx-4,hy-14],[cx,hy-24],[cx+4,hy-14],[cx+8,hy-20],[cx+12,hy-11]],GOLD);tC(g,cx,hy-17,2.4,'#7ad0ff');\\\\n      g.fillStyle='#5a2a1a';g.beginPath();g.ellipse(cx-14,hy+6,5,14,0,0,6.283);g.ellipse(cx+14,hy+6,5,14,0,0,6.283);g.fill();g.stroke();break;\\\\n  }}\\\\nfunction bossSprite(i,f,atk){return tSpr('bs|'+i+'|'+f+'|'+(atk?1:0),80,98,g=>bossDraw(g,BOSSES[i],f,atk));}\\\\nfunction drawBossToon(g,e){const f=Math.floor(e.t*(e.moving?9:5))%8,atk=e.st==='wind'||e.st==='rec';\\\\n  tDraw(g,bossSprite(e.bi,f,atk),e.x,e.y+2,40,93,.62*e.scale,e.face);}\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\n/* =====================================================================\\\\n   KING ARENA · audio: 200 brani e 150 suoni, tutti generati con Web Audio\\\\n   (nessun file: ogni brano nasce da un \\\\\\\"seme\\\\\\\" con tempo, tonalità, accordi,\\\\n   melodia, strumenti e batteria diversi).\\\\n   ===================================================================== */\\\\nlet AC=null,MG=null,MUS=null,SFXG=null;\\\\nfunction au(){if(!AC){try{AC=new(window.AudioContext||window.webkitAudioContext)();MG=AC.createGain();MG.connect(AC.destination);\\\\n    MUS=AC.createGain();MUS.connect(MG);SFXG=AC.createGain();SFXG.connect(MG);}catch(e){return null;}}\\\\n  if(AC.state==='suspended')AC.resume();MG.gain.value=AS.vol;MUS.gain.value=AS.mus?AS.musVol:0;SFXG.gain.value=AS.sfxVol;return AC;}\\\\n/* massimo 12 suoni insieme (come in KING TOWER) */\\\\nconst LIVE=[];\\\\nfunction voice(node,end){LIVE.push({node,end});while(LIVE.length>12){const v=LIVE.shift();try{v.node.stop();}catch(e){}}}\\\\nfunction tone(f,d,type,vol,slide,delay,dest){const c=au();if(!c)return;const t=c.currentTime+(delay||0),o=c.createOscillator(),gn=c.createGain();\\\\n  o.type=type||'square';o.frequency.setValueAtTime(f,t);if(slide&&slide!==1)o.frequency.exponentialRampToValueAtTime(Math.max(20,f*slide),t+d);\\\\n  gn.gain.setValueAtTime(0,t);gn.gain.linearRampToValueAtTime(vol||.1,t+.005);gn.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(gn);gn.connect(dest||SFXG);o.start(t);o.stop(t+d+.02);if(!dest)voice(o,t+d);}\\\\nlet NBUF=null;function nbuf(){if(!NBUF){const c=au();NBUF=c.createBuffer(1,c.sampleRate,c.sampleRate);const a=NBUF.getChannelData(0);for(let i=0;i<a.length;i++)a[i]=Math.random()*2-1;}return NBUF;}\\\\nfunction noise(d,vol,hp,delay,dest,lp){const c=au();if(!c)return;const t=c.currentTime+(delay||0),s=c.createBufferSource(),f=c.createBiquadFilter(),gn=c.createGain();\\\\n  s.buffer=nbuf();f.type=lp?'lowpass':'highpass';f.frequency.value=lp||hp||800;gn.gain.setValueAtTime(vol||.1,t);gn.gain.exponentialRampToValueAtTime(.0001,t+d);\\\\n  s.connect(f);f.connect(gn);gn.connect(dest||SFXG);s.start(t,Math.random()*.5);s.stop(t+d+.02);if(!dest)voice(s,t+d);}\\\\n\\\\n/* ===================== 150 SUONI ===================== */\\\\n/* ogni suono è una lista di strati: [tipo, freq, durata, onda, volume, scivolo, ritardo, filtro] */\\\\nconst SFX=[];\\\\nfunction addS(n,layers){SFX.push({n,L:layers});return SFX.length-1;}\\\\nconst WAV=['square','triangle','sawtooth','sine'];\\\\n{const r=rng(424242),pk=a=>a[Math.floor(r()*a.length)];\\\\n  // 15 attacchi e 15 colpi delle armi\\\\n  const WN=['Mazza','Spada','Lancia','Ascia','Alabarda','Martelletto','Bastone','Pistola','Fucile','Balestra','Arco','Pugnali','Bastone del mago','Ampolla','Corno'];\\\\n  WN.forEach((w,i)=>{const melee=i<7;addS('Attacco: '+w,melee?[['n',0,.06+r()*.06,0,.05,0,0,900+r()*1600],['t',180+r()*200,.05,'triangle',.02,.6,0,0]]:\\\\n    i===7||i===8?[['t',600+r()*300,.06,'square',.035,.35,0,0],['n',0,.05+r()*.05,0,.04,0,0,2200]]:i>=12?[['t',400+r()*300,.2,'sine',.05,1.8+r(),0,0],['t',800+r()*200,.12,'triangle',.02,1.5,.04,0]]:\\\\n    [['t',350+r()*200,.08,'triangle',.05,1.5+r()*.5,0,0],['n',0,.03,0,.02,0,0,3000]]);});\\\\n  WN.forEach((w,i)=>addS('Colpo: '+w,[['t',120+r()*120,.06+r()*.05,pk(['square','triangle']),.045,.45+r()*.2,0,0],['n',0,.04,0,.025,0,0,1200+r()*1500]]));\\\\n  // 25 morti e 25 attacchi dei nemici (una per specie)\\\\n  const SPN=['Guardia','Ratto','Scheletro','Melma','Spadaccino','Fantasma','Cane','Ragno','Scudiero','Arciere','Pipistrello','Folletto','Libro','Balestriere','Carceriere','Candela','Forziere','Alabardiere','Assassino','Gargoyle','Quadro','Alchimista','Golem','Boia','Cavaliere'];\\\\n  SPN.forEach((s,i)=>{const f=90+r()*500,w=pk(WAV);addS('Sconfitto: '+s,[['t',f,.12+r()*.2,w,.04,.25+r()*.5,0,0],['n',0,.08+r()*.1,0,.025,0,0,400+r()*2000],['t',f*1.5,.08,'triangle',.02,.5,.05,0]]);});\\\\n  SPN.forEach((s,i)=>{const f=150+r()*400;addS('Attacco: '+s,[['t',f,.1+r()*.12,pk(WAV),.035,.6+r()*.9,0,0],['n',0,.06,0,.02,0,0,1500]]);});\\\\n  // 20 attacchi dei boss\\\\n  const BA=['Ventaglio di monete','Pioggia d\\\\\\\\'oro','Chiamata','Carica','Anello di sfere','Lingotti','Spirale','Terremoto','Sacco esplosivo','Sparizione','Risata ricca','Tintinnio','Cassaforte','Gong','Patto','Fiamma d\\\\\\\\'oro','Ruggito','Tesoro','Corona','Furia'];\\\\n  BA.forEach((n,i)=>{const f=60+r()*180;addS('Boss: '+n,[['t',f,.4+r()*.4,pk(['sawtooth','square']),.06,.4+r()*.5,0,0],['t',f*2.01,.3,'triangle',.03,.7,.05,0],['n',0,.25,0,.04,0,0,200+r()*600]]);});\\\\n  // 10 raccolte\\\\n  [['Moneta',1250],['Mucchio di monete',1500],['Cuore',660],['Forziere',520],['Cibo',440],['Punto',1700],['Esperienza',990],['Chiave',1100],['Gemma',1900],['Cassa rotta',0]].forEach(([n,f],i)=>\\\\n    addS('Raccolta: '+n,f?[['t',f,.05+i*.006,'sine',.035,1.35,0,0],['t',f*1.5,.05,'sine',.02,1.2,.04,0]]:[['n',0,.18,0,.08,0,0,500],['t',140,.12,'square',.03,.5,0,0]]));\\\\n  // 20 suoni di gioco e menu\\\\n  const UI=[['Clic',[['t',660,.04,'square',.03,1,0,0]]],['Compra',[['t',880,.07,'square',.045,1,0,0],['t',1320,.09,'square',.045,1,.06,0]]],['Errore',[['t',140,.15,'square',.05,.8,0,0]]],\\\\n    ['Grado salito',[523,659,784,1046].map((f,k)=>['t',f,.12,'square',.045,1,k*.07,0])],['Inizio ondata',[392,523,659].map((f,k)=>['t',f,.18,'triangle',.07,1,k*.1,0])],\\\\n    ['Ondata superata',[659,784,988].map((f,k)=>['t',f,.14,'triangle',.06,1,k*.08,0])],['Arriva il boss',[['t',110,.8,'sawtooth',.08,.5,0,0],['t',82,.9,'square',.05,.6,0,0]]],\\\\n    ['Sconfitta',[['t',300,.7,'sawtooth',.09,.2,0,0]]],['Vittoria',[523,659,784,1046,1318].map((f,k)=>['t',f,.25,'triangle',.07,1,k*.13,0])],\\\\n    ['Skin sbloccata',[784,988,1175,1568].map((f,k)=>['t',f,.16,'sine',.06,1,k*.06,0])],['Cancello',[['n',0,.9,0,.06,0,0,0,300],['t',70,.8,'sawtooth',.03,.9,0,0]]],\\\\n    ['Folla che esulta',[['n',0,1.1,0,.07,0,0,700],['n',0,.8,0,.05,0,.2,1400]]],['Folla che fischia',[['t',1800,.5,'sine',.02,.7,0,0],['n',0,.7,0,.04,0,0,500]]],\\\\n    ['Risata del Re',[0,1,2,3,4].map(k=>['t',220-k*12,.11,'sawtooth',.05,.85,k*.13,0])],['Porta',[['t',90,.3,'sawtooth',.04,.7,0,0],['n',0,.2,0,.04,0,.05,300]]],\\\\n    ['Botola',[['n',0,.25,0,.07,0,0,0,400],['t',60,.25,'sine',.08,.6,0,0]]],['Avviso',[['t',1046,.07,'square',.04,1,0,0],['t',1046,.07,'square',.04,1,.1,0]]],\\\\n    ['Rimescola',[['t',500,.05,'triangle',.04,1.6,0,0],['t',700,.05,'triangle',.04,1.6,.05,0],['t',900,.05,'triangle',.04,1.6,.1,0]]],['Lucchetto',[['t',1400,.04,'square',.03,.7,0,0],['n',0,.03,0,.02,0,.02,4000]]],\\\\n    ['Vendi',[['t',1320,.07,'square',.04,.7,0,0],['t',880,.09,'square',.04,1,.06,0]]]];\\\\n  UI.forEach(([n,L])=>addS(n,L));\\\\n  // 20 suoni vari\\\\n  for(let k=0;k<5;k++)addS('Ferito '+(k+1),[['t',200+k*20,.18,'sawtooth',.07,.5-k*.03,0,0],['n',0,.08,0,.03,0,0,800]]);\\\\n  addS('Schivata',[['n',0,.12,0,.05,0,0,3000],['t',900,.08,'sine',.02,1.6,0,0]]);\\\\n  for(let k=0;k<4;k++)addS('Passo '+(k+1),[['n',0,.05,0,.03,0,0,0,300+k*120]]);\\\\n  addS('Fuoco',[['n',0,.4,0,.05,0,0,0,900],['t',120,.3,'sawtooth',.02,1.4,0,0]]);addS('Ghiaccio',[['t',2400,.15,'sine',.03,.7,0,0],['t',3100,.1,'sine',.02,.8,.04,0]]);\\\\n  addS('Veleno',[['t',300,.25,'sine',.03,.6,0,0],['t',360,.2,'sine',.02,.6,.08,0]]);addS('Esplosione',[['n',0,.5,0,.1,0,0,0,600],['t',60,.4,'sine',.1,.5,0,0]]);\\\\n  addS('Schianto',[['n',0,.25,0,.11,0,0,200],['t',70,.3,'sine',.12,.5,0,0]]);addS('Teletrasporto',[['t',300,.25,'sine',.04,3,0,0],['t',1200,.15,'sine',.02,.4,.1,0]]);\\\\n  addS('Magia',[['t',520,.22,'sine',.05,2,0,0]]);addS('Cura',[['t',660,.15,'sine',.04,1.5,0,0],['t',990,.15,'sine',.03,1.3,.08,0]]);\\\\n  addS('Parata',[['t',1700,.08,'square',.03,.9,0,0],['n',0,.05,0,.03,0,0,5000]]);addS('Critico',[['t',1600,.06,'square',.04,1.3,0,0],['n',0,.06,0,.04,0,0,2500]]);\\\\n}\\\\nconst SFX_ID=Object.fromEntries(SFX.map((s,i)=>[s.n,i]));\\\\nfunction playS(i,vol){const s=SFX[i];if(!s||!au())return;const k=vol==null?1:vol;\\\\n  for(const L of s.L){if(L[0]==='t')tone(L[1],L[2],L[3],L[4]*k,L[5],L[6]);else noise(L[2],L[4]*k,L[7],L[6],null,L[8]);}}\\\\nconst sLast={};\\\\n/* nomi brevi usati dal gioco */\\\\nconst SFX_ALIAS={click:'Clic',buy:'Compra',err:'Errore',lvl:'Grado salito',wave:'Inizio ondata',clear:'Ondata superata',boss:'Arriva il boss',die:'Sconfitta',win:'Vittoria',\\\\n  unlock:'Skin sbloccata',gate:'Cancello',cheer:'Folla che esulta',boo:'Folla che fischia',laugh:'Risata del Re',door:'Porta',trap:'Botola',alert:'Avviso',reroll:'Rimescola',lock:'Lucchetto',sell:'Vendi',\\\\n  pick:'Raccolta: Moneta',pickbig:'Raccolta: Mucchio di monete',heart:'Raccolta: Cuore',chest:'Raccolta: Forziere',food:'Raccolta: Cibo',point:'Raccolta: Punto',crate:'Raccolta: Cassa rotta',\\\\n  dodge:'Schivata',fire:'Fuoco',ice:'Ghiaccio',poison:'Veleno',boom:'Esplosione',slam:'Schianto',tele:'Teletrasporto',magic:'Magia',heal:'Cura',block:'Parata',crit:'Critico'};\\\\nfunction sfx(k,vol){const now=performance.now();if(sLast[k]&&now-sLast[k]<45)return;sLast[k]=now;\\\\n  if(k==='hurt'){playS(SFX_ID['Ferito '+(1+Math.floor(Math.random()*5))]);return;}\\\\n  const n=SFX_ALIAS[k]||k,i=SFX_ID[n];if(i!=null)playS(i,vol);}\\\\n\\\\n/* ===================== 200 BRANI ===================== */\\\\nconst MODES={minore:[0,2,3,5,7,8,10],dorico:[0,2,3,5,7,9,10],frigio:[0,1,3,5,7,8,10],armonico:[0,2,3,5,7,8,11],maggiore:[0,2,4,5,7,9,11],misolidio:[0,2,4,5,7,9,10]};\\\\nconst PROGS=[[0,5,3,4],[0,3,4,0],[0,6,5,4],[0,4,5,3],[0,2,3,4],[0,5,2,4],[0,3,0,4],[0,6,3,4],[0,1,0,4],[0,4,3,4],[0,5,6,4],[0,2,5,4]];\\\\nconst DRUMS=[\\\\n  {k:[0,8],s:[4,12],h:[0,2,4,6,8,10,12,14]},{k:[0,6,8],s:[4,12],h:[2,6,10,14]},{k:[0,4,8,12],s:[4,12],h:[0,2,4,6,8,10,12,14]},{k:[0,10],s:[8],h:[0,4,8,12]},\\\\n  {k:[0,3,8,11],s:[4,12],h:[0,2,4,6,8,10,12,14]},{k:[0,8],s:[12],h:[4,12]},{k:[0,7,8],s:[4,10,12],h:[0,1,2,4,6,8,9,10,12,14]},{k:[0,2,8,10],s:[4,12],h:[2,6,10,14]}];\\\\nconst MN_A=['Marcia','Ballata','Danza','Canto','Rondò','Inno','Fuga','Lamento','Valzer','Galoppo','Notturno','Tamburi','Corteo','Furia','Sogno','Assalto','Giostra','Veglia','Scherzo','Duello'];\\\\nconst MN_B=['delle Catene','della Cella','del Re','dell\\\\\\\\'Arena','delle Torce','del Mercante','dei Forzieri','della Ronda','delle Ombre','dell\\\\\\\\'Oro'];\\\\nconst TRACKS=[];\\\\nfor(let i=0;i<200;i++){const r=rng(i*7919+13),pk=a=>a[Math.floor(r()*a.length)];\\\\n  const boss=i>=160&&i<190,menu=i>=190;\\\\n  const modeN=boss?pk(['frigio','armonico','minore']):menu?pk(['dorico','maggiore','misolidio','minore']):pk(Object.keys(MODES));\\\\n  const T={i,n:MN_A[i%20]+' '+MN_B[Math.floor(i/20)],bpm:Math.round(boss?130+r()*40:menu?80+r()*30:90+r()*55),root:45+Math.floor(r()*12),mode:modeN,\\\\n    prog:pk(PROGS),drum:pk(DRUMS),lead:pk(['square','triangle','sawtooth']),bassW:pk(['triangle','sawtooth','square']),arp:Math.floor(r()*4),\\\\n    swing:r()<.25?.12:0,leadVol:.018+r()*.012,oct:r()<.5?12:24,seed:i*31+7};\\\\n  // melodia: 2 frasi da 16 note (ottavi), con un motivo che si ripete\\\\n  const mot=[];for(let k=0;k<4;k++)mot.push(r()<.2?null:Math.floor(r()*5)-1);\\\\n  T.mel=[];for(let ph=0;ph<4;ph++)for(let k=0;k<8;k++){const base=k<4?mot[k]:(r()<.5?mot[k-4]:(r()<.25?null:Math.floor(r()*7)-2));T.mel.push(base==null?null:base+(ph===3&&k===7?0:0));}\\\\n  TRACKS.push(T);}\\\\n/* scelta del brano: livelli normali 0-159 (in giro), boss 160-189, menu/negozio/storia 190-199 */\\\\nconst trackOfLevel=n=>(n-1)%160;\\\\nconst trackOfBoss=bi=>160+bi%30;\\\\nconst TR_MENU=190,TR_SHOP=192,TR_STORY=195,TR_WIN=197;\\\\nconst MZ={cur:-1,step:0,next:0,timer:null};\\\\nfunction musicPlay(i){if(MZ.cur===i)return;MZ.cur=i;MZ.step=0;const c=au();if(!c)return;MZ.next=c.currentTime+.08;\\\\n  if(!MZ.timer)MZ.timer=setInterval(musTick,30);}\\\\nfunction musicStop(){MZ.cur=-1;}\\\\nfunction musTick(){if(MZ.cur<0||!AC||!AS.mus)return;const T=TRACKS[MZ.cur];if(!T)return;const sp=60/T.bpm/4;\\\\n  while(MZ.next<AC.currentTime+.15){musStep(T,MZ.step,MZ.next+(MZ.step%2?T.swing*sp:0));MZ.step++;MZ.next+=sp;}}\\\\nfunction noteF(m){return 440*Math.pow(2,(m-69)/12);}\\\\nfunction mtone(f,t,d,type,vol){const o=AC.createOscillator(),gn=AC.createGain();o.type=type;o.frequency.setValueAtTime(f,t);\\\\n  gn.gain.setValueAtTime(0,t);gn.gain.linearRampToValueAtTime(vol,t+.01);gn.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(gn);gn.connect(MUS);o.start(t);o.stop(t+d+.03);}\\\\nfunction mnoise(t,d,vol,hp){const s=AC.createBufferSource(),f=AC.createBiquadFilter(),gn=AC.createGain();s.buffer=nbuf();f.type='highpass';f.frequency.value=hp;\\\\n  gn.gain.setValueAtTime(vol,t);gn.gain.exponentialRampToValueAtTime(.0001,t+d);s.connect(f);f.connect(gn);gn.connect(MUS);s.start(t,Math.random()*.5);s.stop(t+d+.02);}\\\\nfunction musStep(T,st,t){const sc=MODES[T.mode],bar=Math.floor(st/16)%4,s16=st%16,deg=T.prog[bar];\\\\n  const chord=[0,2,4].map(k=>{const d=deg+k;return T.root+12+sc[d%7]+12*Math.floor(d/7);});\\\\n  // basso\\\\n  if(s16%4===0)mtone(noteF(T.root+sc[deg%7]),t,.32,T.bassW,.05);\\\\n  // arpeggio\\\\n  if(T.arp&&s16%2===0){const n=chord[(s16/2)%3]+(T.arp===2?12:0);mtone(noteF(n),t,.12,'triangle',.012);}\\\\n  // melodia (ottavi)\\\\n  if(s16%2===0){const m=T.mel[(Math.floor(st/2))%T.mel.length];if(m!=null){const d=deg+m+7;mtone(noteF(T.root+T.oct+sc[((d%7)+7)%7]+12*Math.floor(d/7)),t,.2,T.lead,T.leadVol);}}\\\\n  // batteria\\\\n  const D=T.drum;if(D.k.includes(s16))mtone(70,t,.18,'sine',.09);if(D.s.includes(s16))mnoise(t,.1,.05,1500);if(D.h.includes(s16))mnoise(t,.03,.018,6000);\\\\n}\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\r\\\\n/* =====================================================================\\\\r\\\\n   KING ARENA · 100 sfondi: i 5 luoghi di KING TOWER × 20 stanze diverse.\\\\r\\\\n   Ogni stanza ha pavimento, colori, luci, tappeti e arredi suoi.\\\\r\\\\n   Livello n → sfondo (n-1)%100 (il luogo cambia ogni 20 livelli).\\\\r\\\\n   ===================================================================== */\\\\r\\\\nconst PLACES=[\\\\r\\\\n {n:'Prigioni',fl:'#4a4640',wall:'#3e3b36',dec:'cells'},\\\\r\\\\n {n:'Sala delle Armi',fl:'#5a5248',wall:'#4a4038',dec:'racks'},\\\\r\\\\n {n:'Biblioteca',fl:'#6a4a32',wall:'#3a2a20',dec:'books'},\\\\r\\\\n {n:'Galleria dei Ritratti',fl:'#6a6058',wall:'#4a3a44',dec:'portraits'},\\\\r\\\\n {n:'Corridoi Reali',fl:'#746c62',wall:'#5a4a3a',dec:'banners'}];\\\\r\\\\nconst ROOMS=[\\\\r\\\\n ['Cella 1','Celle allagate','Pozzo dei ratti','Catene arrugginite','Cella del carceriere','Segrete profonde','Muffa verde','Ossa antiche','Cella dei ladri','Paglia bagnata',\\\\r\\\\n  'Fossa buia','Cella d\\\\\\\\'isolamento','Prigione dei nobili','Gogna','Sotterraneo freddo','Celle della luna','Cunicolo','Stanza della tortura','Cripta','Cancello di ferro'],\\\\r\\\\n ['Rastrelliere','Armeria del re','Fucina','Sala degli scudi','Deposito delle lance','Sala delle armature','Officina','Arsenale d\\\\\\\\'oro','Sala delle balestre','Polveriera',\\\\r\\\\n  'Sala dei trofei','Caserma','Sala d\\\\\\\\'addestramento','Magazzino','Armeria nera','Forno della fucina','Sala delle asce','Sala del capitano','Bottega dell\\\\\\\\'armaiolo','Salone delle bandiere'],\\\\r\\\\n ['Scaffali alti','Sala di lettura','Archivio','Biblioteca proibita','Sala delle mappe','Scrittoio','Torre dei libri','Sala delle candele','Biblioteca del mago','Sala degli atlanti',\\\\r\\\\n  'Stanza delle pergamene','Biblioteca d\\\\\\\\'inverno','Sala degli alchimisti','Archivio segreto','Sala delle clessidre','Studio del sapiente','Libreria rossa','Sala degli specchi','Sala delle stelle','Biblioteca reale'],\\\\r\\\\n ['Galleria','Sala dei re','Ritratti antichi','Galleria d\\\\\\\\'oro','Sala delle statue','Galleria della luna','Corridoio dei volti','Sala delle cornici','Galleria rossa','Sala dei nobili',\\\\r\\\\n  'Galleria blu','Sala dei mosaici','Galleria delle ombre','Sala delle vetrate','Galleria verde','Sala del pittore','Galleria d\\\\\\\\'argento','Sala delle maschere','Galleria imperiale','Sala dei tesori'],\\\\r\\\\n ['Corridoio reale','Sala del trono','Salone delle feste','Sala del banchetto','Corridoio d\\\\\\\\'oro','Sala da ballo','Anticamera','Balconata','Sala del consiglio','Salone degli specchi',\\\\r\\\\n  'Corridoio delle torce','Sala della corona','Appartamenti reali','Sala delle udienze','Cappella','Sala dei cristalli','Terrazza','Sala del tesoro','Corridoio del re','Cima della torre']];\\\\r\\\\nconst LIGHTS=[['#ffaa3c',.28],['#9ab8ff',.22],['#6aff7a',.18],['#c07aff',.22],['#ffd45c',.3],['#5ad0ff',.2],['#ff5a3a',.24]];\\\\r\\\\nconst bgOfLevel=n=>(n-1)%100;\\\\r\\\\nconst bgName=bi=>PLACES[Math.floor(bi/20)].n+' — '+ROOMS[Math.floor(bi/20)][bi%20];\\\\r\\\\nlet FLOOR=null;const TORCH=[];let BG=null;\\\\r\\\\n/* due tele del pavimento che si riusano: creare una tela nuova (2240×1560) a ogni livello faceva scattare il gioco */\\\\r\\\\nconst FL_POOL=[];\\\\r\\\\nfunction floorCanvas(w,h){let c=FL_POOL.find(x=>x!==FLOOR&&x.width===w&&x.height===h);\\\\r\\\\n  if(!c){c=document.createElement('canvas');c.width=w;c.height=h;FL_POOL.push(c);}\\\\r\\\\n  c.__dz=0;const f=c.getContext('2d');f.setTransform(1,0,0,1,0,0);f.globalAlpha=1;f.globalCompositeOperation='source-over';f.clearRect(0,0,w,h);f.imageSmoothingEnabled=false;return[c,f];}\\\\r\\\\nfunction bgParams(bi){const pl=Math.floor(bi/20),v=bi%20,r=rng(bi*977+5),P=PLACES[pl];\\\\r\\\\n  const hue=[null,'#3a6ab0','#7a3aa8','#3a8a3a','#a87a2a','#8a2a2a','#2a8a8a'][Math.floor(r()*7)];\\\\r\\\\n  return{pl,v,r,P,floor:['tiles','checker','wood','flag','herring','hex'][(v+pl*2)%6],tint:v%3===0?null:hue,\\\\r\\\\n    light:LIGHTS[(v*3+pl)%7],rug:['none','rect','circle','cross','long'][Math.floor(r()*5)],rugC:pick(['#8e1b1b','#1f3a6a','#3a5a2a','#5a1830','#6a4a1a','#2a2a5a']),\\\\r\\\\n    props:Math.floor(r()*5),windows:v%4===1,cols:v%5===2,chand:v%6===3,dark:v%7===4?.25:0};}\\\\r\\\\nfunction buildFloor(bi){\\\\r\\\\n  BG=bgParams(bi);const{P,r}=BG,AWi=AW,AHi=AH,[c,f]=floorCanvas(AWi*2,AHi*2);f.imageSmoothingEnabled=true;f.scale(2,2);\\\\r\\\\n  const fl=BG.tint?mix(P.fl,BG.tint,.18):P.fl,fl2=mix(fl,'#000',.15),wall=BG.tint?mix(P.wall,BG.tint,.2):P.wall;\\\\r\\\\n  f.fillStyle=fl2;f.fillRect(0,0,AWi,AHi);\\\\r\\\\n  const st=BG.floor;\\\\r\\\\n  if(st==='wood'){for(let y=WALL;y<AHi;y+=14){for(let x=-(y*7%60);x<AWi;x+=60+Math.floor(r()*40)){f.fillStyle=mix(fl,'#000',r()*.25);f.fillRect(x,y,58,13);f.fillStyle='rgba(255,230,200,.06)';f.fillRect(x,y,58,2);}}}\\\\r\\\\n  else if(st==='herring'){for(let y=WALL;y<AHi;y+=12)for(let x=0;x<AWi;x+=24){f.save();f.translate(x+12,y+6);f.rotate(((x/24+y/12)%2?1:-1)*.6);f.fillStyle=mix(fl,'#000',r()*.25);f.fillRect(-12,-4,24,8);f.restore();}}\\\\r\\\\n  else if(st==='hex'){const S=22;for(let y=WALL,row=0;y<AHi+S;y+=S*.86,row++)for(let x=(row%2)*S/2;x<AWi+S;x+=S){f.fillStyle=mix(fl,r()<.5?'#000':'#fff6e6',r()*.12);f.beginPath();for(let k=0;k<6;k++){const a=k*1.047+.52;f.lineTo(x+Math.cos(a)*S*.55,y+Math.sin(a)*S*.55);}f.fill();}}\\\\r\\\\n  else if(st==='flag'){for(let i=0;i<260;i++){const x=r()*AWi,y=WALL+r()*(AHi-WALL),w=20+r()*30,h=14+r()*22;f.fillStyle=mix(fl,r()<.5?'#000':'#fff6e6',r()*.15);f.beginPath();f.ellipse(x,y,w/2,h/2,r()*3,0,6.283);f.fill();}}\\\\r\\\\n  else{const S=st==='checker'?32:40;for(let y=WALL;y<AHi;y+=S)for(let x=((y/S)%2)*(st==='checker'?0:20)-20;x<AWi;x+=S){\\\\r\\\\n      const alt=st==='checker'&&((x/S+y/S)&1);f.fillStyle=alt?mix(fl,'#000',.3):mix(fl,r()<.5?'#000':'#fff6e6',r()*.12);f.fillRect(x+1,y+1,S-2,S-2);\\\\r\\\\n      f.fillStyle='rgba(255,246,230,.05)';f.fillRect(x+1,y+1,S-2,3);f.fillStyle='rgba(0,0,0,.18)';f.fillRect(x+1,y+S-4,S-2,3);}}\\\\r\\\\n  for(let i=0;i<AWi*AHi/70;i++){f.fillStyle=r()<.5?'rgba(0,0,0,.08)':'rgba(255,246,230,.04)';f.fillRect(r()*AWi,WALL+r()*(AHi-WALL),1,1);}\\\\r\\\\n  // crepe\\\\r\\\\n  for(let i=0;i<14;i++){f.strokeStyle='rgba(0,0,0,.3)';f.lineWidth=1;f.beginPath();let x=r()*AWi,y=WALL+r()*(AHi-WALL);f.moveTo(x,y);for(let k=0;k<4;k++){x+=(r()-.5)*24;y+=(r()-.5)*18;f.lineTo(x,y);}f.stroke();}\\\\r\\\\n  // tappeto\\\\r\\\\n  const cx=AWi/2,cy=(WALL+AHi)/2;f.fillStyle=BG.rugC;\\\\r\\\\n  if(BG.rug==='rect'){f.fillRect(cx-150,cy-90,300,180);f.strokeStyle='#d8a93a';f.lineWidth=4;f.strokeRect(cx-140,cy-80,280,160);}\\\\r\\\\n  else if(BG.rug==='circle'){f.beginPath();f.ellipse(cx,cy,170,110,0,0,6.283);f.fill();f.strokeStyle='#d8a93a';f.lineWidth=4;f.beginPath();f.ellipse(cx,cy,155,98,0,0,6.283);f.stroke();f.font='60px serif';f.textAlign='center';f.fillStyle='rgba(216,169,58,.5)';f.fillText('♛',cx,cy+20);}\\\\r\\\\n  else if(BG.rug==='cross'){f.fillRect(cx-60,WALL,120,AHi-WALL);f.fillRect(0,cy-50,AWi,100);f.fillStyle='#d8a93a';f.fillRect(cx-60,WALL,4,AHi-WALL);f.fillRect(cx+56,WALL,4,AHi-WALL);}\\\\r\\\\n  else if(BG.rug==='long'){f.fillRect(cx-70,WALL,140,AHi-WALL);f.fillStyle='#d8a93a';f.fillRect(cx-70,WALL,5,AHi-WALL);f.fillRect(cx+65,WALL,5,AHi-WALL);f.fillStyle='rgba(0,0,0,.15)';for(let y=WALL;y<AHi;y+=26)f.fillRect(cx-60,y,120,2);}\\\\r\\\\n  // oggetti sul pavimento del luogo\\\\r\\\\n  for(let i=0;i<30+BG.props*8;i++){const x=40+r()*(AWi-80),y=WALL+30+r()*(AHi-WALL-60);\\\\r\\\\n    if(BG.pl===0){if(r()<.5){f.strokeStyle='rgba(200,170,90,.45)';f.lineWidth=.8;for(let k=0;k<5;k++){f.beginPath();f.moveTo(x+(r()-.5)*12,y+(r()-.5)*6);f.lineTo(x+(r()-.5)*20,y+(r()-.5)*8);f.stroke();}}\\\\r\\\\n      else if(r()<.3){f.fillStyle='rgba(60,90,120,.25)';f.beginPath();f.ellipse(x,y,16+r()*14,6+r()*5,0,0,6.283);f.fill();}else{f.fillStyle='#d8d0bc';f.fillRect(x,y,7,2);f.beginPath();f.arc(x,y+1,1.6,0,6.283);f.arc(x+7,y+1,1.6,0,6.283);f.fill();}}\\\\r\\\\n    else if(BG.pl===1){if(r()<.4){f.fillStyle='rgba(30,30,30,.35)';f.beginPath();f.arc(x,y,3,0,6.283);f.fill();}else if(r()<.2){f.fillStyle='#6a4a2a';f.fillRect(x-6,y-6,12,12);f.strokeStyle='#3a2a1a';f.strokeRect(x-6,y-6,12,12);}}\\\\r\\\\n    else if(BG.pl===2){if(r()<.5){f.fillStyle='#efe4c8';f.save();f.translate(x,y);f.rotate(r()*3);f.fillRect(-5,-3,10,6);f.restore();}else if(r()<.2){f.fillStyle=pick(['#7a1626','#1f3a6a','#3a5a2a']);f.fillRect(x,y,9,6);}}\\\\r\\\\n    else if(BG.pl===3){if(r()<.25){f.fillStyle='rgba(255,220,150,.08)';f.beginPath();f.ellipse(x,y,30,12,0,0,6.283);f.fill();}}\\\\r\\\\n    else{if(r()<.3){f.fillStyle='#d8a93a';f.beginPath();f.arc(x,y,1.8,0,6.283);f.fill();}else if(r()<.15){f.fillStyle='rgba(180,30,40,.3)';f.fillRect(x,y,4,4);}}}\\\\r\\\\n  // parete\\\\r\\\\n  f.fillStyle=mix(wall,'#000',.35);f.fillRect(0,0,AWi,WALL);\\\\r\\\\n  for(let y=0;y<WALL-8;y+=12)for(let x=(y/12%2)*14-14;x<AWi;x+=28){f.fillStyle=mix(wall,r()<.5?'#000':'#fff6e6',r()*.15);f.fillRect(x+1,y+1,26,10);f.fillStyle='rgba(255,246,230,.06)';f.fillRect(x+1,y+1,26,2);}\\\\r\\\\n  f.fillStyle='rgba(0,0,0,.45)';f.fillRect(0,WALL-10,AWi,10);f.fillStyle=mix(wall,'#fff6e6',.2);f.fillRect(0,WALL-12,AWi,3);\\\\r\\\\n  // arredi sulla parete, porte e torce\\\\r\\\\n  TORCH.length=0;DOORS.length=0;\\\\r\\\\n  for(let x=60;x<AWi;x+=140){const k=Math.round(x/140)%4;\\\\r\\\\n    if(k===0||k===2){if(k===2&&DOORS.length<3){DOORS.push(x);drawDoor(f,x);continue;}TORCH.push(x);f.fillStyle='#2a1a10';f.fillRect(x-2,46,5,16);f.fillStyle='#5a3a22';f.fillRect(x-4,44,9,4);continue;}\\\\r\\\\n    if(BG.windows&&k===3){f.fillStyle='#0a1430';f.beginPath();f.moveTo(x-14,80);f.lineTo(x-14,36);f.arc(x,36,14,3.14,0);f.lineTo(x+14,80);f.fill();f.fillStyle='#fff6c0';f.beginPath();f.arc(x+5,40,4,0,6.283);f.fill();\\\\r\\\\n      f.strokeStyle='#3a3028';f.lineWidth=3;f.strokeRect(x-14,36,28,44);f.beginPath();f.moveTo(x,22);f.lineTo(x,80);f.stroke();continue;}\\\\r\\\\n    const d=P.dec;\\\\r\\\\n    if(d==='cells'){f.fillStyle='#120e0c';f.fillRect(x-26,24,52,WALL-36);for(let i=0;i<6;i++){f.fillStyle='#5a5f66';f.fillRect(x-24+i*9,24,3,WALL-36);}f.fillStyle='#7a8088';f.fillRect(x-26,24,52,3);f.fillRect(x-26,52,52,3);}\\\\r\\\\n    else if(d==='racks'){f.fillStyle='#4a3420';f.fillRect(x-30,30,60,4);f.fillRect(x-30,80,60,4);\\\\r\\\\n      for(const[i,wt]of['spear','halberd','spear'].entries()){f.save();f.translate(x-18+i*18,86);sprDraw(f,wSprite(wt,0),0,0,30,32,{rot:-Math.PI/2});f.restore();}}\\\\r\\\\n    else if(d==='books'){f.fillStyle='#2a1a10';f.fillRect(x-32,16,64,WALL-26);for(let s=0;s<4;s++){let bx=x-29;while(bx<x+28){const bw=3+Math.floor(r()*4);f.fillStyle=pick(['#7a1626','#1f3a6a','#3a5a2a','#6a4a1a','#4a2a6a','#8a6a3a']);f.fillRect(bx,20+s*19,bw,15-Math.floor(r()*4));bx+=bw+1;}f.fillStyle='#4a3020';f.fillRect(x-32,35+s*19,64,3);}}\\\\r\\\\n    else if(d==='portraits'){f.fillStyle='#8a6a1c';f.fillRect(x-22,18,44,56);f.fillStyle='#d8a93a';f.fillRect(x-20,20,40,52);f.fillStyle='#2a1a22';f.fillRect(x-17,23,34,46);\\\\r\\\\n      f.save();f.beginPath();f.rect(x-17,23,34,46);f.clip();drawHuman(f,x,90,{face:1,pal:pick([NOBLE,KING,GOLD,skinPal(Math.floor(r()*100))]),pose:'idle',t:0,weapon:'none',scale:1.1});f.restore();}\\\\r\\\\n    else{f.fillStyle=BG.rugC;f.beginPath();f.moveTo(x-16,14);f.lineTo(x+16,14);f.lineTo(x+16,78);f.lineTo(x,68);f.lineTo(x-16,78);f.closePath();f.fill();\\\\r\\\\n      f.fillStyle='#d8a93a';f.fillRect(x-16,14,32,3);f.font='18px serif';f.textAlign='center';f.fillText('♛',x,48);}}\\\\r\\\\n  // botole nel pavimento (da qui escono i mostri)\\\\r\\\\n  TRAPS.length=0;for(let i=0;i<6;i++){const x=120+(i%3)*((AWi-240)/2),y=WALL+120+Math.floor(i/3)*(AHi-WALL-240);TRAPS.push({x,y});\\\\r\\\\n    f.fillStyle='#2a1c12';f.fillRect(x-14,y-10,28,20);f.strokeStyle='#5a4028';f.lineWidth=2;f.strokeRect(x-14,y-10,28,20);f.beginPath();f.moveTo(x,y-10);f.lineTo(x,y+10);f.stroke();f.fillStyle='#8a8a8a';f.fillRect(x-3,y-2,2,4);f.fillRect(x+1,y-2,2,4);}\\\\r\\\\n  // colonne ai lati\\\\r\\\\n  if(BG.cols)for(let y=WALL+60;y<AHi-40;y+=170)for(const x of[50,AWi-50]){f.fillStyle='rgba(0,0,0,.3)';f.beginPath();f.ellipse(x+4,y+6,18,7,0,0,6.283);f.fill();f.fillStyle=mix(wall,'#fff6e6',.25);f.beginPath();f.arc(x,y,14,0,6.283);f.fill();f.strokeStyle='rgba(0,0,0,.3)';f.stroke();}\\\\r\\\\n  // ombre ai bordi\\\\r\\\\n  const sh=(x,y,w,h,a,b)=>{const gr=f.createLinearGradient(x,y,a?x+w:x,a?y:y+h);gr.addColorStop(0,b?'rgba(0,0,0,0)':'rgba(0,0,0,.6)');gr.addColorStop(1,b?'rgba(0,0,0,.6)':'rgba(0,0,0,0)');f.fillStyle=gr;f.fillRect(x,y,w,h);};\\\\r\\\\n  sh(0,WALL,40,AHi-WALL,1,0);sh(AWi-40,WALL,40,AHi-WALL,1,1);sh(0,AHi-40,AWi,40,0,1);\\\\r\\\\n  f.fillStyle='#14100d';f.fillRect(0,WALL,EDGE-8,AHi);f.fillRect(AWi-EDGE+8,WALL,EDGE,AHi);f.fillRect(0,AHi-EDGE+8,AWi,EDGE);\\\\r\\\\n  if(BG.dark){f.fillStyle='rgba(0,0,10,'+BG.dark+')';f.fillRect(0,0,AWi,AHi);}\\\\r\\\\n  // luce colorata della stanza\\\\r\\\\n  const L=BG.light,gr=f.createRadialGradient(cx,cy,60,cx,cy,AWi*.7);gr.addColorStop(0,'rgba(0,0,0,0)');gr.addColorStop(1,'rgba(0,0,0,.35)');f.fillStyle=gr;f.fillRect(0,0,AWi,AHi);\\\\r\\\\n  f.globalAlpha=.07;f.fillStyle=L[0];f.fillRect(0,0,AWi,AHi);f.globalAlpha=1;\\\\r\\\\n  FLOOR=c;\\\\r\\\\n}\\\\r\\\\nconst DOORS=[],TRAPS=[];\\\\r\\\\nfunction drawDoor(f,x){f.fillStyle='#120c08';f.beginPath();f.moveTo(x-20,WALL-10);f.lineTo(x-20,42);f.arc(x,42,20,3.14,0);f.lineTo(x+20,WALL-10);f.fill();\\\\r\\\\n  f.strokeStyle='#6a5a4a';f.lineWidth=4;f.beginPath();f.moveTo(x-22,WALL-10);f.lineTo(x-22,42);f.arc(x,42,22,3.14,0);f.lineTo(x+22,WALL-10);f.stroke();\\\\r\\\\n  f.strokeStyle='#4a4f56';f.lineWidth=2;for(let i=-15;i<=15;i+=6){f.beginPath();f.moveTo(x+i,30);f.lineTo(x+i,WALL-10);f.stroke();}}\\\\r\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\n/* =====================================================================\\\\n   KING ARENA · parametri, carte, oggetti, oggetti dei boss e armi nuove\\\\n   - 30 parametri: salgono SOLO con le carte; a ogni livello di esperienza\\\\n     tutti crescono dello 0,25%.\\\\n   - ogni 5 livelli di esperienza: 3 carte (15% arma, 60% potenziamento, 25% oggetto)\\\\n   - dopo ogni boss: 3 carte con i 30 oggetti dei boss (PERMANENTI)\\\\n   ===================================================================== */\\\\n/* chiave, nome, icona, valore di partenza, percentuale?, passo della carta, cosa fa */\\\\nconst PARAMS=[\\\\n ['forza','Forza','💪',10,0,1,'danno delle armi corpo a corpo e di quelle che girano'],\\\\n ['destrezza','Destrezza','🏹',10,0,1,'danno delle armi a distanza'],\\\\n ['magia','Magia','✨',10,0,1,'danno delle armi magiche'],\\\\n ['vita','Vita','❤️',30,0,5,'vita massima'],\\\\n ['rigenerazione','Rigenerazione','🍞',1,0,.5,'vita che torna da sola'],\\\\n ['armatura','Armatura','🛡️',2,0,1,'riduce i danni che ricevi'],\\\\n ['schivata','Schivata','💨',3,1,2,'probabilità di evitare un colpo (massimo 60%)'],\\\\n ['agilita','Agilità','👢',100,1,5,'velocità di corsa'],\\\\n ['velatt','Velocità d\\\\\\\\'attacco','⚡',100,1,5,'quanto spesso attaccano le armi'],\\\\n ['critico','Critico','🎯',5,1,2,'probabilità di colpo critico'],\\\\n ['dannocrit','Danno critico','💥',150,1,10,'quanto fa male un critico'],\\\\n ['portata','Portata','🔭',100,1,8,'quanto arrivano lontano le armi'],\\\\n ['vista','Vista','👁️',100,1,8,'quanto lontano le armi vedono i nemici'],\\\\n ['udito','Udito','👂',100,1,10,'senti prima dove arrivano i nemici'],\\\\n ['fortuna','Fortuna','🍀',10,0,5,'carte e oggetti più rari, più cuori e forzieri'],\\\\n ['raccolta','Raccolta','🧲',60,0,10,'da quanto lontano attiri l\\\\\\\\'esperienza'],\\\\n ['esperienza','Esperienza','📚',100,1,8,'esperienza in più da ogni gemma'],\\\\n ['furto','Furto di vita','🩸',1,1,1,'probabilità di recuperare 1 vita quando colpisci'],\\\\n ['spine','Spine','🌵',2,0,2,'danno a chi ti colpisce'],\\\\n ['rotazione','Giri','🌀',100,1,10,'velocità delle armi che girano intorno a te'],\\\\n ['spinta','Spinta','🤜',100,1,10,'quanto lontano spingi i nemici'],\\\\n ['perforazione','Perforazione','🗡️',1,0,.5,'nemici in più trapassati dai proiettili'],\\\\n ['durata','Durata','⏳',100,1,8,'quanto durano veleno, fuoco, gelo e scudi'],\\\\n ['area','Area','🌐',100,1,6,'grandezza di esplosioni, aure e giri'],\\\\n ['proiettili','Proiettili','🔁',1,0,.25,'proiettili in più per ogni colpo'],\\\\n ['coraggio','Coraggio','🦁',5,1,3,'danno in più quando hai meno di metà vita (×2)'],\\\\n ['resistenza','Resistenza','🧱',5,1,4,'meno danni da veleno, fuoco e gelo'],\\\\n ['riflessi','Riflessi','🐱',100,1,10,'quanto resti intoccabile dopo un colpo'],\\\\n ['ricchezza','Ricchezza','🪙',5,1,3,'probabilità di una moneta in più a fine livello'],\\\\n ['mira','Mira','➶',100,1,8,'velocità dei proiettili']];\\\\nconst PK=Object.fromEntries(PARAMS.map(p=>[p[0],p]));\\\\nconst pName=k=>PK[k]?PK[k][1]:k,pPct=k=>PK[k]?PK[k][4]:0;\\\\n/* valore attuale: (partenza + carte + oggetti) × (1 + 0,25% per livello di esperienza) */\\\\nfunction stv(k){const p=PK[k];if(!p)return 0;return(p[3]+(A.st[k]||0))*(1+.0025*((A.lvl||1)-1));}\\\\nconst sm=k=>stv(k)/PK[k][3];\\\\nfunction modsHtml(m){return Object.entries(m).map(([k,v])=>numH(v,pPct(k)?'%':'')+' '+pName(k)).join('<br>');}\\\\n\\\\n/* ===================== 100 OGGETTI (con pro e contro) ===================== */\\\\nconst ITEMS_RAW=[\\\\n ['Scarpe da corsa','👟',1,{agilita:10,forza:-1}],['Pane della mensa','🍞',1,{vita:6,agilita:-2}],['Chiave della cella','🗝️',1,{agilita:6,fortuna:2}],\\\\n ['Catena spezzata','⛓️',1,{forza:2,agilita:-4}],['Candela','🕯️',1,{vista:10,udito:-5}],['Stivali della ronda','🥾',1,{agilita:6,schivata:2,vita:-2}],\\\\n ['Documento segreto','📜',1,{esperienza:10,armatura:-1}],['Munizioni','🧨',1,{destrezza:2,mira:-4}],['Pennacchio rosso','🪶',1,{velatt:6,armatura:-1}],\\\\n ['Formaggio dei ratti','🧀',1,{rigenerazione:1,agilita:-3}],['Cucchiaio scavatore','🥄',1,{fortuna:4,forza:-1}],['Corno da caccia','📯',1,{udito:15,schivata:-1}],\\\\n ['Lente d\\\\\\\\'ingrandimento','🔍',1,{vista:12,area:-4}],['Guanti di cuoio','🧤',1,{forza:1,velatt:3}],['Sasso portafortuna','🪨',1,{fortuna:6,agilita:-3}],\\\\n ['Mela rossa','🍎',1,{vita:4,rigenerazione:.5,spine:-1}],['Fionda','🪀',1,{destrezza:1,mira:8,forza:-1}],['Calamita','🧲',1,{raccolta:25,agilita:-2}],\\\\n ['Ago e filo','🪡',1,{armatura:1,velatt:-2}],['Cappuccio del ladro','🎭',1,{schivata:3,vita:-3}],['Ciotola di zuppa','🥣',1,{vita:5,velatt:-2}],\\\\n ['Corda','🪢',1,{portata:6,agilita:-2}],['Clessidra rotta','⌛',1,{durata:10,velatt:-3}],['Spilla del soldato','📍',1,{coraggio:4,armatura:-1}],\\\\n ['Monocolo','🧐',1,{critico:2,vista:-5}],\\\\n ['Cotta di maglia','🥋',2,{armatura:3,agilita:-6}],['Mantello della notte','🧥',2,{schivata:6,vita:-4}],['Vino del re','🍷',2,{furto:3,forza:2,schivata:-2}],\\\\n ['Sigillo del mercante','💍',2,{fortuna:12,ricchezza:5,armatura:-1}],['Pietra per affilare','🔪',2,{forza:3,critico:3,velatt:-3}],['Polvere da sparo','💥',2,{destrezza:3,area:8,vita:-4}],\\\\n ['Pergamena antica','📖',2,{magia:3,durata:8,agilita:-3}],['Scudo dello scudiero','🛡️',2,{armatura:2,vita:6,velatt:-4}],['Campana del campanile','🔔',2,{velatt:10,udito:-10}],\\\\n ['Borsa del banchiere','👛',2,{ricchezza:8,fortuna:5,forza:-1}],['Arco corto','🏹',2,{destrezza:3,velatt:4,portata:-6}],['Bacchetta di betulla','🪄',2,{magia:3,area:5,vita:-3}],\\\\n ['Collana di denti','🦷',2,{spine:5,critico:2,fortuna:-3}],['Elmo ammaccato','⛑️',2,{armatura:2,riflessi:10,vista:-6}],['Erba medica','🌿',2,{rigenerazione:1.5,resistenza:5,forza:-1}],\\\\n ['Ventaglio','🪭',2,{schivata:4,agilita:4,armatura:-1}],['Bussola','🧭',2,{vista:10,udito:10,critico:-1}],['Lanterna','🏮',2,{magia:2,vista:8,schivata:-2}],\\\\n ['Martello del fabbro','🔨',2,{forza:4,agilita:-6}],['Bende','🩹',2,{rigenerazione:1,vita:4,velatt:-3}],['Frecce d\\\\\\\\'argento','🪶',2,{perforazione:.5,destrezza:1,velatt:-3}],\\\\n ['Ruota del mulino','🎡',2,{rotazione:15,forza:-1}],['Fune da arrampicata','🧗',2,{agilita:8,vita:-3}],['Specchietto','🪞',2,{spine:4,schivata:2,vita:-3}],\\\\n ['Tamburello','🪘',2,{velatt:7,coraggio:3,armatura:-2}],['Pozione blu','🧴',2,{magia:2,esperienza:8,vita:-3}],['Chiodi','📌',2,{spine:6,agilita:-4}],\\\\n ['Stemma della guardia','🎖️',2,{armatura:2,coraggio:4,fortuna:-3}],['Zaino','🎒',2,{raccolta:20,vita:4,agilita:-4}],['Ampolla di olio','🫙',2,{durata:12,area:4,critico:-2}],\\\\n ['Ritratto della galleria','🖼️',3,{forza:3,destrezza:3,magia:3,armatura:-2}],['Elmo del cavaliere','🪖',3,{armatura:5,vita:10,agilita:-8}],['Fiala di veleno','🧪',3,{critico:6,durata:15,vita:-5}],\\\\n ['Cappuccio dell\\\\\\\\'assassino','🥷',3,{schivata:8,critico:5,vita:-8}],['Tamburo di guerra','🥁',3,{velatt:14,forza:2,armatura:-2}],['Lanterna magica','🪔',3,{magia:5,rigenerazione:1.5,agilita:-4}],\\\\n ['Diamante grezzo','💎',3,{fortuna:15,esperienza:10,armatura:-2}],['Bracciale d\\\\\\\\'oro','📿',3,{fortuna:10,furto:3,agilita:-4}],['Elsa d\\\\\\\\'argento','🗡️',3,{forza:5,dannocrit:20,velatt:-6}],\\\\n ['Mirino del cacciatore','🔭',3,{destrezza:5,portata:15,schivata:-3}],['Grimorio','📕',3,{magia:6,area:10,vita:-8}],['Cuore di leone','🦁',3,{coraggio:12,vita:8,schivata:-3}],\\\\n ['Ragnatela d\\\\\\\\'oro','🕸️',3,{durata:20,perforazione:.5,agilita:-5}],['Piuma di fenice','🔥',3,{rigenerazione:2,riflessi:20,armatura:-2}],['Occhio di falco','🦅',3,{vista:20,critico:4,vita:-5}],\\\\n ['Orecchie di volpe','🦊',3,{udito:25,schivata:5,forza:-2}],['Stivali alati','🪽',3,{agilita:15,schivata:4,armatura:-3}],['Cintura del campione','🥇',3,{forza:3,vita:12,fortuna:-5}],\\\\n ['Lama gemella','⚔️',3,{proiettili:.5,velatt:5,forza:-2}],['Torcia eterna','🎇',3,{area:12,magia:3,resistenza:-5}],['Corazza di spine','🌵',3,{spine:12,armatura:3,agilita:-8}],\\\\n ['Mappa del tesoro','🗺️',3,{ricchezza:12,fortuna:10,vita:-6}],['Fischietto','🎶',3,{velatt:8,spinta:20,forza:-2}],['Ferro di cavallo','🧿',3,{fortuna:12,critico:3,magia:-2}],\\\\n ['Clessidra d\\\\\\\\'argento','⏱️',3,{durata:25,rotazione:10,agilita:-5}],\\\\n ['Corona del re','👑',4,{forza:5,destrezza:5,magia:5,vita:15,agilita:-10}],['Armatura incantata','🗿',4,{armatura:8,rigenerazione:3,schivata:-5}],['Pezzo del trono','🪑',4,{vita:35,rigenerazione:3,agilita:-12}],\\\\n ['Lama del Boia del Re','🪓',4,{forza:10,critico:10,velatt:-10}],['Mappa della torre','🧾',4,{agilita:15,portata:25,vista:20,armatura:-3}],['Cuore della torre','🫀',4,{furto:8,vita:20,resistenza:-10}],\\\\n ['Forziere del drago','🧰',4,{ricchezza:20,fortuna:25,armatura:-4}],['Occhio del mago','🔮',4,{magia:10,area:20,vita:-12}],['Arco del re','🎯',4,{destrezza:10,perforazione:1,velatt:-8}],\\\\n ['Scettro del tempo','⏳',4,{velatt:20,durata:20,vita:-10}],['Scudo d\\\\\\\\'oro','🏅',4,{armatura:6,spine:15,agilita:-10}],['Pendolo ipnotico','🌗',4,{rotazione:30,area:15,forza:-3}],\\\\n ['Anello del vampiro','🦇',4,{furto:12,critico:5,rigenerazione:-2}],['Mantello dell\\\\\\\\'ombra','🌑',4,{schivata:15,riflessi:30,vita:-12}],['Gemma del destino','🌟',4,{fortuna:30,esperienza:20,armatura:-5}],\\\\n ['Stendardo del re','🚩',4,{coraggio:20,forza:5,vita:10,schivata:-5}],['Faretra infinita','🪹',4,{proiettili:1,destrezza:3,velatt:-12}],['Calice d\\\\\\\\'oro','🏆',4,{rigenerazione:4,vita:15,agilita:-8}],\\\\n ['Ali di pipistrello','🦋',4,{agilita:20,schivata:8,armatura:-6}],['Lingotto maledetto','🧱',4,{ricchezza:30,forza:5,vita:-20}]];\\\\nconst ITEMS=ITEMS_RAW.map((x,i)=>({id:'o'+i,n:x[0],ic:x[1],r:x[2],m:x[3]}));\\\\nconst ITB=Object.fromEntries(ITEMS.map(i=>[i.id,i]));\\\\n\\\\n/* ===================== 30 OGGETTI DEI BOSS (permanenti) ===================== */\\\\nconst RELICS=[\\\\n {id:'r0',n:'Moneta del Mercante',ic:'🪙',m:{fortuna:8,ricchezza:5}},{id:'r1',n:'Libro mastro del Banchiere',ic:'📒',m:{esperienza:12}},\\\\n {id:'r2',n:'Bilancino dell\\\\\\\\'Usuraio',ic:'⚖️',m:{critico:4,dannocrit:15}},{id:'r3',n:'Timbro dell\\\\\\\\'Esattore',ic:'🔏',m:{armatura:2,vita:8}},\\\\n {id:'r4',n:'Lente della Gioielliera',ic:'🔎',m:{vista:15,critico:3}},{id:'r5',n:'Grimaldello del Re dei Ladri',ic:'🗝️',m:{agilita:10,schivata:4}},\\\\n {id:'r6',n:'Bandana del Pirata',ic:'🏴‍☠️',m:{forza:3,coraggio:8}},{id:'r7',n:'Zoccolo del Diavolo',ic:'😈',m:{spine:8,resistenza:8}},\\\\n {id:'r8',n:'Moneta infernale',ic:'🔴',m:{magia:3,area:8}},{id:'r9',n:'Scheggia del Golem d\\\\\\\\'Oro',ic:'🟡',m:{armatura:4,vita:12}},\\\\n {id:'r10',n:'Pietra filosofale',ic:'🟣',m:{rigenerazione:2,durata:12}},{id:'r11',n:'Vetrina del Collezionista',ic:'🗃️',m:{raccolta:30,fortuna:6}},\\\\n {id:'r12',n:'Chiave della Tesoreria',ic:'🔑',m:{ricchezza:10,vita:6}},{id:'r13',n:'Abaco del Cambiavalute',ic:'🧮',m:{velatt:10}},\\\\n {id:'r14',n:'Mantello del Contrabbandiere',ic:'🧣',m:{schivata:6,riflessi:20}},{id:'r15',n:'Boccale dell\\\\\\\\'Oste',ic:'🍺',m:{vita:15,rigenerazione:1}},\\\\n {id:'r16',n:'Contratto del Patto',ic:'📃',m:{forza:3,destrezza:3,magia:3}},{id:'r17',n:'Scaglia del Drago',ic:'🐲',m:{armatura:3,resistenza:12,spine:5}},\\\\n {id:'r18',n:'Diadema delle Gemme',ic:'💠',m:{magia:5,esperienza:8}},{id:'r19',n:'Corno di Mammona',ic:'🦬',m:{forza:5,spinta:20}},\\\\n /* armi dei boss: con te all'inizio di ogni partita */\\\\n {id:'r20',n:'Spada d\\\\\\\\'oro del Mercante',ic:'🗡️',w:'b_spada'},{id:'r21',n:'Bilancia del Banchiere',ic:'⚖️',w:'b_bilancia'},\\\\n {id:'r22',n:'Forcone del Diavolo',ic:'🔱',w:'b_forcone'},{id:'r23',n:'Sacco senza fondo',ic:'💰',w:'b_sacco'},\\\\n {id:'r24',n:'Corona di fulmini',ic:'👑',w:'b_corona'},{id:'r25',n:'Draghetto del tesoro',ic:'🐉',w:'b_drago'},\\\\n {id:'r26',n:'Anello dell\\\\\\\\'Usuraio',ic:'💍',w:'b_anello'},{id:'r27',n:'Monete rotanti',ic:'🪙',w:'b_monete'},\\\\n {id:'r28',n:'Specchio della Gioielliera',ic:'🪞',w:'b_specchio'},{id:'r29',n:'Clessidra d\\\\\\\\'oro',ic:'⌛',w:'b_clessidra'}];\\\\nconst RLB=Object.fromEntries(RELICS.map(r=>[r.id,r]));\\\\n\\\\n/* ===================== 35 ARMI NUOVE (le altre 15 sono in arena.js) =====================\\\\n   tipi: orbit (girano intorno), shield (scudo che compare), whip (frusta ai lati), lob (bomba ad arco), boomerang,\\\\n   chain (fulmine che salta), rain (dal cielo), beam (raggio), bounce (rimbalza sui muri), cone (soffio), mine, trail (scia),\\\\n   aura (danno intorno), nova (onda), summon (alleato), turret (torretta), pulse (cura e spinta), mark (maledizione),\\\\n   thrust (affondo), spread (ventaglio), homing (missili), smash (martello dal cielo), tornado */\\\\nconst WX={\\\\n lame:{n:'Lame rotanti',ic:'🌀',k:'orbit',st:'forza',dmg:8,cd:0,cnt:2,rad:38,spd:3,d:'Due lame girano intorno a te e tagliano chi tocchi.'},\\\\n scudo:{n:'Scudo del cavaliere',ic:'🛡️',k:'shield',st:'forza',dmg:0,cd:7,cnt:1,d:'Ogni tanto compare uno scudo: blocca un colpo intero.'},\\\\n frusta:{n:'Frusta del carceriere',ic:'⛓️',k:'whip',st:'forza',dmg:14,cd:1.3,rng:80,d:'Frusta a destra e a sinistra insieme.'},\\\\n bombe:{n:'Candelotti di dinamite',ic:'🧨',k:'lob',st:'destrezza',dmg:18,cd:1.8,rng:200,rad:44,d:'Lancia una bomba che esplode sul nemico.'},\\\\n boomerang:{n:'Boomerang',ic:'🪃',k:'boomerang',st:'destrezza',dmg:10,cd:1.4,rng:170,spd:260,d:'Va e torna: colpisce due volte.'},\\\\n fulmine:{n:'Fulmine a catena',ic:'⚡',k:'chain',st:'magia',dmg:11,cd:1.6,rng:200,cnt:3,d:'Il fulmine salta da un nemico all\\\\\\\\'altro.'},\\\\n meteore:{n:'Pioggia di meteore',ic:'☄️',k:'rain',st:'magia',dmg:20,cd:2.6,cnt:3,rad:30,d:'Meteore cadono dal cielo sui nemici.'},\\\\n raggio:{n:'Raggio del sole',ic:'☀️',k:'beam',st:'magia',dmg:6,cd:2.2,rng:230,d:'Un raggio di luce brucia tutto sulla sua linea.'},\\\\n palla:{n:'Palla rimbalzante',ic:'🥎',k:'bounce',st:'destrezza',dmg:9,cd:1.7,spd:240,d:'Rimbalza sui muri e colpisce chi incontra.'},\\\\n soffio:{n:'Soffio di fuoco',ic:'🔥',k:'cone',st:'magia',dmg:4,cd:1.9,rng:90,burn:1,d:'Fiamme davanti a te: i nemici bruciano.'},\\\\n mina:{n:'Mina di polvere',ic:'💣',k:'mine',st:'destrezza',dmg:26,cd:2.4,rad:46,cnt:4,d:'Lascia una mina: esplode quando passa un nemico.'},\\\\n scia:{n:'Scia di fuoco',ic:'🕯️',k:'trail',st:'magia',dmg:4,cd:.35,rad:16,burn:1,d:'Dove corri resta il fuoco.'},\\\\n gelo:{n:'Aura di gelo',ic:'❄️',k:'aura',st:'magia',dmg:3,cd:.5,rad:55,slow:1,d:'Il freddo intorno a te rallenta e ferisce.'},\\\\n onda:{n:'Onda d\\\\\\\\'urto',ic:'💥',k:'nova',st:'forza',dmg:12,cd:3,rad:90,kb:3,d:'Un\\\\\\\\'onda respinge tutti lontano da te.'},\\\\n cane:{n:'Cane fedele',ic:'🐕',k:'summon',st:'forza',dmg:9,cd:.8,cnt:1,d:'Un cane da guardia combatte con te.'},\\\\n torre:{n:'Torretta',ic:'🗼',k:'turret',st:'destrezza',dmg:7,cd:5,cnt:2,rng:200,d:'Costruisce torrette che sparano da sole.'},\\\\n campana:{n:'Campana sacra',ic:'🔔',k:'pulse',st:'magia',dmg:5,cd:6,rad:80,heal:3,d:'Suona: ti cura e respinge i nemici vicini.'},\\\\n occhio:{n:'Occhio maledetto',ic:'🧿',k:'mark',st:'magia',dmg:0,cd:4,cnt:3,d:'Maledice 3 nemici: prendono il 50% di danni in più.'},\\\\n tridente:{n:'Tridente',ic:'🔱',k:'thrust',st:'forza',dmg:16,cd:1.2,rng:110,d:'Affondo lungo che trapassa tutta la fila.'},\\\\n ventaglio:{n:'Pugnali a ventaglio',ic:'🔪',k:'spread',st:'destrezza',dmg:6,cd:1.3,rng:170,cnt:5,spd:380,d:'Cinque pugnali a ventaglio.'},\\\\n missili:{n:'Missili magici',ic:'💫',k:'homing',st:'magia',dmg:8,cd:1.5,rng:240,cnt:3,spd:200,d:'Tre missili che inseguono i nemici.'},\\\\n nube:{n:'Nube velenosa',ic:'🍄',k:'aura',st:'magia',dmg:2,cd:.5,rad:65,poison:1,d:'Spore velenose intorno a te.'},\\\\n lune:{n:'Sfere lunari',ic:'🌙',k:'orbit',st:'magia',dmg:6,cd:0,cnt:3,rad:58,spd:2,slow:1,d:'Tre lune ti girano attorno e rallentano.'},\\\\n martello:{n:'Martello del tuono',ic:'🔨',k:'smash',st:'forza',dmg:30,cd:2.8,rad:40,stun:1,d:'Un martello cade dal cielo e stordisce.'},\\\\n vortice:{n:'Vortice',ic:'🌪️',k:'tornado',st:'magia',dmg:5,cd:3.2,spd:90,d:'Un tornado lento che colpisce tante volte.'},\\\\n /* armi dei boss */\\\\n b_spada:{n:'Spada d\\\\\\\\'oro del Mercante',ic:'🗡️',k:'orbit',st:'forza',dmg:22,cd:0,cnt:1,rad:52,spd:2.4,boss:1,d:'Una grande spada d\\\\\\\\'oro ti gira attorno.'},\\\\n b_bilancia:{n:'Bilancia del Banchiere',ic:'⚖️',k:'nova',st:'magia',dmg:0,pct:.08,cd:4,rad:120,boss:1,d:'Toglie l\\\\\\\\'8% della vita a tutti i nemici vicini.'},\\\\n b_forcone:{n:'Forcone del Diavolo',ic:'😈',k:'thrust',st:'forza',dmg:24,cd:1.1,rng:130,burn:1,boss:1,d:'Affondo infuocato che trapassa tutti.'},\\\\n b_sacco:{n:'Sacco senza fondo',ic:'💰',k:'lob',st:'destrezza',dmg:22,cd:2,rng:220,rad:50,shards:8,boss:1,d:'Esplode in una pioggia di monete taglienti.'},\\\\n b_corona:{n:'Corona di fulmini',ic:'👑',k:'chain',st:'magia',dmg:16,cd:1.4,rng:240,cnt:6,boss:1,d:'Fulmine che salta su 6 nemici.'},\\\\n b_drago:{n:'Draghetto del tesoro',ic:'🐉',k:'summon',st:'magia',dmg:12,cd:1.2,cnt:1,fire:1,boss:1,d:'Un draghetto vola con te e sputa fuoco.'},\\\\n b_anello:{n:'Anello dell\\\\\\\\'Usuraio',ic:'💍',k:'aura',st:'magia',dmg:5,cd:.5,rad:70,steal:1,boss:1,d:'Ruba vita a chi ti sta vicino.'},\\\\n b_monete:{n:'Monete rotanti',ic:'🪙',k:'orbit',st:'destrezza',dmg:9,cd:0,cnt:6,rad:46,spd:3.5,boss:1,d:'Sei monete d\\\\\\\\'oro ti girano veloci attorno.'},\\\\n b_specchio:{n:'Specchio della Gioielliera',ic:'🪞',k:'shield',st:'magia',dmg:20,cd:5,cnt:2,reflect:1,boss:1,d:'Scudo che blocca un colpo e lo rimanda con un raggio.'},\\\\n b_clessidra:{n:'Clessidra d\\\\\\\\'oro',ic:'⌛',k:'pulse',st:'magia',dmg:8,cd:8,rad:400,heal:5,freeze:1,boss:1,d:'Ferma il tempo: tutti i nemici rallentano per 3 secondi.'}};\\\\nconst WLV=[1,1.5,2.2,3.2];\\\\n/* icone anche per le 15 armi di KING TOWER */\\\\nconst WICON={mace:'🏏',sword:'⚔️',spear:'📍',axe:'🪓',halberd:'⚜️',gold:'🏆',cane:'🦯',pistol:'🔫',rifle:'🎯',crossbow:'➶',bow:'🏹',dagger:'✴️',staff:'🪄',flask:'🧪',horn:'📯'};\\\\nfunction wIcon(id){return WX[id]?WX[id].ic:WICON[id]||'⚔️';}\\\\nfunction wName(id){return WX[id]?WX[id].n:WP[id].n;}\\\\nfunction wCls(id){return WX[id]?WX[id].st:({melee:'forza',ranged:'destrezza',magic:'magia'})[WP[id].cls];}\\\\nfunction wDescCard(id,t){if(!WX[id]){const wp=WP[id];return wp.d+'<br>Danno <b>'+wp.dmg[t]+'</b> × '+pName(wCls(id)).toLowerCase()+'<br>Ogni '+wp.cd[t].toFixed(2)+' s · portata '+wp.rng+'<br>Critico '+wp.crit[0]+'%'+(wp.pierce?' · trapassa '+wp.pierce:'')+(wp.stun?' · stordisce':'')+(wp.poison?' · veleno':'');}\\\\n  const w=WX[id],L=WLV[t];const p=[w.d];\\\\n  if(w.dmg)p.push('Danno <b>'+Math.round(w.dmg*L)+'</b> × '+pName(w.st).toLowerCase());if(w.pct)p.push('Toglie <b>'+Math.round(w.pct*L*100)+'%</b> della vita');\\\\n  if(w.cd)p.push((w.k==='orbit'||w.k==='aura'||w.k==='trail'?'Colpisce ogni ':'Ogni ')+w.cd+' s');if(w.cnt)p.push('Quantità: <b>'+(w.cnt+(t>=2?1:0))+'</b>');\\\\n  if(w.rad)p.push('Raggio '+w.rad);if(w.rng)p.push('Portata '+w.rng);\\\\n  const fx=[w.burn&&'fuoco',w.poison&&'veleno',w.slow&&'rallenta',w.stun&&'stordisce',w.kb&&'spinge',w.heal&&'cura '+w.heal,w.steal&&'ruba vita',w.reflect&&'rimanda il colpo',w.freeze&&'ferma il tempo'].filter(Boolean);\\\\n  if(fx.length)p.push(fx.join(' · '));return p.join('<br>');}\\\\n\\\\n/* ===================== CARTE ===================== */\\\\nfunction rollCards(){const out=[],seen=new Set();\\\\n  for(let i=0;i<3;i++){let c=null;for(let k=0;k<12&&(!c||seen.has(c.key));k++){const r=Math.random();\\\\n      if(r<.15)c=weaponCard();if(!c||r>=.15&&r<.75)c=statCard();else if(r>=.75)c=itemCard();}\\\\n    seen.add(c.key);out.push(c);}return out;}\\\\nfunction weaponCard(){const own=A.weapons;const t=tierRoll();\\\\n  const up=own.filter(w=>w.tier<3);if(own.length>=6&&!up.length)return null;\\\\n  if(own.length>=6||(up.length&&Math.random()<.4)){const w=pick(up);return{type:'w',id:w.id,up:true,tier:w.tier+1,key:'w'+w.id};}\\\\n  const pool=[...Object.keys(WP),...Object.keys(WX).filter(k=>!WX[k].boss)].filter(id=>!own.some(w=>w.id===id));\\\\n  if(!pool.length)return null;const id=pick(pool);return{type:'w',id,tier:0,key:'w'+id};}\\\\nfunction statCard(){const k=pick(PARAMS)[0],t=tierRoll(),v=Math.round(PK[k][5]*[1,2,3,5][t]*100)/100;return{type:'s',k,v,t,key:'s'+k};}\\\\nfunction itemCard(){const t=tierRoll();const pool=ITEMS.filter(i=>i.r-1===t);const it=pick(pool.length?pool:ITEMS);return{type:'i',id:it.id,t:it.r-1,key:'i'+it.id};}\\\\nfunction relicCards(){const ids=RELICS.map(r=>r.id).filter(id=>(AS.relics[id]|0)<3).sort(()=>Math.random()-.5).slice(0,3);return ids.map(id=>({type:'r',id,key:'r'+id}));}\\\\nfunction cardHtml(c,i){let ic,nm,tp,ds,t=0;\\\\n  if(c.type==='w'){t=c.tier;ic=wIcon(c.id);nm=wName(c.id);tp=c.up?'Arma · sale a '+TIER[c.tier]:'Arma nuova';ds=wDescCard(c.id,c.tier);}\\\\n  else if(c.type==='s'){t=c.t;ic=PK[c.k][2];nm=PK[c.k][1];tp='Potenziamento · '+TIER[c.t];ds=numH(c.v,pPct(c.k)?'%':'')+' '+PK[c.k][1]+'<br><span class=\\\\\\\"small\\\\\\\">'+PK[c.k][6]+'</span>';}\\\\n  else if(c.type==='i'){const it=ITB[c.id];t=c.t;ic=it.ic;nm=it.n;tp='Oggetto · '+TIER[t];ds=modsHtml(it.m);}\\\\n  else{const r=RLB[c.id];t=3;ic=r.ic;nm=r.n;tp='Oggetto del boss · PERMANENTE'+(AS.relics[c.id]?' (ne hai '+AS.relics[c.id]+')':'');ds=r.w?'Arma che hai all\\\\\\\\'inizio di ogni partita.<br>'+wDescCard(r.w,Math.min(3,AS.relics[c.id]|0)):modsHtml(r.m)+'<br><span class=\\\\\\\"small\\\\\\\">Vale in tutte le partite.</span>';}\\\\n  return`<div class=\\\\\\\"card b${t}\\\\\\\"><div class=\\\\\\\"ic\\\\\\\">${ic}</div><div class=\\\\\\\"nm t${t}\\\\\\\">${nm}</div><div class=\\\\\\\"small\\\\\\\">${tp}</div><div class=\\\\\\\"ds\\\\\\\">${ds}</div><button data-i=\\\\\\\"${i}\\\\\\\">Scegli</button></div>`;}\\\\nfunction takeCard(c){\\\\n  if(c.type==='w'){if(c.up){const w=A.weapons.find(w=>w.id===c.id);if(w)w.tier=Math.min(3,w.tier+1);}else if(A.weapons.length<6)A.weapons.push(mkW(c.id,0));}\\\\n  else if(c.type==='s')A.st[c.k]=(A.st[c.k]||0)+c.v;\\\\n  else if(c.type==='i')giveItem(c.id);\\\\n  else{AS.relics[c.id]=(AS.relics[c.id]|0)+1;const r=RLB[c.id];if(r.m)addMods(r.m);else{const w=A.weapons.find(x=>x.id===r.w);if(w)w.tier=Math.min(3,w.tier+1);else if(A.weapons.length<6)A.weapons.push(mkW(r.w,0));else{A.weapons[A.weapons.length-1]=mkW(r.w,0);}}asSave();}\\\\n  A.p.hp=Math.min(A.p.hp,maxHp());}\\\\n/* apre le carte: kind 'bonus' (ogni 5 livelli) o 'boss' */\\\\nfunction openCards(kind,done){A.state='cards';A.cardKind=kind;A.cardDone=done;A.cards=kind==='boss'?relicCards():rollCards();\\\\n  if(!A.cards.length){A.state='play';if(done)done();return;}\\\\n  $('#lv-t').textContent=kind==='boss'?'Hai sconfitto '+(A.lastBoss||'il boss')+'!':'Sei arrivato al livello bonus!';\\\\n  $('#lv-sub').textContent=kind==='boss'?'Scegli un oggetto del boss: è tuo per sempre.':'Livello '+A.lvl+' · scegli una carta';\\\\n  $('#lv-cards').innerHTML=A.cards.map(cardHtml).join('');$('#lv-roll').style.display='none';\\\\n  $$('#lv-cards button').forEach(b=>b.onclick=()=>{const c=A.cards[+b.dataset.i];takeCard(c);sfx(c.type==='r'?'unlock':'buy');A.setB=setBonus();\\\\n    showOv(null);A.state='play';const d=A.cardDone;A.cardDone=null;if(d)d();});\\\\n  showOv('lvup');sfx('lvl');\\\\n  if(window.ARENA_BOT)setTimeout(()=>{const b=$$('#lv-cards button')[0];if(b&&A.state==='cards')b.click();},30);}\\\\n\\\\n/* ===================== MOTORE DELLE ARMI NUOVE ===================== */\\\\nfunction emojiSpr(ic,sz){return tSpr('em|'+ic+'|'+sz,sz,sz,g=>{g.font=(sz*.8)+'px \\\\\\\"Segoe UI Emoji\\\\\\\",\\\\\\\"Apple Color Emoji\\\\\\\",\\\\\\\"Noto Color Emoji\\\\\\\",serif';g.textAlign='center';g.textBaseline='middle';g.fillText(ic,sz/2,sz/2+sz*.05);});}\\\\nfunction xDmg(w){const d=WX[w.id];let v=d.dmg*WLV[w.tier]*sm(d.st);if(A.p.hp<maxHp()/2)v*=1+stv('coraggio')*2/100;return Math.max(1,v);}\\\\nfunction xCrit(){return Math.random()*100<stv('critico');}\\\\nfunction xHit(e,w,dmg,o){if(e.dead)return;const d=WX[w.id];o=o||{};let c=xCrit();let v=dmg*(c?stv('dannocrit')/100:1);\\\\n  if(e.mark>0)v*=1.5;if(d.pct&&!e.crate)v=Math.max(v,e.max*d.pct*WLV[w.tier]*(e.boss?.25:1));\\\\n  hitEnemy(e,v,c,{kb:(d.kb||1)*4,n:d.n,stun:d.stun?.8:0,poison:d.poison?1:0,burn:d.burn?1:0,slow:d.slow?1:0},o.x==null?A.p.x:o.x,o.y==null?A.p.y:o.y);\\\\n  if(d.steal&&Math.random()<.3&&A.p.hp<maxHp()){A.p.hp=Math.min(maxHp(),A.p.hp+1);}}\\\\nfunction inR(x,y,r,f){for(const e of A.en){if(e.dead||e.entT>0)continue;if(Math.hypot(e.x-x,e.y-8-y)<r+e.r)f(e);}}\\\\nfunction aimR(r){return r*stv('vista')/100;}\\\\nfunction updX(w,dt){const d=WX[w.id],p=A.p,cnt=(d.cnt||1)+(w.tier>=2?1:0),cd=d.cd/Math.max(.3,stv('velatt')/100),AR=stv('area')/100;\\\\n  w.t=(w.t||0)+dt;w.cd-=dt;w.hx=p.x;w.hy=p.y-14;\\\\n  switch(d.k){\\\\n    case'orbit':{w.ang=(w.ang||0)+dt*d.spd*stv('rotazione')/100;w.hitT=w.hitT||new Map();const R=d.rad*AR;\\\\n      for(let i=0;i<cnt;i++){const a=w.ang+i*6.283/cnt,x=p.x+Math.cos(a)*R,y=p.y-12+Math.sin(a)*R*.7;\\\\n        inR(x,y+8,10,e=>{const k=w.hitT.get(e)||0;if(A.t-k>.4){w.hitT.set(e,A.t);xHit(e,w,xDmg(w),{x:p.x,y:p.y});}});}\\\\n      if(w.hitT.size>300)w.hitT.clear();break;}\\\\n    case'shield':{w.ch=w.ch==null?cnt:w.ch;if(w.ch<cnt&&w.cd<=0){w.ch++;w.cd=cd*stv('durata')/100;sfx('block');}break;}\\\\n    case'aura':{if(w.cd<=0){w.cd=d.cd;inR(p.x,p.y,d.rad*AR,e=>{xHit(e,w,xDmg(w));if(d.slow)e.slowT=1;});}break;}\\\\n    case'trail':{if(w.cd<=0&&p.moving){w.cd=d.cd;A.pud.push({x:p.x,y:p.y,r:d.rad*AR,t:2*stv('durata')/100,mine:w,c:'rgba(255,120,30,.32)',tick:0});}break;}\\\\n    case'mine':{if(w.cd<=0){w.cd=cd;if(A.pud.filter(q=>q.mineOf===w).length<cnt)A.pud.push({x:p.x,y:p.y,r:8,t:30,mineOf:w,c:'rgba(0,0,0,0)'});}\\\\n      for(const q of A.pud)if(q.mineOf===w&&!q.boom){let hit=false;inR(q.x,q.y,14,()=>hit=true);if(hit){q.boom=1;q.t=0;addFx({k:'ring',x:q.x,y:q.y,t:.35,r:d.rad*AR,c:'#ff8a2a'});sfx('boom');inR(q.x,q.y,d.rad*AR,e=>xHit(e,w,xDmg(w),{x:q.x,y:q.y}));}}break;}\\\\n    default:if(MANUAL[d.k]&&!window.ARENA_BOT)break;if(w.cd<=0){const tg=nearest(p.x,p.y-12,aimR(d.rng||220));if(!tg&&!['nova','pulse','summon','turret','rain','tornado','whip','bounce'].includes(d.k))break;w.cd=cd;xFire(w,d,tg,cnt,AR);}\\\\n  }\\\\n  if(d.k==='summon')updAllies(w,dt,cnt);if(d.k==='turret')for(const t of(w.tur||[])){t.t-=dt;t.cd-=dt;if(t.cd<=0){const e=nearest(t.x,t.y-10,d.rng);if(e){t.cd=.9;xShoot(w,t.x,t.y-14,e,1,300);}}}\\\\n  if(w.tur)w.tur=w.tur.filter(t=>t.t>0);\\\\n}\\\\nfunction xShoot(w,x,y,tg,n,spd,o){const a0=Math.atan2(tg.y-12-y,tg.x-x),sp=spd*stv('mira')/100;n=n+Math.floor(stv('proiettili')-1)+(Math.random()<(stv('proiettili')%1)?1:0);\\\\n  for(let i=0;i<n;i++){const a=a0+(i-(n-1)/2)*.18;A.proj.push(Object.assign({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,dmg:xDmg(w),crit:false,wp:{kb:4},xw:w,k:'emoji',ic:WX[w.id].ic,life:1.6,pierce:Math.floor(stv('perforazione')-1),hit:new Set(),r:6},o||{}));}}\\\\nfunction xFire(w,d,tg,cnt,AR){const p=A.p;sfx('magic',.6);\\\\n  switch(d.k){\\\\n    case'whip':for(const s of[-1,1]){addFx({k:'arc',x:p.x,y:p.y-14,t:.25,r:d.rng*AR,a:s>0?0:Math.PI,c:'#c8a070'});inR(p.x+s*d.rng*AR/2,p.y-6,d.rng*AR/2,e=>xHit(e,w,xDmg(w)));}break;\\\\n    case'lob':A.eproj.length;A.proj.push({k:'emoji',ic:d.ic,lob:1,sx:p.x,sy:p.y-14,tx:tg.x,ty:tg.y,age:0,dur:.6,x:p.x,y:p.y,xw:w,dmg:xDmg(w),hit:new Set(),wp:{},life:2});break;\\\\n    case'boomerang':xShoot(w,p.x,p.y-14,tg,1,d.spd,{boom:1,life:1.4,pierce:99});break;\\\\n    case'chain':{let cur=tg,done=new Set();let px_=p.x,py_=p.y-14;for(let i=0;i<cnt&&cur;i++){done.add(cur);addFx({k:'bolt',x:px_,y:py_,x2:cur.x,y2:cur.y-12,t:.2,c:'#9ae0ff'});xHit(cur,w,xDmg(w)*(1-i*.1),{x:px_,y:py_});px_=cur.x;py_=cur.y-12;\\\\n        let nb=null,bd=110;for(const e of A.en)if(!e.dead&&!e.crate&&!done.has(e)){const dd=Math.hypot(e.x-cur.x,e.y-cur.y);if(dd<bd){bd=dd;nb=e;}}cur=nb;}sfx('Attacco: Folletto',.6);break;}\\\\n    case'rain':case'smash':{const vis=A.en.filter(e=>!e.dead&&!e.crate&&Math.abs(e.x-p.x)<VW/2&&Math.abs(e.y-p.y)<VH/2);for(let i=0;i<(d.k==='smash'?1:cnt);i++){const e=d.k==='smash'?tg:pick(vis);if(!e)break;\\\\n        A.events.push({t:.45,k:'xrain',x:e.x,y:e.y,w,r:d.rad*AR,ic:d.ic});addFx({k:'mark',x:e.x,y:e.y,t:.5,c:'#ff8a2a'});}break;}\\\\n    case'beam':{const a=Math.atan2(tg.y-12-(p.y-14),tg.x-p.x),L=d.rng*stv('portata')/100;addFx({k:'beam',x:p.x,y:p.y-14,a,L,t:.35,c:'#ffe28a'});\\\\n      for(const e of A.en)if(!e.dead&&segDist(e.x,e.y-10,p.x,p.y-14,p.x+Math.cos(a)*L,p.y-14+Math.sin(a)*L)<e.r+6)xHit(e,w,xDmg(w)*3);break;}\\\\n    case'bounce':{const a=Math.random()*6.283,sp=d.spd*stv('mira')/100;A.proj.push({k:'emoji',ic:d.ic,x:p.x,y:p.y-14,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,bounce:4,life:5,dmg:xDmg(w),xw:w,hit:new Set(),pierce:99,r:7,wp:{kb:4},rehit:.3});break;}\\\\n    case'cone':{const a=Math.atan2(tg.y-p.y,tg.x-p.x),R=d.rng*AR;addFx({k:'cone',x:p.x,y:p.y-12,a,r:R,t:.4,c:'rgba(255,120,30,.45)'});\\\\n      for(const e of A.en)if(!e.dead){const dx=e.x-p.x,dy=e.y-p.y,dd=Math.hypot(dx,dy);if(dd<R+e.r&&Math.abs(((Math.atan2(dy,dx)-a+9.42)%6.283)-3.14)<.55)xHit(e,w,xDmg(w)*2);}sfx('fire',.6);break;}\\\\n    case'nova':addFx({k:'ring',x:p.x,y:p.y-8,t:.45,r:d.rad*AR,c:'#ffd45c'});inR(p.x,p.y,d.rad*AR,e=>xHit(e,w,xDmg(w)));sfx('slam',.6);break;\\\\n    case'pulse':addFx({k:'ring',x:p.x,y:p.y-8,t:.6,r:Math.min(300,d.rad*AR),c:'#9ae0ff'});A.p.hp=Math.min(maxHp(),A.p.hp+d.heal*WLV[w.tier]);addNum(p.x,p.y-40,sgn(d.heal*WLV[w.tier]),NCOL.pos);\\\\n      inR(p.x,p.y,Math.min(300,d.rad*AR),e=>{xHit(e,w,xDmg(w));if(d.freeze)e.slowT=3*stv('durata')/100;});sfx('heal');break;\\\\n    case'mark':{let n=0;for(const e of A.en.filter(e=>!e.dead&&!e.crate).sort((a,b)=>dist(a,p)-dist(b,p))){if(n++>=cnt)break;e.mark=5*stv('durata')/100;}sfx('Boss: Patto',.5);break;}\\\\n    case'thrust':{const a=Math.atan2(tg.y-12-(p.y-14),tg.x-p.x),L=d.rng*stv('portata')/100;addFx({k:'beam',x:p.x,y:p.y-14,a,L,t:.18,c:'#e0e6ec',w:3});\\\\n      for(const e of A.en)if(!e.dead&&segDist(e.x,e.y-10,p.x,p.y-14,p.x+Math.cos(a)*L,p.y-14+Math.sin(a)*L)<e.r+6)xHit(e,w,xDmg(w));break;}\\\\n    case'spread':xShoot(w,p.x,p.y-14,tg,cnt,d.spd);break;\\\\n    case'homing':xShoot(w,p.x,p.y-14,tg,cnt,d.spd,{home:1,life:3});break;\\\\n    case'summon':break;\\\\n    case'turret':{w.tur=w.tur||[];if(w.tur.length<cnt){w.tur.push({x:p.x,y:p.y,t:10*stv('durata')/100,cd:.5});sfx('door',.6);}break;}\\\\n    case'tornado':{const a=Math.random()*6.283;A.proj.push({k:'emoji',ic:d.ic,x:p.x,y:p.y-10,vx:Math.cos(a)*d.spd,vy:Math.sin(a)*d.spd,life:4*stv('durata')/100,dmg:xDmg(w),xw:w,hit:new Set(),pierce:999,r:16*AR,wp:{kb:1},rehit:.35,bounce:6,big:1});break;}\\\\n  }}\\\\n/* alleati: cane e draghetto */\\\\nfunction updAllies(w,dt,cnt){w.al=w.al||[];while(w.al.length<cnt)w.al.push({x:A.p.x+rand(-20,20),y:A.p.y+rand(-20,20),t:0,cd:0,face:1});\\\\n  const d=WX[w.id];for(const a of w.al){a.t+=dt;a.cd-=dt;const tg=nearest(a.x,a.y,260);let tx=A.p.x+(a===w.al[0]?-24:24),ty=A.p.y+10;\\\\n    if(tg){tx=tg.x;ty=tg.y;}const dx=tx-a.x,dy=ty-a.y,dd=Math.hypot(dx,dy)||1,sp=d.fire?150:170;a.moving=dd>14;if(dd>14){a.x+=dx/dd*sp*dt;a.y+=dy/dd*sp*dt;a.face=dx<0?-1:1;}\\\\n    if(tg&&a.cd<=0&&dd<(d.fire?90:24)){a.cd=d.cd;if(d.fire){addFx({k:'cone',x:a.x,y:a.y-20,a:Math.atan2(dy,dx),r:70,t:.35,c:'rgba(255,120,30,.45)'});inR(a.x+dx/dd*35,a.y+dy/dd*35,35,e=>xHit(e,w,xDmg(w),{x:a.x,y:a.y}));}\\\\n      else xHit(tg,w,xDmg(w),{x:a.x,y:a.y});}}}\\\\n/* disegno delle armi nuove */\\\\nfunction drawX(g,w,T){const d=WX[w.id],p=A.p,AR=stv('area')/100,cnt=(d.cnt||1)+(w.tier>=2?1:0);\\\\n  if(d.k==='orbit'){const R=d.rad*AR,s=emojiSpr(d.ic,32);for(let i=0;i<cnt;i++){const a=(w.ang||0)+i*6.283/cnt;g.save();g.translate(p.x+Math.cos(a)*R,p.y-12+Math.sin(a)*R*.7);g.rotate(a*2);g.drawImage(s.c,-8,-8,16,16);g.restore();}}\\\\n  else if(d.k==='shield'&&w.ch>0){g.save();g.globalAlpha=.35+.1*Math.sin(T*6);g.strokeStyle=d.reflect?'#d8f0ff':'#ffd45c';g.lineWidth=2.5;g.beginPath();g.ellipse(p.x,p.y-14,20,24,0,0,6.283);g.stroke();g.restore();\\\\n    const s=emojiSpr(d.ic,32);for(let i=0;i<w.ch;i++)g.drawImage(s.c,p.x-14+i*10,p.y-48,10,10);}\\\\n  else if(d.k==='aura'){g.save();g.globalAlpha=.12+.05*Math.sin(T*4);g.fillStyle=d.slow?'#9ae0ff':d.poison?'#7ae04a':'#ffd45c';g.beginPath();g.ellipse(p.x,p.y-4,d.rad*AR,d.rad*AR*.6,0,0,6.283);g.fill();g.restore();}\\\\n  else if(d.k==='mine'){const s=emojiSpr(d.ic,32);for(const q of A.pud)if(q.mineOf===w&&!q.boom)g.drawImage(s.c,q.x-6,q.y-8,12,12);}\\\\n  else if(d.k==='summon'){for(const a of(w.al||[])){if(d.fire){const s=emojiSpr(d.ic,40);g.save();g.translate(a.x,a.y-26+Math.sin(T*6)*3);if(a.face<0)g.scale(-1,1);g.drawImage(s.c,-11,-11,22,22);g.restore();tShadow(g,a.x,a.y,6);}\\\\n    else drawDog(g,a.x,a.y,{face:a.face,t:a.t,pose:a.moving?'run':'idle',iron:true});}}\\\\n  else if(d.k==='turret'){const s=emojiSpr(d.ic,40);for(const t of(w.tur||[])){tShadow(g,t.x,t.y,8);g.drawImage(s.c,t.x-10,t.y-24,20,20);}}\\\\n}\\\\nfunction drawXProj(g,b){const s=emojiSpr(b.ic,32),k=b.big?2:1;g.save();g.translate(b.x,b.y);g.rotate(performance.now()/90);g.drawImage(s.c,-7*k,-7*k,14*k,14*k);g.restore();}\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\r\\\\n/* =====================================================================\\\\r\\\\n   KING ARENA (mod di KING TOWER)\\\\r\\\\n   Arena a ondate: 1000 livelli da 10 ondate, alla 10ª il boss del livello.\\\\r\\\\n   Le armi attaccano da sole, tu schivi. Monete per il negozio della partita,\\\\r\\\\n   esperienza a ogni nemico sconfitto, punti per sbloccare le skin.\\\\r\\\\n   Grafica: kt-grafica.js (copiata da KING TOWER), toon.js (cartoni),\\\\r\\\\n   sfondi.js (100 stanze), audio.js (200 brani, 150 suoni), anim.js, admin.js.\\\\r\\\\n   ===================================================================== */\\\\r\\\\n\\\\r\\\\n/* ===== Prestazioni: meno fotogrammi per animazione (solo in questa copia) ===== */\\\\r\\\\nObject.assign(ANIM_N,{walk:10,run:10,idle:8,attack:10,shoot:8,hurt:6,alert:6});\\\\r\\\\nObject.assign(DOG_N,{run:18,idle:12,attack:12});\\\\r\\\\n\\\\r\\\\n/* ===== Schermo e mondo ===== */\\\\r\\\\nlet VH=315,VW=560,SC=1,OX=0,OY=0;\\\\r\\\\nconst AW=1120,AH=780,WALL=104,EDGE=22;\\\\r\\\\nconst cv=document.getElementById('cv'),ctx=cv.getContext('2d');\\\\r\\\\nfunction resize(){const dpr=Math.min(2,window.devicePixelRatio||1),w=innerWidth,h=innerHeight;\\\\r\\\\n  cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr);\\\\r\\\\n  VH=285;VW=clamp(w/(h/VH),340,700);if(w/h<340/285){VW=340;VH=Math.min(560,VW*h/w);}SC=Math.min(cv.width/VW,cv.height/VH);OX=(cv.width-VW*SC)/2;OY=(cv.height-VH*SC)/2;}\\\\r\\\\naddEventListener('resize',resize);resize();\\\\r\\\\nconst MOB=(()=>{try{return /[?&]mob(&|$)/.test(location.search)||matchMedia('(pointer:coarse)').matches;}catch(e){return false;}})();\\\\r\\\\nif(MOB)document.body.classList.add('mob');\\\\r\\\\nconst rand=(a,b)=>a+Math.random()*(b-a),pick=a=>a[Math.floor(Math.random()*a.length)];\\\\r\\\\nconst dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);\\\\r\\\\nfunction angLerp(a,b,t){let d=((b-a+Math.PI*3)%(Math.PI*2))-Math.PI;return a+d*Math.min(1,t);}\\\\r\\\\nfunction segDist(px_,py_,ax,ay,bx,by){const dx=bx-ax,dy=by-ay,l=dx*dx+dy*dy||1,u=clamp(((px_-ax)*dx+(py_-ay)*dy)/l,0,1);return Math.hypot(px_-ax-dx*u,py_-ay-dy*u);}\\\\r\\\\n\\\\r\\\\n/* ===== Salvataggio (separato da quello di KING TOWER) ===== */\\\\r\\\\nconst AKEY='kt_arena_v2';\\\\r\\\\nconst AS={best:{},runs:0,wins:0,vol:.7,musVol:.6,sfxVol:.8,mus:true,ch:0,diff:1,skin:0,wpn:'',run:null,top:0,unlocked:1,pts:0,ptsTot:0,skins:{},coins:0,story:false,shake:true,nums:true,kills:0,bossK:{}};\\\\r\\\\ntry{const s=JSON.parse(localStorage.getItem(AKEY));if(s&&typeof s==='object')Object.assign(AS,s);}catch(e){}\\\\r\\\\nif(!skinOk(AS.skin|0))AS.skin=0;\\\\r\\\\nfunction asSave(){if(window.ADM_NOSAVE)return;try{localStorage.setItem(AKEY,JSON.stringify(AS));}catch(e){}}\\\\r\\\\n/* ponte con KING TOWER (la mod apre l'arena in una finestra del gioco) */\\\\r\\\\nconst KT=(()=>{try{return window.parent!==window&&window.parent.ktArenaHost?window.parent.ktArenaHost:null;}catch(e){return null;}})();\\\\r\\\\n/* portafoglio: le monete di KING TOWER (le stesse del 3D) */\\\\r\\\\nfunction wallet(){try{if(KT)return KT.coins()|0;}catch(e){}return AS.coins|0;}\\\\r\\\\nfunction walletAdd(n){n=Math.round(n);try{if(KT){KT.addCoins(n);return;}}catch(e){}AS.coins=Math.max(0,(AS.coins|0)+n);asSave();}\\\\r\\\\nconst isAdmin=()=>{try{if(KT&&KT.admin&&KT.admin())return true;}catch(e){}return /[?&]admin\\\\\\\\b/.test(location.search)&&(location.protocol==='file:'||location.hostname==='localhost');};\\\\r\\\\nconst MAXL=1000,WAVES=10;\\\\r\\\\n\\\\r\\\\n/* ===== Numeri colorati: negativi rossi, positivi verdi, zero bianco ===== */\\\\r\\\\nfunction sgn(v,suf){const r=Math.round(v*10)/10;return(r>0?'+':r<0?'−':'')+Math.abs(r)+(suf||'');}\\\\r\\\\nfunction numH(v,suf){const r=Math.round(v*10)/10;return`<b class=\\\\\\\"${r>0?'np':r<0?'nn':'nz'}\\\\\\\">${sgn(r,suf)}</b>`;}\\\\r\\\\nconst NCOL={pos:'#5ef08a',neg:'#ff5a4a',zero:'#ffffff'};\\\\r\\\\n\\\\r\\\\n/* ===== I 30 parametri sono in dati.js ===== */\\\\r\\\\nconst TIER=['Comune','Raro','Epico','Leggendario'],TOUT=['#0a0706','#1f4f9a','#5a1f8a','#9a2a14'];\\\\r\\\\n\\\\r\\\\n/* ===== Armi (disegnate con drawWeapon di KING TOWER) ===== */\\\\r\\\\nconst WP={\\\\r\\\\n mace:   {n:'Mazza',cls:'melee',dmg:[10,15,22,32],cd:[1.0,.95,.9,.8],rng:55,sc:{melee:1},crit:[3,1.5],kb:22,hr:22,price:22,d:'L\\\\\\\\'arma di sempre della guardia.'},\\\\r\\\\n sword:  {n:'Spada',cls:'melee',dmg:[7,11,16,24],cd:[.65,.6,.55,.5],rng:52,sc:{melee:.8},crit:[8,2],kb:8,hr:16,price:26,d:'Veloce e affilata.'},\\\\r\\\\n spear:  {n:'Lancia',cls:'melee',dmg:[9,14,21,30],cd:[1.05,1,.95,.85],rng:95,sc:{melee:1},crit:[3,1.5],kb:14,pierce:1,price:28,d:'Colpisce tutti i nemici sulla linea.'},\\\\r\\\\n axe:    {n:'Ascia del boia',cls:'melee',dmg:[20,32,48,70],cd:[1.5,1.45,1.4,1.3],rng:56,sc:{melee:1.5},crit:[5,2],kb:36,hr:24,price:38,d:'Lenta ma terribile.'},\\\\r\\\\n halberd:{n:'Alabarda',cls:'melee',dmg:[14,22,33,48],cd:[1.25,1.2,1.1,1],rng:108,sc:{melee:1.2},crit:[3,1.5],kb:22,pierce:1,price:40,d:'Lunghissima, trapassa la fila.'},\\\\r\\\\n gold:   {n:'Martelletto dorato',cls:'melee',dmg:[24,38,56,80],cd:[1.7,1.6,1.5,1.4],rng:60,sc:{melee:2},crit:[5,2],kb:30,hr:26,stun:.6,price:52,d:'Stordisce chi colpisce.'},\\\\r\\\\n cane:   {n:'Bastone del nobile',cls:'melee',dmg:[8,12,18,26],cd:[.8,.75,.7,.62],rng:60,sc:{melee:.7,magic:.5},crit:[5,2],kb:10,hr:18,price:28,d:'Elegante: usa anche la magia.'},\\\\r\\\\n pistol: {n:'Pistola',cls:'ranged',dmg:[10,15,22,32],cd:[.85,.8,.75,.65],rng:220,sc:{ranged:1},crit:[5,2],proj:'bullet',spd:520,price:28,d:'Quella che trovi al livello 50 di KING TOWER.'},\\\\r\\\\n rifle:  {n:'Fucile',cls:'ranged',dmg:[22,34,50,72],cd:[1.7,1.6,1.5,1.4],rng:320,sc:{ranged:2},crit:[10,2],proj:'bullet',spd:720,pierce:2,price:48,d:'Lontano e potente.'},\\\\r\\\\n crossbow:{n:'Balestra',cls:'ranged',dmg:[15,23,34,50],cd:[1.3,1.25,1.15,1.05],rng:270,sc:{ranged:1.2},crit:[15,2],proj:'bolt',spd:480,pierce:1,price:36,d:'Il dardo trapassa un nemico.'},\\\\r\\\\n bow:    {n:'Arco',cls:'ranged',dmg:[6,9,13,19],cd:[.55,.5,.45,.4],rng:240,sc:{ranged:.7},crit:[5,2],proj:'arrow',spd:430,price:24,d:'Frecce rapide.'},\\\\r\\\\n dagger: {n:'Pugnali da lancio',cls:'ranged',dmg:[5,8,12,17],cd:[.4,.37,.34,.3],rng:165,sc:{ranged:.5,melee:.3},crit:[25,2.5],proj:'dagger',spd:400,price:22,d:'Tanti critici.'},\\\\r\\\\n staff:  {n:'Bastone del mago',cls:'magic',dmg:[12,18,27,40],cd:[1.15,1.1,1,.9],rng:210,sc:{magic:1.2},crit:[3,1.5],proj:'orb',spd:230,homing:1,price:38,d:'Le sfere inseguono i nemici.'},\\\\r\\\\n flask:  {n:'Ampolla dell\\\\\\\\'alchimista',cls:'magic',dmg:[8,12,18,27],cd:[1.6,1.5,1.4,1.3],rng:190,sc:{magic:1},crit:[0,1],proj:'potion',spd:260,aoe:42,poison:1,price:34,d:'Esplode e lascia veleno.'},\\\\r\\\\n horn:   {n:'Corno dell\\\\\\\\'araldo',cls:'magic',dmg:[6,10,15,22],cd:[2.6,2.4,2.2,2],rng:85,sc:{magic:.8,melee:.3},crit:[0,1],wave:1,kb:60,price:32,d:'Onda che respinge tutti intorno a te.'},\\\\r\\\\n};\\\\r\\\\nconst WIDS=Object.keys(WP);\\\\r\\\\nfunction setBonus(){return{};}\\\\r\\\\n\\\\r\\\\n/* ===== Personaggi: 20 stili di guardia ===== */\\\\r\\\\nconst CHARS=[\\\\r\\\\n {n:'Guardia Ribelle',w:'mace',    m:{maxhp:3,regen:1}},{n:'Mantello',w:'dagger',m:{speed:15,dodge:5,maxhp:-2}},\\\\r\\\\n {n:'Cappuccio',w:'bow',m:{dodge:12,ranged:1}},{n:'Cavaliere',w:'sword',m:{armor:4,melee:2,speed:-8}},\\\\r\\\\n {n:'Assassino',w:'dagger',m:{crit:15,aspd:8,maxhp:-4}},{n:'Ranger',w:'crossbow',m:{range:60,ranged:3,melee:-2}},\\\\r\\\\n {n:'Mercenario',w:'axe',m:{harvest:12},shop:.85},{n:'Nobile Caduto',w:'pistol',m:{luck:20},start:30},\\\\r\\\\n {n:'Corazziere',w:'halberd',m:{maxhp:8,armor:3,aspd:-10}},{n:'Sovrano',w:'gold',m:{dmg:20,regen:-1,harvest:-5}},\\\\r\\\\n {n:'Carceriere evaso',w:'mace',m:{regen:3,armor:1,speed:-4}},{n:'Alchimista',w:'flask',m:{magic:4,luck:5,maxhp:-2}},\\\\r\\\\n {n:'Mago di corte',w:'staff',m:{magic:5,range:30,armor:-2}},{n:'Araldo',w:'horn',m:{aspd:10,maxhp:4}},\\\\r\\\\n {n:'Boia',w:'axe',m:{melee:5,crit:5,speed:-10}},{n:'Arciere',w:'bow',m:{ranged:3,aspd:6,armor:-1}},\\\\r\\\\n {n:'Pistolero',w:'pistol',m:{ranged:2,crit:8,maxhp:-3}},{n:'Fante',w:'spear',m:{maxhp:5,melee:2}},\\\\r\\\\n {n:'Armaiolo',w:'sword',m:{},extra:'mace',shop:.9},{n:'Fuggiasco',w:'dagger',m:{speed:20,harvest:5,armor:-3,maxhp:-3}}];\\\\r\\\\nfunction charDesc(c){return 'Arma iniziale: '+WP[c.w].n;}\\\\r\\\\n/* difficoltà davvero diverse; monete di KING TOWER per ogni livello vinto: Normale 1, Difficile 2 */\\\\r\\\\nconst DIFFS=[{n:'Facile',hp:.65,dmg:.55,spawn:.75,spd:.9,champ:.5,coins:0},{n:'Normale',hp:1,dmg:1,spawn:1,spd:1,champ:1,coins:1},{n:'Difficile',hp:1.6,dmg:1.6,spawn:1.4,spd:1.12,champ:2,coins:2}];\\\\r\\\\n\\\\r\\\\n/* ===== 1000 livelli × 10 ondate: la difficoltà cresce con l'indice E = (livello-1)·10 + ondata ===== */\\\\r\\\\nconst Eof=(l,w)=>(l-1)*WAVES+w;\\\\r\\\\nconst hpE=E=>E<=20?6+1.2*(E-1)+.05*(E-1)*(E-1):47.9+4*(E-20)+.0005*(E-20)*(E-20);\\\\r\\\\nconst dmgE=E=>E<=20?1+.3*(E-1):6.7+.1*(E-20);\\\\r\\\\nconst spdE=E=>1+Math.min(E,40)*.012;\\\\r\\\\nconst priceE=E=>E<=20?1+.1*(E-1)+.008*(E-1)*(E-1):5.788+.25*(E-20);\\\\r\\\\nconst coinV=E=>1+Math.floor(E/40);\\\\r\\\\n/* le guardie: armature di colori diversi e armi diverse */\\\\r\\\\nconst GUARD_KIT=[{weapon:'spear'},{weapon:'sword',range:1.15*B,windup:.3},{weapon:'sword',shield:.25,range:1.15*B,windup:.4,spd:48},\\\\r\\\\n  {weapon:'bow',ranged:'arrow',range:5.5*B,windup:.6,mv:'rifle',dmg:.9},{weapon:'mace',range:1.2*B,windup:.5,dmg:1.2},{weapon:'axe',range:1.2*B,windup:.6,dmg:1.4,spd:50},\\\\r\\\\n  {weapon:'halberd',range:2.2*B,windup:.6},{weapon:'crossbow',ranged:'bolt',range:5*B,windup:.7,mv:'rifle',dmg:1.3}];\\\\r\\\\nconst GUARD_COL=['#9aa4ae','#b8283a','#2f5fa8','#3a8a3a','#7a3aa8','#d8a93a','#2e2c38','#b8622a'];\\\\r\\\\n/* una tavolozza fissa per ogni tipo di guardia (così i disegni si riusano e il gioco non scatta) */\\\\r\\\\nconst GKP=new Map();function guardKitPal(ki,v){const k=ki+'|'+v;if(!GKP.has(k))GKP.set(k,tintPal(tintPal(GUARD_PALS[ki%7],GUARD_COL[ki]),VARIANTS[v].tint));return GKP.get(k);}\\\\r\\\\nfunction gemSpr(v){const col=v>=100?'#ffd45c':v>=25?'#c070ff':v>=5?'#4aa8ff':'#5ef08a',s=v>=100?5.5:v>=25?4.5:v>=5?4:3.5;\\\\r\\\\n  return tSpr('gem|'+col+s,s*2,s*2.6,g=>{const R=ramp(col);g.fillStyle=R.d;g.beginPath();g.moveTo(s,0);g.lineTo(s*2,s*.9);g.lineTo(s,s*2.6);g.lineTo(0,s*.9);g.closePath();g.fill();\\\\r\\\\n    g.fillStyle=R.b;g.beginPath();g.moveTo(s,0);g.lineTo(s*2,s*.9);g.lineTo(s,s*1.2);g.lineTo(0,s*.9);g.closePath();g.fill();g.fillStyle=R.h;g.beginPath();g.moveTo(s*.6,s*.4);g.lineTo(s,s*.15);g.lineTo(s*.9,s*.7);g.closePath();g.fill();});}\\\\r\\\\nconst XTP={guard:{name:'Guardia',mv:'spear',hp:1,spd:58,dmg:1,range:1.3*B,windup:.45,weapon:'spear'},\\\\r\\\\n  dog:{name:'Cane da guardia',body:'dog',mv:'dog',hp:.6,spd:112,dmg:.7,range:16,windup:.25}};\\\\r\\\\n\\\\r\\\\n/* ===== Stato della partita ===== */\\\\r\\\\nconst A={allies:[],state:'menu',t:0,en:[],spawns:[],proj:[],eproj:[],drops:[],pud:[],fx:[],nums:[],cam:{x:AW/2-280,y:AH/2-160},shake:0,setB:{},E:1,level:1,wv:1,cine:null};\\\\r\\\\nconst maxHp=()=>Math.max(1,Math.round(stv('vita')));\\\\r\\\\n/* esperienza: ogni barra piena = un livello (solo per la partita) */\\\\r\\\\nconst xpNeed=()=>Math.round((2+A.lvl*1.2+A.lvl*A.lvl*.04)*10);\\\\r\\\\nfunction addMods(m,k=1){for(const s in m)A.st[s]=(A.st[s]||0)+m[s]*k;}\\\\r\\\\nfunction mkW(id,tier){return{id,tier,cd:rand(.1,.5),ang:0,anim:0,adur:.3,reach:0,aang:0,hit:null,hx:0,hy:0};}\\\\r\\\\nfunction freshRun(ci,skin,diff,wid,level){const ch=CHARS[ci]||CHARS[0];wid=WP[wid]||WX[wid]?wid:ch.w;\\\\r\\\\n  Object.assign(A,{state:'play',ci,skin,wid,diff,level,wv:1,E:Eof(level,1),coins:ch.start||0,xp:0,lvl:1,pendLv:0,kills:0,pts:0,items:[],weapons:[],\\\\r\\\\n    st:{},boss:null,endT:0,time:0,won:false,revived:false,earned:0,pendBonus:0});\\\\r\\\\n  A.weapons.push(mkW(wid,0));applyRelics();\\\\r\\\\n  A.setB=setBonus();A.p={x:AW/2,y:(WALL+AH)/2,r:9,hp:maxHp(),face:1,t:0,inv:0,moving:false,slow:0};}\\\\r\\\\n/* oggetti dei boss: valgono in tutte le partite */\\\\r\\\\nfunction applyRelics(){AS.relics=AS.relics||{};for(const id in AS.relics){const r=RLB[id],n=AS.relics[id]|0;if(!r||!n)continue;\\\\r\\\\n  if(r.m)addMods(r.m,n);else if(A.weapons.length<6&&!A.weapons.some(w=>w.id===r.w))A.weapons.push(mkW(r.w,Math.min(3,n-1)));}}\\\\r\\\\nfunction newRun(ci,skin,diff,wid,level){level=clamp(level|0||1,1,MAXL);\\\\r\\\\n  freshRun(ci,skin,diff,wid,level);\\\\r\\\\n  if(level>1)startKit(level);\\\\r\\\\n  AS.runs++;AS.run=null;asSave();\\\\r\\\\n  A.theme=-1;startWave(level,1,true);A.state='play';showOv(null);cineStart('gate',()=>{A.banner={t:2.4,a:'Livello '+level+' · Ondata 1/'+WAVES,b:bgName(A.theme)};sfx('wave');});}\\\\r\\\\n/* partire da un livello alto: un \\\\\\\"corredo\\\\\\\" adatto a quel livello */\\\\r\\\\nfunction startKit(level){const E=Eof(level,1)-1;\\\\r\\\\n  A.lvl=1+Math.min(400,Math.floor(E*.9));const nc=Math.floor((A.lvl-1)/5)*2;\\\\r\\\\n  const t=Math.min(3,Math.floor(level/3));for(const w of A.weapons)w.tier=Math.max(w.tier,t);\\\\r\\\\n  for(let i=0;i<Math.min(3,Math.floor(level/2));i++)if(A.weapons.length<6){const pool=Object.keys(WX).filter(k=>!WX[k].boss&&!A.weapons.some(w=>w.id===k));A.weapons.push(mkW(pick(pool),Math.max(0,t-1)));}\\\\r\\\\n  for(let i=0;i<nc;i++){const c=pick(rollCards());if(c)takeCard(c);}\\\\r\\\\n  A.p.hp=maxHp();}\\\\r\\\\n/* la partita si salva a ogni negozio */\\\\r\\\\nfunction saveRun(){if(window.ADM_NOSAVE)return;\\\\r\\\\n  AS.run={ci:A.ci,skin:A.skin,wid:A.wid,diff:A.diff,level:A.level,xp:A.xp,lvl:A.lvl,kills:A.kills,items:A.items.slice(),\\\\r\\\\n    weapons:A.weapons.map(w=>[w.id,w.tier]),st:Object.assign({},A.st),time:A.time,earned:A.earned||0};asSave();}\\\\r\\\\nfunction loadRun(){const r=AS.run;if(!r||!CHARS[r.ci])return false;\\\\r\\\\n  freshRun(r.ci,r.skin|0,r.diff|0,r.wid,r.level|0||1);\\\\r\\\\n  Object.assign(A,{xp:r.xp||0,lvl:r.lvl||1,kills:r.kills||0,items:(r.items||[]).filter(id=>ITB[id]),earned:r.earned||0,\\\\r\\\\n    weapons:(r.weapons||[]).filter(x=>WP[x[0]]||WX[x[0]]).map(x=>mkW(x[0],x[1])),st:Object.assign({},r.st),time:r.time||0});\\\\r\\\\n  if(!A.weapons.length)A.weapons.push(mkW('mace',0));A.p.hp=maxHp();\\\\r\\\\n  A.theme=-1;startWave(A.level,1);return true;}\\\\r\\\\n\\\\r\\\\nfunction nextPos(){let l=A.level,w=A.wv+1;if(w>WAVES){w=1;l++;}return[l,w];}\\\\r\\\\nfunction startWave(l,w,silent){\\\\r\\\\n  const bi=bgOfLevel(l),boss=w===WAVES;\\\\r\\\\n  A.level=l;A.wv=w;A.E=Eof(l,w);A.boss=null;A.bossWave=boss;A.horde=w===7;\\\\r\\\\n  A.waveT=boss?0:(A.horde?18:Math.min(40,18+2*w));A.waveMax=A.waveT;\\\\r\\\\n  A.spT=.6;A.en=[];A.spawns=[];A.proj=[];A.eproj=[];A.drops=[];A.pud=[];A.fx=[];A.nums=[];A.endT=0;A.crT=4;A.events=[];\\\\r\\\\n  if(w===5)A.events.push({t:4,k:'captain'});\\\\r\\\\n  if(boss){if(l>=MAXL)A.events.push({t:2,k:'boss'},{t:1,k:'king',after:1});else A.events.push({t:2,k:'boss'});}\\\\r\\\\n  A.p.x=AW/2;A.p.y=(WALL+AH)/2;A.p.hp=maxHp();A.p.inv=1;A.p.slow=0;if(A.allies.length)reviveAllies();\\\\r\\\\n  for(const wp of A.weapons){wp.cd=rand(.2,.6);wp.anim=0;}\\\\r\\\\n  if(A.theme!==bi){A.theme=bi;buildFloor(bi);}\\\\r\\\\n  A.banner=silent?null:{t:2.4,a:'Livello '+l+' · Ondata '+w+'/'+WAVES+(boss?' — '+(l>=MAXL?'Il Re':bossOfLevel(l).n):A.horde?' — Orda!':''),b:bgName(bi)};\\\\r\\\\n  A.state=silent?A.state:'play';if(!silent)showOv(null);\\\\r\\\\n  musicPlay(boss?trackOfBoss(bossOfLevel(l).i):trackOfLevel(l));if(!silent)sfx('wave');if(w===1||w===6)warmUp();\\\\r\\\\n  /* casse all'inizio */\\\\r\\\\n  for(let i=0;i<2;i++)spawnCrate();\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* ===== Ingresso ===== */\\\\r\\\\nconst K={};let joy=null;\\\\r\\\\naddEventListener('keydown',e=>{if(e.target&&e.target.tagName==='INPUT')return;K[e.code]=1;\\\\r\\\\n  if((e.code==='Escape'||e.code==='KeyP')&&!e.repeat){if(A.state==='play'&&!A.cine)pauseGame();else if(A.state==='pause')resumeGame();}\\\\r\\\\n  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code)&&A.state==='play')e.preventDefault();});\\\\r\\\\naddEventListener('keyup',e=>{K[e.code]=0;});\\\\r\\\\naddEventListener('blur',()=>{for(const k in K)K[k]=0;joy=null;if(A.state==='play'&&!A.cine&&!window.ARENA_BOT&&!NET.on)pauseGame();});\\\\r\\\\n/* lancio a mano: dinamite, boomerang, palla, ventaglio, vortice partono verso il clic e poi si ricaricano */\\\\r\\\\nconst MANUAL={lob:1,boomerang:1,bounce:1,spread:1,tornado:1};\\\\r\\\\nfunction throwAt(tx,ty){if(A.state!=='play'||!A.p||A.cine)return;let any=false;\\\\r\\\\n  for(const w of A.weapons){const d=WX[w.id];if(!d||!MANUAL[d.k]||w.cd>0)continue;w.cd=d.cd/Math.max(.3,stv('velatt')/100);xFire(w,d,{x:tx,y:ty+12,scale:1},(d.cnt||1)+(w.tier>=2?1:0),stv('area')/100);any=true;}\\\\r\\\\n  if(any)sfx('Attacco: Pugnali',.7);}\\\\r\\\\nfunction throwAuto(){const p=A.p;if(!p)return;const e=nearest(p.x,p.y,400);throwAt(e?e.x:p.x+p.face*120,e?e.y:p.y);}\\\\r\\\\ncv.addEventListener('contextmenu',e=>e.preventDefault());\\\\r\\\\ncv.addEventListener('mousedown',e=>{if(MOB||A.state!=='play')return;const d=Math.min(2,devicePixelRatio||1);throwAt((e.clientX*d-OX)/SC+A.cam.x,(e.clientY*d-OY)/SC+A.cam.y);});\\\\r\\\\ncv.addEventListener('pointerdown',e=>{au();if(A.state!=='play'||!MOB)return;joy={id:e.pointerId,x0:e.clientX,y0:e.clientY,x:e.clientX,y:e.clientY};});\\\\r\\\\naddEventListener('pointermove',e=>{if(joy&&e.pointerId===joy.id){joy.x=e.clientX;joy.y=e.clientY;}});\\\\r\\\\naddEventListener('pointerup',e=>{if(joy&&e.pointerId===joy.id)joy=null;});\\\\r\\\\naddEventListener('pointercancel',()=>{joy=null;});\\\\r\\\\nfunction inputVec(){if(window.ARENA_BOT)return window.ARENA_BOT();\\\\r\\\\n  let x=(K.KeyD||K.ArrowRight?1:0)-(K.KeyA||K.ArrowLeft?1:0),y=(K.KeyS||K.ArrowDown?1:0)-(K.KeyW||K.ArrowUp?1:0);\\\\r\\\\n  if(joy){const dx=joy.x-joy.x0,dy=joy.y-joy.y0,d=Math.hypot(dx,dy);if(d>8){x=dx/Math.max(d,50);y=dy/Math.max(d,50);}}\\\\r\\\\n  const gps=navigator.getGamepads?navigator.getGamepads():[];for(const gp of gps){if(!gp)continue;const ax=gp.axes[0]||0,ay=gp.axes[1]||0;if(Math.hypot(ax,ay)>.2){x=ax;y=ay;}\\\\r\\\\n    if(gp.buttons[9]&&gp.buttons[9].pressed&&!A._gpP){A._gpP=1;pauseGame();}if(!(gp.buttons[9]&&gp.buttons[9].pressed))A._gpP=0;}\\\\r\\\\n  const d=Math.hypot(x,y);if(d>1){x/=d;y/=d;}return{x,y};}\\\\r\\\\n\\\\r\\\\n/* ===== Aggiornamento ===== */\\\\r\\\\nfunction update(dt){\\\\r\\\\n  A.t+=dt;A.time+=dt;\\\\r\\\\n  if(A.cine&&A.cine.block){updCine(dt);updFx(dt);return;}\\\\r\\\\n  if(A.cine)updCine(dt);\\\\r\\\\n  if(A.banner){A.banner.t-=dt;if(A.banner.t<=0)A.banner=null;}\\\\r\\\\n  if(A.shake>0)A.shake=Math.max(0,A.shake-dt*30);\\\\r\\\\n  if(A.endT>0){A.endT-=dt;updFx(dt);updDrops(dt,true);if(A.endT<=0)endWave();return;}\\\\r\\\\n  if(!A.bossWave){A.waveT-=dt;if(A.waveT<=0){A.waveT=0;A.endT=1.2;clearEnemies();sfx('clear');return;}}\\\\r\\\\n  for(const ev of A.events){if(!ev.done){if(ev.after&&(A.en.some(e=>e.boss&&!e.dead)||A.events.some(o=>o!==ev&&!o.done&&o.k!=='captain'&&o.k!=='rain'&&o.k!=='xrain')))continue;\\\\r\\\\n    ev.t-=dt;if(ev.t<=0){ev.done=1;spawnSpecial(ev.k);}}}\\\\r\\\\n  A.spT-=dt;\\\\r\\\\n  if(A.spT<=0){const E=A.E,D=DIFFS[A.diff];A.spT=Math.max(.6,1.25-Math.min(E,50)*.013)/D.spawn*(A.bossWave?3.2:1)/(A.horde?1.6:1);\\\\r\\\\n    const n=1+Math.floor(Math.min(E,80)/16)+(Math.random()<.3?1:0),cap=A.bossWave?(MOB?18:25):MOB?60:90;\\\\r\\\\n    for(let i=0;i<n&&A.en.length+A.spawns.length<cap;i++)queueSpawn(pickKind());}\\\\r\\\\n  A.crT-=dt;if(A.crT<=0){A.crT=rand(7,12);if(A.en.filter(e=>e.crate).length<4)spawnCrate();}\\\\r\\\\n  for(let i=A.spawns.length-1;i>=0;i--){const s=A.spawns[i];s.t-=dt;if(s.t<=0){A.spawns.splice(i,1);const e=spawnEnemy(s.k,s.x,s.y);if(e){e.ent=s.how;e.entT=s.how==='x'?0:.6;if(s.how==='door')e.y=WALL-4;}}}\\\\r\\\\n  updPlayer(dt);updWeapons(dt);if(A.allies.length)updAlliesMP(dt);if(NET.on)netHostTick(dt);\\\\r\\\\n  for(const e of A.en)updEnemy(e,dt);\\\\r\\\\n  separate();\\\\r\\\\n  updProj(dt);updEProj(dt);updDrops(dt,false);updFx(dt);\\\\r\\\\n  A.en=A.en.filter(e=>!e.dead);\\\\r\\\\n  if(A.pendBonus>0&&!A.cine&&A.state==='play'&&A.p.hp>0&&A.endT<=0)bonusTime();\\\\r\\\\n}\\\\r\\\\n/* --- quale nemico: i 200 nemici entrano piano piano nei 1000 livelli --- */\\\\r\\\\nfunction pickKind(){const pool=enemyPool(A.level+(A.wv-1)*.1);let tot=0;const wts=pool.map(e=>{const w=(e.lv>A.level-40?2:1)*(e.v===4?.5:1)*(e.sp.kt==='rat'?1.2:1);tot+=w;return w;});\\\\r\\\\n  let r=Math.random()*tot;for(let i=0;i<pool.length;i++){r-=wts[i];if(r<=0)return pool[i].i;}return 0;}\\\\r\\\\nfunction freeSpot(){for(let i=0;i<20;i++){const x=rand(EDGE+30,AW-EDGE-30),y=rand(WALL+30,AH-EDGE-30);if(Math.hypot(x-A.p.x,y-A.p.y)>150)return{x,y};}return{x:EDGE+40,y:AH-60};}\\\\r\\\\n/* come entrano: dalle porte e dalle botole (come le guardie di KING TOWER) oppure su una X rossa */\\\\r\\\\nfunction queueSpawn(idx){const E=ENEMIES[idx],r=Math.random();let s,how;\\\\r\\\\n  if(r<.3&&DOORS.length){const x=pick(DOORS);s={x,y:WALL+12};how='door';}\\\\r\\\\n  else if(r<.55&&TRAPS.length){const tp=TRAPS.filter(t=>Math.hypot(t.x-A.p.x,t.y-A.p.y)>130);if(tp.length){s=Object.assign({},pick(tp));how='trap';}}\\\\r\\\\n  if(!s){s=freeSpot();how='x';}\\\\r\\\\n  const n=E.sp.kt==='rat'?3:1;for(let i=0;i<n;i++)A.spawns.push({k:idx,how,x:clamp(s.x+rand(-14,14)*(n>1),EDGE+10,AW-EDGE-10),y:clamp(s.y+rand(-14,14)*(n>1),WALL+10,AH-EDGE-10),t:(how==='x'?.9:.6+i*.15)*clamp(stv('udito')/100,.6,2.5)});}\\\\r\\\\nfunction spawnEnemy(idx,x,y,o){\\\\r\\\\n  const En=ENEMIES[idx]||ENEMIES[0],tp=enemyTp(En),V=En.va,E=A.E,D=DIFFS[A.diff];\\\\r\\\\n  const e={idx,En,sp:En.sp,v:En.v,k:En.sp.kt||En.sp.id,tp,x,y,face:1,t:Math.random()*5,spd:(tp.spd||50)*.85*spdE(E)*(V.spd||1)*D.spd,dmg:(tp.dmg||1)*dmgE(E)*D.dmg*(V.dmg||1),range:tp.range||30,\\\\r\\\\n    st:'move',wait:0,wt:1,cool:rand(.4,1.4),scale:(tp.scale||1)*(V.scale||1),hurt:0,kbx:0,kby:0,stun:0,poison:0,buff:0,pal:tintPal(tp.pal,V.tint),weapon:tp.weapon||'none',pr:0,moving:false,alertT:.8};\\\\r\\\\n  if(e.k==='guard'&&!o){const ki=Math.floor(Math.random()*GUARD_KIT.length),L=GUARD_KIT[ki];e.tp=Object.assign({},tp,L);e.weapon=L.weapon;e.range=L.range||tp.range;\\\\r\\\\n    e.pal=guardKitPal(ki,e.v);}\\\\r\\\\n  else if(e.k==='guard')e.pal=tintPal(GUARD_PALS[Math.floor(A.level/10)%7],V.tint);\\\\r\\\\n  e.hp=e.max=Math.max(1,(tp.hp||tp.hpB*20||1)*(V.hp||1)*hpE(E)*D.hp);\\\\r\\\\n  if(!o&&E>=30&&Math.random()<Math.min(.06,.015+E*.00002)*D.champ){e.champ=true;e.scale*=1.2;e.hp=e.max=e.max*4;e.dmg*=1.3;}\\\\r\\\\n  e.r=(tp.body==='rat'?7:tp.body==='toon'?10:tp.body?9:10)*e.scale;\\\\r\\\\n  Object.assign(e,o||{});A.en.push(e);\\\\r\\\\n  addFx({k:'puff',x,y:y-8,t:.35,c:'#a89a8a'});\\\\r\\\\n  return e;}\\\\r\\\\nfunction spawnCrate(){const s=freeSpot();A.en.push({crate:true,x:s.x,y:s.y,r:11,hp:hpE(A.E)*1.5,max:hpE(A.E)*1.5,t:0,scale:1,kbx:0,kby:0,hurt:0,face:1,tp:{},sp:{},v:0,barrel:Math.random()<.4});}\\\\r\\\\nfunction spawnSpecial(k){\\\\r\\\\n  const D=DIFFS[A.diff],E=A.E,x=AW/2+(A.en.some(e=>e.boss)?rand(-200,200):0),y=WALL+70;\\\\r\\\\n  if(k==='captain'){const e=spawnEnemy(0,x,y,{elite:true,name:'Capitano della Guardia'});e.tp=Object.assign({},ET.captain);e.k='captain';e.pal=ET.captain.pal;e.weapon='sword';e.scale=1.25;\\\\r\\\\n    e.hp=e.max=hpE(E)*14*D.hp;e.dmg=dmgE(E)*2*D.dmg;e.r=12*e.scale;toast(e.name+' entra in battaglia!');sfx('boss');}\\\\r\\\\n  if(k==='boss'){const B=bossOfLevel(A.level),rk=B.r;\\\\r\\\\n    const e=spawnEnemy(0,x,y,{boss:'rich',bi:B.i,name:B.n,atkList:B.T.atk,scale:1.5+rk*.05,spd:52+rk*4,atkT:2.2});\\\\r\\\\n    e.r=17*e.scale/1.5;e.hp=e.max=hpE(E)*20*(1+rk*.2)*D.hp;e.dmg=dmgE(E)*2.4*D.dmg*(1+rk*.06);e.pal=null;A.boss=e;\\\\r\\\\n    AS.bossK=AS.bossK||{};cineStart('boss',null,{e});}\\\\r\\\\n  if(k==='king'){const e=spawnEnemy(0,x,y,{boss:'king',name:'Il Re',pal:KING,weapon:'gold',scale:1.75,spd:62,atkT:2.2,atkList:['swing','orbRing','charge','summon','coinFan','goldRain']});\\\\r\\\\n    e.r=18;e.hp=e.max=hpE(E)*60*D.hp;e.dmg=dmgE(E)*5*D.dmg;A.boss=e;cineStart('boss',null,{e});}\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* --- giocatore --- */\\\\r\\\\nfunction updPlayer(dt){\\\\r\\\\n  const p=A.p,v=inputVec(),spd=125*Math.max(.3,stv('agilita')/100)*(p.slow>0?.6+.4*Math.min(.8,stv('resistenza')/100):1);if(p.slow>0)p.slow-=dt;\\\\r\\\\n  p.moving=Math.abs(v.x)+Math.abs(v.y)>.05;p.t+=dt*(p.moving?1:.6);\\\\r\\\\n  p.x=clamp(p.x+v.x*spd*dt,EDGE+p.r,AW-EDGE-p.r);p.y=clamp(p.y+v.y*spd*dt,WALL+p.r,AH-EDGE-p.r);\\\\r\\\\n  if(v.x>.1)p.face=1;else if(v.x<-.1)p.face=-1;\\\\r\\\\n  if(p.inv>0)p.inv-=dt;\\\\r\\\\n  const rg=stv('rigenerazione');if(rg>0){p.reg=(p.reg||0)+dt*rg*.15;if(p.reg>=1&&p.hp<maxHp()){const h=Math.floor(p.reg);p.reg-=h;p.hp=Math.min(maxHp(),p.hp+h);addNum(p.x,p.y-38,sgn(h),NCOL.pos);}if(p.reg>=1)p.reg=0;}\\\\r\\\\n  for(const q of A.pud){if(q.enemy&&Math.hypot(q.x-p.x,q.y-p.y)<q.r){q.tick=(q.tick||0)-dt;if(q.tick<=0){q.tick=.5;hurtPlayer(q.dmg*(1-Math.min(.8,stv('resistenza')/100)));}}\\\\r\\\\n    if(q.mine&&!q.enemy){q.tick-=dt;if(q.tick<=0){q.tick=.5;inR(q.x,q.y,q.r,e=>xHit(e,q.mine,xDmg(q.mine),{x:q.x,y:q.y}));}}}\\\\r\\\\n  for(const w of A.weapons)if(WX[w.id])updX(w,dt);\\\\r\\\\n  A.cam.x=clamp(p.x-VW/2,0,AW-VW);A.cam.y=clamp(p.y-VH/2-12,0,AH-VH);\\\\r\\\\n}\\\\r\\\\nfunction hurtPlayer(d,src){\\\\r\\\\n  const p=A.p;if(p.inv>0||A.endT>0||A.state!=='play'||window.ADM_GOD)return;\\\\r\\\\n  if(Math.random()*100<Math.min(60,stv('schivata'))){addNum(p.x,p.y-40,'Schivato','#bfe0ff');p.inv=.15;sfx('dodge');return;}\\\\r\\\\n  /* scudo: blocca il colpo intero (lo specchio lo rimanda indietro) */\\\\r\\\\n  const sh=A.weapons.find(w=>WX[w.id]&&WX[w.id].k==='shield'&&w.ch>0);\\\\r\\\\n  if(sh){sh.ch--;sh.cd=WX[sh.id].cd*stv('durata')/100;p.inv=.4;addNum(p.x,p.y-40,'Parato!','#ffe28a');sfx('block');\\\\r\\\\n    if(WX[sh.id].reflect&&src&&!src.dead&&src.x!=null){addFx({k:'beam',x:p.x,y:p.y-14,a:Math.atan2(src.y-p.y,src.x-p.x),L:Math.hypot(src.x-p.x,src.y-p.y),t:.3,c:'#d8f0ff'});xHit(src,sh,xDmg(sh)*2);}return;}\\\\r\\\\n  if(src&&src.x!=null&&!src.dead&&src.hp>0&&stv('spine')>0)hitEnemy(src,stv('spine')*(1+A.E*.04),false,{kb:2},p.x,p.y);\\\\r\\\\n  const ar=stv('armatura');d*=ar>=0?15/(15+ar):1+(-ar)/15;d=Math.max(1,Math.round(d));\\\\r\\\\n  p.hp-=d;p.inv=.45*stv('riflessi')/100;if(AS.shake)A.shake=4;sfx('hurt');addNum(p.x,p.y-40,sgn(-d),NCOL.neg,true);\\\\r\\\\n  if(src&&src.v===6)p.slow=1.2;\\\\r\\\\n  if(p.hp<=0){p.hp=0;playerDown();}\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* --- armi --- */\\\\r\\\\nconst wRange=w=>WP[w.id].rng*stv('portata')/100;\\\\r\\\\nconst wCd=w=>WP[w.id].cd[w.tier]/Math.max(.25,stv('velatt')/100);\\\\r\\\\nfunction wDmg(w){const wp=WP[w.id];let d=wp.dmg[w.tier]*sm(wCls(w.id));if(A.p.hp<maxHp()/2)d*=1+stv('coraggio')*2/100;return Math.max(1,d);}\\\\r\\\\nfunction nearest(x,y,r){let b=null,bd=r,c=null,cd=r;for(const e of A.en){if(e.dead)continue;const d=Math.hypot(e.x-x,e.y-12-y)-e.r;if(e.crate){if(d<cd){cd=d;c=e;}continue;}if(d<bd){bd=d;b=e;}}return b||c;}\\\\r\\\\nfunction updWeapons(dt){\\\\r\\\\n  const p=A.p,n=A.weapons.length;\\\\r\\\\n  A.weapons.forEach((w,i)=>{\\\\r\\\\n    const wp=WP[w.id];if(!wp)return;const a0=-Math.PI/2+i*Math.PI*2/n;\\\\r\\\\n    const rx=n===1?14*p.face:Math.cos(a0)*24,ry=n===1?-14:Math.sin(a0)*13-16;\\\\r\\\\n    w.hx=lerp(w.hx||p.x,p.x+rx,Math.min(1,dt*18));w.hy=lerp(w.hy||p.y,p.y+ry,Math.min(1,dt*18));\\\\r\\\\n    const R_=wRange(w),tg=nearest(w.hx,w.hy,R_*Math.max(1,stv('vista')/100)+(wp.cls==='melee'?8:0));\\\\r\\\\n    if(w.anim>0){w.anim-=dt;if(wp.cls==='melee')meleeTick(w,wp);if(w.anim<=0)w.anim=0;}\\\\r\\\\n    else if(tg)w.ang=angLerp(w.ang,Math.atan2(tg.y-12*tg.scale-w.hy,tg.x-w.hx),dt*16);\\\\r\\\\n    else w.ang=angLerp(w.ang,p.face>0?-.35:Math.PI+.35,dt*5);\\\\r\\\\n    w.cd-=dt;\\\\r\\\\n    if(w.cd<=0&&tg&&w.anim<=0){w.cd=wCd(w);fire(w,wp,tg);}\\\\r\\\\n  });\\\\r\\\\n}\\\\r\\\\nfunction fire(w,wp,tg){\\\\r\\\\n  const crit=Math.random()*100<wp.crit[0]+stv('critico'),dmg=wDmg(w)*(crit?wp.crit[1]*stv('dannocrit')/150:1),ang=Math.atan2(tg.y-12*tg.scale-w.hy,tg.x-w.hx);\\\\r\\\\n  w.ang=ang;const wi=WIDS.indexOf(w.id);\\\\r\\\\n  if(wp.wave){const R_=wRange(w);addFx({k:'ring',x:A.p.x,y:A.p.y-8,t:.35,r:R_,c:'#ffd45c'});sfx('Attacco: Corno');\\\\r\\\\n    for(const e of A.en)if(!e.dead&&Math.hypot(e.x-A.p.x,e.y-A.p.y)<R_+e.r){hitEnemy(e,dmg,crit,wp,A.p.x,A.p.y);}\\\\r\\\\n    w.anim=.25;w.adur=.25;w.aang=ang;w.reach=0;return;}\\\\r\\\\n  sfx(SFX[wi]?SFX[wi].n:'Clic',.9);\\\\r\\\\n  if(wp.cls==='melee'){\\\\r\\\\n    w.anim=w.adur=Math.min(.32,wCd(w)*.8);w.aang=ang;w.hit=new Set();w.crit=crit;w.dmgNow=dmg;\\\\r\\\\n    w.reach=clamp(Math.hypot(tg.x-w.hx,tg.y-12-w.hy)-4,14,wRange(w));return;}\\\\r\\\\n  const sp=wp.spd*stv('mira')/100,b={x:w.hx+Math.cos(ang)*12,y:w.hy+Math.sin(ang)*12,vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp,dmg,crit,wp,\\\\r\\\\n    k:wp.proj,life:wRange(w)/sp*1.15,pierce:(wp.pierce||0)+Math.floor(stv('perforazione')-1),hit:new Set(),r:wp.proj==='orb'?6:4};\\\\r\\\\n  if(wp.proj==='potion'){b.tx=tg.x;b.ty=tg.y;b.sx=b.x;b.sy=b.y;b.dur=Math.max(.25,Math.hypot(tg.x-b.x,tg.y-b.y)/sp);b.age=0;}\\\\r\\\\n  A.proj.push(b);\\\\r\\\\n  const ex=Math.floor(stv('proiettili')-1)+(Math.random()<stv('proiettili')%1?1:0);for(let i=0;i<ex;i++){const a=ang+(i%2?1:-1)*.2*(1+Math.floor(i/2));A.proj.push(Object.assign({},b,{vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,hit:new Set()}));}\\\\r\\\\n}\\\\r\\\\nfunction meleeTick(w,wp){\\\\r\\\\n  const k=1-w.anim/w.adur;if(k<.2||k>.8)return;\\\\r\\\\n  const ext=Math.sin(Math.PI*k)*w.reach,tx=w.hx+Math.cos(w.aang)*ext,ty=w.hy+Math.sin(w.aang)*ext,hr=wp.hr||14;\\\\r\\\\n  for(const e of A.en){if(e.dead||w.hit.has(e))continue;const ey=e.y-10*e.scale;\\\\r\\\\n    const ok=wp.pierce?segDist(e.x,ey,w.hx,w.hy,tx,ty)<e.r+8:Math.hypot(e.x-tx,ey-ty)<e.r+hr;\\\\r\\\\n    if(ok){w.hit.add(e);hitEnemy(e,w.dmgNow,w.crit,wp,w.hx,w.hy);}}\\\\r\\\\n}\\\\r\\\\nfunction hitEnemy(e,dmg,crit,wp,fx_,fy_){\\\\r\\\\n  if(e.dead)return;\\\\r\\\\n  if(e.tp.shield)dmg*=1-e.tp.shield;if(e.tp.ghost||e.sp.ghost)dmg*=.75;if(e.v===1)dmg*=.7;if(e.mark>0&&!(wp&&wp.n))dmg*=1.5;\\\\r\\\\n  if(window.ADM_ONESHOT)dmg=e.hp+1;\\\\r\\\\n  e.hp-=dmg;e.hurt=.12;\\\\r\\\\n  if(!e.crate){const D=stv('durata')/100,kb=(wp&&wp.kb||4)*(e.boss?.1:e.elite?.3:e.v===4?.4:1)*stv('spinta')/100,a=Math.atan2(e.y-fy_,e.x-fx_);e.kbx+=Math.cos(a)*kb*6;e.kby+=Math.sin(a)*kb*6;\\\\r\\\\n    if(wp&&wp.stun&&!e.boss)e.stun=Math.max(e.stun,wp.stun*D);if(wp&&(wp.poison||wp.burn)){e.poison=3*D;e.pDmg=Math.max(1,dmg*(wp.burn?.2:.15));}if(wp&&wp.slow)e.slowT=1.5*D;}\\\\r\\\\n  if(AS.nums)addNum(e.x+rand(-6,6),e.y-30*e.scale,String(Math.round(dmg))+(crit?'!':''),crit?'#ffd45c':NCOL.zero,crit);\\\\r\\\\n  sfx(crit?'crit':(wp&&wp.n?'Colpo: '+wp.n.split(' ')[0]:'Colpo: Mazza'),.8);\\\\r\\\\n  const sl=stv('furto');if(sl>0&&Math.random()*100<sl&&A.p.hp<maxHp()){A.p.hp=Math.min(maxHp(),A.p.hp+1);addNum(A.p.x,A.p.y-40,'+1',NCOL.pos);}\\\\r\\\\n  if(e.hp<=0)killEnemy(e);\\\\r\\\\n}\\\\r\\\\n/* gemme di esperienza a terra: verde 1, blu 5, viola 25, oro 100 */\\\\r\\\\n/* troppe gemme a terra fanno scattare il gioco: oltre 150 si uniscono a una gemma vicina */\\\\r\\\\nfunction dropCoins(x,y,n){let tot=Math.round(n*2*coinV(A.E));const many=n>1;\\\\r\\\\n  if(A.drops.length>150){const gm=A.drops.find(d=>d.k==='xp'&&Math.abs(d.x-x)<160&&Math.abs(d.y-y)<160)||A.drops.find(d=>d.k==='xp');if(gm){gm.v+=tot;return;}}\\\\r\\\\n  while(tot>0){const v=tot>=100&&n>=20?100:tot>=25&&n>=8?25:tot>=5&&n>=3?5:1;tot-=v;A.drops.push({k:'xp',x:x+rand(-8,8)*(many?2:1),y:y+rand(-6,6)*(many?2:1),v,t:0,vy:rand(-40,-10)});if(A.drops.length>500)break;}}\\\\r\\\\nfunction killEnemy(e){\\\\r\\\\n  e.dead=true;const L=(stv('fortuna')-10)/100;\\\\r\\\\n  if(e.crate){sfx('crate');addFx({k:'puff',x:e.x,y:e.y-8,t:.45,c:'#8a6a3a',big:true});dropCoins(e.x,e.y,3+Math.floor(Math.random()*3));\\\\r\\\\n    if(Math.random()<.35)A.drops.push({k:'food',x:e.x,y:e.y,t:0});if(Math.random()<.08*(1+L))A.drops.push({k:'chest',x:e.x,y:e.y,t:0});return;}\\\\r\\\\n  A.kills++;AS.kills=(AS.kills|0)+1;A.pts++;\\\\r\\\\n  sfx('Sconfitto: '+['Guardia','Ratto','Scheletro','Melma','Spadaccino','Fantasma','Cane','Ragno','Scudiero','Arciere','Pipistrello','Folletto','Libro','Balestriere','Carceriere','Candela','Forziere','Alabardiere','Assassino','Gargoyle','Quadro','Alchimista','Golem','Boia','Cavaliere'][e.En?e.En.s:0],.8);\\\\r\\\\n  addFx({k:'puff',x:e.x,y:e.y-10,t:.45,c:e.boss?'#ffd45c':'#8a7a6a',big:e.boss||e.elite});\\\\r\\\\n  if(e.boss)A.lastBoss=e.name;\\\\r\\\\n  let n=e.boss?60:e.elite?14:e.champ?6:e.v===4?3:(Math.random()<.25+L*.2?2:1);if(e.v===7)n+=4;if(e.sp.rich)n+=3;\\\\r\\\\n  dropCoins(e.x,e.y,n);\\\\r\\\\n  if(Math.random()<.02*(1+L)*(e.champ?5:1))A.drops.push({k:'heart',x:e.x,y:e.y,t:0});\\\\r\\\\n  if(Math.random()<.012*(1+L))A.drops.push({k:'food',x:e.x,y:e.y,t:0});\\\\r\\\\n  if(e.elite||(Math.random()<(e.champ?.1:.004)*(1+L)))A.drops.push({k:'chest',x:e.x,y:e.y,t:0});\\\\r\\\\n  if(e.v===3)A.pud.push({x:e.x,y:e.y,r:24,t:3,enemy:true,dmg:e.dmg*.4,c:'rgba(90,200,70,.3)'});\\\\r\\\\n  if(e.sp.split&&!e.small&&A.en.length<160)for(let i=0;i<2;i++){const s=spawnEnemy(e.idx,e.x+rand(-12,12),e.y+rand(-8,8),{small:true});s.scale*=.65;s.r*=.65;s.hp=s.max=e.max*.3;s.alertT=0;}\\\\r\\\\n  if(e.boss){A.shake=12;sfx('slam');A.pts+=50;if(e.boss==='rich'){AS.bossK=AS.bossK||{};AS.bossK[e.bi]=(AS.bossK[e.bi]|0)+1;}\\\\r\\\\n    const altro=A.en.find(o=>o!==e&&!o.dead&&o.boss);\\\\r\\\\n    if(altro||A.events.some(ev=>!ev.done&&ev.k!=='captain'&&ev.k!=='rain'&&ev.k!=='xrain')){if(A.boss===e)A.boss=altro||null;return;}\\\\r\\\\n    for(const o of A.en)if(o!==e&&!o.dead){o.dead=true;addFx({k:'puff',x:o.x,y:o.y-10,t:.4,c:'#8a7a6a'});}\\\\r\\\\n    A.spawns=[];A.eproj=[];A.endT=2.2;if(A.level>=MAXL)A.won=true;}\\\\r\\\\n}\\\\r\\\\nfunction clearEnemies(){for(const e of A.en){if(e.crate)continue;e.dead=true;addFx({k:'puff',x:e.x,y:e.y-10,t:.4,c:'#8a7a6a'});}A.en=A.en.filter(e=>!e.dead);A.spawns=[];A.eproj=[];A.pud=A.pud.filter(q=>!q.enemy);}\\\\r\\\\n\\\\r\\\\n/* --- nemici --- */\\\\r\\\\nfunction updEnemy(e,dt){\\\\r\\\\n  if(e.dead||e.crate){if(e&&e.crate&&e.hurt>0)e.hurt-=dt;return;}\\\\r\\\\n  e.t+=dt;if(e.hurt>0)e.hurt-=dt;if(e.buff>0)e.buff-=dt;if(e.alertT>0)e.alertT-=dt;if(e.mark>0)e.mark-=dt;if(e.slowT>0)e.slowT-=dt;\\\\r\\\\n  if(e.entT>0){e.entT-=dt;if(e.ent==='door'){e.y+=60*dt;e.moving=true;}return;}\\\\r\\\\n  e.x+=e.kbx*dt;e.y+=e.kby*dt;const fr=Math.pow(.0005,dt);e.kbx*=fr;e.kby*=fr;\\\\r\\\\n  if(e.poison>0){e.poison-=dt;e.pT=(e.pT||0)-dt;if(e.pT<=0){e.pT=.5;e.hp-=e.pDmg;e.hurt=.06;if(AS.nums)addNum(e.x,e.y-28,String(Math.round(e.pDmg)),'#7ae04a');if(e.hp<=0){killEnemy(e);return;}}}\\\\r\\\\n  if(e.stun>0){e.stun-=dt;e.moving=false;return;}\\\\r\\\\n  const p=tgtOf(e),dx=p.x-e.x,dy=p.y-e.y,d=Math.hypot(dx,dy)||1,tp=e.tp;\\\\r\\\\n  if(e.st!=='wind'&&e.st!=='dash')e.face=dx<0?-1:1;\\\\r\\\\n  const spd=e.spd*(e.buff>0?1.35:1)*(e.slowT>0?.5:1);\\\\r\\\\n  if(e.boss){updBoss(e,dt,dx,dy,d,spd);return;}\\\\r\\\\n  if(e.v===5||tp.trail==='fire'){e.trT=(e.trT||0)-dt;if(e.trT<=0){e.trT=.7;A.pud.push({x:e.x,y:e.y,r:12,t:1.6,enemy:true,dmg:e.dmg*.25,c:'rgba(255,120,30,.3)'});}}\\\\r\\\\n  if(tp.heal){e.ab=(e.ab==null?3:e.ab)-dt;if(e.ab<=0){e.ab=4;addFx({k:'ring',x:e.x,y:e.y-8,t:.4,r:70,c:'#7ae04a'});for(const o of A.en)if(!o.dead&&!o.crate&&o!==e&&Math.hypot(o.x-e.x,o.y-e.y)<70){o.hp=Math.min(o.max,o.hp+o.max*.2);}}}\\\\r\\\\n  if(tp.horn||tp.rally){e.ab=(e.ab==null?2:e.ab)-dt;if(e.ab<=0){e.ab=5;addFx({k:'ring',x:e.x,y:e.y-8,t:.4,r:90,c:'#ffd45c'});for(const o of A.en)if(!o.dead&&Math.hypot(o.x-e.x,o.y-e.y)<90)o.buff=3;}}\\\\r\\\\n  if(e.st==='move'){\\\\r\\\\n    let mx=dx/d,my=dy/d;\\\\r\\\\n    if(tp.ranged){const want=e.range*.7;if(d<want*.6){mx=-mx;my=-my;}else if(d<e.range*.95){mx=0;my=0;}}\\\\r\\\\n    if(tp.body==='bat'||tp.fly){mx+=Math.cos(e.t*3)*.5;my+=Math.sin(e.t*2.3)*.5;}\\\\r\\\\n    e.x+=mx*spd*dt;e.y+=my*spd*dt;e.moving=!!(mx||my);\\\\r\\\\n    e.cool-=dt;\\\\r\\\\n    if(tp.charge&&e.cool<=0&&d>80&&d<230){e.st='dashw';e.wait=.5;e.ddx=dx/d;e.ddy=dy/d;return;}\\\\r\\\\n    if(e.cool<=0&&d<e.range+p.r+e.r*.4+(tp.ranged?0:6)){e.st='wind';e.wt=e.wait=Math.max(.2,tp.windup||.4);e.pr=0;}\\\\r\\\\n  }else if(e.st==='wind'){\\\\r\\\\n    e.wait-=dt;e.pr=(1-e.wait/e.wt)*.45;e.moving=false;\\\\r\\\\n    if(e.wait<=0){\\\\r\\\\n      if(tp.ranged)eShoot(e,tp.ranged,tp.fan||1);\\\\r\\\\n      else if(Math.hypot(p.x-e.x,p.y-e.y)<e.range+p.r+e.r+8)hurtT(p,e.dmg,e);\\\\r\\\\n      if(tp.slam){addFx({k:'ring',x:e.x,y:e.y,t:.4,r:55,c:'#c0392b'});if(AS.shake)A.shake=4;sfx('slam');if(d<55)hurtT(p,e.dmg,e);}\\\\r\\\\n      e.st='rec';e.wait=.3;}\\\\r\\\\n  }else if(e.st==='rec'){\\\\r\\\\n    e.wait-=dt;e.pr=.45+(1-e.wait/.3)*.55;\\\\r\\\\n    if(e.wait<=0){e.st='move';e.cool=rand(.9,1.7);e.pr=0;\\\\r\\\\n      if(tp.teleport&&Math.random()<.6){const a=Math.random()*6.28;addFx({k:'puff',x:e.x,y:e.y-10,t:.4,c:'#c070ff'});e.x=clamp(p.x+Math.cos(a)*160,EDGE+20,AW-EDGE-20);e.y=clamp(p.y+Math.sin(a)*120,WALL+20,AH-EDGE-20);addFx({k:'puff',x:e.x,y:e.y-10,t:.4,c:'#c070ff'});sfx('tele');}}\\\\r\\\\n  }else if(e.st==='dashw'){e.wait-=dt;e.moving=false;if(e.wait<=0){e.st='dash';e.wait=.55;}}\\\\r\\\\n  else if(e.st==='dash'){e.wait-=dt;e.x+=e.ddx*spd*4.2*dt;e.y+=e.ddy*spd*4.2*dt;e.moving=true;\\\\r\\\\n    if(d<p.r+e.r+4)hurtT(p,e.dmg*1.2,e);if(e.wait<=0){e.st='move';e.cool=rand(1.5,2.5);}}\\\\r\\\\n}\\\\r\\\\nfunction eShoot(e,kind,fan){\\\\r\\\\n  const p=tgtOf(e),a0=Math.atan2(p.y-10-(e.y-14),p.x-e.x),sp={bolt:260,arrow:230,dagger:240,potion:200,orb:150,coin:170,page:190,eye:210,bar:160}[kind]||200;\\\\r\\\\n  for(let i=0;i<fan;i++){const a=a0+(i-(fan-1)/2)*.22;\\\\r\\\\n    const b={k:kind,x:e.x,y:e.y-14*e.scale,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,dmg:e.dmg,life:3.5,r:kind==='orb'?6:4,src:e};\\\\r\\\\n    if(kind==='potion'){b.tx=p.x;b.ty=p.y;b.sx=b.x;b.sy=b.y;b.dur=Math.max(.3,Math.hypot(p.x-b.x,p.y-b.y)/sp);b.age=0;}\\\\r\\\\n    A.eproj.push(b);}\\\\r\\\\n  sfx('Attacco: '+(e.En?['Guardia','Ratto','Scheletro','Melma','Spadaccino','Fantasma','Cane','Ragno','Scudiero','Arciere','Pipistrello','Folletto','Libro','Balestriere','Carceriere','Candela','Forziere','Alabardiere','Assassino','Gargoyle','Quadro','Alchimista','Golem','Boia','Cavaliere'][e.En.s]:'Arciere'),.8);\\\\r\\\\n}\\\\r\\\\n/* --- boss ricchi e il Re: ogni boss ha i suoi 3-4 attacchi --- */\\\\r\\\\nfunction updBoss(e,dt,dx,dy,d,spd){\\\\r\\\\n  const p=tgtOf(e),ph2=e.hp<e.max/2,rk=e.boss==='rich'?BOSSES[e.bi].r:3;\\\\r\\\\n  if(e.st==='move'){\\\\r\\\\n    e.x+=dx/d*spd*(ph2?1.2:1)*dt;e.y+=dy/d*spd*(ph2?1.2:1)*dt;e.moving=true;\\\\r\\\\n    e.atkT-=dt;\\\\r\\\\n    if(e.atkT<=0){let k=pick(e.atkList);if(d<70&&e.atkList.includes('slam'))k='slam';e.atk=k;e.st='wind';e.wt=e.wait=k==='charge'?.7:.75;e.pr=0;e.ddx=dx/d;e.ddy=dy/d;\\\\r\\\\n      if(k==='goldRain')for(let i=0;i<8+rk*2;i++){const x=clamp(p.x+rand(-140,140),EDGE+20,AW-EDGE-20),y=clamp(p.y+rand(-100,100),WALL+20,AH-EDGE-20);A.events.push({t:.6+i*.08,k:'rain',x,y});addFx({k:'mark',x,y,t:.9,c:'#ffd45c'});}}\\\\r\\\\n  }else if(e.st==='wind'){\\\\r\\\\n    e.wait-=dt;e.pr=(1-e.wait/e.wt)*.45;e.moving=false;\\\\r\\\\n    if(e.wait<=0){const k=e.atk,ang=Math.atan2(dy,dx);\\\\r\\\\n      sfx('Boss: '+({coinFan:'Ventaglio di monete',goldRain:'Pioggia d\\\\\\\\'oro',summon:'Chiamata',charge:'Carica',orbRing:'Anello di sfere',barThrow:'Lingotti',spiral:'Spirale',slam:'Terremoto',bagBomb:'Sacco esplosivo',teleport:'Sparizione',swing:'Gong'}[k]||'Tintinnio'));\\\\r\\\\n      if(k==='swing'||k==='slam'){addFx({k:'ring',x:e.x,y:e.y-6,t:.4,r:80,c:'#ffd45c'});if(AS.shake)A.shake=5;if(d<80+p.r)hurtT(p,e.dmg*1.3,e);}\\\\r\\\\n      if(k==='coinFan'){const n=(ph2?11:7)+rk;for(let i=0;i<n;i++){const a=ang+(i-(n-1)/2)*.2;A.eproj.push({k:'coin',x:e.x,y:e.y-20,vx:Math.cos(a)*170,vy:Math.sin(a)*170,dmg:e.dmg*.45,life:4,r:5});}}\\\\r\\\\n      if(k==='orbRing'){const n=(ph2?18:12)+rk*2;for(let r=0;r<(ph2?2:1);r++)for(let i=0;i<n;i++){const a=i*Math.PI*2/n+r*.15;A.eproj.push({k:'orb',x:e.x,y:e.y-24,vx:Math.cos(a)*(130-r*30),vy:Math.sin(a)*(130-r*30),dmg:e.dmg*.5,life:5,r:6});}}\\\\r\\\\n      if(k==='spiral'){e.spir={n:28+rk*6,t:0,a:Math.random()*6};}\\\\r\\\\n      if(k==='barThrow'){for(let i=-1;i<=1;i++){const a=ang+i*.25;A.eproj.push({k:'bar',x:e.x,y:e.y-20,vx:Math.cos(a)*190,vy:Math.sin(a)*190,dmg:e.dmg*.9,life:4,r:7});}}\\\\r\\\\n      if(k==='bagBomb'){A.eproj.push({k:'bag',x:e.x,y:e.y-20,sx:e.x,sy:e.y-20,tx:p.x,ty:p.y,dur:.9,age:0,dmg:e.dmg*.8,r:6});}\\\\r\\\\n      if(k==='summon'){const n=3+Math.floor(rk/2);for(let i=0;i<n;i++){const a=i*Math.PI*2/n;queueAt(pickKind(),e.x+Math.cos(a)*60,e.y+Math.sin(a)*40);}}\\\\r\\\\n      if(k==='teleport'){addFx({k:'puff',x:e.x,y:e.y-20,t:.5,c:'#ffd45c',big:true});const a=Math.random()*6.28;e.x=clamp(p.x+Math.cos(a)*170,EDGE+40,AW-EDGE-40);e.y=clamp(p.y+Math.sin(a)*120,WALL+40,AH-EDGE-40);addFx({k:'puff',x:e.x,y:e.y-20,t:.5,c:'#ffd45c',big:true});}\\\\r\\\\n      if(k==='charge'){e.st='dash';e.wait=.7;e.ddx=dx/d;e.ddy=dy/d;return;}\\\\r\\\\n      e.st='rec';e.wait=.45;}\\\\r\\\\n  }else if(e.st==='rec'){e.wait-=dt;e.pr=.45+(1-e.wait/.45)*.55;if(e.wait<=0){e.st='move';e.pr=0;e.atkT=(ph2?1.4:2.1)*(1-rk*.05);}}\\\\r\\\\n  else if(e.st==='dash'){e.wait-=dt;e.x+=e.ddx*430*dt;e.y+=e.ddy*430*dt;e.moving=true;if(d<p.r+e.r+6)hurtT(p,e.dmg*1.2,e);if(e.wait<=0){e.st='rec';e.wait=.45;}}\\\\r\\\\n  if(e.spir){e.spir.t-=dt;if(e.spir.t<=0&&e.spir.n>0){e.spir.t=.05;e.spir.n--;e.spir.a+=.45;A.eproj.push({k:'coin',x:e.x,y:e.y-20,vx:Math.cos(e.spir.a)*150,vy:Math.sin(e.spir.a)*150,dmg:e.dmg*.35,life:4,r:5});}if(e.spir.n<=0)e.spir=null;}\\\\r\\\\n}\\\\r\\\\nfunction queueAt(k,x,y){A.spawns.push({k,how:'x',x:clamp(x,EDGE+12,AW-EDGE-12),y:clamp(y,WALL+12,AH-EDGE-12),t:.8});}\\\\r\\\\nfunction separate(){\\\\r\\\\n  const E=A.en,n=E.length;\\\\r\\\\n  for(let i=0;i<n;i++){const a=E[i];if(a.dead)continue;\\\\r\\\\n    for(let j=i+1;j<n;j++){const b=E[j];if(b.dead)continue;const dx=b.x-a.x,dy=b.y-a.y,m=a.r+b.r;if(dx*dx+dy*dy<m*m){const d=Math.sqrt(dx*dx+dy*dy)||.1,o=(m-d)/2,ux=dx/d,uy=dy/d;\\\\r\\\\n      const wa=a.crate?0:b.crate?1:a.boss?0:b.boss?1:.5;a.x-=ux*o*2*wa;a.y-=uy*o*2*wa;b.x+=ux*o*2*(1-wa);b.y+=uy*o*2*(1-wa);}}\\\\r\\\\n    if(!(a.entT>0&&a.ent==='door')){a.x=clamp(a.x,EDGE+a.r,AW-EDGE-a.r);a.y=clamp(a.y,WALL+a.r,AH-EDGE-a.r);}}\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* --- proiettili --- */\\\\r\\\\nfunction updProj(dt){\\\\r\\\\n  for(const b of A.proj){\\\\r\\\\n    if(b.xw){updXProj(b,dt);continue;}\\\\r\\\\n    if(b.k==='potion'){b.age+=dt;const u=Math.min(1,b.age/b.dur);b.x=lerp(b.sx,b.tx,u);b.y=lerp(b.sy,b.ty,u)-Math.sin(Math.PI*u)*40;\\\\r\\\\n      if(u>=1){b.dead=true;splash(b.tx,b.ty,b);}continue;}\\\\r\\\\n    if(b.wp.homing){const t=nearest(b.x,b.y,200);if(t){const a=Math.atan2(t.y-12-b.y,t.x-b.x),c=Math.atan2(b.vy,b.vx),na=angLerp(c,a,dt*6),s=Math.hypot(b.vx,b.vy);b.vx=Math.cos(na)*s;b.vy=Math.sin(na)*s;}}\\\\r\\\\n    b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;if(b.life<=0||b.x<0||b.x>AW||b.y<WALL-30||b.y>AH){b.dead=true;continue;}\\\\r\\\\n    for(const e of A.en){if(e.dead||b.hit.has(e)||(e.entT>0))continue;if(Math.hypot(e.x-b.x,e.y-10*e.scale-b.y)<e.r+b.r){b.hit.add(e);hitEnemy(e,b.dmg,b.crit,b.wp,b.x-b.vx,b.y-b.vy);\\\\r\\\\n      if(b.pierce-->0){b.dmg*=.7;}else{b.dead=true;break;}}}\\\\r\\\\n  }\\\\r\\\\n  A.proj=A.proj.filter(b=>!b.dead);\\\\r\\\\n}\\\\r\\\\n/* proiettili delle armi nuove: bomba ad arco, boomerang, rimbalzi, missili, vortice */\\\\r\\\\nfunction updXProj(b,dt){const w=b.xw,d=WX[w.id];\\\\r\\\\n  if(b.lob){b.age+=dt;const u=Math.min(1,b.age/b.dur);b.x=lerp(b.sx,b.tx,u);b.y=lerp(b.sy,b.ty,u)-Math.sin(Math.PI*u)*45;\\\\r\\\\n    if(u>=1){b.dead=true;const R=d.rad*stv('area')/100;addFx({k:'ring',x:b.tx,y:b.ty,t:.35,r:R,c:'#ff8a2a'});sfx('boom',.6);inR(b.tx,b.ty,R,e=>xHit(e,w,b.dmg,{x:b.tx,y:b.ty}));\\\\r\\\\n      if(d.shards)for(let i=0;i<d.shards;i++){const a=i*6.283/d.shards;A.proj.push({k:'emoji',ic:'🪙',x:b.tx,y:b.ty,vx:Math.cos(a)*220,vy:Math.sin(a)*220,life:.7,dmg:b.dmg*.4,xw:w,hit:new Set(),pierce:2,r:5,wp:{}});}}return;}\\\\r\\\\n  if(b.home){const t=nearest(b.x,b.y,240);if(t){const a=Math.atan2(t.y-12-b.y,t.x-b.x),c=Math.atan2(b.vy,b.vx),na=angLerp(c,a,dt*5),sp=Math.hypot(b.vx,b.vy);b.vx=Math.cos(na)*sp;b.vy=Math.sin(na)*sp;}}\\\\r\\\\n  if(b.boom){b.age=(b.age||0)+dt;if(b.age>.55&&!b.back){b.back=1;b.hit=new Set();}if(b.back){const a=Math.atan2(A.p.y-14-b.y,A.p.x-b.x),sp=Math.hypot(b.vx,b.vy);b.vx=Math.cos(a)*sp;b.vy=Math.sin(a)*sp;if(Math.hypot(A.p.x-b.x,A.p.y-14-b.y)<12){b.dead=true;return;}}}\\\\r\\\\n  b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;\\\\r\\\\n  if(b.bounce>0){if(b.x<EDGE||b.x>AW-EDGE){b.vx*=-1;b.bounce--;b.x=clamp(b.x,EDGE,AW-EDGE);}if(b.y<WALL||b.y>AH-EDGE){b.vy*=-1;b.bounce--;b.y=clamp(b.y,WALL,AH-EDGE);}}\\\\r\\\\n  if(b.life<=0||b.x<-20||b.x>AW+20||b.y<WALL-40||b.y>AH+20){b.dead=true;return;}\\\\r\\\\n  for(const e of A.en){if(e.dead||e.entT>0)continue;if(b.rehit){const k=b.hitT||(b.hitT=new Map()),t0=k.get(e)||-9;if(A.t-t0<b.rehit)continue;if(Math.hypot(e.x-b.x,e.y-10-b.y)<e.r+b.r){k.set(e,A.t);xHit(e,w,b.dmg,{x:b.x-b.vx*.05,y:b.y-b.vy*.05});}continue;}\\\\r\\\\n    if(b.hit.has(e))continue;if(Math.hypot(e.x-b.x,e.y-10*e.scale-b.y)<e.r+b.r){b.hit.add(e);xHit(e,w,b.dmg,{x:b.x-b.vx,y:b.y-b.vy});if(b.pierce-->0)b.dmg*=.8;else{b.dead=true;break;}}}}\\\\r\\\\nfunction splash(x,y,b){const R_=b.wp.aoe;addFx({k:'ring',x,y,t:.35,r:R_,c:'#7ae04a'});sfx('poison');\\\\r\\\\n  for(const e of A.en)if(!e.dead&&Math.hypot(e.x-x,e.y-y)<R_+e.r)hitEnemy(e,b.dmg,b.crit,b.wp,x,y);\\\\r\\\\n  A.pud.push({x,y,r:R_*.8,t:2.5,c:'rgba(90,200,70,.28)'});}\\\\r\\\\nfunction updEProj(dt){\\\\r\\\\n  const p=A.p;\\\\r\\\\n  for(const ev of A.events)if(ev.k==='xrain'&&ev.done&&!ev.hit){ev.hit=1;addFx({k:'ring',x:ev.x,y:ev.y,t:.35,r:ev.r,c:'#ff8a2a'});sfx('boom',.5);inR(ev.x,ev.y,ev.r,e=>xHit(e,ev.w,xDmg(ev.w)*(WX[ev.w.id].k==='smash'?1.5:1),{x:ev.x,y:ev.y}));}\\\\r\\\\n  for(const ev of A.events)if(ev.k==='rain'&&ev.done&&!ev.hit){ev.hit=1;addFx({k:'ring',x:ev.x,y:ev.y,t:.3,r:26,c:'#ffd45c'});sfx('Raccolta: Mucchio di monete',.6);if(Math.hypot(p.x-ev.x,p.y-ev.y)<26)hurtPlayer((A.boss?A.boss.dmg:dmgE(A.E))*.8);}\\\\r\\\\n  for(const b of A.eproj){\\\\r\\\\n    if(b.k==='potion'||b.k==='bag'){b.age+=dt;const u=Math.min(1,b.age/b.dur);b.x=lerp(b.sx,b.tx,u);b.y=lerp(b.sy,b.ty,u)-Math.sin(Math.PI*u)*50;\\\\r\\\\n      if(u>=1){b.dead=true;if(b.k==='bag'){sfx('boom');addFx({k:'ring',x:b.tx,y:b.ty,t:.35,r:40,c:'#ffd45c'});if(Math.hypot(p.x-b.tx,p.y-b.ty)<40)hurtPlayer(b.dmg);\\\\r\\\\n          for(let i=0;i<10;i++){const a=i*.628;A.eproj.push({k:'coin',x:b.tx,y:b.ty,vx:Math.cos(a)*140,vy:Math.sin(a)*140,dmg:b.dmg*.5,life:2.5,r:5});}}\\\\r\\\\n        else{A.pud.push({x:b.tx,y:b.ty,r:30,t:3,enemy:true,dmg:b.dmg*.6,c:'rgba(150,60,200,.32)'});addFx({k:'ring',x:b.tx,y:b.ty,t:.3,r:30,c:'#c070ff'});}}continue;}\\\\r\\\\n    b.x+=b.vx*dt;b.y+=b.vy*dt;b.life-=dt;\\\\r\\\\n    if(b.life<=0||b.x<0||b.x>AW||b.y<WALL-40||b.y>AH){b.dead=true;continue;}\\\\r\\\\n    if(Math.hypot(p.x-b.x,p.y-12-b.y)<p.r+b.r){b.dead=true;hurtPlayer(b.dmg,b.src);}\\\\r\\\\n    else for(const al of A.allies)if(!al.dead&&Math.hypot(al.x-b.x,al.y-12-b.y)<9+b.r){b.dead=true;hurtAlly(al,b.dmg);break;}\\\\r\\\\n  }\\\\r\\\\n  A.eproj=A.eproj.filter(b=>!b.dead);\\\\r\\\\n  for(const q of A.pud)q.t-=dt;A.pud=A.pud.filter(q=>q.t>0);\\\\r\\\\n}\\\\r\\\\n/* --- monete, cuori, cibo, forzieri --- */\\\\r\\\\nfunction updDrops(dt,all){\\\\r\\\\n  const p=A.p,pr=all?9999:stv('raccolta');\\\\r\\\\n  for(const d of A.drops){d.t+=dt;\\\\r\\\\n    if(d.vy!=null&&d.t<.3){d.y+=d.vy*dt;d.vy+=200*dt;}\\\\r\\\\n    const dd=Math.hypot(p.x-d.x,p.y-10-d.y)||1;\\\\r\\\\n    if((dd<pr||d.mag)&&(d.k==='xp'||all||dd<p.r+10)){d.mag=1;const s=(all?600:320)+d.t*60;d.x+=(p.x-d.x)/dd*s*dt;d.y+=(p.y-10-d.y)/dd*s*dt;}\\\\r\\\\n    if(dd<p.r+8){d.dead=true;collect(d);}\\\\r\\\\n  }\\\\r\\\\n  A.drops=A.drops.filter(d=>!d.dead);\\\\r\\\\n}\\\\r\\\\nfunction collect(d){\\\\r\\\\n  if(d.k==='xp'){gainXp(d.v*stv('esperienza')/100);sfx('Raccolta: Esperienza',.5);}\\\\r\\\\n  else if(d.k==='heart'){const h=Math.max(3,Math.round(maxHp()*.15));A.p.hp=Math.min(maxHp(),A.p.hp+h);addNum(A.p.x,A.p.y-40,sgn(h),NCOL.pos);sfx('heart');}\\\\r\\\\n  else if(d.k==='food'){const h=Math.max(2,Math.round(maxHp()*.1));A.p.hp=Math.min(maxHp(),A.p.hp+h);addNum(A.p.x,A.p.y-40,sgn(h),NCOL.pos);sfx('food');}\\\\r\\\\n  else if(d.k==='chest'){const it=rollItem(Math.min(3,1+(Math.random()<.25+(stv('fortuna')-10)/200?1:0)));giveItem(it.id);cineStart('chest',null,{it,x:d.x,y:d.y});sfx('chest');}\\\\r\\\\n}\\\\r\\\\n/* ogni livello: tutti i parametri +0,25% (in stv); ogni 5 livelli: livello bonus con 3 carte */\\\\r\\\\nfunction gainXp(v){A.xp+=v;while(A.xp>=xpNeed()){A.xp-=xpNeed();A.lvl++;sfx('lvl');addNum(A.p.x,A.p.y-50,'LIVELLO '+A.lvl+'!','#ffe28a',true);cineStart('lvup');\\\\r\\\\n    if(A.lvl%5===0)A.pendBonus=(A.pendBonus|0)+1;}\\\\r\\\\n  if(A.pendBonus>0&&A.state==='play'&&!A.cine&&A.p.hp>0)bonusTime();}\\\\r\\\\nfunction bonusTime(){A.pendBonus--;cineStart('bonus',()=>openCards('bonus',()=>{if(A.pendBonus>0)bonusTime();}));}\\\\r\\\\nfunction giveItem(id){const it=ITB[id];if(!it)return;A.items.push(id);addMods(it.m);A.p.hp=Math.min(A.p.hp,maxHp());}\\\\r\\\\nfunction rollItem(t){const pool=ITEMS.filter(i=>i.r-1===t);return pick(pool.length?pool:ITEMS);}\\\\r\\\\n/* --- effetti --- */\\\\r\\\\nfunction addFx(f){f.t0=f.t;A.fx.push(f);if(A.fx.length>220)A.fx.shift();}\\\\r\\\\nfunction addNum(x,y,s,c,big){A.nums.push({x,y,s,c,big,t:.75});if(A.nums.length>90)A.nums.shift();}\\\\r\\\\nfunction updFx(dt){tickAnims(dt);for(const f of A.fx)f.t-=dt;A.fx=A.fx.filter(f=>f.t>0);for(const n of A.nums){n.t-=dt;n.y-=28*dt;}A.nums=A.nums.filter(n=>n.t>0);}\\\\r\\\\n\\\\r\\\\n/* ===== Morte: rialzarsi con le monete di KING TOWER ===== */\\\\r\\\\nconst REVIVE_COST=100;\\\\r\\\\nfunction playerDown(){if(A.state!=='play')return;\\\\r\\\\n  if(!A.revived&&wallet()>=REVIVE_COST&&!window.ARENA_BOT){A.state='revive';showOv('revive');$('#rv-txt').innerHTML='Hai '+fmt(wallet())+' monete di KING TOWER. Rialzarsi costa '+REVIVE_COST+' monete.';return;}\\\\r\\\\n  cineStart('death',()=>gameOver(false));}\\\\r\\\\nfunction doRevive(){walletAdd(-REVIVE_COST);A.revived=true;A.p.hp=maxHp();A.p.inv=2.5;A.state='play';showOv(null);\\\\r\\\\n  for(const e of A.en)if(!e.boss&&!e.crate&&Math.hypot(e.x-A.p.x,e.y-A.p.y)<120){e.kbx+=(e.x-A.p.x)*4;e.kby+=(e.y-A.p.y)*4;}\\\\r\\\\n  addFx({k:'ring',x:A.p.x,y:A.p.y-8,t:.6,r:120,c:'#ffd45c'});sfx('heal');}\\\\r\\\\n\\\\r\\\\n/* ===== Fine ondata e fine livello (niente negozio: i parametri salgono solo con le carte) ===== */\\\\r\\\\nfunction endWave(){\\\\r\\\\n  for(const d of A.drops)collect(d);A.drops=[];A.en=A.en.filter(e=>!e.crate);\\\\r\\\\n  if(A.wv===WAVES){levelDone();return;}\\\\r\\\\n  const[l,w]=nextPos();startWave(l,w);\\\\r\\\\n}\\\\r\\\\n/* boss sconfitto: prima l'animazione, poi la scritta e 3 carte dei boss, poi il riepilogo con Continua / Esci */\\\\r\\\\nfunction levelDone(){const l=A.level,D=DIFFS[A.diff];\\\\r\\\\n  let prize=D.coins;if(prize&&Math.random()*100<stv('ricchezza'))prize++;\\\\r\\\\n  const pts=20+A.pts;A.pts=0;A.lvPrize=prize;A.lvPts=pts;\\\\r\\\\n  if(l>(AS.top|0))AS.top=l;AS.unlocked=Math.max(AS.unlocked|0,Math.min(MAXL,l+1));\\\\r\\\\n  if(A.won||l>=MAXL){walletAdd(prize);AS.pts=(AS.pts|0)+pts;asSave();cineStart('victory',()=>gameOver(true));return;}\\\\r\\\\n  cineStart('bossdown',()=>openCards('boss',()=>levelSummary()));\\\\r\\\\n}\\\\r\\\\nfunction levelSummary(){A.state='lvdone';const l=A.level;\\\\r\\\\n  $('#ld-t').textContent='Livello '+l+' completato!';\\\\r\\\\n  $('#ld-s').innerHTML='Boss sconfitto: <b>'+(A.lastBoss||'')+'</b><br>Monete di KING TOWER: '+numH(A.lvPrize)+' <span class=\\\\\\\"small\\\\\\\">('+DIFFS[A.diff].n+')</span> · Punti: '+numH(A.lvPts)+\\\\r\\\\n    '<br><span class=\\\\\\\"small\\\\\\\">«Continua» salva tutto e va al livello '+(l+1)+'. «Esci» torna al menu senza salvare questo livello.</span>';\\\\r\\\\n  showOv('lvdone');musicPlay(TR_SHOP);sfx('clear');\\\\r\\\\n  if(window.ARENA_BOT)setTimeout(()=>{if(A.state==='lvdone')$('#ld-go').click();},30);}\\\\r\\\\nfunction levelContinue(){walletAdd(A.lvPrize);AS.pts=(AS.pts|0)+A.lvPts;AS.ptsTot=(AS.ptsTot|0)+A.lvPts;A.earned=(A.earned||0)+A.lvPrize;\\\\r\\\\n  const l=A.level+1;A.level=l;saveRun();A.state='play';showOv(null);\\\\r\\\\n  if(bgOfLevel(l)%20===0){startWave(l,1,true);cineStart('travel',()=>{A.banner={t:2.4,a:'Livello '+l,b:bgName(bgOfLevel(l))};sfx('wave');});}\\\\r\\\\n  else startWave(l,1);}\\\\r\\\\nfunction levelExit(){openMenu();}\\\\r\\\\nfunction showOv(id){for(const o of document.querySelectorAll('.ov'))o.classList.toggle('on',o.id===id);\\\\r\\\\n  document.body.classList.toggle('inmenu',id==='menu');}\\\\r\\\\nfunction toast(s,ms){const t=$('#toast');t.textContent=s;t.style.display='block';clearTimeout(toast._t);toast._t=setTimeout(()=>t.style.display='none',ms||2200);}\\\\r\\\\nfunction tierRoll(){const E=A.E,l=1+(stv('fortuna')-10)/100,r=Math.random();\\\\r\\\\n  const p4=Math.max(0,(E-8)*.004)*l,p3=Math.max(0,(E-3)*.012)*l,p2=Math.min(.5,(E*.02+.12)*l);\\\\r\\\\n  return r<p4?3:r<p4+p3?2:r<p4+p3+p2?1:0;}\\\\r\\\\nfunction weapIcon(id,tier,w){if(WX[id]){const[c,g]=hdCanvas(w||120,Math.round((w||120)*.5));g.font=Math.round((w||120)*.36)+'px \\\\\\\"Segoe UI Emoji\\\\\\\",\\\\\\\"Apple Color Emoji\\\\\\\",serif';g.textAlign='center';g.textBaseline='middle';g.fillText(WX[id].ic,c.width/2,c.height/2);return c;}\\\\r\\\\n  const s=wSprite(id,tier),[c,g]=hdCanvas(w||120,Math.round((w||120)*.5));g.imageSmoothingEnabled=true;\\\\r\\\\n  const k=(w||120)/150*2.1;g.translate(c.width*.1,c.height*.82);g.rotate(-.42);g.drawImage(s.c,-30*k,-32*k,s.w*k,s.h*k);return c;}\\\\r\\\\n/* la lista dei 30 parametri (in alto a destra e in pausa) */\\\\r\\\\nfunction statsHtml(){return`<div><span>⭐ Livello</span><b class=\\\\\\\"nz\\\\\\\">${A.lvl}</b></div><div><span>❤️ Vita</span><b class=\\\\\\\"nz\\\\\\\">${Math.ceil(A.p.hp)}/${maxHp()}</b></div>`+\\\\r\\\\n  PARAMS.map(p=>{const v=stv(p[0]),b=p[3],d=v-b;return`<div title=\\\\\\\"${p[6]}\\\\\\\"><span>${p[2]} ${p[1]}</span><b class=\\\\\\\"nz\\\\\\\">${Math.round(v*10)/10}${p[4]?'%':''}</b>${Math.abs(d)>=.05?numH(d):''}</div>`;}).join('');}\\\\r\\\\n/* ===== Pausa e fine ===== */\\\\r\\\\nfunction pauseGame(){if(A.state!=='play')return;A.state='pause';$('#p-stats').innerHTML=statsHtml();$('#p-vol').value=AS.vol;showOv('pause');}\\\\r\\\\nfunction resumeGame(){A.state='play';showOv(null);for(const k in K)K[k]=0;}\\\\r\\\\nfunction gameOver(win){\\\\r\\\\n  if(A.state==='end')return;A.state='end';if(NET.on){if(NET.role==='host')netAll({t:'end',win});setTimeout(netStop,500);}\\\\r\\\\n  const reached=win?MAXL+1:A.level,prev=AS.best[A.ci]||0;if(reached>prev)AS.best[A.ci]=reached;if(win){AS.wins++;AS.run=null;}\\\\r\\\\n  AS.pts=(AS.pts|0)+A.pts;AS.ptsTot=(AS.ptsTot|0)+A.pts;asSave();\\\\r\\\\n  sfx(win?'win':'die');musicPlay(win?TR_WIN:TR_MENU);\\\\r\\\\n  $('#e-t').textContent=win?'Il Re è sconfitto!':'Sei caduto…';\\\\r\\\\n  $('#e-s').innerHTML=(win?'1000 livelli! L\\\\\\\\'arena è tua. ':'Livello '+A.level+', ondata '+A.wv+' · ')+DIFFS[A.diff].n+'<br>Nemici sconfitti: '+fmt(A.kills)+' · Livello di esperienza '+A.lvl+\\\\r\\\\n    '<br>Monete portate a KING TOWER: '+numH(A.earned||0)+' · Punti: '+numH(A.pts)+\\\\r\\\\n    '<br>'+A.weapons.map(w=>`<span class=\\\\\\\"t${w.tier}\\\\\\\">${wName(w.id)}</span>`).join(' · ');\\\\r\\\\n  const rb=$('#e-retry');rb.style.display=!win&&AS.run?'':'none';if(AS.run)rb.textContent='Riprova dal livello '+(AS.run.level);\\\\r\\\\n  showOv('end');\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* ===== Disegno ===== */\\\\r\\\\nfunction render(){\\\\r\\\\n  const g=ctx;g.setTransform(1,0,0,1,0,0);g.fillStyle='#000';g.fillRect(0,0,cv.width,cv.height);\\\\r\\\\n  if(!FLOOR){A.theme=0;buildFloor(0);}\\\\r\\\\n  const cam=A.cam,sk=AS.shake?A.shake:0,sx=sk?rand(-sk,sk):0,sy=sk?rand(-sk,sk):0;\\\\r\\\\n  const inMenu=['menu','select','help','skins','levels','opts','story','admin','cart','relics','mp'].includes(A.state);\\\\r\\\\n  if(inMenu){const side=.5;cam.x=clamp(AW/2-VW*side+Math.sin(performance.now()/5000)*60,0,AW-VW);cam.y=AH/2-VH/2;}\\\\r\\\\n  g.setTransform(SC,0,0,SC,OX-(cam.x+sx)*SC,OY-(cam.y+sy)*SC);\\\\r\\\\n  g.imageSmoothingEnabled=true;\\\\r\\\\n  const cx=clamp(cam.x,0,AW-VW),cy=clamp(cam.y,0,AH-VH);\\\\r\\\\n  const vx0=cx-50,vx1=cx+VW+50,vy0=cy-30,vy1=cy+VH+80;\\\\r\\\\n  g.drawImage(FLOOR,cx*2,cy*2,VW*2,VH*2,cx,cy,VW,VH);\\\\r\\\\n  const T=performance.now()/1000,LC=BG?BG.light:LIGHTS[0];\\\\r\\\\n  for(const x of TORCH){const f=Math.sin(T*13+x)*1.5;\\\\r\\\\n    const gr=g.createRadialGradient(x,40,2,x,40,70);gr.addColorStop(0,'rgba(255,170,60,.28)');gr.addColorStop(1,'rgba(255,140,40,0)');g.fillStyle=gr;g.fillRect(x-70,-30,140,140);\\\\r\\\\n    g.fillStyle=LC[0];g.beginPath();g.ellipse(x,38+f*.3,4,8+f,0,0,6.283);g.fill();g.fillStyle='#ffe28a';g.beginPath();g.ellipse(x,41,2,4,0,0,6.283);g.fill();}\\\\r\\\\n  if(inMenu){drawMenuScene(g,T,cam);return;}\\\\r\\\\n  for(const q of A.pud){g.fillStyle=q.c;g.globalAlpha=Math.min(1,q.t);g.beginPath();g.ellipse(q.x,q.y,q.r,q.r*.55,0,0,6.283);g.fill();g.globalAlpha=1;}\\\\r\\\\n  // segni di arrivo dei nemici: X rossa, botola che trema, porta che si apre\\\\r\\\\n  for(const s of A.spawns){const a=.5+.5*Math.sin(T*16);\\\\r\\\\n    if(s.how==='x'){g.strokeStyle=`rgba(220,40,40,${.5+a*.4})`;g.lineWidth=2.2;g.beginPath();g.moveTo(s.x-6,s.y-6);g.lineTo(s.x+6,s.y+6);g.moveTo(s.x+6,s.y-6);g.lineTo(s.x-6,s.y+6);g.stroke();}\\\\r\\\\n    else if(s.how==='trap'){g.fillStyle=`rgba(0,0,0,${.4+a*.3})`;g.fillRect(s.x-14+rand(-1,1),s.y-10,28,20);}\\\\r\\\\n    else{g.fillStyle=`rgba(255,200,80,${.15+a*.2})`;g.beginPath();g.ellipse(s.x,WALL-6,22,8,0,0,6.283);g.fill();}}\\\\r\\\\n  for(const f of A.fx)if(f.k==='mark'){g.strokeStyle=f.c;g.globalAlpha=.4+.4*Math.sin(T*20);g.lineWidth=1.5;g.beginPath();g.ellipse(f.x,f.y,26,12,0,0,6.283);g.stroke();g.globalAlpha=1;}\\\\r\\\\n  for(const d of A.drops){if(d.x<vx0||d.x>vx1||d.y<vy0||d.y>vy1)continue;\\\\r\\\\n    if(d.k==='xp'){const s=gemSpr(d.v),bob=Math.sin(d.t*5+d.x)*1.5;g.drawImage(s.c,d.x-s.w/2,d.y-s.h+bob,s.w,s.h);}\\\\r\\\\n    else if(d.k==='coin'){const bob=Math.sin(d.t*5+d.x)*1.5;drawCoinIcon(g,d.x,d.y-4+bob,3.6,d.t);}\\\\r\\\\n    else if(d.k==='heart')drawHeart(g,d.x-6,d.y-12,1);\\\\r\\\\n    else if(d.k==='food'){g.font='12px serif';g.textAlign='center';g.fillText(['🍎','🍗','🧀','🍞'][Math.floor(d.x)%4],d.x,d.y);}\\\\r\\\\n    else if(d.k==='chest'){g.fillStyle='#6a3a1a';g.fillRect(d.x-9,d.y-12,18,12);g.fillStyle='#d8a93a';g.fillRect(d.x-9,d.y-12,18,3);g.fillRect(d.x-1,d.y-9,3,4);g.strokeStyle='#2a1408';g.lineWidth=1;g.strokeRect(d.x-9,d.y-12,18,12);}\\\\r\\\\n  }\\\\r\\\\n  /* i mostri fuori dallo schermo non si disegnano (si muovono e ti cercano lo stesso): meno lavoro, niente scatti */\\\\r\\\\n  const list=A.en.filter(e=>!e.dead&&e.x>vx0&&e.x<vx1&&e.y>vy0&&e.y<vy1).map(e=>({y:e.y,e}));\\\\r\\\\n  if(A.state!=='end'||A.p.hp>0)list.push({y:A.p.y,pl:true});\\\\r\\\\n  for(const al of A.allies)if(!al.dead||al.hp>0)list.push({y:al.y,al});\\\\r\\\\n  list.sort((a,b)=>a.y-b.y);\\\\r\\\\n  for(const it of list){if(it.pl)drawPlayer(g,T);else if(it.al)drawAlly(g,it.al,T);else drawEnemy(g,it.e,T);}\\\\r\\\\n  for(const b of A.proj){if(b.k==='emoji')drawXProj(g,b);else drawProj(g,b,false);}\\\\r\\\\n  for(const b of A.eproj)if(b.x>vx0&&b.x<vx1&&b.y>vy0&&b.y<vy1)drawProj(g,b,true);\\\\r\\\\n  for(const ev of A.events)if(ev.k==='rain'&&!ev.done){const u=1-ev.t/.6;drawCoinIcon(g,ev.x,ev.y-120*(1-clamp(u,0,1)),5,T);}\\\\r\\\\n  for(const f of A.fx){const u=1-f.t/f.t0;\\\\r\\\\n    if(f.k==='ring'){g.strokeStyle=f.c;g.globalAlpha=1-u;g.lineWidth=3;g.beginPath();g.ellipse(f.x,f.y,f.r*(.3+.7*u),f.r*(.3+.7*u)*.6,0,0,6.283);g.stroke();g.globalAlpha=1;}\\\\r\\\\n    else if(f.k==='arc'){g.strokeStyle=f.c;g.globalAlpha=1-u;g.lineWidth=4;g.beginPath();g.arc(f.x,f.y,f.r*(.5+.5*u),f.a-.9,f.a+.9);g.stroke();g.globalAlpha=1;}\\\\r\\\\n    else if(f.k==='bolt'){g.strokeStyle=f.c;g.globalAlpha=1-u;g.lineWidth=2.5;g.beginPath();g.moveTo(f.x,f.y);for(let k=1;k<6;k++){const q=k/6;g.lineTo(lerp(f.x,f.x2,q)+rand(-6,6),lerp(f.y,f.y2,q)+rand(-6,6));}g.lineTo(f.x2,f.y2);g.stroke();g.globalAlpha=1;}\\\\r\\\\n    else if(f.k==='beam'){g.strokeStyle=f.c;g.globalAlpha=(1-u)*.85;g.lineWidth=(f.w||7)*(1-u*.5);g.beginPath();g.moveTo(f.x,f.y);g.lineTo(f.x+Math.cos(f.a)*f.L,f.y+Math.sin(f.a)*f.L);g.stroke();g.globalAlpha=1;}\\\\r\\\\n    else if(f.k==='cone'){g.fillStyle=f.c;g.globalAlpha=1-u;g.beginPath();g.moveTo(f.x,f.y);g.arc(f.x,f.y,f.r*(.6+.4*u),f.a-.55,f.a+.55);g.closePath();g.fill();g.globalAlpha=1;}\\\\r\\\\n    else if(f.k==='puff'){g.fillStyle=f.c;g.globalAlpha=(1-u)*.7;for(let i=0;i<6;i++){const a=i*1.05,r=(f.big?18:9)*u+3;g.beginPath();g.arc(f.x+Math.cos(a)*r,f.y+Math.sin(a)*r*.6,(f.big?6:3.5)*(1-u*.5),0,6.283);g.fill();}g.globalAlpha=1;}}\\\\r\\\\n  drawCineWorld(g,T);\\\\r\\\\n  g.textAlign='center';\\\\r\\\\n  for(const n of A.nums){g.globalAlpha=Math.min(1,n.t*2.5);g.font=(n.big?'bold 10px':'bold 8px')+' Georgia, serif';g.fillStyle='#000';g.fillText(n.s,n.x+.7,n.y+.7);g.fillStyle=n.c;g.fillText(n.s,n.x,n.y);}\\\\r\\\\n  g.globalAlpha=1;\\\\r\\\\n  drawHUD(g,T);\\\\r\\\\n  drawCineScreen(g,T);\\\\r\\\\n}\\\\r\\\\nfunction drawCoinIcon(g,x,y,r,t){const s=Math.abs(Math.sin((t||0)*4+x))*.6+.4;g.fillStyle='#8a5a10';g.beginPath();g.ellipse(x,y,r*s+.6,r+.6,0,0,6.283);g.fill();\\\\r\\\\n  g.fillStyle='#e8b22a';g.beginPath();g.ellipse(x,y,r*s,r,0,0,6.283);g.fill();g.fillStyle='#ffe28a';g.beginPath();g.ellipse(x-r*.25*s,y-r*.25,r*.45*s,r*.45,0,0,6.283);g.fill();}\\\\r\\\\nfunction drawPlayer(g,T){\\\\r\\\\n  const p=A.p;if(p.inv>0&&A.state==='play'&&Math.floor(T*20)%2)g.globalAlpha=.55;\\\\r\\\\n  const pose=A.p.hp<=0?'hurt':p.moving?'run':'idle';\\\\r\\\\n  drawToonGuard(g,p.x,p.y,{skin:A.skin,face:p.face,t:p.t,pose,scale:1});\\\\r\\\\n  g.globalAlpha=1;\\\\r\\\\n  if(A.p.hp>0)for(const w of A.weapons){if(WX[w.id])drawX(g,w,T);else drawWeap(g,w);}\\\\r\\\\n}\\\\r\\\\nfunction wSprite(id,tier){return sprGet('aw|'+id+'|'+tier,150,64,c=>drawWeapon(c,id,30,32,0,IRON),TOUT[tier]);}\\\\r\\\\nfunction drawWeap(g,w){const wp=WP[w.id],s=wSprite(w.id,w.tier),a=w.anim>0?w.aang:w.ang;let x=w.hx,y=w.hy;\\\\r\\\\n  if(w.anim>0&&wp.cls==='melee'){const k=Math.sin(Math.PI*(1-w.anim/w.adur));x+=Math.cos(a)*w.reach*k;y+=Math.sin(a)*w.reach*k;}\\\\r\\\\n  if(w.anim>0&&wp.cls!=='melee'){const k=w.anim/w.adur;x-=Math.cos(a)*3*k;y-=Math.sin(a)*3*k;}\\\\r\\\\n  g.save();g.translate(x,y);g.rotate(a);if(Math.cos(a)<0)g.scale(1,-1);const k=.82;g.drawImage(s.c,-30*.5*k,-32*.5*k,s.w*.5*k,s.h*.5*k);g.restore();}\\\\r\\\\nfunction drawEnemy(g,e,T){\\\\r\\\\n  const tp=e.tp,x=e.x,y=e.y;\\\\r\\\\n  if(e.crate){g.save();if(e.hurt>0)g.filter='brightness(1.8)';tShadow(g,x,y,11);\\\\r\\\\n    if(e.barrel){g.fillStyle='#7a4a22';g.beginPath();g.ellipse(x,y-10,9,11,0,0,6.283);g.fill();g.strokeStyle='#3a2410';g.lineWidth=1.2;g.stroke();g.fillStyle='#4a4f56';g.fillRect(x-9,y-15,18,2);g.fillRect(x-9,y-6,18,2);}\\\\r\\\\n    else{g.fillStyle='#8a5a2a';g.fillRect(x-10,y-18,20,18);g.strokeStyle='#3a2410';g.lineWidth=1.2;g.strokeRect(x-10,y-18,20,18);g.beginPath();g.moveTo(x-10,y-18);g.lineTo(x+10,y);g.moveTo(x+10,y-18);g.lineTo(x-10,y);g.stroke();}\\\\r\\\\n    g.restore();return;}\\\\r\\\\n  // entrata: dalla botola il nemico sale, dalla porta scende camminando\\\\r\\\\n  let rise=1;if(e.entT>0&&e.ent==='trap'){rise=1-e.entT/.6;g.save();g.beginPath();g.rect(x-30,y-80,60,80);g.clip();g.translate(0,(1-rise)*40);}\\\\r\\\\n  if(e.champ||e.tier){g.strokeStyle='rgba(255,212,92,.75)';g.lineWidth=1.6;g.beginPath();g.ellipse(x,y,e.r+4,(e.r+4)*.45,0,0,6.283);g.stroke();}\\\\r\\\\n  if(e.hurt>0)g.filter='brightness(2.4)';\\\\r\\\\n  if(tp.ghost||e.sp.ghost)g.globalAlpha=.78;\\\\r\\\\n  if(e.boss==='rich')drawBossToon(g,e);\\\\r\\\\n  else if(tp.body==='toon')drawToonMon(g,e);\\\\r\\\\n  else if(tp.body==='rat'){const f=(Math.floor(e.t*12)%10)*4;g.save();g.translate(x,y);if(e.face<0)g.scale(-1,1);g.scale(e.scale,e.scale);g.fillStyle='rgba(0,0,0,.25)';g.fillRect(-12,-1,24,2);sprDraw(g,ratSprite(f),0,0,35,36);g.restore();}\\\\r\\\\n  else if(tp.body==='bat'){const f=(Math.floor(e.t*12)%12)*3;g.fillStyle='rgba(0,0,0,.22)';g.fillRect(x-8,y-1,16,2);sprDraw(g,batSprite(f),x,y-24-Math.sin(e.t*3)*4,40,25,{face:e.face,scale:e.scale});}\\\\r\\\\n  else if(tp.body==='dog')drawDog(g,x,y,{face:e.face,t:e.t,pose:e.st==='wind'||e.st==='rec'?'attack':e.moving?'run':'idle',iron:A.level>=12||e.v===1});\\\\r\\\\n  else{const atk=e.st==='wind'||e.st==='rec'||(e.boss&&e.st==='dash');\\\\r\\\\n    const pose=e.stun>0?'hurt':atk?(tp.ranged&&!e.boss?'shoot':'attack'):e.moving?'walk':'idle';\\\\r\\\\n    drawHuman(g,x,y,{face:e.face,t:e.t,pose,pr:e.pr,pal:e.pal,weapon:e.weapon,scale:.78*e.scale,shadow:true,alert:e.st==='wind'});\\\\r\\\\n    if(tp.shield)drawShield(g,x,y,e.face,.78*e.scale,!!e.elite);}\\\\r\\\\n  if(e.En&&e.v&&tp.body!=='toon'&&!e.boss){const s=tSpr('vo|'+e.v+'|'+(Math.floor(e.t*8)%8),48,56,gg=>varOverlay(gg,e.v,Math.floor(e.t*8)%8));tDraw(g,s,x,y,24,52,.6*e.scale,1);}\\\\r\\\\n  if(e.dashw||(e.st==='dashw')||(e.boss&&e.st==='wind'&&e.atk==='charge')){g.strokeStyle='rgba(220,40,40,.5)';g.lineWidth=e.r;g.beginPath();g.moveTo(x,y-6);g.lineTo(x+e.ddx*200,y-6+e.ddy*200);g.stroke();}\\\\r\\\\n  if(e.stun>0)drawStars(g,x,y-40*e.scale,e.t);\\\\r\\\\n  g.filter='none';g.globalAlpha=1;\\\\r\\\\n  if(e.entT>0&&e.ent==='trap')g.restore();\\\\r\\\\n  // il punto esclamativo di KING TOWER quando ti vede\\\\r\\\\n  if(e.alertT>0&&!e.boss){const a=Math.min(1,e.alertT*3);g.globalAlpha=a;g.fillStyle='#ffe28a';g.strokeStyle='#1b120c';g.lineWidth=2;g.font='bold 14px Georgia';g.textAlign='center';\\\\r\\\\n    g.strokeText('!',x,y-44*e.scale);g.fillText('!',x,y-44*e.scale);g.globalAlpha=1;}\\\\r\\\\n  if(e.buff>0){g.fillStyle='#ffd45c';g.fillRect(x-1,y-44*e.scale,2,4);}\\\\r\\\\n  if(e.mark>0){g.font='9px serif';g.textAlign='center';g.fillText('🧿',x+10,y-36*e.scale);}\\\\r\\\\n  if(e.slowT>0){g.fillStyle='rgba(150,220,255,.35)';g.beginPath();g.ellipse(x,y,e.r+2,(e.r+2)*.45,0,0,6.283);g.fill();}\\\\r\\\\n  if((e.elite||e.champ)&&!e.boss){const w=34,u=clamp(e.hp/e.max,0,1),yy=y-50*e.scale;g.fillStyle='#000a';g.fillRect(x-w/2-1,yy-1,w+2,5);g.fillStyle='#c0392b';g.fillRect(x-w/2,yy,w*u,3);}\\\\r\\\\n}\\\\r\\\\nfunction drawProj(g,b,en){\\\\r\\\\n  g.save();g.translate(b.x,b.y);const a=Math.atan2(b.vy||0,b.vx||1);\\\\r\\\\n  switch(b.k){\\\\r\\\\n    case'bullet':g.fillStyle='#ffe28a';g.beginPath();g.arc(0,0,2.4,0,6.283);g.fill();g.strokeStyle='rgba(255,226,138,.4)';g.lineWidth=2;g.beginPath();g.moveTo(0,0);g.lineTo(-b.vx*.02,-b.vy*.02);g.stroke();break;\\\\r\\\\n    case'arrow':case'bolt':g.rotate(a);g.fillStyle=en?'#7a4a2a':'#8a6a3a';g.fillRect(-9,-.8,14,b.k==='bolt'?2.2:1.6);g.fillStyle='#d8dde2';g.beginPath();g.moveTo(8,0);g.lineTo(4,-2.5);g.lineTo(4,2.5);g.fill();g.fillStyle=en?'#c0392b':'#e8e0d0';g.fillRect(-10,-2,3,4);break;\\\\r\\\\n    case'dagger':g.rotate(performance.now()/60);g.fillStyle='#d8dde2';g.beginPath();g.moveTo(7,0);g.lineTo(-2,-2);g.lineTo(-2,2);g.fill();g.fillStyle='#5a3a22';g.fillRect(-6,-1.2,4,2.4);break;\\\\r\\\\n    case'orb':{const gr=g.createRadialGradient(0,0,0,0,0,8);gr.addColorStop(0,'#fff6ff');gr.addColorStop(.4,en?'#ff6aa0':'#d07aff');gr.addColorStop(1,'rgba(120,40,200,0)');g.fillStyle=gr;g.beginPath();g.arc(0,0,8,0,6.283);g.fill();break;}\\\\r\\\\n    case'potion':g.fillStyle=en?'#a050e0':'#4ac24a';g.beginPath();g.arc(0,0,3.5,0,6.283);g.fill();g.fillStyle='rgba(255,255,255,.7)';g.fillRect(-1.5,-2.5,1.5,1.5);g.fillStyle='#8a6a3a';g.fillRect(-1,-5.5,2,2.5);break;\\\\r\\\\n    case'coin':drawCoinIcon(g,0,0,4.5,performance.now()/1000);break;\\\\r\\\\n    case'bar':g.rotate(performance.now()/120);g.fillStyle='#e8b22a';g.strokeStyle='#8a5a10';g.lineWidth=1;g.beginPath();g.moveTo(-7,3);g.lineTo(7,3);g.lineTo(5,-3);g.lineTo(-5,-3);g.closePath();g.fill();g.stroke();break;\\\\r\\\\n    case'bag':g.fillStyle='#8a6a3a';g.beginPath();g.arc(0,0,6,0,6.283);g.fill();g.strokeStyle='#3a2410';g.stroke();g.fillStyle='#ffd45c';g.font='bold 8px Georgia';g.textAlign='center';g.fillText('$',0,3);break;\\\\r\\\\n    case'page':g.rotate(performance.now()/100);g.fillStyle='#f4ecd8';g.fillRect(-4,-5,8,10);g.fillStyle='#9a8a6a';g.fillRect(-2,-3,4,1);g.fillRect(-2,0,4,1);break;\\\\r\\\\n    case'eye':g.fillStyle='#fff';g.beginPath();g.ellipse(0,0,5,3.5,a,0,6.283);g.fill();g.fillStyle='#c0392b';g.beginPath();g.arc(Math.cos(a)*1.5,Math.sin(a)*1.5,2,0,6.283);g.fill();break;\\\\r\\\\n  }g.restore();}\\\\r\\\\nfunction drawMenuScene(g,T,cam){\\\\r\\\\n  // la guardia a cartone e i mostri che passano (sul telefono la guardia sta a sinistra, il menu a destra)\\\\r\\\\n  const cx=cam.x+VW*.72,cy=AH/2+40;\\\\r\\\\n  drawToonGuard(g,cx,cy,{skin:AS.skin,face:-1,t:T,pose:'idle',scale:1.6});\\\\r\\\\n  const n=8;for(let i=0;i<n;i++){const E=ENEMIES[(i*37+Math.floor(T/9)*11)%200],x=cam.x-60+((T*28+i*110)%(VW+120)),y=cy+60+(i%3)*12;\\\\r\\\\n    const e={En:E,sp:E.sp,v:E.v,tp:enemyTp(E),x,y,t:T+i,face:1,scale:.9,r:9,moving:true,st:'move',pal:tintPal((enemyTp(E).pal)||GUARD_PALS[0],E.va.tint),weapon:enemyTp(E).weapon||'none'};\\\\r\\\\n    drawEnemy(g,e,T);}\\\\r\\\\n}\\\\r\\\\nfunction drawHUD(g,T){\\\\r\\\\n  g.setTransform(SC,0,0,SC,OX,OY);const p=A.p;\\\\r\\\\n  const hw=Math.min(120,VW*.26),u=clamp(p.hp/maxHp(),0,1);\\\\r\\\\n  g.fillStyle='#000b';g.fillRect(8,8,hw+4,14);g.fillStyle='#4a0c0c';g.fillRect(10,10,hw,10);g.fillStyle='#d83a2a';g.fillRect(10,10,hw*u,10);g.fillStyle='rgba(255,255,255,.25)';g.fillRect(10,10,hw*u,3);\\\\r\\\\n  g.font='bold 8px Georgia, serif';g.textAlign='center';g.fillStyle='#fff';g.fillText(Math.ceil(p.hp)+' / '+maxHp(),10+hw/2,18);\\\\r\\\\n  const xu=clamp(A.xp/xpNeed(),0,1);g.fillStyle='#000b';g.fillRect(8,24,hw+4,9);g.fillStyle='#0f3a22';g.fillRect(10,26,hw,5);g.fillStyle='#3ac27a';g.fillRect(10,26,hw*xu,5);\\\\r\\\\n  g.textAlign='left';g.fillStyle='#bfe8cf';g.font='bold 7px Georgia, serif';g.fillText('LIVELLO '+A.lvl+' · bonus tra '+(5-A.lvl%5),10,43);\\\\r\\\\n  drawCoinIcon(g,15,54,4,T);g.font='bold 9px Georgia, serif';g.fillStyle='#ffe28a';g.fillText(fmt(A.walletC|0),23,57);\\\\r\\\\n  g.textAlign='center';g.fillStyle='#d8a93a';g.font='bold 9px Georgia, serif';g.fillText('LIVELLO '+A.level+' · ONDATA '+A.wv+'/'+WAVES,VW/2,14);\\\\r\\\\n  g.font='bold 20px Georgia, serif';g.fillStyle=A.waveT<5&&!A.bossWave?'#ff6a4a':'#fff';\\\\r\\\\n  g.fillText(A.bossWave?'♛':String(Math.ceil(A.waveT)),VW/2,36);\\\\r\\\\n  g.font='7px Georgia, serif';g.fillStyle='#a8977e';g.fillText(bgName(A.theme),VW/2,46);\\\\r\\\\n  if(A.boss&&!A.boss.dead){const b=A.boss,w=Math.min(300,VW-60),u=clamp(b.hp/b.max,0,1);\\\\r\\\\n    g.fillStyle='#000c';g.fillRect(VW/2-w/2-2,VH-24,w+4,12);g.fillStyle='#3a0a0a';g.fillRect(VW/2-w/2,VH-22,w,8);g.fillStyle='#d8a93a';g.fillRect(VW/2-w/2,VH-22,w*u,8);\\\\r\\\\n    g.font='bold 8px Georgia, serif';g.fillStyle='#ffe28a';g.fillText(b.name+(b.hp<b.max/2?' — furioso!':''),VW/2,VH-27);}\\\\r\\\\n  /* armi da lancio: icona e cerchio di ricarica in basso a sinistra */\\\\r\\\\n  {let k=0;for(const w of A.weapons){const d=WX[w.id];if(!d||!MANUAL[d.k])continue;const x=18+k*30,y=VH-20,cdm=d.cd/Math.max(.3,stv('velatt')/100),u=clamp(1-Math.max(0,w.cd)/cdm,0,1);\\\\r\\\\n    g.fillStyle='rgba(0,0,0,.55)';g.beginPath();g.arc(x,y,12,0,6.283);g.fill();g.strokeStyle=u>=1?'#ffe28a':'#8a6a3a';g.lineWidth=2.5;g.beginPath();g.arc(x,y,12,-1.571,-1.571+u*6.283);g.stroke();\\\\r\\\\n    const s2=emojiSpr(d.ic,32);g.globalAlpha=u>=1?1:.45;g.drawImage(s2.c,x-8,y-8,16,16);g.globalAlpha=1;k++;}\\\\r\\\\n    if(k&&!MOB){g.font='7px Georgia';g.textAlign='left';g.fillStyle='rgba(255,255,255,.6)';g.fillText('Clic: lancia',8,VH-36);g.textAlign='center';}}\\\\r\\\\n  if(A.banner){const a=Math.min(1,A.banner.t*1.5,(2.4-A.banner.t)*4);g.globalAlpha=a;g.fillStyle='#000a';g.fillRect(0,VH/2-34,VW,46);\\\\r\\\\n    g.font='bold 18px Georgia, serif';g.fillStyle='#ffe28a';g.fillText(A.banner.a,VW/2,VH/2-8);g.font='10px Georgia, serif';g.fillStyle='#d8c8a8';g.fillText(A.banner.b,VW/2,VH/2+6);g.globalAlpha=1;}\\\\r\\\\n  if(A.endT>0&&!A.boss&&!A.cine){g.font='bold 18px Georgia, serif';g.fillStyle='#5ef08a';g.fillText(A.wv===WAVES?'Boss sconfitto!':'Ondata superata!',VW/2,VH/2);}\\\\r\\\\n  if(joy){const x0=(joy.x0*(devicePixelRatio||1)-OX)/SC,y0=(joy.y0*(devicePixelRatio||1)-OY)/SC,x1=(joy.x*(devicePixelRatio||1)-OX)/SC,y1=(joy.y*(devicePixelRatio||1)-OY)/SC;\\\\r\\\\n    g.strokeStyle='rgba(255,255,255,.3)';g.lineWidth=2;g.beginPath();g.arc(x0,y0,22,0,6.283);g.stroke();g.fillStyle='rgba(255,255,255,.25)';g.beginPath();\\\\r\\\\n    const dx=x1-x0,dy=y1-y0,d=Math.hypot(dx,dy),m=Math.min(d,22);g.arc(x0+(d?dx/d*m:0),y0+(d?dy/d*m:0),9,0,6.283);g.fill();}\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* ===== Ciclo principale ===== */\\\\r\\\\nlet last=performance.now();\\\\r\\\\nfunction step(dt){if(A.state==='play'&&NET.on&&NET.role==='guest'){netGuestStep(dt);return;}if(A.state==='play')update(dt);else if(A.cine&&A.cine.any)updCine(dt);}\\\\r\\\\nlet hudT=0;\\\\r\\\\n/* disegni preparati in anticipo (un po' a ogni fotogramma) così i mostri nuovi non fanno scattare il gioco */\\\\r\\\\nconst WARM=[],WCV=document.createElement('canvas').getContext('2d');\\\\r\\\\nfunction warmUp(){WARM.length=0;const pool=enemyPool(A.level+1).slice(-14);\\\\r\\\\n  const add=(pal,wep,poses)=>{for(const pose of poses)for(let t=0;t<1.6;t+=.06)WARM.push(()=>drawHuman(WCV,0,0,{face:1,t,pose,pal,weapon:wep,scale:.78}));};\\\\r\\\\n  GUARD_KIT.forEach((L,ki)=>add(guardKitPal(ki,0),L.weapon,['walk','attack',L.ranged?'shoot':'idle']));\\\\r\\\\n  for(const E of pool){const tp=enemyTp(E);if(tp.body==='toon'){for(let f=0;f<8;f++)for(const a of[0,1])WARM.push(()=>monSprite(E.sp.toon,E.v,f,a));}\\\\r\\\\n    else if(!tp.body&&tp.pal)add(tintPal(tp.pal,E.va.tint),tp.weapon||'none',['walk','attack']);}}\\\\r\\\\nfunction frame(now){let dt=Math.min(.05,(now-last)/1000);last=now;const sp=window.ADM_SPEED||1;\\\\r\\\\n  {const w0=performance.now();while(WARM.length&&performance.now()-w0<3)WARM.shift()();}\\\\r\\\\n  /* niente scatti a inizio livello: il pavimento del livello dopo si prepara mentre c'è il riepilogo */\\\\r\\\\n  if(A.state==='lvdone'){if(!A.preF){A.preF=1;const nb=bgOfLevel(Math.min(MAXL,A.level+1));if(nb!==A.theme){A.theme=nb;buildFloor(nb);}}}else if(A.state==='play')A.preF=0;\\\\r\\\\n  hudT-=dt;if(hudT<=0){hudT=.5;A.walletC=wallet();const h=$('#hud-st');if(h){const on=A.state==='play'&&A.p;h.style.display=on?'':'none';if(on&&!h.classList.contains('closed'))h.querySelector('.lst').innerHTML=statsHtml();}}\\\\r\\\\n  try{for(let i=0;i<sp;i++)step(dt);render();}catch(e){console.error(e);window.ARENA_ERR=(window.ARENA_ERR||[]).concat(String(e&&e.stack||e)).slice(-20);}\\\\r\\\\n  requestAnimationFrame(frame);}\\\\r\\\\nrequestAnimationFrame(frame);\\\\r\\\\n\\\\r\\\\n/* ===== per le altre mod di KING TOWER (es. DISTRUGGI): cosa possono toccare dell'arena ===== */\\\\r\\\\nwindow.ARENA_API={A,killEnemy:e=>killEnemy(e),floor:()=>FLOOR,\\\\r\\\\n  mute:(m,s)=>{try{if(MUS&&m)MUS.gain.value=0;if(SFXG&&s)SFXG.gain.value=0;}catch(e){}}};\\\\r\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\r\\\\n/* =====================================================================\\\\r\\\\n   KING ARENA · animazioni\\\\r\\\\n   La storia iniziale e 10 animazioni:\\\\r\\\\n   1 storia · 2 cancello (entrata nell'arena) · 3 arrivo del boss · 4 grado salito\\\\r\\\\n   5 forziere · 6 livello superato · 7 caduta · 8 vittoria · 9 skin sbloccata · 10 salita a un luogo nuovo\\\\r\\\\n   ===================================================================== */\\\\r\\\\nconst CINE_DUR={bonus:1.8,bossdown:2.6,gate:2.2,boss:2.4,clear:2.8,death:2.4,victory:4.5,travel:2.8,lvup:1,chest:1.5};\\\\r\\\\nconst CINE_FREE={lvup:1,chest:1};\\\\r\\\\nconst CQ=[];A.anims=[];\\\\r\\\\nfunction cineStart(kind,done,data){\\\\r\\\\n  if(window.ARENA_FAST&&!CINE_FREE[kind]){if(done)done();return;}\\\\r\\\\n  if(CINE_FREE[kind]){A.anims.push({kind,t:0,dur:CINE_DUR[kind],data:data||{}});return;}\\\\r\\\\n  const c={kind,t:0,dur:CINE_DUR[kind],done,data:data||{},block:true};\\\\r\\\\n  if(A.cine)CQ.push(c);else{A.cine=c;cineSfx(c);}\\\\r\\\\n}\\\\r\\\\nfunction cineSfx(c){({gate:()=>{sfx('gate');setTimeout(()=>sfx('cheer'),700);},boss:()=>sfx('boss'),clear:()=>{sfx('clear');sfx('pickbig');},death:()=>{sfx('die');setTimeout(()=>sfx('laugh'),600);},\\\\r\\\\n  victory:()=>{sfx('win');sfx('cheer');},travel:()=>sfx('door'),bonus:()=>{sfx('unlock');},bossdown:()=>{sfx('slam');setTimeout(()=>sfx('cheer'),500);sfx('pickbig');}}[c.kind]||(()=>{}))();}\\\\r\\\\nfunction updCine(dt){const c=A.cine;if(!c)return;c.t+=dt;if(c.t>=c.dur){A.cine=CQ.shift()||null;if(A.cine)cineSfx(A.cine);if(c.done)c.done();}}\\\\r\\\\nfunction tickAnims(dt){for(const a of A.anims)a.t+=dt;A.anims=A.anims.filter(a=>a.t<a.dur);}\\\\r\\\\n/* --- nel mondo (sotto l'interfaccia) --- */\\\\r\\\\nfunction drawCineWorld(g,T){\\\\r\\\\n  for(const a of A.anims){const u=a.t/a.dur;\\\\r\\\\n    if(a.kind==='lvup'){const p=A.p;g.save();g.globalAlpha=1-u;for(let i=0;i<12;i++){const ang=i*.523+T*2;g.strokeStyle=i%2?'#ffe28a':'#ffb43a';g.lineWidth=2;\\\\r\\\\n      g.beginPath();g.moveTo(p.x+Math.cos(ang)*10,p.y-14+Math.sin(ang)*10);g.lineTo(p.x+Math.cos(ang)*(18+u*30),p.y-14+Math.sin(ang)*(18+u*30));g.stroke();}\\\\r\\\\n      g.globalAlpha=(1-u)*.5;g.fillStyle='#ffe28a';g.beginPath();g.arc(p.x,p.y-14,10+u*20,0,6.283);g.fill();g.restore();}\\\\r\\\\n    if(a.kind==='chest'){const d=a.data,o=Math.min(1,u*3);g.save();g.translate(d.x,d.y);\\\\r\\\\n      g.globalAlpha=Math.min(1,(1-u)*3);for(let i=0;i<8;i++){const ang=-Math.PI/2+(i-3.5)*.25;g.strokeStyle='rgba(255,230,140,.6)';g.lineWidth=3;g.beginPath();g.moveTo(0,-10);g.lineTo(Math.cos(ang)*50*o,-10+Math.sin(ang)*50*o);g.stroke();}\\\\r\\\\n      g.fillStyle='#6a3a1a';g.fillRect(-9,-12,18,12);g.save();g.translate(-9,-12);g.rotate(-o*1.2);g.fillStyle='#8a5a2a';g.fillRect(0,-5,18,5);g.restore();\\\\r\\\\n      g.font='16px serif';g.textAlign='center';g.fillText(d.it.ic,0,-20-u*26);g.font='bold 7px Georgia';g.fillStyle='#ffe28a';g.fillText(d.it.n,0,-38-u*26);g.restore();}}\\\\r\\\\n  const c=A.cine;if(!c)return;const u=c.t/c.dur,p=A.p;\\\\r\\\\n  if(c.kind==='death'){g.save();g.translate(p.x,p.y);g.rotate(Math.min(1,u*2)*1.4*p.face);drawToonGuard(g,0,0,{skin:A.skin,pose:'hurt',t:0,face:p.face,shadow:false});g.restore();}\\\\r\\\\n  if(c.kind==='victory'){const k=A.en.find(e=>e.boss==='king');const x=AW/2,y=WALL+90;\\\\r\\\\n    drawHuman(g,x,y,{face:-1,t:T,pose:'hurt',pal:KING,weapon:'none',scale:1.3,shadow:true});\\\\r\\\\n    const cy=y-60+Math.min(1,u*1.6)*58;g.save();g.translate(x+20,cy);g.rotate(u*6);g.fillStyle='#ffd45c';g.beginPath();g.moveTo(-8,4);g.lineTo(-8,-4);g.lineTo(-4,0);g.lineTo(0,-6);g.lineTo(4,0);g.lineTo(8,-4);g.lineTo(8,4);g.closePath();g.fill();g.restore();\\\\r\\\\n    drawToonGuard(g,p.x,p.y,{skin:A.skin,pose:'win',t:T,face:1});}\\\\r\\\\n}\\\\r\\\\n/* --- sopra lo schermo --- */\\\\r\\\\nfunction drawCineScreen(g,T){const c=A.cine;g.setTransform(SC,0,0,SC,OX,OY);if(!c)return;const u=c.t/c.dur;g.textAlign='center';\\\\r\\\\n  if(CINE_SKIP[c.kind]){g.font='8px Georgia';g.fillStyle='rgba(255,255,255,.6)';g.fillText('Tocca o premi un tasto per saltare',VW/2,VH-6);}\\\\r\\\\n  if(c.kind==='bonus'){g.fillStyle='rgba(20,10,0,'+Math.min(.6,u*2)+')';g.fillRect(0,0,VW,VH);\\\\r\\\\n    for(let i=0;i<24;i++){const a=i*.2618+T*1.5,r0=20+u*40;g.strokeStyle=i%2?'rgba(255,226,138,.55)':'rgba(255,170,60,.45)';g.lineWidth=5;g.beginPath();g.moveTo(VW/2+Math.cos(a)*r0,VH/2+Math.sin(a)*r0);g.lineTo(VW/2+Math.cos(a)*(r0+VW),VH/2+Math.sin(a)*(r0+VW));g.stroke();}\\\\r\\\\n    const sc=Math.min(1.2,u*4)-Math.max(0,u-.85)*2;g.save();g.translate(VW/2,VH/2);g.scale(sc,sc);g.font='bold 22px Georgia';g.fillStyle='#000';g.fillText('LIVELLO '+A.lvl+'!',1.5,1.5);g.fillStyle='#ffe28a';g.fillText('LIVELLO '+A.lvl+'!',0,0);g.restore();\\\\r\\\\n    drawToonGuard(g,VW/2,VH/2+70,{skin:A.skin,pose:'win',t:T,face:1,scale:1.5});}\\\\r\\\\n  if(c.kind==='bossdown'){g.fillStyle='rgba(0,0,0,'+Math.min(.55,u)+')';g.fillRect(0,0,VW,VH);\\\\r\\\\n    for(let i=0;i<50;i++){const x=(i*41.3)%VW,y=((T*120+i*31)%(VH+20))-10;drawCoinIcon(g,x,y,3.5,T+i);}\\\\r\\\\n    const b=A.boss||{};const s=bossSprite(BOSSES[(A.level-1)%100].i,0,false);g.save();g.translate(VW/2,VH/2+40);g.rotate(Math.min(1,u*2)*1.5);g.globalAlpha=1-Math.max(0,u-.6)*2.5;g.drawImage(s.c,-40,-90,80,98);g.restore();\\\\r\\\\n    if(u>.35){const k=Math.min(1,(u-.35)*4);g.save();g.translate(VW/2,VH*.24);g.scale(k,k);g.font='bold 20px Georgia';g.fillStyle='#000';g.fillText('BOSS SCONFITTO!',1.5,1.5);g.fillStyle='#ffe28a';g.fillText('BOSS SCONFITTO!',0,0);g.restore();}}\\\\r\\\\n  if(c.kind==='gate'){const up=clamp((c.t-.4)/1.4,0,1);g.fillStyle='rgba(0,0,0,'+(.6*(1-up))+')';g.fillRect(0,0,VW,VH);\\\\r\\\\n    const y=-up*VH;g.fillStyle='#2a2420';for(let x=10;x<VW;x+=22){g.fillRect(x,y,6,VH);}for(let k=0;k<6;k++)g.fillRect(0,y+k*VH/5,VW,5);\\\\r\\\\n    g.fillStyle='#5a5048';for(let x=10;x<VW;x+=22)g.fillRect(x+1,y,2,VH);\\\\r\\\\n    g.globalAlpha=1-up;g.font='bold 22px Georgia';g.fillStyle='#ffe28a';g.fillText('Entra nell\\\\\\\\'arena!',VW/2,VH/2);g.globalAlpha=1;}\\\\r\\\\n  if(c.kind==='boss'){const e=c.data.e,b=Math.min(1,u*4,(1-u)*4);g.fillStyle='#000';g.fillRect(0,0,VW,30*b);g.fillRect(0,VH-30*b,VW,30*b);\\\\r\\\\n    g.globalAlpha=b;g.fillStyle='rgba(30,10,0,.55)';g.fillRect(0,VH/2-50,VW,100);\\\\r\\\\n    const sx=VW*.28+(1-Math.min(1,u*3))*-120;\\\\r\\\\n    if(e&&e.boss==='rich'){const s=bossSprite(e.bi,Math.floor(T*6)%8,false);g.drawImage(s.c,sx-45,VH/2-56,90,110);}\\\\r\\\\n    else if(e)drawHuman(g,sx,VH/2+44,{face:1,t:T,pose:'idle',pal:KING,weapon:'gold',scale:1.4});\\\\r\\\\n    g.font='bold 9px Georgia';g.fillStyle='#d8a93a';g.fillText(A.level>=MAXL?'LO SCONTRO FINALE':'BOSS DEL LIVELLO '+A.level,VW*.62,VH/2-16);\\\\r\\\\n    g.font='bold 20px Georgia';g.fillStyle='#ffe28a';g.fillText(e?e.name:'',VW*.62,VH/2+8);\\\\r\\\\n    g.font='9px Georgia';g.fillStyle='#e8d8b8';g.fillText(e&&e.boss==='rich'?'«Tutto l\\\\\\\\'oro della torre è mio!»':'«Sei arrivato fin qui? Impossibile!»',VW*.62,VH/2+24);g.globalAlpha=1;}\\\\r\\\\n  if(c.kind==='clear'){g.fillStyle='rgba(0,0,0,.35)';g.fillRect(0,0,VW,VH);\\\\r\\\\n    for(let i=0;i<40;i++){const x=(i*53.7)%VW,y=((T*90+i*37)%(VH+20))-10;drawCoinIcon(g,x,y,3.5,T+i);}\\\\r\\\\n    const s=Math.min(1,u*4);g.save();g.translate(VW/2,VH/2-30);g.scale(s,s);g.font='bold 24px Georgia';g.fillStyle='#000';g.fillText('Livello '+A.level+' superato!',1.5,1.5);g.fillStyle='#ffe28a';g.fillText('Livello '+A.level+' superato!',0,0);g.restore();\\\\r\\\\n    g.font='bold 11px Georgia';g.fillStyle=NCOL.pos;g.fillText('+'+c.data.prize+' monete di KING TOWER   ·   +'+c.data.pts+' punti',VW/2,VH/2-6);\\\\r\\\\n    // il Re dal balcone, arrabbiato\\\\r\\\\n    const ky=VH*.82;g.fillStyle='#3a2a20';g.fillRect(VW*.78-40,ky-4,80,10);for(let i=0;i<7;i++)g.fillRect(VW*.78-36+i*12,ky-20,4,16);\\\\r\\\\n    drawHuman(g,VW*.78,ky-2,{face:-1,t:T*3,pose:'attack',pr:(Math.sin(T*10)+1)/2,pal:KING,weapon:'none',scale:.9});\\\\r\\\\n    g.font='bold 8px Georgia';g.fillStyle='#fff';g.fillText('«Grrr! Il prossimo ti batterà!»',VW*.78,ky-58);}\\\\r\\\\n  if(c.kind==='death'){g.fillStyle='rgba(20,0,0,'+Math.min(.65,u)+')';g.fillRect(0,0,VW,VH);\\\\r\\\\n    if(u>.3){const a=Math.min(1,(u-.3)*4);g.globalAlpha=a;drawHuman(g,VW/2,VH/2+40,{face:1,t:T*4,pose:'idle',pal:KING,weapon:'none',scale:1.4});\\\\r\\\\n      g.fillStyle='#fff';g.beginPath();g.ellipse(VW/2+60,VH/2-40,46,16,0,0,6.283);g.fill();g.beginPath();g.moveTo(VW/2+30,VH/2-28);g.lineTo(VW/2+18,VH/2-16);g.lineTo(VW/2+40,VH/2-30);g.fill();\\\\r\\\\n      g.font='bold 12px Georgia';g.fillStyle='#7a1626';g.fillText('AH AH AH!',VW/2+60,VH/2-36);g.globalAlpha=1;}}\\\\r\\\\n  if(c.kind==='victory'){for(let i=0;i<60;i++){const x=(i*37.3+T*20*(i%3+1))%VW,y=((T*70+i*29)%(VH+10))-5;g.fillStyle=['#ffd45c','#e8486a','#5ad0ff','#5ef08a'][i%4];g.fillRect(x,y,3,5);}\\\\r\\\\n    const s=Math.min(1,u*3);g.save();g.translate(VW/2,VH*.25);g.scale(s,s);g.font='bold 26px Georgia';g.fillStyle='#ffe28a';g.fillText('LIBERO!',0,0);g.restore();\\\\r\\\\n    g.font='11px Georgia';g.fillStyle='#fff';g.fillText('Il Re si inginocchia: l\\\\\\\\'arena è tua.',VW/2,VH*.25+18);}\\\\r\\\\n  if(c.kind==='travel'){g.fillStyle='#0a0706';g.fillRect(0,0,VW,VH);const k=Math.min(1,u*1.2);\\\\r\\\\n    for(let i=0;i<10;i++){const x=VW*.2+i*VW*.06,y=VH*.85-i*VH*.06;g.fillStyle=mix('#5a4a3a','#8a7a6a',i/10);g.fillRect(x,y,VW*.07,VH*.06);}\\\\r\\\\n    const st=Math.min(9,Math.floor(k*10)),gx=VW*.2+st*VW*.06+VW*.035,gy=VH*.85-st*VH*.06;\\\\r\\\\n    drawToonGuard(g,gx,gy,{skin:A.skin,pose:'run',t:T,face:1,scale:1.1});\\\\r\\\\n    g.font='bold 18px Georgia';g.fillStyle='#ffe28a';g.fillText('Si sale!',VW*.7,VH*.3);g.font='11px Georgia';g.fillStyle='#e8d8b8';g.fillText(PLACES[Math.floor(bgOfLevel(A.level)/20)].n,VW*.7,VH*.3+16);\\\\r\\\\n    g.fillStyle='rgba(0,0,0,'+Math.max(0,(u-.85)*6)+')';g.fillRect(0,0,VW,VH);}\\\\r\\\\n}\\\\r\\\\n\\\\r\\\\n/* le animazioni corte si saltano con un tocco, un clic o un tasto */\\\\r\\\\nconst CINE_SKIP={bonus:1,bossdown:1,gate:1,clear:1,travel:1,boss:1};\\\\r\\\\nfunction cineSkip(){if(A.cine&&CINE_SKIP[A.cine.kind]&&A.cine.t>.25)A.cine.t=A.cine.dur;}\\\\r\\\\naddEventListener('pointerdown',()=>cineSkip());addEventListener('keydown',e=>{if(!e.repeat)cineSkip();});\\\\r\\\\n\\\\r\\\\n/* ===================== LOGO (immagine logo.webp, trasparente) ===================== */\\\\r\\\\nconst LOGO_IMG=new Image();LOGO_IMG.src=$('#logo')?$('#logo').src:'logo.webp';\\\\r\\\\nfunction drawLogo(g,W,H,t){const s=Math.min(W/LOGO_IMG.width||1,H/LOGO_IMG.height||1)*.9,w=LOGO_IMG.width*s,h=LOGO_IMG.height*s,b=Math.sin((t||0)*2)*3;if(LOGO_IMG.complete&&LOGO_IMG.width)g.drawImage(LOGO_IMG,(W-w)/2,(H-h)/2+b,w,h);}\\\\r\\\\n\\\\r\\\\n/* ===================== STORIA INIZIALE ===================== */\\\\r\\\\nconst STORY=[\\\\r\\\\n {d:4.5,t:'Hai risalito, piano dopo piano, tutta la torre del Re…'},\\\\r\\\\n {d:4.5,t:'…e finalmente sei arrivato in cima, al livello del Re.'},\\\\r\\\\n {d:4.5,t:'Ma il Re ha riso. Una gabbia è caduta dal soffitto: sei di nuovo prigioniero!'},\\\\r\\\\n {d:4.5,t:'«Vuoi la libertà? Allora combatti nella mia arena… per il mio divertimento!»'},\\\\r\\\\n {d:5,t:'Mille livelli. Dieci ondate ciascuno. Un boss ricco alla fine di ogni livello. Sopravvivi… e riprenditi la libertà!'},\\\\r\\\\n {d:3.5,t:''}];\\\\r\\\\nconst SY={on:false,i:0,t:0,done:null};\\\\r\\\\nfunction storyOpen(done){SY.on=true;SY.i=0;SY.t=0;SY.done=done;A.state='story';showOv('story');musicPlay(TR_STORY);storyCap();requestAnimationFrame(storyLoop);}\\\\r\\\\nfunction storyCap(){$('#st-txt').textContent=STORY[SY.i].t;}\\\\r\\\\nfunction storyNext(){SY.i++;SY.t=0;sfx('click');if(SY.i>=STORY.length){storyEnd();return;}storyCap();}\\\\r\\\\nfunction storyEnd(){if(!SY.on)return;SY.on=false;AS.story=true;asSave();const d=SY.done;SY.done=null;if(d)d();else openMenu();}\\\\r\\\\nlet syLast=0;\\\\r\\\\nfunction storyLoop(now){if(!SY.on)return;const dt=Math.min(.05,(now-(syLast||now))/1000);syLast=now;SY.t+=dt;if(SY.t>STORY[SY.i].d){storyNext();if(!SY.on)return;}\\\\r\\\\n  const c=$('#st-cv'),g=c.getContext('2d'),W=c.width=c.clientWidth*Math.min(2,devicePixelRatio||1)||960,H=c.height=c.clientHeight*Math.min(2,devicePixelRatio||1)||540;\\\\r\\\\n  g.setTransform(W/480,0,0,H/270,0,0);g.imageSmoothingEnabled=true;storyScene(g,SY.i,SY.t,now/1000);requestAnimationFrame(storyLoop);}\\\\r\\\\nfunction storyScene(g,i,t,T){const sky=g.createLinearGradient(0,0,0,270);\\\\r\\\\n  if(i===0){/* dentro la torre: una scala lunga che sale verso destra; la guardia sale sempre in avanti e la vista la segue */\\\\r\\\\n    const k=Math.min(1,t/4.3),ease=k*k*(3-2*k),gx=60+ease*360,gy=262-(gx-40)*1.3,cam=Math.max(0,190-gy);\\\\r\\\\n    g.fillStyle='#1a1418';g.fillRect(0,0,480,270);g.save();g.translate(0,cam);\\\\r\\\\n    for(let y=-560;y<300;y+=24)for(let x=(Math.floor(y/24)%2)*20-20;x<480;x+=40){g.fillStyle=((x*7+y*3)%5)?'#2a2228':'#30272e';g.fillRect(x+1,y+1,38,22);}\\\\r\\\\n    for(let n=0;n<6;n++){const tx=40+n*80,ty=200-n*95;g.fillStyle='#2a1a10';g.fillRect(tx-2,ty,5,14);const f=Math.sin(T*12+n)*2;\\\\r\\\\n      const gr=g.createRadialGradient(tx,ty-4,1,tx,ty-4,40);gr.addColorStop(0,'rgba(255,170,60,.35)');gr.addColorStop(1,'rgba(255,140,40,0)');g.fillStyle=gr;g.fillRect(tx-40,ty-44,80,80);\\\\r\\\\n      g.fillStyle='#ff8a1a';g.beginPath();g.ellipse(tx,ty-4,3,6+f,0,0,6.283);g.fill();}\\\\r\\\\n    for(let s2=0;s2<40;s2++){const x=40+s2*10,y=262-s2*13;g.fillStyle='#4a3a30';g.fillRect(x,y,12,300);g.fillStyle='#6a5648';g.fillRect(x,y,12,3);}\\\\r\\\\n    drawToonGuard(g,gx,gy,{skin:AS.skin,pose:k<1?'run':'idle',t:T,face:1,scale:.9});g.restore();\\\\r\\\\n    g.fillStyle='rgba(0,0,0,'+Math.max(0,(t-3.9)*1.6)+')';g.fillRect(0,0,480,270);}\\\\r\\\\n  else if(i===1||i===2){g.fillStyle='#3a2420';g.fillRect(0,0,480,270);g.fillStyle='#5a3a2a';g.fillRect(0,190,480,80);g.fillStyle='#8e1b1b';g.fillRect(200,190,80,80);\\\\r\\\\n    for(let k=0;k<5;k++){g.fillStyle='#7a1626';g.fillRect(40+k*100,20,30,90);g.fillStyle='#d8a93a';g.font='16px serif';g.textAlign='center';g.fillText('♛',55+k*100,70);}\\\\r\\\\n    drawThrone(g,240,200);\\\\r\\\\n    const pr=i===2?Math.min(1,t*2):0;drawHuman(g,240,198,{face:-1,t:T*(i===2?4:1),pose:i===2&&t<1.5?'attack':'idle',pr,pal:KING,weapon:'gold',scale:1.3});\\\\r\\\\n    const gx=i===1?40+Math.min(1,t/3)*110:150;drawToonGuard(g,gx,236,{skin:AS.skin,pose:i===1&&t<3?'run':i===2&&t>1.6?'hurt':'idle',t:T,face:1,scale:1.4});\\\\r\\\\n    if(i===2){const drop=clamp((t-1)/.6,0,1),cy=-80+drop*240;g.strokeStyle='#4a4f56';g.lineWidth=4;g.beginPath();g.moveTo(150,0);g.lineTo(150,cy-60);g.stroke();\\\\r\\\\n      g.fillStyle='rgba(0,0,0,0)';g.strokeStyle='#5a5f66';g.lineWidth=4;for(let k=0;k<7;k++){g.beginPath();g.moveTo(118+k*11,cy-60);g.lineTo(118+k*11,cy+10);g.stroke();}\\\\r\\\\n      g.lineWidth=6;g.beginPath();g.moveTo(112,cy-60);g.lineTo(188,cy-60);g.moveTo(112,cy+10);g.lineTo(188,cy+10);g.stroke();\\\\r\\\\n      if(t>1.6&&t<2.2){g.fillStyle='rgba(255,255,255,'+(1-(t-1.6)/.6)+')';g.fillRect(0,0,480,270);}}}\\\\r\\\\n  else if(i===3){g.fillStyle='#14100d';g.fillRect(0,0,480,270);g.fillStyle='#2a2420';g.fillRect(0,200,480,70);\\\\r\\\\n    g.fillStyle='rgba(255,200,120,.12)';g.beginPath();g.moveTo(330,0);g.lineTo(480,0);g.lineTo(480,270);g.lineTo(260,270);g.fill();\\\\r\\\\n    drawToonGuard(g,170,236,{skin:AS.skin,pose:'idle',t:T,face:1,scale:1.4});\\\\r\\\\n    g.strokeStyle='#5a5f66';g.lineWidth=5;for(let k=0;k<9;k++){g.beginPath();g.moveTo(100+k*18,40);g.lineTo(100+k*18,250);g.stroke();}g.lineWidth=8;g.beginPath();g.moveTo(92,40);g.lineTo(254,40);g.stroke();\\\\r\\\\n    drawHuman(g,360,240,{face:-1,t:T*3,pose:'idle',pal:KING,weapon:'gold',scale:1.5});}\\\\r\\\\n  else if(i===4){sky.addColorStop(0,'#2a3a6a');sky.addColorStop(1,'#d8a060');g.fillStyle=sky;g.fillRect(0,0,480,270);\\\\r\\\\n    g.fillStyle='#5a4a3a';g.beginPath();g.ellipse(240,300,300,140,0,0,6.283);g.fill();g.fillStyle='#c8a870';g.beginPath();g.ellipse(240,260,220,70,0,0,6.283);g.fill();\\\\r\\\\n    for(let k=0;k<160;k++){const a=Math.PI+k/160*Math.PI,x=240+Math.cos(a)*270,y=300+Math.sin(a)*150+((k*7)%3)*6;g.fillStyle=['#c0392b','#2f5fa8','#e8b22a','#3a8a3a','#f2c9a0'][k%5];g.beginPath();g.arc(x,y+Math.sin(T*8+k)*2,3,0,6.283);g.fill();}\\\\r\\\\n    const up=Math.min(1,t/2);g.fillStyle='#1a120c';g.fillRect(210,170,60,60);g.strokeStyle='#4a4f56';g.lineWidth=3;for(let k=0;k<6;k++){g.beginPath();g.moveTo(213+k*11,170-up*60);g.lineTo(213+k*11,230-up*60);g.stroke();}\\\\r\\\\n    drawToonGuard(g,240,230+Math.max(0,1-(t-1.6))*-10,{skin:AS.skin,pose:t>1.6?'run':'idle',t:T,face:1,scale:1.2});\\\\r\\\\n    for(let k=0;k<4;k++){const E=ENEMIES[[2,5,7,15][k]];drawEnemy(g,{En:E,sp:E.sp,v:0,tp:enemyTp(E),x:120+k*80+(k>1?40:0),y:250,t:T+k,face:k<2?1:-1,scale:1,r:10,moving:true,st:'move'},T);}\\\\r\\\\n    g.fillStyle='#3a2a20';g.fillRect(200,60,80,10);drawHuman(g,240,62,{face:1,t:T*3,pose:'idle',pal:KING,weapon:'none',scale:.8});}\\\\r\\\\n  else{g.fillStyle='#0a0706';g.fillRect(0,0,480,270);g.save();drawLogo(g,480,270,T);g.restore();}\\\\r\\\\n  // cornice a vignetta\\\\r\\\\n  g.strokeStyle='#d8a93a';g.lineWidth=4;g.strokeRect(2,2,476,266);}\\\\r\\\\n$('#st-skip').onclick=()=>storyEnd();\\\\r\\\\n$('#st-next').onclick=()=>storyNext();\\\\r\\\\n\\\\r\\\\n/* ===================== SKIN SBLOCCATA ===================== */\\\\r\\\\nfunction unlockAnim(i){const o=$('#unlock');o.classList.add('on');$('#un-txt').textContent=SKINS[i].n;sfx('unlock');const c=$('#un-cv'),g=c.getContext('2d');const t0=performance.now();\\\\r\\\\n  const loop=now=>{const t=(now-t0)/1000;if(t>2.6||!o.classList.contains('on')){o.classList.remove('on');return;}\\\\r\\\\n    g.setTransform(1,0,0,1,0,0);g.clearRect(0,0,c.width,c.height);g.save();g.translate(c.width/2,c.height*.84);\\\\r\\\\n    for(let k=0;k<14;k++){const a=k*.449+t*1.5;g.strokeStyle='rgba(255,220,120,'+(.35+.25*Math.sin(t*5+k))+')';g.lineWidth=6;g.beginPath();g.moveTo(0,-90);g.lineTo(Math.cos(a)*200,-90+Math.sin(a)*200);g.stroke();}\\\\r\\\\n    const sx=Math.cos(Math.min(t,1.2)*Math.PI*4);g.scale(sx||.05,1);drawToonGuard(g,0,0,{skin:i,pose:t>1.2?'win':'idle',t,face:1,scale:4.2});g.restore();\\\\r\\\\n    for(let k=0;k<20;k++){const a=k*.314+t,r=60+((t*90+k*23)%120);g.fillStyle='#fff';g.fillRect(c.width/2+Math.cos(a)*r,c.height*.5+Math.sin(a)*r*.6,3,3);}\\\\r\\\\n    requestAnimationFrame(loop);};requestAnimationFrame(loop);}\\\\r\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\r\\\\n/* =====================================================================\\\\r\\\\n   KING ARENA · menu (uguale a KING TOWER), scelta, skin, livelli, impostazioni\\\\r\\\\n   ===================================================================== */\\\\r\\\\nfunction menuRec(){const best=Math.max(0,AS.top|0);\\\\r\\\\n  $('#m-rec').innerHTML=`Punti: <b>${fmt(AS.pts|0)}</b> · Record: livello ${best} · Monete: 🪙 ${fmt(wallet())}<br>Creato da Admin 2D · KING ARENA, mod di KING TOWER`;\\\\r\\\\n  const c=$('#m-cont');if(AS.run){c.style.display='';c.textContent='Continua (livello '+AS.run.level+')';}else c.style.display='none';\\\\r\\\\n  $('#m-kt').style.display=KT?'':'none';$('#b-chat').style.display=KT?'':'none';$('#m-admin').style.display=isAdmin()?'':'none';}\\\\r\\\\nfunction openMenu(){A.state='menu';showOv('menu');menuRec();musicPlay(TR_MENU);document.body.classList.remove('playing');}\\\\r\\\\nconst back=()=>{sfx('click');openMenu();};\\\\r\\\\n$$('[data-back]').forEach(b=>b.onclick=back);\\\\r\\\\n$('#m-play').onclick=()=>{au();sfx('click');const go=()=>{AS.startLv=1;openSelect();};if(AS.run)askYes('Iniziare una partita nuova? Quella salvata (livello '+AS.run.level+') verrà persa.',go);else go();};\\\\r\\\\n$('#m-cont').onclick=()=>{au();sfx('click');if(!loadRun()){AS.run=null;asSave();openMenu();}};\\\\r\\\\n$('#m-kt').onclick=()=>{try{KT.chiudi();}catch(e){}};\\\\r\\\\n$('#m-help').onclick=$('#b-help').onclick=()=>{sfx('click');A.state='help';showOv('help');};\\\\r\\\\n$('#m-story').onclick=()=>{au();storyOpen(()=>openMenu());};\\\\r\\\\n$('#m-admin').onclick=()=>{sfx('click');openAdmin();};\\\\r\\\\n$('#m-mp').onclick=()=>{au();sfx('click');openMP();};\\\\r\\\\n/* chat: la stessa del 2D e del 3D (con l'IA); senza KING TOWER non c'è */\\\\r\\\\n$('#b-chat').onclick=()=>{sfx('click');try{if(KT&&KT.chat){KT.chat();return;}}catch(e){}toast('La chat è dentro KING TOWER.');};\\\\r\\\\naddEventListener('keydown',e=>{if(e.code==='KeyT'&&!e.repeat&&A.state==='play'&&!(e.target&&e.target.tagName==='INPUT')){try{if(KT&&KT.chat)KT.chat();}catch(er){}}});\\\\r\\\\n$('#b-cart').onclick=()=>{sfx('click');try{if(KT&&KT.carrello){KT.carrello();return;}}catch(e){}A.state='cart';\\\\r\\\\n  $('#cart-txt').innerHTML='Il carrello è dentro KING TOWER: da lì compri mod, diamanti e monete.';showOv('cartov');};\\\\r\\\\n/* --- scelta dell'arma e della difficoltà --- */\\\\r\\\\nconst START_W=[...Object.keys(WP),...Object.keys(WX).filter(k=>!WX[k].boss)];\\\\r\\\\nfunction openSelect(){A.state='select';showOv('select');if(!START_W.includes(AS.wpn))AS.wpn='mace';renderSelect();}\\\\r\\\\nfunction renderSelect(){const lv=AS.startLv||1;\\\\r\\\\n  $('#sel-info').innerHTML=`Skin: <b>${SKINS[AS.skin].n}</b> · Partenza: <b>livello ${lv}</b>`+(lv>1?' <span class=\\\\\\\"small\\\\\\\">(con le carte di quel livello)</span>':'');\\\\r\\\\n  const wb=$('#weps');wb.innerHTML='';\\\\r\\\\n  START_W.forEach(id=>{const d=document.createElement('div');d.className='wp'+(AS.wpn===id?' sel':'');d.title=wName(id);\\\\r\\\\n    d.innerHTML=`<div class=\\\\\\\"ic\\\\\\\">${wIcon(id)}</div><div>${wName(id)}</div>`;d.onclick=()=>{AS.wpn=id;asSave();sfx('click');renderSelect();};wb.appendChild(d);});\\\\r\\\\n  $$('#select [data-d]').forEach(b=>{b.className=+b.dataset.d===AS.diff?'on':'';b.onclick=()=>{AS.diff=+b.dataset.d;asSave();sfx('click');renderSelect();};});\\\\r\\\\n  const D=DIFFS[AS.diff];$('#sel-diff').innerHTML=`Vita dei nemici ${numH(Math.round((D.hp-1)*100),'%')} · danni ${numH(Math.round((D.dmg-1)*100),'%')} · nemici ${numH(Math.round((D.spawn-1)*100),'%')} · monete per livello: <b>${D.coins}</b>`;}\\\\r\\\\n$('#s-back').onclick=back;\\\\r\\\\n$('#s-go').onclick=()=>{au();const go=()=>newRun(0,AS.skin,AS.diff,AS.wpn,AS.startLv||1);if(!AS.story){storyOpen(go);return;}go();};\\\\r\\\\n/* --- skin: 3 libere, le altre con i punti --- */\\\\r\\\\nconst SKC=new Map();\\\\r\\\\nfunction skinThumb(i){if(SKC.has(i))return SKC.get(i);const[c,g]=hdCanvas(160,160);g.imageSmoothingEnabled=true;drawToonGuard(g,80,150,{skin:i,pose:'idle',t:0,face:1,scale:3.6});SKC.set(i,c);return c;}\\\\r\\\\nfunction openSkins(){A.state='skins';showOv('skinsov');renderSkins();}\\\\r\\\\nfunction renderSkins(){$('#sk-info').innerHTML=`Hai <b>${fmt(AS.pts|0)}</b> punti. Si guadagnano sconfiggendo mostri e boss.`;\\\\r\\\\n  const box=$('#skins');box.innerHTML='';\\\\r\\\\n  SKINS.forEach((s,i)=>{const ok=skinOk(i),d=document.createElement('div');d.className='sk'+(AS.skin===i?' sel':'')+(ok?'':' lock');\\\\r\\\\n    d.appendChild(skinThumb(i));d.insertAdjacentHTML('beforeend',`<div>${s.n}</div>`+(ok?'':`<div class=\\\\\\\"lk\\\\\\\">🔒</div><div class=\\\\\\\"${(AS.pts|0)>=s.cost?'np':'nn'}\\\\\\\">${fmt(s.cost)} punti</div>`));\\\\r\\\\n    d.onclick=()=>{if(ok){AS.skin=i;asSave();sfx('click');renderSkins();return;}\\\\r\\\\n      if((AS.pts|0)<s.cost){sfx('err');toast('Ti servono '+fmt(s.cost)+' punti.');return;}\\\\r\\\\n      askYes('Sbloccare \\\\\\\"'+s.n+'\\\\\\\" per '+fmt(s.cost)+' punti?',()=>{AS.pts-=s.cost;AS.skins[i]=1;AS.skin=i;asSave();unlockAnim(i);renderSkins();});};\\\\r\\\\n    box.appendChild(d);});}\\\\r\\\\n$('#m-skins').onclick=()=>{sfx('click');openSkins();};\\\\r\\\\n/* --- livelli: parti da uno già raggiunto --- */\\\\r\\\\nlet lvPage=0;\\\\r\\\\nfunction openLevels(){A.state='levels';lvPage=Math.floor(((AS.unlocked|0)-1)/100);showOv('levels');renderLevels();}\\\\r\\\\nfunction renderLevels(){const u=Math.max(1,AS.unlocked|0);$('#lv-info').innerHTML=`Livelli sbloccati: <b>${u}</b> / ${MAXL}. Scegli da dove partire.`;\\\\r\\\\n  const pg=$('#lv-pages');pg.innerHTML='';for(let p=0;p<10;p++){const b=document.createElement('button');b.textContent=(p*100+1)+'-'+(p*100+100);b.className=p===lvPage?'on':'';b.style.fontSize='12px';b.style.padding='4px 7px';b.onclick=()=>{lvPage=p;renderLevels();};pg.appendChild(b);}\\\\r\\\\n  const g=$('#lvgrid');g.innerHTML='';\\\\r\\\\n  for(let l=lvPage*100+1;l<=lvPage*100+100;l++){const d=document.createElement('div');d.className='lv'+(l>u?' lock':l<u?' done':'')+((AS.startLv||1)===l?' sel':'');d.textContent=l;d.title=bgName(bgOfLevel(l))+' · boss: '+(l>=MAXL?'Il Re':bossOfLevel(l).n);\\\\r\\\\n    if(l<=u)d.onclick=()=>{AS.startLv=l;sfx('click');if(AS.run)askYes('Iniziare una partita nuova dal livello '+l+'? Quella salvata verrà persa.',openSelect);else openSelect();};g.appendChild(d);}}\\\\r\\\\n$('#m-levels').onclick=()=>{sfx('click');openLevels();};\\\\r\\\\n/* --- oggetti dei boss --- */\\\\r\\\\n$('#m-relics').onclick=()=>{sfx('click');A.state='relics';showOv('relicsov');\\\\r\\\\n  $('#relics').innerHTML=RELICS.map(r=>{const n=(AS.relics&&AS.relics[r.id])|0;return`<div class=\\\\\\\"rl${n?'':' no'}\\\\\\\"><div class=\\\\\\\"ic\\\\\\\">${r.ic}</div><b>${r.n}</b>${n>1?' ×'+n:''}<div class=\\\\\\\"small\\\\\\\">${r.w?'Arma: '+wName(r.w):modsHtml(r.m)}</div></div>`;}).join('');};\\\\r\\\\n/* --- impostazioni --- */\\\\r\\\\n$('#m-opts').onclick=()=>{sfx('click');A.state='opts';showOv('opts');$('#o-vol').value=AS.vol;$('#o-mus').value=AS.musVol;$('#o-sfx').value=AS.sfxVol;$('#o-muson').checked=!!AS.mus;$('#o-shake').checked=!!AS.shake;$('#o-nums').checked=!!AS.nums;};\\\\r\\\\n$('#o-vol').oninput=e=>{AS.vol=+e.target.value;au();asSave();};$('#o-mus').oninput=e=>{AS.musVol=+e.target.value;au();asSave();};$('#o-sfx').oninput=e=>{AS.sfxVol=+e.target.value;au();sfx('click');asSave();};\\\\r\\\\n$('#o-muson').onchange=e=>{AS.mus=e.target.checked;au();asSave();};$('#o-shake').onchange=e=>{AS.shake=e.target.checked;asSave();};$('#o-nums').onchange=e=>{AS.nums=e.target.checked;asSave();};\\\\r\\\\n$('#p-vol').oninput=e=>{AS.vol=+e.target.value;au();asSave();};\\\\r\\\\n/* --- partita --- */\\\\r\\\\n$('#p-res').onclick=()=>resumeGame();\\\\r\\\\n$('#p-menu').onclick=()=>{sfx('click');openMenu();};\\\\r\\\\n$('#pausebtn').onclick=()=>pauseGame();\\\\r\\\\n$('#hud-hd').onclick=()=>{$('#hud-st').classList.toggle('closed');};\\\\r\\\\nif(MOB)$('#hud-st').classList.add('closed');\\\\r\\\\n$('#ld-go').onclick=()=>{sfx('click');levelContinue();};\\\\r\\\\n$('#ld-exit').onclick=()=>{sfx('click');levelExit();};\\\\r\\\\n$('#rv-yes').onclick=()=>doRevive();\\\\r\\\\n$('#rv-no').onclick=()=>{showOv(null);A.state='play';cineStart('death',()=>gameOver(false));};\\\\r\\\\n$('#e-again').onclick=()=>{AS.startLv=1;openSelect();};\\\\r\\\\n$('#e-retry').onclick=()=>{if(!loadRun())openMenu();};\\\\r\\\\n$('#e-menu').onclick=()=>openMenu();\\\\r\\\\n/* domanda Sì/No dentro la pagina */\\\\r\\\\nfunction askYes(msg,yes){const o=$('#ask');$('#ask-t').textContent=msg;o.classList.add('on');$('#ask-y').onclick=()=>{o.classList.remove('on');sfx('click');yes();};$('#ask-n').onclick=()=>{o.classList.remove('on');sfx('click');};}\\\\r\\\\n/* lancio: sul telefono il pulsante */\\\\r\\\\n$('#throwbtn').addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();throwAuto();});\\\\r\\\\n/* lo stato \\\\\\\"in partita\\\\\\\" serve al pulsante di pausa sul telefono */\\\\r\\\\nsetInterval(()=>{document.body.classList.toggle('playing',A.state==='play');document.body.classList.toggle('canthrow',!!(A.weapons&&A.weapons.some(w=>WX[w.id]&&MANUAL[WX[w.id].k])));},300);\\\\r\\\\n/* avvio: la prima volta la storia */\\\\r\\\\nopenMenu();\\\\r\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\r\\\\n/* =====================================================================\\\\r\\\\n   KING ARENA · multigiocatore (massimo 5) con PeerJS, come gli altri giochi di KING TOWER\\\\r\\\\n   - Cerca partita: entra in una stanza pubblica; dopo 15 s i posti vuoti li prendono i bot IA.\\\\r\\\\n   - Crea lobby: un codice da dare agli amici; NIENTE bot (si gioca solo tra persone).\\\\r\\\\n   - Entra con codice.\\\\r\\\\n   L'host fa girare la partita (nemici, boss, ondate); gli altri mandano dove si muovono e\\\\r\\\\n   ricevono la partita 10 volte al secondo. Gli altri giocatori sono \\\\\\\"alleati\\\\\\\" nell'arena.\\\\r\\\\n   ===================================================================== */\\\\r\\\\nconst NET={on:false,role:null,peer:null,conns:[],code:'',bots:false,players:[],snap:null,sendT:0,lastIn:0,myId:'',started:false};\\\\r\\\\nconst PEER_URL='https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js',PRE='kt-arena-',MAXP=5;\\\\r\\\\nconst netName=()=>{try{if(KT&&KT.nome)return String(KT.nome()).slice(0,16);}catch(e){}return AS.name||'Guardia';};\\\\r\\\\nfunction loadPeer(){return new Promise((ok,ko)=>{if(window.Peer)return ok();const s=document.createElement('script');s.src=PEER_URL;s.onload=()=>ok();s.onerror=()=>ko(new Error('PeerJS non si carica'));document.head.appendChild(s);});}\\\\r\\\\n\\\\r\\\\n/* ---------- alleati (altri giocatori umani o bot) nella simulazione dell'host ---------- */\\\\r\\\\nfunction tgtOf(e){let b=A.p,bd=A.p&&A.p.hp>0?Math.hypot(A.p.x-e.x,A.p.y-e.y):1e9;\\\\r\\\\n  for(const al of A.allies){if(al.dead)continue;const d=Math.hypot(al.x-e.x,al.y-e.y);if(d<bd){bd=d;b=al;}}return b;}\\\\r\\\\nfunction hurtT(p,d,src){if(p===A.p)hurtPlayer(d,src);else hurtAlly(p,d);}\\\\r\\\\nfunction allyMax(){return Math.round(30*(1+A.E*.04));}\\\\r\\\\nfunction hurtAlly(al,d){if(al.dead||al.inv>0)return;al.hp-=Math.max(1,Math.round(d*.8));al.inv=.45;\\\\r\\\\n  if(al.hp<=0){al.hp=0;al.dead=true;addFx({k:'puff',x:al.x,y:al.y-10,t:.5,c:'#c0392b',big:true});toast(al.name+' è caduto!');}}\\\\r\\\\nfunction makeAlly(o){return Object.assign({x:AW/2+rand(-60,60),y:(WALL+AH)/2+rand(-40,40),r:9,face:1,t:0,moving:false,cd:.5,inv:0,dead:false,hp:allyMax(),max:allyMax(),wid:'pistol',skin:0,name:'Guardia',bot:false,inp:{x:0,y:0}},o);}\\\\r\\\\nfunction allyBotVec(al){let fx=0,fy=0;\\\\r\\\\n  for(const e of A.en){if(e.dead||e.crate)continue;const dx=al.x-e.x,dy=al.y-e.y,d=Math.hypot(dx,dy)||1;const R=e.boss?160:100;if(d<R){fx+=dx/d*(R-d)/R*1.6;fy+=dy/d*(R-d)/R*1.6;}}\\\\r\\\\n  for(const b of A.eproj){const dx=al.x-b.x,dy=al.y-b.y,d=Math.hypot(dx,dy)||1;if(d<60){fx+=dx/d*2;fy+=dy/d*2;}}\\\\r\\\\n  const hx=A.p.x-al.x,hy=A.p.y-al.y,hd=Math.hypot(hx,hy)||1;if(hd>140){fx+=hx/hd*.8;fy+=hy/hd*.8;}\\\\r\\\\n  const d=Math.hypot(fx,fy);return d>.05?{x:fx/d,y:fy/d}:{x:0,y:0};}\\\\r\\\\nfunction updAlliesMP(dt){\\\\r\\\\n  for(const al of A.allies){al.t+=dt;if(al.inv>0)al.inv-=dt;if(al.dead)continue;\\\\r\\\\n    const v=al.bot?allyBotVec(al):al.inp;\\\\r\\\\n    if(al.bot){const sp=125*dt;al.x=clamp(al.x+v.x*sp,EDGE+9,AW-EDGE-9);al.y=clamp(al.y+v.y*sp,WALL+9,AH-EDGE-9);al.moving=Math.abs(v.x)+Math.abs(v.y)>.05;if(v.x>.1)al.face=1;else if(v.x<-.1)al.face=-1;}\\\\r\\\\n    /* arma: tiro automatico al nemico più vicino */\\\\r\\\\n    al.cd-=dt;const wp=WP[al.wid]||WP.pistol;const tg=nearest(al.x,al.y-12,(wp.rng||200)*1.1);\\\\r\\\\n    if(tg&&al.cd<=0){al.cd=wp.cd[0];const dmg=wp.dmg[0]*(1+A.E*.08);\\\\r\\\\n      if(wp.cls==='melee'){hitEnemy(tg,dmg,false,wp,al.x,al.y);addFx({k:'arc',x:al.x,y:al.y-14,t:.2,r:wp.rng*.6,a:Math.atan2(tg.y-al.y,tg.x-al.x),c:'#e0e6ec'});}\\\\r\\\\n      else{const a=Math.atan2(tg.y-12-(al.y-14),tg.x-al.x),sp=wp.spd||400;A.proj.push({x:al.x,y:al.y-14,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,dmg,crit:false,wp,k:wp.proj||'bullet',life:(wp.rng||200)/sp*1.2,pierce:wp.pierce||0,hit:new Set(),r:4});}}}\\\\r\\\\n  /* XP raccolta dagli alleati: va alla squadra (all'host) */\\\\r\\\\n  for(const d of A.drops){if(d.k!=='xp')continue;for(const al of A.allies)if(!al.dead&&Math.hypot(al.x-d.x,al.y-10-d.y)<30){d.dead=true;collect(d);break;}}\\\\r\\\\n}\\\\r\\\\nfunction reviveAllies(){for(const al of A.allies){al.max=allyMax();al.hp=al.max;al.dead=false;al.x=AW/2+rand(-80,80);al.y=(WALL+AH)/2+rand(-50,50);}}\\\\r\\\\nfunction drawAlly(g,al,T){if(al.dead){g.globalAlpha=.4;}\\\\r\\\\n  drawToonGuard(g,al.x,al.y,{skin:al.skin|0,face:al.face,t:al.t,pose:al.dead?'hurt':al.moving?'run':'idle',scale:1});g.globalAlpha=1;\\\\r\\\\n  const w=26,u=clamp(al.hp/(al.max||1),0,1);g.fillStyle='#000a';g.fillRect(al.x-w/2-1,al.y-50,w+2,5);g.fillStyle=al.bot?'#5aa0ff':'#3ac27a';g.fillRect(al.x-w/2,al.y-49,w*u,3);\\\\r\\\\n  g.font='bold 7px Georgia';g.textAlign='center';g.fillStyle='#000';g.fillText(al.name,al.x+.6,al.y-53.4);g.fillStyle=al.bot?'#9ad0ff':'#fff';g.fillText(al.name,al.x,al.y-54);}\\\\r\\\\n\\\\r\\\\n/* ---------- rete ---------- */\\\\r\\\\nfunction netSend(c,m){try{if(c&&c.open)c.send(m);}catch(e){}}\\\\r\\\\nfunction netAll(m){for(const c of NET.conns)netSend(c,m);}\\\\r\\\\nfunction lobbyPlayers(){const l=[{id:'host',name:netName(),skin:AS.skin,wid:AS.wpn||'mace',bot:false}];\\\\r\\\\n  for(const c of NET.conns)if(c.info)l.push(Object.assign({id:c.peer},c.info));return l;}\\\\r\\\\nasync function netHost(code,pub){await loadPeer();netReset();NET.on=true;NET.role='host';NET.code=code;NET.bots=!!pub;\\\\r\\\\n  return new Promise((ok,ko)=>{const p=new Peer(PRE+code,{debug:0});NET.peer=p;\\\\r\\\\n    p.on('open',()=>{NET.myId=p.id;ok();});p.on('error',e=>{ko(e);});\\\\r\\\\n    p.on('connection',c=>{c.on('open',()=>{if(NET.conns.length>=MAXP-1||NET.started){netSend(c,{t:'pieno'});setTimeout(()=>c.close(),300);return;}NET.conns.push(c);});\\\\r\\\\n      c.on('data',m=>netHostData(c,m));c.on('close',()=>{NET.conns=NET.conns.filter(x=>x!==c);const al=A.allies.find(a=>a.cid===c.peer);if(al){A.allies=A.allies.filter(a=>a!==al);toast(al.name+' è uscito.');}lobbyRender();});});});}\\\\r\\\\nfunction netHostData(c,m){if(!m||typeof m!=='object')return;\\\\r\\\\n  if(m.t==='hi'){c.info={name:String(m.name||'Guardia').slice(0,16),skin:clamp(m.skin|0,0,99),wid:WP[m.wid]?m.wid:'pistol',bot:false};lobbyRender();netAll({t:'lobby',players:lobbyPlayers(),bots:NET.bots});}\\\\r\\\\n  else if(m.t==='in'){const al=A.allies.find(a=>a.cid===c.peer);if(al&&!al.dead){al.x=clamp(+m.x||al.x,EDGE,AW-EDGE);al.y=clamp(+m.y||al.y,WALL,AH-EDGE);al.face=m.f<0?-1:1;al.moving=!!m.mv;}}\\\\r\\\\n  else if(m.t==='say'){toast((c.info?c.info.name:'?')+': '+String(m.s||'').slice(0,80),3000);}}\\\\r\\\\nasync function netJoin(code){await loadPeer();netReset();NET.on=true;NET.role='guest';NET.code=code;\\\\r\\\\n  return new Promise((ok,ko)=>{const p=new Peer(undefined,{debug:0});NET.peer=p;p.on('error',e=>ko(e));\\\\r\\\\n    p.on('open',()=>{NET.myId=p.id;const c=p.connect(PRE+code,{serialization:'json',reliable:true});NET.conns=[c];\\\\r\\\\n      const to=setTimeout(()=>ko(new Error('nessuna partita con questo codice')),8000);\\\\r\\\\n      c.on('open',()=>{clearTimeout(to);netSend(c,{t:'hi',name:netName(),skin:AS.skin,wid:WP[AS.wpn]?AS.wpn:'pistol'});ok();});\\\\r\\\\n      c.on('data',m=>netGuestData(m));c.on('close',()=>{if(NET.on){toast('La partita è finita (l\\\\\\\\'host è uscito).',3000);netStop();openMenu();}});});});}\\\\r\\\\nfunction netReset(){try{if(NET.peer)NET.peer.destroy();}catch(e){}Object.assign(NET,{on:false,role:null,peer:null,conns:[],code:'',bots:false,snap:null,started:false});A.allies=[];}\\\\r\\\\nfunction netStop(){netReset();}\\\\r\\\\n\\\\r\\\\n/* host: parte la partita (con i bot solo in «Cerca partita») */\\\\r\\\\nfunction netStart(){if(NET.role!=='host')return;NET.started=true;const l=lobbyPlayers();\\\\r\\\\n  newRun(0,AS.skin,AS.diff,AS.wpn||'mace',1);A.allies=[];\\\\r\\\\n  for(const c of NET.conns)if(c.info)A.allies.push(makeAlly(Object.assign({cid:c.peer},c.info)));\\\\r\\\\n  if(NET.bots){const nomi=['Bot Ronda','Bot Fante','Bot Arciere','Bot Scudiero'];for(let i=A.allies.length;i<MAXP-1;i++)A.allies.push(makeAlly({bot:true,name:nomi[i%4],skin:Math.floor(Math.random()*20),wid:pick(['pistol','bow','crossbow','mace','spear','staff'])}));}\\\\r\\\\n  netAll({t:'start',level:A.level,diff:A.diff});showOv(null);}\\\\r\\\\n/* host: la partita 10 volte al secondo */\\\\r\\\\nfunction netHostTick(dt){if(NET.role!=='host'||!NET.started)return;NET.sendT-=dt;if(NET.sendT>0)return;NET.sendT=.1;\\\\r\\\\n  const R=Math.round;const en=[];for(const e of A.en){if(e.dead||en.length>=140)continue;\\\\r\\\\n    en.push(e.crate?[-1,R(e.x),R(e.y),e.barrel?1:0]:[e.idx|0,R(e.x),R(e.y),e.face,Math.round(e.hp/e.max*100),e.boss==='rich'?e.bi:e.boss==='king'?-2:-1,e.st==='wind'?1:0,Math.round(e.scale*100),GUARD_KIT.indexOf(e.tp&&e.weapon&&GUARD_KIT.find(k=>k.weapon===e.weapon))]);}\\\\r\\\\n  const pr=A.eproj.slice(0,120).map(b=>[b.k,R(b.x),R(b.y),R(b.vx||0),R(b.vy||0)]);\\\\r\\\\n  const pp=A.proj.slice(0,80).map(b=>[b.k,R(b.x),R(b.y),R(b.vx||0),R(b.vy||0),b.ic||'']);\\\\r\\\\n  const pl=[{id:'host',n:netName(),s:AS.skin,x:R(A.p.x),y:R(A.p.y),f:A.p.face,mv:A.p.moving?1:0,hp:R(A.p.hp),mx:maxHp()}].concat(A.allies.map(a=>({id:a.cid||a.name,n:a.name,s:a.skin,x:R(a.x),y:R(a.y),f:a.face,mv:a.moving?1:0,hp:R(a.hp),mx:a.max,b:a.bot?1:0,d:a.dead?1:0})));\\\\r\\\\n  const b=A.boss&&!A.boss.dead?{n:A.boss.name,u:A.boss.hp/A.boss.max}:null;\\\\r\\\\n  netAll({t:'s',st:A.state,l:A.level,w:A.wv,wt:R(A.waveT),bw:A.bossWave?1:0,th:A.theme,en,pr,pp,pl,b,bn:A.banner?A.banner.a:null,lv:A.lvl});}\\\\r\\\\n/* ospite */\\\\r\\\\nfunction netGuestData(m){if(!m||typeof m!=='object')return;\\\\r\\\\n  if(m.t==='lobby'){NET.players=m.players||[];NET.bots=!!m.bots;lobbyRender();}\\\\r\\\\n  else if(m.t==='pieno'){toast('La partita è piena o già iniziata.',3000);netStop();openMenu();}\\\\r\\\\n  else if(m.t==='start'){NET.started=true;freshRun(0,AS.skin,m.diff|0,AS.wpn||'pistol',m.level|0||1);A.weapons=[];Object.assign(A,{events:[],spawns:[],pud:[],fx:[],nums:[],drops:[],en:[],proj:[],eproj:[],anims:[]});A.theme=-1;A.state='play';A.cine=null;showOv(null);musicPlay(trackOfLevel(m.level|0||1));}\\\\r\\\\n  else if(m.t==='s')NET.snap=m;\\\\r\\\\n  else if(m.t==='end'){toast(m.win?'Avete vinto!':'La partita è finita.',3000);netStop();openMenu();}}\\\\r\\\\n/* ospite: niente simulazione, solo la partita ricevuta; il proprio giocatore si muove subito */\\\\r\\\\nfunction netGuestStep(dt){const s=NET.snap;A.t+=dt;\\\\r\\\\n  const v=inputVec(),p=A.p,sp=125*dt;p.moving=Math.abs(v.x)+Math.abs(v.y)>.05;p.t+=dt;p.x=clamp(p.x+v.x*sp,EDGE+9,AW-EDGE-9);p.y=clamp(p.y+v.y*sp,WALL+9,AH-EDGE-9);if(v.x>.1)p.face=1;else if(v.x<-.1)p.face=-1;\\\\r\\\\n  A.cam.x=clamp(p.x-VW/2,0,AW-VW);A.cam.y=clamp(p.y-VH/2-12,0,AH-VH);\\\\r\\\\n  NET.lastIn-=dt;if(NET.lastIn<=0){NET.lastIn=.05;netSend(NET.conns[0],{t:'in',x:Math.round(p.x),y:Math.round(p.y),f:p.face,mv:p.moving?1:0});}\\\\r\\\\n  for(const e of A.en)e.t+=dt;for(const b of A.eproj){b.x+=b.vx*dt;b.y+=b.vy*dt;}for(const b of A.proj){b.x+=b.vx*dt;b.y+=b.vy*dt;}for(const al of A.allies)al.t+=dt;\\\\r\\\\n  updFx(dt);if(!s)return;NET.snap=null;\\\\r\\\\n  A.level=s.l;A.wv=s.w;A.waveT=s.wt;A.bossWave=!!s.bw;A.lvl=s.lv;if(A.theme!==s.th){A.theme=s.th;buildFloor(s.th);}\\\\r\\\\n  if(s.bn&&(!A.banner||A.banner.a!==s.bn))A.banner={t:2.4,a:s.bn,b:bgName(s.th)};\\\\r\\\\n  const old=new Map(A.en.map(e=>[e.key,e]));A.en=s.en.map((q,i)=>{if(q[0]===-1)return{crate:true,x:q[1],y:q[2],barrel:!!q[3],r:11,hurt:0,tp:{},sp:{},scale:1};\\\\r\\\\n    const En=ENEMIES[q[0]]||ENEMIES[0],key=i+':'+q[0],o=old.get(key);const tp=enemyTp(En);const ki=q[8];\\\\r\\\\n    const e=o||{key,idx:q[0],En,sp:En.sp,v:En.v,k:En.sp.kt||En.sp.id,tp:ki>=0&&En.sp.kt==='guard'?Object.assign({},tp,GUARD_KIT[ki]):tp,t:Math.random()*5,hurt:0,stun:0};\\\\r\\\\n    e.moving=!o||Math.hypot(o.x-q[1],o.y-q[2])>.5;e.x=q[1];e.y=q[2];e.face=q[3];e.hp=q[4];e.max=100;e.st=q[6]?'wind':'move';e.scale=q[7]/100;e.r=10*e.scale;\\\\r\\\\n    if(q[5]>=0){e.boss='rich';e.bi=q[5];}else if(q[5]===-2){e.boss='king';e.pal=KING;e.weapon='gold';}\\\\r\\\\n    if(!e.pal&&!e.boss)e.pal=ki>=0&&En.sp.kt==='guard'?guardKitPal(ki,En.v):tintPal(tp.pal,En.va.tint);if(!e.weapon)e.weapon=ki>=0&&GUARD_KIT[ki]?GUARD_KIT[ki].weapon:tp.weapon||'none';return e;});\\\\r\\\\n  A.eproj=s.pr.map(q=>({k:q[0],x:q[1],y:q[2],vx:q[3],vy:q[4]}));A.proj=s.pp.map(q=>({k:q[5]?'emoji':q[0],ic:q[5],x:q[1],y:q[2],vx:q[3],vy:q[4],wp:{}}));\\\\r\\\\n  const me=s.pl.find(x=>x.id===NET.myId);if(me){p.hp=me.hp;A.st={vita:me.mx-30};}\\\\r\\\\n  A.allies=s.pl.filter(x=>x.id!==NET.myId).map(x=>({name:x.n,skin:x.s,x:x.x,y:x.y,face:x.f,moving:!!x.mv,hp:x.hp,max:x.mx,bot:!!x.b,dead:!!x.d,t:A.t}));\\\\r\\\\n  A.boss=s.b?{name:s.b.n,hp:s.b.u,max:1,boss:'rich'}:null;A.drops=[];\\\\r\\\\n  if(s.st==='end'){toast('La partita è finita.',3000);netStop();openMenu();}}\\\\r\\\\n\\\\r\\\\n/* ---------- schermata del multigiocatore ---------- */\\\\r\\\\nfunction openMP(){A.state='mp';showOv('mpov');lobbyRender();}\\\\r\\\\nfunction lobbyRender(){const b=$('#mp-box');if(!b)return;\\\\r\\\\n  if(!NET.on){b.innerHTML=`<h2>Multigiocatore</h2><div class=\\\\\\\"sub\\\\\\\">Fino a 5 guardie nella stessa arena.</div>\\\\r\\\\n    <div class=\\\\\\\"row center\\\\\\\" style=\\\\\\\"flex-direction:column;align-items:stretch;max-width:420px;margin:0 auto;gap:8px\\\\\\\">\\\\r\\\\n    <button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"mp-find\\\\\\\">Cerca partita</button><div class=\\\\\\\"small\\\\\\\" style=\\\\\\\"text-align:center\\\\\\\">Se non arrivano abbastanza persone, i posti vuoti li prendono i bot IA.</div>\\\\r\\\\n    <button id=\\\\\\\"mp-host\\\\\\\">Crea lobby (con codice)</button><div class=\\\\\\\"small\\\\\\\" style=\\\\\\\"text-align:center\\\\\\\">Solo persone: niente bot.</div>\\\\r\\\\n    <div class=\\\\\\\"row\\\\\\\" style=\\\\\\\"gap:6px\\\\\\\"><input id=\\\\\\\"mp-code\\\\\\\" maxlength=\\\\\\\"5\\\\\\\" placeholder=\\\\\\\"CODICE\\\\\\\" style=\\\\\\\"flex:1;text-transform:uppercase;background:#1a120c;color:var(--txt);border:1px solid #8a6a3a;border-radius:6px;padding:8px;font:inherit\\\\\\\"><button id=\\\\\\\"mp-join\\\\\\\">Entra</button></div>\\\\r\\\\n    <div class=\\\\\\\"small\\\\\\\" id=\\\\\\\"mp-msg\\\\\\\" style=\\\\\\\"text-align:center;min-height:1.2em;color:#ffe28a\\\\\\\"></div><button data-back>Indietro</button></div>`;\\\\r\\\\n    $('#mp-find').onclick=()=>mpFind();$('#mp-host').onclick=()=>mpHost();$('#mp-join').onclick=()=>mpJoin($('#mp-code').value.trim().toUpperCase());\\\\r\\\\n    b.querySelector('[data-back]').onclick=()=>{sfx('click');openMenu();};$('#mp-code').addEventListener('keydown',e=>e.stopPropagation());return;}\\\\r\\\\n  const pl=NET.role==='host'?lobbyPlayers():NET.players,host=NET.role==='host';\\\\r\\\\n  b.innerHTML=`<h2>${NET.bots?'Partita pubblica':'Lobby'} ${NET.bots?'':'· codice <b style=\\\\\\\"color:#ffe28a;letter-spacing:.2em\\\\\\\">'+NET.code+'</b>'}</h2>\\\\r\\\\n    <div class=\\\\\\\"sub\\\\\\\">${pl.length}/${MAXP} giocatori${NET.bots?' · i posti vuoti li prendono i bot IA':' · solo persone, niente bot'}</div>\\\\r\\\\n    <div style=\\\\\\\"max-width:420px;margin:0 auto\\\\\\\">${pl.map(p=>`<div class=\\\\\\\"row\\\\\\\" style=\\\\\\\"justify-content:space-between;border-bottom:1px solid #4a3828;padding:4px 0\\\\\\\"><span>${p.id==='host'?'👑 ':''}${p.name}</span><span class=\\\\\\\"small\\\\\\\">${p.wid?wName(p.wid):''}</span></div>`).join('')}\\\\r\\\\n    <div class=\\\\\\\"small\\\\\\\" id=\\\\\\\"mp-msg\\\\\\\" style=\\\\\\\"text-align:center;min-height:1.2em;color:#ffe28a;margin:6px 0\\\\\\\">${host?(NET.bots?'La partita parte da sola tra poco (o premi Inizia).':'Quando ci siete tutti, premi Inizia.'):'Aspetta che l\\\\\\\\'host faccia partire la partita.'}</div>\\\\r\\\\n    <div class=\\\\\\\"row center\\\\\\\">${host?'<button class=\\\\\\\"big\\\\\\\" id=\\\\\\\"mp-go\\\\\\\">Inizia</button>':''}<button id=\\\\\\\"mp-x\\\\\\\">Esci</button></div></div>`;\\\\r\\\\n  if(host)$('#mp-go').onclick=()=>netStart();$('#mp-x').onclick=()=>{netStop();openMP();};}\\\\r\\\\nconst mpMsg=t=>{const m=$('#mp-msg');if(m)m.textContent=t;};\\\\r\\\\nfunction newCode(){const L='ABCDEFGHJKLMNPQRSTUVWXYZ';let s='';for(let i=0;i<5;i++)s+=L[Math.floor(Math.random()*L.length)];return s;}\\\\r\\\\nasync function mpHost(){mpMsg('Creo la lobby…');try{await netHost(newCode(),false);lobbyRender();}catch(e){mpMsg('Non riesco a creare la lobby: '+(e.message||e));netStop();}}\\\\r\\\\nasync function mpJoin(code){if(!/^[A-Z]{5}$/.test(code)){mpMsg('Il codice ha 5 lettere.');return;}mpMsg('Mi collego…');\\\\r\\\\n  try{await netJoin(code);lobbyRender();}catch(e){mpMsg('Non trovo la partita: controlla il codice.');netStop();}}\\\\r\\\\n/* cerca partita: prova le stanze pubbliche; se sono tutte vuote o piene ne apre una e dopo 15 s parte con i bot */\\\\r\\\\nasync function mpFind(){mpMsg('Cerco una partita…');\\\\r\\\\n  for(let i=1;i<=6;i++){try{await netJoin('PUB0'+i);lobbyRender();return;}catch(e){netStop();}}\\\\r\\\\n  for(let i=1;i<=6;i++){try{await netHost('PUB0'+i,true);lobbyRender();setTimeout(()=>{if(NET.role==='host'&&!NET.started)netStart();},15000);return;}catch(e){netStop();}}\\\\r\\\\n  mpMsg('Il server delle partite non risponde: riprova tra poco.');}\\\\r\\\\n</script>\\\\r\\\\n<script>'use strict';\\\\r\\\\n/* =====================================================================\\\\r\\\\n   KING ARENA · menu Admin (solo per l'admin di KING TOWER)\\\\r\\\\n   Si apre dal pulsante «Admin» del menu e, in partita, con il tasto F9.\\\\r\\\\n   ===================================================================== */\\\\r\\\\nlet ADM_PREV=null;\\\\r\\\\nfunction openAdmin(){if(!isAdmin())return;ADM_PREV=A.state;A.state='admin';showOv('admin');renderAdmin();}\\\\r\\\\nfunction closeAdmin(){const p=ADM_PREV;ADM_PREV=null;if(p==='play'){A.state='play';showOv(null);}else openMenu();}\\\\r\\\\naddEventListener('keydown',e=>{if(e.code==='F9'&&isAdmin()){e.preventDefault();if(A.state==='admin')closeAdmin();else openAdmin();}});\\\\r\\\\nfunction opts(list){return list.map(([v,t])=>`<option value=\\\\\\\"${v}\\\\\\\">${t}</option>`).join('');}\\\\r\\\\nfunction renderAdmin(){const inRun=!!A.p&&A.weapons&&A.weapons.length;\\\\r\\\\n  $('#adm-box').innerHTML=`<div class=\\\\\\\"row\\\\\\\" style=\\\\\\\"justify-content:space-between\\\\\\\"><h2 style=\\\\\\\"margin:0\\\\\\\">Admin · KING ARENA</h2><button id=\\\\\\\"ad-x\\\\\\\">Chiudi</button></div>\\\\r\\\\n  ${KT?'<div class=\\\\\\\"row\\\\\\\"><button id=\\\\\\\"ad-kt\\\\\\\" class=\\\\\\\"big\\\\\\\">Pannello admin completo di KING TOWER</button><span class=\\\\\\\"small\\\\\\\">giocatori online, messaggi, ban, regala il 3D, spettatore, giochi eliminati…</span></div>':''}\\\\r\\\\n  <h3>Partita</h3>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\">Livello <input id=\\\\\\\"ad-lv\\\\\\\" type=\\\\\\\"number\\\\\\\" min=\\\\\\\"1\\\\\\\" max=\\\\\\\"1000\\\\\\\" value=\\\\\\\"${A.level||1}\\\\\\\" style=\\\\\\\"width:80px\\\\\\\"> ondata <input id=\\\\\\\"ad-wv\\\\\\\" type=\\\\\\\"number\\\\\\\" min=\\\\\\\"1\\\\\\\" max=\\\\\\\"10\\\\\\\" value=\\\\\\\"1\\\\\\\" style=\\\\\\\"width:60px\\\\\\\"><button id=\\\\\\\"ad-go\\\\\\\">Vai</button></div>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><button id=\\\\\\\"ad-god\\\\\\\">${window.ADM_GOD?'✅':'⬜'} Invincibile</button><button id=\\\\\\\"ad-one\\\\\\\">${window.ADM_ONESHOT?'✅':'⬜'} Colpo mortale</button><button id=\\\\\\\"ad-ns\\\\\\\">${window.ADM_NOSAVE?'✅':'⬜'} Non salvare</button>\\\\r\\\\n    Velocità ${[1,2,5,10].map(v=>`<button data-sp=\\\\\\\"${v}\\\\\\\" class=\\\\\\\"${(window.ADM_SPEED||1)===v?'on':''}\\\\\\\">×${v}</button>`).join('')}</div>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><button id=\\\\\\\"ad-kill\\\\\\\"${inRun?'':' disabled'}>Sconfiggi tutti</button><button id=\\\\\\\"ad-heal\\\\\\\"${inRun?'':' disabled'}>Vita piena</button><button id=\\\\\\\"ad-xp\\\\\\\"${inRun?'':' disabled'}>+5 livelli (carte)</button>\\\\r\\\\n    <button id=\\\\\\\"ad-cb\\\\\\\"${inRun?'':' disabled'}>Carte bonus</button><button id=\\\\\\\"ad-cr\\\\\\\"${inRun?'':' disabled'}>Carte del boss</button><button id=\\\\\\\"ad-end\\\\\\\"${inRun?'':' disabled'}>Finisci l'ondata</button></div>\\\\r\\\\n  <h3>Nemici (200) e boss (100)</h3>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><select id=\\\\\\\"ad-en\\\\\\\">${opts(ENEMIES.map(e=>[e.i,(e.i+1)+'. '+e.n+' (dal liv. '+e.lv+')']))}</select><button id=\\\\\\\"ad-en-go\\\\\\\"${inRun?'':' disabled'}>Fai apparire</button>\\\\r\\\\n    <select id=\\\\\\\"ad-bs\\\\\\\">${opts(BOSSES.map(b=>[b.i,(b.i+1)+'. '+b.n]))}</select><button id=\\\\\\\"ad-bs-go\\\\\\\"${inRun?'':' disabled'}>Fai apparire</button></div>\\\\r\\\\n  <h3>Armi (50), oggetti (100), oggetti dei boss (30), parametri (30)</h3>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><select id=\\\\\\\"ad-w\\\\\\\">${opts([...Object.keys(WP),...Object.keys(WX)].map(id=>[id,wIcon(id)+' '+wName(id)]))}</select><button id=\\\\\\\"ad-w-go\\\\\\\"${inRun?'':' disabled'}>Dai arma</button>\\\\r\\\\n    <select id=\\\\\\\"ad-it\\\\\\\">${opts(ITEMS.map(i=>[i.id,i.ic+' '+i.n]))}</select><button id=\\\\\\\"ad-it-go\\\\\\\"${inRun?'':' disabled'}>Dai oggetto</button></div>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><select id=\\\\\\\"ad-r\\\\\\\">${opts(RELICS.map(r=>[r.id,r.ic+' '+r.n]))}</select><button id=\\\\\\\"ad-r-go\\\\\\\">Dai oggetto del boss</button>\\\\r\\\\n    <select id=\\\\\\\"ad-p\\\\\\\">${opts(PARAMS.map(p=>[p[0],p[2]+' '+p[1]]))}</select><input id=\\\\\\\"ad-pv\\\\\\\" type=\\\\\\\"number\\\\\\\" value=\\\\\\\"5\\\\\\\" style=\\\\\\\"width:70px\\\\\\\"><button id=\\\\\\\"ad-p-go\\\\\\\"${inRun?'':' disabled'}>Aggiungi</button></div>\\\\r\\\\n  <h3>Musica (200), suoni (150), sfondi (100)</h3>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><select id=\\\\\\\"ad-m\\\\\\\">${opts(TRACKS.map(t=>[t.i,(t.i+1)+'. '+t.n]))}</select><button id=\\\\\\\"ad-m-go\\\\\\\">Suona</button><button id=\\\\\\\"ad-m-st\\\\\\\">Ferma</button>\\\\r\\\\n    <select id=\\\\\\\"ad-s\\\\\\\">${opts(SFX.map((s,i)=>[i,(i+1)+'. '+s.n]))}</select><button id=\\\\\\\"ad-s-go\\\\\\\">Suona</button></div>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><select id=\\\\\\\"ad-bg\\\\\\\">${opts(Array.from({length:100},(_,i)=>[i,(i+1)+'. '+bgName(i)]))}</select><button id=\\\\\\\"ad-bg-go\\\\\\\">Mostra sfondo</button></div>\\\\r\\\\n  <h3>Animazioni</h3>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\">${['storia','gate','boss','lvup','chest','clear','death','victory','unlock','travel','bonus','bossdown'].map(k=>`<button data-an=\\\\\\\"${k}\\\\\\\">${k}</button>`).join('')}</div>\\\\r\\\\n  <h3>Salvataggio</h3>\\\\r\\\\n  <div class=\\\\\\\"row\\\\\\\"><button id=\\\\\\\"ad-pts\\\\\\\">+1000 punti</button><button id=\\\\\\\"ad-sk\\\\\\\">Sblocca tutte le skin</button><button id=\\\\\\\"ad-lvall\\\\\\\">Sblocca tutti i livelli</button><button id=\\\\\\\"ad-coins\\\\\\\">+100 monete</button><button id=\\\\\\\"ad-reset\\\\\\\" style=\\\\\\\"color:#ff8a7a\\\\\\\">Azzera KING ARENA</button></div>\\\\r\\\\n  <div class=\\\\\\\"small\\\\\\\" id=\\\\\\\"ad-msg\\\\\\\" style=\\\\\\\"margin-top:8px\\\\\\\"></div>`;\\\\r\\\\n  const ok=m=>{$('#ad-msg').textContent=m;sfx('click');};\\\\r\\\\n  $('#ad-x').onclick=closeAdmin;\\\\r\\\\n  if($('#ad-kt'))$('#ad-kt').onclick=()=>{try{KT.adminPanel();}catch(e){}};\\\\r\\\\n  $('#ad-go').onclick=()=>{const l=clamp(+$('#ad-lv').value|0,1,MAXL),w=clamp(+$('#ad-wv').value|0,1,WAVES);if(!A.p||!A.weapons||!A.weapons.length)newRun(0,AS.skin,AS.diff,AS.wpn||'mace',l);ADM_PREV='play';A.cine=null;A.theme=-1;startWave(l,w);};\\\\r\\\\n  $('#ad-god').onclick=()=>{window.ADM_GOD=!window.ADM_GOD;renderAdmin();};$('#ad-one').onclick=()=>{window.ADM_ONESHOT=!window.ADM_ONESHOT;renderAdmin();};\\\\r\\\\n  $('#ad-ns').onclick=()=>{window.ADM_NOSAVE=!window.ADM_NOSAVE;renderAdmin();};\\\\r\\\\n  $$('#adm-box [data-sp]').forEach(b=>b.onclick=()=>{window.ADM_SPEED=+b.dataset.sp;renderAdmin();});\\\\r\\\\n  if(inRun){$('#ad-kill').onclick=()=>{for(const e of A.en)if(!e.dead&&!e.crate)killEnemy(e);ok('Sconfitti.');};\\\\r\\\\n    $('#ad-heal').onclick=()=>{A.p.hp=maxHp();ok('Vita piena.');};\\\\r\\\\n    $('#ad-xp').onclick=()=>{for(let i=0;i<5;i++)A.xp+=xpNeed();gainXp(0);ok('+5 livelli: le carte arrivano quando chiudi.');};\\\\r\\\\n    $('#ad-cb').onclick=()=>{ADM_PREV=null;openCards('bonus',()=>{});};$('#ad-cr').onclick=()=>{ADM_PREV=null;A.lastBoss='(prova)';openCards('boss',()=>{});};\\\\r\\\\n    $('#ad-end').onclick=()=>{A.waveT=0;if(A.bossWave&&A.boss)killEnemy(A.boss);closeAdmin();};\\\\r\\\\n    $('#ad-en-go').onclick=()=>{const i=+$('#ad-en').value;queueAt(i,A.p.x+80,A.p.y);ok('Arriva: '+ENEMIES[i].n);};\\\\r\\\\n    $('#ad-bs-go').onclick=()=>{const bi=+$('#ad-bs').value,B=BOSSES[bi];const e=spawnEnemy(0,A.p.x,WALL+70,{boss:'rich',bi,name:B.n,atkList:B.T.atk,scale:1.5,spd:52,atkT:2.2});e.r=17;e.hp=e.max=hpE(A.E)*38;e.dmg=dmgE(A.E)*3.6;e.pal=null;A.boss=e;ok('Boss: '+B.n);};\\\\r\\\\n    $('#ad-w-go').onclick=()=>{const id=$('#ad-w').value;const w=A.weapons.find(x=>x.id===id);if(w)w.tier=Math.min(3,w.tier+1);else if(A.weapons.length<6)A.weapons.push(mkW(id,0));else A.weapons[5]=mkW(id,0);ok('Arma: '+wName(id));};\\\\r\\\\n    $('#ad-it-go').onclick=()=>{giveItem($('#ad-it').value);ok('Oggetto dato.');};\\\\r\\\\n    $('#ad-p-go').onclick=()=>{const k=$('#ad-p').value;A.st[k]=(A.st[k]||0)+(+$('#ad-pv').value||0);ok(pName(k)+': '+Math.round(stv(k)*10)/10);};}\\\\r\\\\n  $('#ad-r-go').onclick=()=>{const id=$('#ad-r').value;AS.relics[id]=(AS.relics[id]|0)+1;asSave();ok('Oggetto del boss dato (vale dalla prossima partita).');};\\\\r\\\\n  $('#ad-m-go').onclick=()=>{au();MZ.cur=-1;musicPlay(+$('#ad-m').value);ok('Suona: '+TRACKS[+$('#ad-m').value].n);};$('#ad-m-st').onclick=()=>musicStop();\\\\r\\\\n  $('#ad-s-go').onclick=()=>{au();playS(+$('#ad-s').value);};\\\\r\\\\n  $('#ad-bg-go').onclick=()=>{const i=+$('#ad-bg').value;A.theme=i;buildFloor(i);ok('Sfondo: '+bgName(i));};\\\\r\\\\n  $$('#adm-box [data-an]').forEach(b=>b.onclick=()=>{const k=b.dataset.an;\\\\r\\\\n    if(k==='storia'){storyOpen(()=>openMenu());return;}if(k==='unlock'){unlockAnim(AS.skin);return;}\\\\r\\\\n    if(!A.p||!A.weapons||!A.weapons.length){ok('Prima inizia una partita (Vai).');return;}\\\\r\\\\n    closeAdmin();A.state='play';showOv(null);\\\\r\\\\n    if(k==='boss'){cineStart('boss',null,{e:A.boss||{boss:'rich',bi:bossOfLevel(A.level).i,name:bossOfLevel(A.level).n}});return;}\\\\r\\\\n    if(k==='chest'){cineStart('chest',null,{it:pick(ITEMS),x:A.p.x+20,y:A.p.y});return;}\\\\r\\\\n    if(k==='clear'){cineStart('clear',null,{prize:1,pts:20});return;}\\\\r\\\\n    if(k==='death'||k==='victory'){cineStart(k,()=>{A.p.hp=Math.max(1,A.p.hp);});return;}\\\\r\\\\n    cineStart(k,null,{});});\\\\r\\\\n  $('#ad-pts').onclick=()=>{AS.pts=(AS.pts|0)+1000;asSave();ok('Punti: '+AS.pts);};\\\\r\\\\n  $('#ad-sk').onclick=()=>{for(let i=0;i<100;i++)AS.skins[i]=1;asSave();ok('Tutte le skin sbloccate.');};\\\\r\\\\n  $('#ad-lvall').onclick=()=>{AS.unlocked=MAXL;asSave();ok('Tutti i livelli sbloccati.');};\\\\r\\\\n  $('#ad-coins').onclick=()=>{walletAdd(100);ok('Monete: '+wallet());};\\\\r\\\\n  $('#ad-reset').onclick=()=>askYes('Azzerare tutti i progressi di KING ARENA?',()=>{try{localStorage.removeItem(AKEY);}catch(e){}location.reload();});\\\\r\\\\n}\\\\r\\\\n</script>\\\\r\\\\n</body>\\\\r\\\\n</html>\\\\r\\\\n\\\";\\n  let lic = null;\\n  async function licControlla() {\\n    try { if (typeof nameAdmPC === 'function' && nameAdmPC()) return (lic = true); } catch (e) {}\\n    try { if (typeof Admin !== 'undefined' && Admin.unlocked) return (lic = true); } catch (e) {}\\n    try {\\n      if (typeof ONL !== 'undefined' && ONL.ready && ONL.sb) {\\n        const { data, error } = await ONL.sb.rpc('mod_state', { p_mod: MOD });\\n        if (error && /PGRST202|function|schema cache/i.test((error.code || '') + ' ' + (error.message || ''))) return (lic = true);\\n        if (data) { try { if (data.owned) localStorage.setItem('ka_ok', String(Date.now())); else localStorage.removeItem('ka_ok'); } catch (e) {} return (lic = !!data.owned); }\\n      }\\n    } catch (e) {}\\n    let t = 0; try { t = +localStorage.getItem('ka_ok') || 0; } catch (e) {}\\n    return (lic = Date.now() - t < 7 * 864e5);\\n  }\\n  setTimeout(licControlla, 1500); setInterval(licControlla, 10 * 60 * 1000);\\n  const coins = () => { try { return (save.k3d && save.k3d.coins) | 0; } catch (e) { return 0; } };\\n  /* ponte: l'arena (nella finestra) chiama queste funzioni */\\n  window.ktArenaHost = {\\n    chiudi: () => chiudi(),\\n    coins,\\n    addCoins: n => { try { save.k3d = save.k3d || {}; save.k3d.coins = Math.max(0, coins() + Math.round(n)); persist(); } catch (e) {} },\\n    admin: () => { try { return (typeof nameAdmPC === 'function' && nameAdmPC()) || (typeof Admin !== 'undefined' && !!Admin.unlocked); } catch (e) { return false; } },\\n    carrello: () => { try { if (typeof ktCarrello === 'function') ktCarrello(); } catch (e) {} },\\n    nome: () => { try { return save.name || (ONL.me && ONL.me.name) || 'Guardia'; } catch (e) { return 'Guardia'; } },\\n    /* chat e pannello admin di KING TOWER: l'arena va sotto finché sono aperti, poi torna */\\n    chat: () => { try { if (typeof chatOpen === 'function') { chatOpen(); sotto(() => !!(ONL && ONL.open)); } } catch (e) {} },\\n    adminPanel: () => { try { if (Admin.unlocked && typeof openAdmin === 'function') openAdmin(); else document.getElementById('btn-help').click();\\n      sotto(() => ['admin', 'admon', 'help', 'reps'].some(id => { const el = document.getElementById(id); return el && el.classList.contains('on'); })); } catch (e) {} }\\n  };\\n  function sotto(aperto) { if (!fr) return; fr.style.zIndex = '-1'; fr.style.visibility = 'hidden';\\n    const t = setInterval(() => { if (aperto()) return; clearInterval(t); if (fr) { fr.style.zIndex = '2147470000'; fr.style.visibility = ''; try { fr.contentWindow.focus(); } catch (e) {} } }, 400); }\\n  let fr = null, musica = null;\\n  function apri() {\\n    if (fr) return;\\n    try { if (typeof Snd !== 'undefined' && Snd.mus) { musica = Snd.mus.gain.value; Snd.mus.gain.value = 0; } } catch (e) {}\\n    fr = document.createElement('iframe'); fr.id = 'kt-arena';\\n    fr.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;border:0;z-index:2147470000;background:#000';\\n    fr.setAttribute('allow', 'autoplay; gamepad; fullscreen');\\n    fr.srcdoc = HTML; document.body.appendChild(fr);\\n    setTimeout(() => { try { fr.contentWindow.focus();\\n      /* Ctrl e Maiusc passano anche a KING TOWER (le altre mod, es. il terminale di DISTRUGGI) */\\n      for (const t of ['keydown', 'keyup']) fr.contentWindow.addEventListener(t, e => { if (e.ctrlKey || e.shiftKey || e.key === 'Control' || e.key === 'Shift') window.dispatchEvent(new KeyboardEvent(t, { key: e.key, code: e.code, ctrlKey: e.ctrlKey, shiftKey: e.shiftKey, altKey: e.altKey })); });\\n    } catch (e) {} }, 300);\\n  }\\n  function chiudi() { if (!fr) return; fr.remove(); fr = null; try { if (typeof showScreen === 'function') showScreen('menu'); } catch (e) {} try { if (typeof Snd !== 'undefined' && Snd.mus && musica != null) Snd.mus.gain.value = musica; } catch (e) {} }\\n  function compra() { if (typeof ktModCompra === 'function') ktModCompra(MOD, 'KING ARENA', PAGINA, () => { lic = true; apri(); }); }\\n  window.ktArenaMod = { apri: async () => { if (lic === null) await licControlla(); if (lic) apri(); else compra(); }, chiudi, html: () => HTML };\\n})();\\n\",\"date\":\"2026-11-05T21:50:27.876Z\"}","sig":"2TqHMN8uSHe+b7KIaf3QQ7OYMWV4/jMQXoYWULo+ZH0+SBPsuOWdkcYXXcgG4RRwnLeOYXduGiUQA+Tewhbw5g=="}
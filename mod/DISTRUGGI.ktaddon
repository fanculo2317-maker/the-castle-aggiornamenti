\\n  }\\r\\n\\r\\n  /* quando si apre il 3D: Ctrl + Maiusc anche lì, e gli effetti valgono anche per i livelli nuovi */\\r\\n  function aggancia3() {\\r\\n    const w = W3(); if (!w || w.__dzOk) return; w.__dzOk = 1;\\r\\n    try { const k = { c: false, s: false, a: false };\\r\\n      w.addEventListener('keydown', e => { if (e.key === 'Control') k.c = true; else if (e.key === 'Shift') k.s = true; else if (k.c || k.s) k.a = true; }, true);\\r\\n      w.addEventListener('keyup', e => { if (e.key === 'Control' || e.key === 'Shift') { if (k.c && k.s && !k.a && !D.fin) apri(); if (e.key === 'Control') k.c = false; else k.s = false; if (!k.c && !k.s) k.a = false; } }, true);\\r\\n    } catch (e) {}\\r\\n    e3(`(()=>{ const o = startLevel; startLevel = function () { const r = o.apply(this, arguments); try { parent.__dzApplica3 && setTimeout(parent.__dzApplica3, 300); } catch (e) {} return r; }; })()`);\\r\\n    e3(DENTRO3); setTimeout(() => { catalogo3(); pezzi3(); applica3(); }, 1500);\\r\\n  }\\r\\n  window.__dzApplica3 = applica3;\\r\\n  setInterval(() => { if (W3()) { aggancia3(); catalogo3(); pezzi3(); applica3(); } }, 1000);\\r\\n\\r\\n  /* tutorial: la prima volta che si apre il gioco con la mod (si rivede con /tutorial) */\\r\\n  function tutorial() {\\r\\n    if (document.getElementById('dz-tut')) return;\\r\\n    const tel = document.body.classList.contains('mob') || !!window.FORCE_MOBILE;\\r\\n    const P = [\\r\\n      ['💥 Benvenuto in DISTRUGGI', 'Con questa mod puoi eliminare il codice di KING TOWER mentre giochi: <b>10.000 file</b> tra livelli, skin, oggetti del negozio, brani, suoni e pezzi del gioco.<br>Non si rompe niente davvero: i salvataggi restano e con <b>/ripristina</b> torna tutto a posto.'],\\r\\n      ['⌨️ Il terminale', tel ? 'Tocca il pulsantino <b>&gt;_</b> sul lato sinistro dello schermo: si apre il terminale del codice.' : 'Premi <b>Ctrl + Maiusc</b> insieme e lasciali: si apre il terminale del codice. Premili di nuovo (o Esc) per chiuderlo.'],\\r\\n      ['🗑️ /elimina', 'Scrivi <b>/elimina</b> e cosa vuoi togliere, anche a parole:<br><code>/elimina le guardie</code> → spariscono<br><code>/elimina il pavimento</code> → cadi nel vuoto<br><code>/elimina il livello 5</code> · <code>/elimina le skin da 1 a 20</code> · <code>/elimina il brano 40</code><br>Se non capisce la frase, chiede all’IA.'],\\r\\n      ['📁 /cartelle', 'Scrivi <b>/cartelle</b>: vedi le cartelle del codice. Un clic per aprirle, <b>doppio clic</b> per eliminare una cartella o un file.'],\\r\\n      ['⚠️ Attento a…', '<b>Il logo di KING TOWER</b>: se lo elimini il gioco si chiude, si riapre e ricomincia da capo.<br><b>Le parti fondamentali</b> (motore, comandi, fisica, salvataggi…): alla terza… <b>hai distrutto il gioco</b>. Scoprirai tu cosa succede.'],\\r\\n      ['✅ Pronto!', 'Altri comandi: <b>/lista</b>, <b>/stato</b>, <b>/ripristina</b>, <b>/aiuto</b>, <b>/tutorial</b>.<br>Buona distruzione!']\\r\\n    ];\\r\\n    const o = document.createElement('div'); o.id = 'dz-tut';\\r\\n    o.style.cssText = 'position:fixed;inset:0;z-index:2147480006;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;padding:16px';\\r\\n    o.innerHTML = '<div style=\\\"max-width:520px;width:100%;background:#071007;border:2px solid #2f6;border-radius:10px;box-shadow:0 10px 40px #000;color:#cfe;font:15px/1.45 Consolas,monospace;padding:18px 20px\\\">' +\\r\\n      '<div id=\\\"dz-tut-t\\\" style=\\\"color:#5f8;font-weight:bold;font-size:18px;margin-bottom:8px\\\"></div><div id=\\\"dz-tut-x\\\"></div>' +\\r\\n      '<div style=\\\"display:flex;justify-content:space-between;align-items:center;margin-top:16px\\\"><span id=\\\"dz-tut-n\\\" style=\\\"color:#3a7\\\"></span><span>' +\\r\\n      '<button id=\\\"dz-tut-s\\\" style=\\\"background:transparent;color:#7a9;border:1px solid #2a5;border-radius:6px;padding:6px 12px;margin-right:8px;font:inherit;cursor:pointer\\\">Salta</button>' +\\r\\n      '<button id=\\\"dz-tut-a\\\" style=\\\"background:#2f6;color:#041;border:0;border-radius:6px;padding:6px 16px;font:bold 15px Consolas,monospace;cursor:pointer\\\">Avanti</button></span></div></div>';\\r\\n    document.body.appendChild(o);\\r\\n    const st = o.querySelector('div').style; st.fontSize = '15px';\\r\\n    o.querySelectorAll('code').forEach(c => c.style.color = '#ff5');\\r\\n    let i = 0;\\r\\n    const fine = () => { o.remove(); try { localStorage.setItem('dz_tut', '1'); } catch (e) {} licControlla().then(ok => { if (!ok) compra(); }); };\\r\\n    const mostra = () => { o.querySelector('#dz-tut-t').textContent = P[i][0]; o.querySelector('#dz-tut-x').innerHTML = P[i][1];\\r\\n      o.querySelectorAll('#dz-tut-x code').forEach(c => { c.style.color = '#ff5'; });\\r\\n      o.querySelector('#dz-tut-n').textContent = (i + 1) + ' / ' + P.length; o.querySelector('#dz-tut-a').textContent = i === P.length - 1 ? 'Inizia!' : 'Avanti'; };\\r\\n    o.querySelector('#dz-tut-a').onclick = e => { e.stopPropagation(); if (++i >= P.length) fine(); else mostra(); };\\r\\n    o.querySelector('#dz-tut-s').onclick = e => { e.stopPropagation(); fine(); };\\r\\n    o.addEventListener('keydown', e => e.stopPropagation());\\r\\n    mostra();\\r\\n  }\\r\\n  { let visto = null; try { visto = localStorage.getItem('dz_tut'); } catch (e) {}\\r\\n    if (!visto) { const prova = () => { if (typeof G !== 'undefined' && G.mode === 'play' && !G.demo || document.querySelector('#intro.on,.intro.on') || (typeof Intro !== 'undefined' && Intro.on)) { setTimeout(prova, 2000); return; } tutorial(); };\\r\\n      setTimeout(prova, 2500); } }\\r\\n\\r\\n  /* telefono e tablet (Android, iPhone): non c'è Ctrl + Maiusc, c'è un pulsantino per aprire il terminale */\\r\\n  if (document.body.classList.contains('mob') || window.FORCE_MOBILE || 'ontouchstart' in window) {\\r\\n    const b = document.createElement('button'); b.id = 'dz-btn'; b.textContent = '>_'; b.title = 'Terminale del codice';\\r\\n    b.style.cssText = 'position:fixed;left:6px;top:50%;z-index:2147479999;width:34px;height:34px;border-radius:8px;border:1px solid #2f6;background:rgba(4,8,4,.8);color:#5f8;font:bold 13px Consolas,monospace;opacity:.75';\\r\\n    b.onclick = e => { e.stopPropagation(); if (!D.fin) apri(); };\\r\\n    document.body.appendChild(b);\\r\\n  }\\r\\n\\r\\n  /* ---------- anche dentro KING ARENA (la mod dell'arena): quello che elimini sparisce anche lì ---------- */\\r\\n  setInterval(() => {\\r\\n    const fr = document.getElementById('kt-arena'); if (!fr || !fr.contentWindow) return;\\r\\n    let api = null; try { api = fr.contentWindow.ARENA_API; } catch (e) {} if (!api) return;\\r\\n    const A = api.A, f = D.flag; if (!A) return;\\r\\n    try {\\r\\n      if (f.nemici) { A.en = A.en.filter(e => e.boss || e.crate); A.spawns = []; }\\r\\n      if ((f.nobili || f.re) && A.boss && !A.boss.dead) { A.boss.hp = 0; api.killEnemy(A.boss); }\\r\\n      if (f.proiettili) A.eproj = [];\\r\\n      if (f.oggetti) A.drops = A.drops.filter(d => d.k === 'xp');\\r\\n      if (f.effetti) { A.fx = []; A.shake = 0; }\\r\\n      if (f.pavimento || D.gone.has('sfondo')) { const c = api.floor(); if (c && !c.__dz) { c.__dz = 1; const g = c.getContext('2d'); missing(g, 0, 0, c.width, c.height); } }\\r\\n      api.mute(f.musica || D.brani.size > 0, f.suoni || D.sfx.size > 0);\\r\\n    } catch (e) {}\\r\\n  }, 300);\\r\\n})();\\r\\n\",\"date\":\"2026-11-05T21:16:22.595Z\"}","sig":"au75jEAa2bH0jmKyxeczNXfSZ3ARoBhGcq0pDigG49G6pkjgxsg7TsD8PAlIFT37uApjWtutIYtLag+H9QLFmA=="}
{"payload":"{\"kind\":\"addon\",\"name\":\"DISTRUGGI\",\"hours\":0,\"intro\":true,\"code\":\"/* KING TOWER · addon \\\"DISTRUGGI\\\" (10.000 file del gioco da eliminare, nel 2D e nel 3D; serve il codice d’acquisto: una installazione)\\r\\n   Ctrl + Maiusc (premuti insieme e lasciati) apre un terminale:\\r\\n     /elimina <cosa>   cancella quella parte del codice (anche a parole: \\\"/elimina i nemici e la musica\\\"; se non capisce chiede all'IA)\\r\\n     /elimina tutto    cancella tutto\\r\\n     /cartelle         le cartelle del codice: doppio clic su una cartella (o su un file) la elimina\\r\\n     /lista /stato /ripristina /chiudi /aiuto\\r\\n   Il codice NON viene cancellato davvero: si lavora su una copia in memoria. Le parti non fondamentali (skin, sfondi, musica…)\\r\\n   spariscono davvero dalla partita; quelle fondamentali (motore, comandi, salvataggi…) fanno solo finta e glitchano.\\r\\n   Dopo 3 parti fondamentali: \\\"HAI DISTRUTTO IL GIOCO\\\", il pulsante cade, tutto glitcha, finta disinstallazione e\\r\\n   reinstallazione della versione completa, poi il gioco riparte intatto (basta ricaricare: niente è perso, i salvataggi non si toccano). */\\r\\n(function () {\\r\\n  const D = { gone: new Set(), imp: 0, fin: false, open: false, hist: [], hi: 0,\\r\\n    flag: {}, lv: new Set(), skin: new Set(), neg: new Set(), brani: new Set(), sfx: new Set() };\\r\\n  const LIMITE = 3, TOTALE = 10000;\\r\\n  const cv = document.getElementById('cv');\\r\\n\\r\\n  /* ---------- come si \\\"cancella\\\" ---------- */\\r\\n  const noop = function () {};\\r\\n  function missing(g, x, y, w, h) {                       // la classica texture mancante: rosa e nera a scacchi\\r\\n    const s = 6; for (let i = 0; i < w; i += s) for (let j = 0; j < h; j += s) { g.fillStyle = ((i + j) / s) % 2 ? '#000' : '#ff00dc'; g.fillRect(x + i, y + j, Math.min(s, w - i), Math.min(s, h - j)); }\\r\\n  }\\r\\n  function sost(nome, f) { try { if (typeof window[nome] === 'function') { const old = window[nome]; window[nome] = f; return old; } } catch (e) {} return null; }\\r\\n  function codice(nomi) {\\r\\n    const out = [];\\r\\n    for (const n of nomi || []) { try { const f = n === 'Snd.play' ? Snd.play : n === 'Snd.startMusic' ? Snd.startMusic : window[n]; if (typeof f === 'function') out.push(String(f)); } catch (e) {} }\\r\\n    return out.join('\\\\n');\\r\\n  }\\r\\n  const nemicoBase = e => e.k !== 'noble' && e.k !== 'king';\\r\\n\\r\\n  /* effetti veri sul livello: valgono anche per i livelli che partono dopo */\\r\\n  function applicaLivello() {\\r\\n    const L = G.L; if (!L) return; const f = D.flag;\\r\\n    if (f.pavimento || D.lv.has(G.n)) L.gaps = [[-1e6, 1e6]];                  // niente pavimento: si cade nel vuoto\\r\\n    if (f.piattaforme) { L.solids = []; L.plats = []; }\\r\\n    if (f.porte) L.doors = [];\\r\\n    if (f.oggetti) { L.items = []; G.drops = []; }\\r\\n    if (G.E) G.E = G.E.filter(e => !(f.nemici && nemicoBase(e)) && !(f.nobili && e.k === 'noble') && !(f.re && e.k === 'king'));\\r\\n    if (f.nobili) { G.boss = null; if (G.arena) G.arena.done = true; }\\r\\n    if (f.re) G.king = null;\\r\\n    if (f.proiettili) G.eproj = [];\\r\\n  }\\r\\n  { const o = window.startLevel; if (typeof o === 'function') window.startLevel = function (n, demo) { const r = o.apply(this, arguments); try { if (!demo) applicaLivello(); } catch (e) {} return r; }; }\\r\\n  setInterval(() => { try { if (G && G.mode === 'play' && !G.demo) applicaLivello(); } catch (e) {} }, 250);   // guardie evocate dopo, proiettili nuovi…\\r\\n\\r\\n  /* skin, oggetti del negozio, brani e suoni cancellati uno per uno */\\r\\n  { const o = window.drawPlayer; window.drawPlayer = function (g, cx) { if (D.skin.has(save.skin | 0) && !G.demo) { const p = G.p; missing(g, Math.round(p.x - cx - 7), Math.round(p.y - 34), 14, 34); return; } return o.apply(this, arguments); }; }\\r\\n  { const o = window.cosDraw; if (typeof o === 'function') window.cosDraw = function (c, eq, layer, X) { if (eq && D.neg.size) eq = eq.map(id => D.neg.has(id) ? -1 : id); return o.call(this, c, eq, layer, X); }; }\\r\\n  try { const op = Snd.play; Snd.play = function (k) { if (D.flag.suoni) return; if (D.sfx.has(((save.sfxset || 1) - 1) + '-' + k)) return; return op.apply(this, arguments); }; } catch (e) {}\\r\\n  setInterval(() => { try { if (Snd.mus && (D.flag.musica || D.brani.size)) Snd.mus.gain.value = (D.flag.musica || D.brani.has(Snd.cur)) ? 0 : save.mus * .35; } catch (e) {} }, 300);\\r\\n\\r\\n  /* ogni file: cartella, nome, fondamentale?, parole per riconoscerlo, funzioni del gioco, cosa succede quando lo cancelli */\\r\\n  const FILE = [\\r\\n    { c: 'personaggi', id: 'skin-giocatore.js', p: ['giocatore', 'personaggio', 'protagonista', 'player', 'me stesso', 'la skin', 'mia skin'], fn: ['drawPlayer'],\\r\\n      via() { window.drawPlayer = function (g, cx) { const p = G.p; missing(g, Math.round(p.x - cx - 7), Math.round(p.y - 34), 14, 34); }; } },\\r\\n    { c: 'personaggi', id: 'nemici.js', p: ['nemici', 'nemico', 'guardie', 'guardia', 'soldati', 'cani', 'lancieri', 'fucilieri'], fn: ['drawMinion', 'mkEnemy'], via() { D.flag.nemici = 1; applicaLivello(); } },\\r\\n    { c: 'personaggi', id: 'nobili.js', p: ['nobili', 'nobile', 'boss'], fn: ['drawNoble', 'spawnNoble'], via() { D.flag.nobili = 1; applicaLivello(); } },\\r\\n    { c: 'personaggi', id: 're.js', p: [' re ', 'il re', 'sovrano'], fn: ['drawKing', 'spawnKing'], via() { D.flag.re = 1; applicaLivello(); } },\\r\\n    { c: 'personaggi', id: 'mascotte.js', p: ['mascotte'], fn: ['mascDraw'],\\r\\n      via() { sost('mascDraw', noop); const m = document.getElementById('masc-wrap'); if (m) m.style.visibility = 'hidden'; } },\\r\\n    { c: 'mondo', id: 'sfondo.js', p: ['sfondo', 'sfondi', 'muri', 'muro', 'parete', 'background', 'mattoni'], fn: ['drawBackground'],\\r\\n      via() { sost('drawBackground', function (g) { g.fillStyle = '#000'; g.fillRect(0, 0, W, H); }); } },\\r\\n    { c: 'mondo', id: 'pavimento.js', p: ['pavimento', 'terra', 'suolo', 'terreno'], fn: ['drawFloor', 'inGap'], via() { sost('drawFloor', noop); D.flag.pavimento = 1; applicaLivello(); } },\\r\\n    { c: 'mondo', id: 'piattaforme.js', p: ['piattaforme', 'piattaforma', 'blocchi', 'solidi'], fn: ['drawSolids'], via() { sost('drawSolids', noop); D.flag.piattaforme = 1; applicaLivello(); } },\\r\\n    { c: 'mondo', id: 'porte-e-scale.js', p: ['porte', 'porta', 'scale', 'scala'], fn: ['drawRoomDoor', 'drawStairs', 'drawStairWall'],\\r\\n      via() { sost('drawRoomDoor', noop); sost('drawStairs', noop); sost('drawStairWall', noop); D.flag.porte = 1; applicaLivello(); } },\\r\\n    { c: 'mondo', id: 'torre.js', p: ['torre', 'uscita', 'traguardo'], fn: ['drawTowerBig'],\\r\\n      via() { sost('drawTowerBig', function (g, x, y) { missing(g, Math.round(x), Math.round(y - 120), 84, 120); }); } },\\r\\n    { c: 'mondo', id: 'decorazioni.js', p: ['decorazioni', 'quadri', 'quadro', 'statue', 'armature', 'arredamento', 'crepe'], fn: ['drawDecor', 'drawDecor2', 'drawPainting', 'drawStatueAt', 'drawWallCracks', 'drawCagesWorld'],\\r\\n      via() { for (const n of this.fn) sost(n, noop); } },\\r\\n    { c: 'mondo', id: 'luci-e-fuoco.js', p: ['luci', 'luce', 'atmosfera', 'fuoco', 'fiamme', 'lampadari', 'torce', 'buio'], fn: ['drawAtmo', 'drawFlame', 'drawChand'],\\r\\n      via() { for (const n of this.fn) sost(n, noop); try { const c = document.createElement('canvas'); c.width = c.height = 1; TEX.vig = c; } catch (e) {} } },\\r\\n    { c: 'mondo', id: 'oggetti.js', p: ['oggetti', 'munizioni', 'cuori', 'monete', 'documenti'], fn: ['drawItems', 'drawDrops'], via() { D.flag.oggetti = 1; applicaLivello(); } },\\r\\n    { c: 'effetti', id: 'effetti.js', p: ['effetti', 'particelle', 'scritte volanti', 'esplosioni', 'bagliori', 'animazioni', 'tremolio'], fn: ['fxDraw', 'drawPops', 'drawAtmo', 'drawDoorFx'],\\r\\n      via() { for (const n of this.fn) sost(n, noop); try { const c = document.createElement('canvas'); c.width = c.height = 1; TEX.vig = c; } catch (e) {}\\r\\n        D.flag.effetti = 1; setInterval(() => { try { if (G) { G.shake = 0; G.fade = 0; } } catch (e) {} }, 50);\\r\\n        const st = document.createElement('style'); st.textContent = 'body *:not([id^=dz-]):not([id^=dz-] *){animation:none!important;transition:none!important;text-shadow:none!important;box-shadow:none!important;filter:none!important}'; document.head.appendChild(st); } },\\r\\n    { c: 'effetti', id: 'proiettili.js', p: ['proiettili', 'proiettile', 'frecce', 'lance'], fn: ['drawEProj'], via() { D.flag.proiettili = 1; applicaLivello(); } },\\r\\n    { c: 'effetti', id: 'colori.css', p: ['colori', 'colore'], fn: [], via() { cv.style.filter = (cv.style.filter || '') + ' grayscale(1) contrast(1.3)'; } },\\r\\n    { c: 'interfaccia', id: 'logo-king-tower.png', speciale: 'daccapo', p: ['logo'], fn: [] },\\r\\n    { c: 'interfaccia', id: 'hud.js', p: ['hud', 'vite', 'barra', 'interfaccia', 'punteggio', 'livello in alto'], fn: ['drawHUD'], via() { sost('drawHUD', noop); } },\\r\\n    { c: 'interfaccia', id: 'scritte.json', p: ['scritte', 'testi', 'testo', 'parole', 'lingua', 'traduzioni'], fn: [],\\r\\n      via() { const sc = '█▓▒░#@%&?¿§¤'; document.querySelectorAll('section.scr h1, section.scr h2, section.scr p, section.scr button, section.scr label').forEach(e => { if (e.closest('[id^=dz-]')) return; for (const n of e.childNodes) if (n.nodeType === 3 && n.nodeValue.trim()) n.nodeValue = n.nodeValue.replace(/[A-Za-zÀ-ù]/g, ch => Math.random() < .55 ? sc[Math.random() * sc.length | 0] : ch); }); } },\\r\\n    { c: 'interfaccia', id: 'font.css', p: ['font', 'caratteri', 'carattere'], fn: [],\\r\\n      via() { const s = document.createElement('style'); s.textContent = 'body *:not([id^=dz-]):not([id^=dz-] *){font-family:\\\"Times New Roman\\\",serif!important}'; document.head.appendChild(s); } },\\r\\n    { c: 'interfaccia', id: 'pulsanti-menu.js', p: ['pulsanti', 'bottoni', 'menu'], fn: [],\\r\\n      via() { document.querySelectorAll('section.scr button').forEach(b => { if (/gioca|play|chiudi|indietro|riprendi|esci/i.test(b.textContent)) return; if (Math.random() < .6) b.style.visibility = 'hidden'; }); } },\\r\\n    { c: 'audio', id: 'musica.js', p: ['la musica', 'tutta la musica', 'canzoni'], fn: ['Snd.startMusic'], via() { D.flag.musica = 1; try { if (MYM && MYM.el) MYM.el.pause(); } catch (e) {} } },\\r\\n    { c: 'audio', id: 'suoni.js', p: ['i suoni', 'tutti i suoni', 'audio', 'rumori'], fn: ['Snd.play'], via() { D.flag.suoni = 1; } },\\r\\n    /* fondamentali: fanno solo finta (il gioco non si rompe davvero), ma glitchano */\\r\\n    { c: 'motore', id: 'loop-principale.js', imp: 1, p: ['loop', 'motore', 'frame', 'ciclo'], fn: ['frame'] },\\r\\n    { c: 'motore', id: 'aggiorna-gioco.js', imp: 1, p: ['aggiornamento', 'logica', 'updategame', 'aggiorna gioco'], fn: ['updateGame'] },\\r\\n    { c: 'motore', id: 'disegna.js', imp: 1, p: ['disegna', 'render', 'grafica', 'schermo'], fn: ['render'] },\\r\\n    { c: 'motore', id: 'comandi.js', imp: 1, p: ['comandi', 'tasti', 'tastiera', 'input', 'joystick'], fn: ['keyIsPause', 'padTick'] },\\r\\n    { c: 'motore', id: 'fisica.js', imp: 1, p: ['fisica', 'gravita', 'gravità', 'collisioni'], fn: ['stepEnemy'] },\\r\\n    { c: 'dati', id: 'salvataggi.js', imp: 1, p: ['salvataggi', 'salvataggio', 'progressi', 'save'], fn: ['persistNow'] },\\r\\n    { c: 'dati', id: 'online.js', imp: 1, p: ['online', 'rete', 'server', 'internet', 'chat'], fn: ['onlConnect'] },\\r\\n    { c: 'dati', id: 'generatore-livelli.js', imp: 1, p: ['generatore', 'genlevel'], fn: ['genLevel'] }\\r\\n  ];\\r\\n  /* i file piccoli, uno per uno (in tutto 10.000): livelli, skin, oggetti del negozio, brani, suoni */\\r\\n  const pad = (n, k) => String(n).padStart(k, '0');\\r\\n  const PICC = [];\\r\\n  for (let i = 1; i <= 1000; i++) PICC.push({ c: 'livelli', id: 'livello-' + pad(i, 4) + '.map', n: i, via() { D.lv.add(this.n); if (G.n === this.n) applicaLivello(); } });\\r\\n  for (let i = 1; i <= 100; i++) PICC.push({ c: 'skin', id: 'skin-' + pad(i, 3) + '.png', n: i - 1, via() { D.skin.add(this.n); } });\\r\\n  const NCOS = (typeof COS_ITEMS !== 'undefined' && COS_ITEMS.length) || 1500;\\r\\n  for (let i = 0; i < NCOS; i++) PICC.push({ c: 'negozio', id: 'oggetto-' + pad(i + 1, 4) + '.png', n: i, via() { D.neg.add(this.n); } });\\r\\n  for (let i = 1; i <= 300; i++) PICC.push({ c: 'musica', id: 'brano-' + pad(i, 3) + '.mid', n: i, via() { D.brani.add(this.n); } });\\r\\n  const CATS = (typeof SFX_CATS !== 'undefined' && SFX_CATS) || ['hit'];\\r\\n  for (let k = 0; FILE.length + PICC.length < TOTALE; k++) { const set = Math.floor(k / CATS.length), cat = CATS[k % CATS.length];\\r\\n    PICC.push({ c: 'suoni', id: 'set-' + pad(set + 1, 3) + '-' + cat + '.wav', n: set + '-' + cat, via() { D.sfx.add(this.n); } }); }\\r\\n  for (const f of PICC) { f.p = []; f.fn = []; f.picc = 1; }\\r\\n  FILE.push(...PICC);\\r\\n  const CART = [...new Set(FILE.map(f => f.c))];\\r\\n\\r\\n  /* ---------- stile ---------- */\\r\\n  const st = document.createElement('style');\\r\\n  st.textContent = `\\r\\n  #dz-term{position:fixed;left:0;right:0;top:0;height:46vh;z-index:2147480000;background:rgba(4,8,4,.94);border-bottom:2px solid #2f6;color:#5f8;font:14px/1.35 Consolas,\\\"Courier New\\\",monospace;display:none;flex-direction:column;box-shadow:0 6px 30px #000}\\r\\n  #dz-term.on{display:flex}\\r\\n  #dz-out{flex:1;overflow:auto;padding:10px 14px;white-space:pre-wrap;word-break:break-word}\\r\\n  #dz-out .er{color:#f55}#dz-out .ok{color:#ff5}#dz-out .dim{color:#3a7}#dz-out .del{color:#f55;text-decoration:line-through;opacity:.8}\\r\\n  #dz-row{display:flex;gap:8px;padding:8px 14px;border-top:1px solid #1a4}#dz-row span{color:#2f6}\\r\\n  #dz-in{flex:1;background:transparent;border:0;outline:0;color:#9fc;font:inherit}\\r\\n  #dz-dirs{position:fixed;inset:6vh 6vw;z-index:2147480001;background:#0b0f0b;border:2px solid #2f6;border-radius:8px;display:none;flex-direction:column;color:#bfc;font:14px Consolas,monospace;box-shadow:0 10px 50px #000}\\r\\n  #dz-dirs.on{display:flex}#dz-dirs h3{margin:0;padding:10px 14px;border-bottom:1px solid #1a4;color:#5f8;font:bold 15px Consolas,monospace;display:flex;justify-content:space-between}\\r\\n  #dz-dirs h3 button{background:#1a4;color:#cfe;border:0;border-radius:4px;padding:4px 10px;cursor:pointer;font:inherit}\\r\\n  #dz-grid{flex:1;overflow:auto;padding:14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;align-content:start}\\r\\n  .dz-it{user-select:none;cursor:pointer;text-align:center;padding:10px 6px;border-radius:6px;border:1px solid transparent}\\r\\n  .dz-it:hover{border-color:#2f6;background:#102010}.dz-it b{display:block;font-size:42px;line-height:1.1}.dz-it small{color:#7a9}\\r\\n  .dz-it.via{animation:dzVia .7s forwards}.dz-it.imp b{filter:drop-shadow(0 0 4px #f44)}\\r\\n  @keyframes dzVia{0%{transform:none}30%{transform:rotate(-8deg) scale(1.1);filter:hue-rotate(90deg)}100%{transform:translateY(60px) rotate(25deg) scale(.2);opacity:0}}\\r\\n  .dz-glitch{animation:dzG .12s steps(2) infinite}\\r\\n  @keyframes dzG{0%{transform:translate(3px,-2px) skewX(4deg);filter:hue-rotate(90deg) saturate(3)}50%{transform:translate(-4px,2px) skewX(-6deg)}100%{transform:translate(2px,3px);filter:hue-rotate(-60deg) contrast(2)}}\\r\\n  #dz-bars{position:fixed;inset:0;z-index:2147480002;pointer-events:none}\\r\\n  #dz-fin{position:fixed;inset:0;z-index:2147480003;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:22px;background:rgba(0,0,0,.6);font-family:Georgia,serif}\\r\\n  #dz-fin h1{color:#ff3b3b;font-size:clamp(28px,6vw,68px);margin:0;text-shadow:0 0 18px #f00,3px 3px 0 #000;letter-spacing:2px}\\r\\n  #dz-fin button{font:bold 22px Georgia,serif;padding:12px 34px;border-radius:8px;border:2px solid #c9973a;background:#2a1a0e;color:#f0d9a0;transition:transform 1.6s cubic-bezier(.5,0,.9,.4)}\\r\\n  #dz-inst{position:fixed;inset:0;z-index:2147480004;background:#000;color:#ccc;font:15px Consolas,monospace;padding:40px 8vw;display:flex;flex-direction:column;gap:14px}\\r\\n  #dz-inst .bar{height:18px;border:1px solid #888;width:min(600px,80vw)}#dz-inst .bar i{display:block;height:100%;width:0;background:#3c8}\\r\\n  #dz-inst pre{margin:0;color:#777;height:40vh;overflow:hidden;white-space:pre-wrap}`;\\r\\n  document.head.appendChild(st);\\r\\n\\r\\n  /* ---------- terminale ---------- */\\r\\n  const T = document.createElement('div'); T.id = 'dz-term';\\r\\n  T.innerHTML = '<div id=\\\"dz-out\\\"></div><div id=\\\"dz-row\\\"><span>KING-TOWER:\\\\\\\\codice&gt;</span><input id=\\\"dz-in\\\" autocomplete=\\\"off\\\" spellcheck=\\\"false\\\"></div>';\\r\\n  document.body.appendChild(T);\\r\\n  const OUT = T.querySelector('#dz-out'), IN = T.querySelector('#dz-in');\\r\\n  function scrivi(t, cl) { const d = document.createElement('div'); if (cl) d.className = cl; d.textContent = t; OUT.appendChild(d); OUT.scrollTop = OUT.scrollHeight; return d; }\\r\\n  const pausa = ms => new Promise(r => setTimeout(r, ms));\\r\\n  /* ---------- codice d'acquisto della mod: vale per una sola installazione (si può spostare 2 volte) ---------- */\\r\\n  const MOD = 'DISTRUGGI', PAGINA = 'https://admin2d.itch.io/distruggi-mod-per-king-tower';\\r\\n  D.lic = null;\\r\\n  async function licControlla() {\\r\\n    try { if (typeof nameAdmPC === 'function' && nameAdmPC()) return (D.lic = true); } catch (e) {}\\r\\n    try {\\r\\n      if (typeof ONL !== 'undefined' && ONL.ready && ONL.sb) {\\r\\n        const { data, error } = await ONL.sb.rpc('mod_state', { p_mod: MOD });\\r\\n        if (error && /PGRST202|function|schema cache/i.test((error.code || '') + ' ' + (error.message || ''))) return (D.lic = true);   // server vecchio: niente controllo\\r\\n        if (data) { try { if (data.owned) localStorage.setItem('dz_ok', String(Date.now())); else localStorage.removeItem('dz_ok'); } catch (e) {} return (D.lic = !!data.owned); }\\r\\n      }\\r\\n    } catch (e) {}\\r\\n    let t = 0; try { t = +localStorage.getItem('dz_ok') || 0; } catch (e) {}\\r\\n    return (D.lic = Date.now() - t < 7 * 864e5);                                     // senza internet: vale l'ultimo controllo (7 giorni)\\r\\n  }\\r\\n  setTimeout(licControlla, 1500); setInterval(licControlla, 10 * 60 * 1000);\\r\\n  function compra() {\\r\\n    if (document.getElementById('dz-buy')) return;\\r\\n    const o = document.createElement('div'); o.id = 'dz-buy';\\r\\n    o.style.cssText = 'position:fixed;inset:0;z-index:2147480007;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;padding:16px';\\r\\n    o.innerHTML = '<div style=\\\"max-width:480px;width:100%;background:#071007;border:2px solid #2f6;border-radius:10px;color:#cfe;font:15px/1.45 Consolas,monospace;padding:18px 20px\\\">' +\\r\\n      '<div style=\\\"color:#5f8;font-weight:bold;font-size:18px;margin-bottom:8px\\\">🔒 Attiva DISTRUGGI</div>' +\\r\\n      '<div>Per usare la mod serve il codice d’acquisto di itch.io. Vale per <b>una sola installazione</b> (se sbagli puoi spostarlo, al massimo 2 volte).</div>' +\\r\\n      '<input id=\\\"dz-buy-in\\\" placeholder=\\\"Codice o link di itch.io\\\" style=\\\"width:100%;box-sizing:border-box;margin:12px 0 6px;background:#020602;border:1px solid #2a5;border-radius:6px;color:#cfe;font:inherit;padding:8px\\\">' +\\r\\n      '<div id=\\\"dz-buy-msg\\\" style=\\\"min-height:1.4em;color:#ff5\\\"></div>' +\\r\\n      '<div style=\\\"display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:8px\\\">' +\\r\\n      '<a href=\\\"' + PAGINA + '\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\" style=\\\"color:#5f8;align-self:center;margin-right:auto\\\">Comprala su itch.io ↗</a>' +\\r\\n      '<button id=\\\"dz-buy-x\\\" style=\\\"background:transparent;color:#7a9;border:1px solid #2a5;border-radius:6px;padding:6px 12px;font:inherit;cursor:pointer\\\">Chiudi</button>' +\\r\\n      '<button id=\\\"dz-buy-ok\\\" style=\\\"background:#2f6;color:#041;border:0;border-radius:6px;padding:6px 16px;font:bold 15px Consolas,monospace;cursor:pointer\\\">Attiva</button></div></div>';\\r\\n    document.body.appendChild(o);\\r\\n    const inp = o.querySelector('#dz-buy-in'), msg = o.querySelector('#dz-buy-msg');\\r\\n    inp.addEventListener('keydown', e => { e.stopPropagation(); if (e.key === 'Enter') o.querySelector('#dz-buy-ok').click(); });\\r\\n    o.querySelector('#dz-buy-x').onclick = () => o.remove();\\r\\n    o.querySelector('#dz-buy-ok').onclick = async () => {\\r\\n      const v = inp.value.trim(); if (!v) { msg.textContent = 'Scrivi il codice.'; return; }\\r\\n      if (typeof ONL === 'undefined' || !ONL.ready || !ONL.sb) { msg.textContent = 'Serve internet e il tuo nome nel gioco.'; return; }\\r\\n      msg.textContent = 'Controllo il codice…';\\r\\n      try {\\r\\n        const a = { p_key: v, p_mod: MOD };\\r\\n        const r = typeof ktSposta === 'function' ? await ktSposta('activate_mod', a) : await ONL.sb.rpc('activate_mod', a);\\r\\n        const d = r && r.data;\\r\\n        if (d && d.ok) { D.lic = true; try { localStorage.setItem('dz_ok', String(Date.now())); } catch (e) {} o.remove(); try { toast('DISTRUGGI attivata: buona distruzione!', 3000); } catch (e) {} return; }\\r\\n        msg.textContent = { CODICE_NON_VALIDO: 'Codice non valido per DISTRUGGI.', GIA_USATO: 'Codice già usato su un’altra installazione: non spostato.', TRASFERIMENTI_FINITI: 'Questo codice è già stato spostato 2 volte.',\\r\\n          TROPPI_TENTATIVI: 'Troppi tentativi: riprova tra 10 minuti.', ITCH_NON_RISPONDE: 'itch.io non risponde: riprova tra poco.', NON_REGISTRATO: 'Scegli prima il tuo nome nel gioco.', NON_CONFIGURATO: 'Attivazione non ancora disponibile.' }[d && d.error] || 'Attivazione non riuscita: riprova.';\\r\\n      } catch (e) { msg.textContent = 'Il server non risponde: riprova tra poco.'; }\\r\\n    };\\r\\n    setTimeout(() => inp.focus(), 50);\\r\\n  }\\r\\n\\r\\n  function apri(on) {\\r\\n    if (on !== false && !D.open && D.lic === false) { compra(); return; }\\r\\n    D.open = on == null ? !D.open : on; T.classList.toggle('on', D.open);\\r\\n    if (D.open) { setTimeout(() => IN.focus(), 30); if (!OUT.childNodes.length) aiuto(); }\\r\\n    else IN.blur();\\r\\n  }\\r\\n  function aiuto() {\\r\\n    scrivi('KING TOWER · terminale del codice · DISTRUGGI v5 (2D + 3D, gomma, cartelle 3D)', 'ok');\\r\\n    scrivi('/elimina <cosa>   es. /elimina le guardie · /elimina il pavimento · /elimina il livello 5 · /elimina le skin da 1 a 20');\\r\\n    scrivi('                  /elimina il brano 40 · /elimina oggetto 300 ·/elimina il logo · /elimina tutto   (' + FILE.length + ' file in tutto)');\\r\\n    scrivi('/cartelle         apri le cartelle del codice (doppio clic = elimina)');\\r\\n    scrivi('/gomma            clicca una cosa qualsiasi del gioco (2D o 3D) e sparisce');\\r\\n    scrivi('/lista            cosa si può eliminare     /stato   cosa hai già eliminato');\\r\\n    scrivi('/ripristina       rimette tutto a posto     /chiudi  (o di nuovo Ctrl + Maiusc)     /tutorial');\\r\\n  }\\r\\n\\r\\n  /* Ctrl + Maiusc premuti insieme e lasciati senza altri tasti */\\r\\n  let cs = { ctrl: false, shift: false, altro: false };\\r\\n  addEventListener('keydown', e => {\\r\\n    if (e.key === 'Control') cs.ctrl = true; else if (e.key === 'Shift') cs.shift = true; else if (cs.ctrl || cs.shift) cs.altro = true;\\r\\n    if (D.open && e.target === IN) {\\r\\n      if (e.key === 'Enter') { const v = IN.value.trim(); IN.value = ''; if (v) { D.hist.push(v); D.hi = D.hist.length; comando(v); } }\\r\\n      else if (e.key === 'ArrowUp') { if (D.hi > 0) IN.value = D.hist[--D.hi] || ''; e.preventDefault(); }\\r\\n      else if (e.key === 'ArrowDown') { if (D.hi < D.hist.length) IN.value = D.hist[++D.hi] || ''; e.preventDefault(); }\\r\\n      else if (e.key === 'Escape') apri(false);\\r\\n      e.stopPropagation();\\r\\n    }\\r\\n  }, true);\\r\\n  addEventListener('keyup', e => {\\r\\n    if (e.key === 'Control' || e.key === 'Shift') {\\r\\n      if (cs.ctrl && cs.shift && !cs.altro && !D.fin) apri();\\r\\n      if (e.key === 'Control') cs.ctrl = false; else cs.shift = false;\\r\\n      if (!cs.ctrl && !cs.shift) cs.altro = false;\\r\\n    }\\r\\n  }, true);\\r\\n\\r\\n  /* ---------- trovare cosa eliminare ---------- */\\r\\n  const norm = s => ' ' + String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9.]+/g, ' ').trim() + ' ';\\r\\n  const CATNUM = [                                                     // \\\"/elimina livello 5\\\", \\\"/elimina le skin da 3 a 10\\\", \\\"/elimina il brano 40\\\"…\\r\\n    { c: 'livelli', re: /livell[oi]/, tutti: / (tutti i livelli|i livelli|livelli) / },\\r\\n    { c: 'skin', re: /skin/, tutti: / (tutte le skin|le skin) / },\\r\\n    { c: 'negozio', re: /oggett[oi]|negozio/, tutti: / (negozio|tutti gli oggetti del negozio) / },\\r\\n    { c: 'musica', re: /bran[oi]|canzon[ei]/, tutti: / (tutti i brani|i brani|brani) / },\\r\\n    { c: 'suoni', re: /set|suon[oi]/, tutti: / (tutti i set|cartella suoni) / }\\r\\n  ];\\r\\n  function trova(testo) {\\r\\n    const n = norm(testo);\\r\\n    if (/ (tutto|tutta|ogni cosa|il gioco intero|everything) /.test(n)) return FILE.slice();\\r\\n    const res = new Set();\\r\\n    for (const K of CATNUM) {\\r\\n      const m = n.match(new RegExp('(?:' + K.re.source + ')\\\\\\\\w*\\\\\\\\s+(?:numero\\\\\\\\s+|n\\\\\\\\s+|da\\\\\\\\s+|dal\\\\\\\\s+)?(\\\\\\\\d+)(?:\\\\\\\\s*(?:-|a|al|fino a|fino al)\\\\\\\\s*(\\\\\\\\d+))?'));\\r\\n      const c3 = W3() && FILE.some(f => f.c === '3D-' + K.c) ? '3D-' + K.c : K.c, l = FILE.filter(f => f.c === c3);\\r\\n      if (m) { const a = +m[1], b = m[2] ? +m[2] : a; l.forEach((f, i) => { if (i + 1 >= Math.min(a, b) && i + 1 <= Math.max(a, b)) res.add(f); }); }\\r\\n      else if (K.tutti.test(n)) l.forEach(f => res.add(f));\\r\\n    }\\r\\n    for (const f of FILE) {\\r\\n      if (f.picc) { if (n.includes(' ' + f.id + ' ')) res.add(f); continue; }\\r\\n      if (n.includes(' ' + f.id.replace(/\\\\.(js|css|json|png)$/, '').replace(/-/g, ' ') + ' ') || n.includes(' ' + f.id + ' ')) { res.add(f); continue; }\\r\\n      if (n.includes(' cartella' + norm(f.c))) { res.add(f); continue; }\\r\\n      if (f.p.some(w => { const k = norm(w); return k.trim().length < 4 ? n.includes(k) : n.includes(k.trimEnd()); })) res.add(f);\\r\\n    }\\r\\n    for (const c of CART) if (n.includes(' cartella' + norm(c))) FILE.forEach(f => { if (f.c === c) res.add(f); });\\r\\n    return [...res];\\r\\n  }\\r\\n  async function chiediIA(testo) {\\r\\n    const elenco = FILE.filter(f => !f.picc).map(f => f.c + '/' + f.id).join(', ') + ', livelli/livello-0001.map … livello-1000.map, skin/skin-001.png … skin-100.png, negozio/oggetto-0001.png … oggetto-' + pad(NCOS, 4) + '.png, musica/brano-001.mid … brano-300.mid, suoni/set-001-hit.wav …';\\r\\n    const msgs = [{ role: 'system', content: 'Sei il terminale di un videogioco. L\\\\'utente vuole eliminare delle parti del gioco. Parti possibili: ' + elenco + '. Rispondi SOLO con i nomi dei file da eliminare (es. personaggi/nemici.js, livelli/livello-0005.map), separati da virgola, oppure NIENTE se nessuno corrisponde.' }, { role: 'user', content: testo }];\\r\\n    let t = '';\\r\\n    try {\\r\\n      if (window.RNT_HOST && window.RNT_HOST.ai) { const r = await window.RNT_HOST.ai(msgs); t = r && r.text || ''; }\\r\\n      else { const ac = new AbortController(), to = setTimeout(() => ac.abort(), 30000);\\r\\n        try { const r = await fetch('https://text.pollinations.ai/openai', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ model: 'openai', messages: msgs }), signal: ac.signal });\\r\\n          const j = await r.json(); t = j && j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content || ''; } finally { clearTimeout(to); } }\\r\\n    } catch (e) {}\\r\\n    return FILE.filter(f => t.includes(f.id));\\r\\n  }\\r\\n\\r\\n  /* ---------- eliminare ---------- */\\r\\n  async function elimina(lista) {\\r\\n    const nuovi = lista.filter(f => !D.gone.has(f.id));\\r\\n    if (!nuovi.length) { scrivi('Già eliminato.', 'dim'); return; }\\r\\n    const grandi = nuovi.filter(f => !f.picc), picc = nuovi.filter(f => f.picc);\\r\\n    if (picc.length > 20) {                                            // tanti file piccoli: a gruppi, cartella per cartella\\r\\n      const per = {}; for (const f of picc) (per[f.c] = per[f.c] || []).push(f);\\r\\n      for (const c of Object.keys(per)) { const l = per[c], d = scrivi('rm -r ' + c + '/', 'ok');\\r\\n        for (let i = 0; i < l.length; i++) { if (D.fin) return; D.gone.add(l[i].id); try { l[i].via(); } catch (e) {}\\r\\n          if (i % 40 === 0) { d.textContent = 'rm -r ' + c + '/   ' + i + '/' + l.length + '   ' + l[i].id; await pausa(16); } }\\r\\n        d.textContent = 'rm -r ' + c + '/   ' + l.length + ' file eliminati'; if (W3()) applica3(); glitch(300, .2); await pausa(150); }\\r\\n    } else grandi.push(...picc);\\r\\n    grandi.sort((a, b) => ((a.imp | 0) - (b.imp | 0)) || ((a.speciale ? 1 : 0) - (b.speciale ? 1 : 0)));\\r\\n    const veloce = grandi.length > 6;\\r\\n    for (const f of grandi) {\\r\\n      if (D.fin) return;\\r\\n      D.gone.add(f.id);\\r\\n      scrivi('rm ' + f.c + '/' + f.id + (f.imp ? '   [FONDAMENTALE]' : ''), f.imp ? 'er' : 'ok');\\r\\n      const righe = (codice(f.fn) || '/* ' + f.id + ' */').split('\\\\n').filter(r => r.trim()).slice(0, veloce ? 3 : 8);\\r\\n      for (const r of righe) { const d = scrivi('  ' + r.slice(0, 140)); await pausa(veloce ? 15 : 45); d.className = 'del'; }\\r\\n      if (f.speciale === 'daccapo') { await daccapo(); return; }\\r\\n      if (f.imp) {\\r\\n        D.imp++;\\r\\n        scrivi('ERRORE CRITICO: ' + f.id + ' non trovato. Avvio la copia di emergenza… (' + D.imp + '/' + LIMITE + ')', 'er');\\r\\n        glitch(1200 + D.imp * 600, D.imp / LIMITE);\\r\\n        if (D.imp >= LIMITE) { await pausa(900); finale(); return; }\\r\\n      } else {\\r\\n        try { f.via(); } catch (e) { scrivi('  (' + f.id + ' si è rotto in modo strano, ma il gioco continua)', 'dim'); }\\r\\n        D.f3[f.id] = 1; if (W3()) applica3();\\r\\n        glitch(250, .15);\\r\\n        scrivi('  eliminato. Il gioco continua senza ' + f.id + '.', 'dim');\\r\\n      }\\r\\n      await pausa(veloce ? 60 : 160);\\r\\n    }\\r\\n    scrivi('Eliminati in tutto: ' + D.gone.size + ' su ' + FILE.length + ' file.', 'dim');\\r\\n  }\\r\\n  /* il logo di KING TOWER: senza logo il gioco si chiude e si riapre, con la mod, ma si ricomincia da capo (dall'introduzione e dal livello 1) */\\r\\n  function senzaLogo() {\\r\\n    document.querySelectorAll('img.logo, .logo-h').forEach(i => { i.style.visibility = 'hidden'; });\\r\\n    e3(`document.querySelectorAll('#scr-menu h1, #scr-menu .box > .sub').forEach(h => { h.style.visibility = 'hidden'; })`);\\r\\n  }\\r\\n  try { if (localStorage.getItem('dz_nologo')) { senzaLogo(); setInterval(senzaLogo, 2000); } } catch (e) {}\\r\\n  async function daccapo() {\\r\\n    scrivi('Il logo di KING TOWER non c\\\\'è più… KING TOWER non sa più chi è. Il gioco si chiude.', 'er');\\r\\n    glitch(1500, .5); await pausa(1600);\\r\\n    try { localStorage.setItem('dz_daccapo', String(Date.now())); localStorage.setItem('dz_nologo', '1'); save.intro = false; persistNow(); } catch (e) {}\\r\\n    senzaLogo();\\r\\n    apri(false); cartelle(false); D.fin = true;\\r\\n    await chiudiERiapri();\\r\\n  }\\r\\n  async function comando(v) {\\r\\n    scrivi('> ' + v, 'dim');\\r\\n    const m = v.match(/^\\\\/?(\\\\S+)\\\\s*(.*)$/), c = (m && m[1] || '').toLowerCase(), arg = m ? m[2] : '';\\r\\n    if (c === 'aiuto' || c === 'help' || c === '?') return aiuto();\\r\\n    if (c === 'tutorial') { apri(false); return tutorial(); }\\r\\n    if (c === 'gomma' && !W3()) { D.gomma2 = !D.gomma2; scrivi(D.gomma2 ? 'GOMMA ACCESA: clicca (o tocca) una cosa nel gioco e sparisce: guardie, nobili, oggetti, porte, statue, piattaforme, la torre, il pavimento (fa un buco). /gomma per spegnerla.' : 'Gomma spenta.', 'ok'); if (D.gomma2) { await pausa(900); apri(false); } return; }\\r\\n    if (c === 'gomma') {\\r\\n      const on = e3('window.__dzGomma = !window.__dzGomma'); scrivi(on ? 'GOMMA ACCESA: clicca qualsiasi cosa nel 3D e sparisce (muri, pavimento, oggetti, nemici). /gomma per spegnerla.' : 'Gomma spenta.', 'ok'); if (on) { await pausa(900); apri(false); } return; }\\r\\n    if (c === 'chiudi' || c === 'esci' || c === 'exit') return apri(false);\\r\\n    if (c === 'cartelle' || c === 'foto' || c === 'dir' || c === 'ls') return cartelle(true);\\r\\n    if (c === 'lista') { for (const k of CART) { const l = FILE.filter(f => f.c === k), g = l.filter(f => D.gone.has(f.id)).length;\\r\\n        scrivi(k + '/  ' + (l.length > 12 ? l.length + ' file (' + l[0].id + ' … ' + l[l.length - 1].id + ')' : l.map(f => f.id + (D.gone.has(f.id) ? ' (X)' : '')).join('  ')) + (g ? '   eliminati: ' + g : '')); }\\r\\n      scrivi('In tutto: ' + FILE.length + ' file.', 'dim'); return; }\\r\\n    if (c === 'stato') { const base = FILE.filter(f => !f.picc && D.gone.has(f.id)).map(f => f.id);\\r\\n      scrivi('Eliminati: ' + D.gone.size + ' su ' + FILE.length + (base.length ? ' · ' + base.join(', ') : '') + ' · fondamentali: ' + D.imp + '/' + LIMITE); return; }\\r\\n    if (c === 'ripristina' || c === 'restore') { scrivi('Ripristino il codice dalla copia di sicurezza…', 'ok'); try { localStorage.removeItem('dz_nologo'); } catch (e) {} await pausa(600); location.reload(); return; }\\r\\n    if (c === 'elimina' || c === 'cancella' || c === 'rm' || c === 'distruggi') {\\r\\n      if (!arg) { scrivi('Cosa elimino? Es. /elimina i nemici · /elimina il livello 5 · /elimina le skin da 1 a 20', 'er'); return; }\\r\\n      let l = trova(arg);\\r\\n      if (!l.length) { scrivi('Chiedo all\\\\'IA cosa vuol dire \\\"' + arg + '\\\"…', 'dim'); l = await chiediIA(arg); }\\r\\n      if (!l.length) { scrivi('Non trovo niente che si chiami \\\"' + arg + '\\\". Prova /lista', 'er'); return; }\\r\\n      return elimina(l);\\r\\n    }\\r\\n    scrivi('Comando sconosciuto. Scrivi /aiuto', 'er');\\r\\n  }\\r\\n\\r\\n  /* ---------- cartelle (doppio clic = elimina); le cartelle grandi sono divise in gruppi da 100 ---------- */\\r\\n  const DIR = document.createElement('div'); DIR.id = 'dz-dirs';\\r\\n  DIR.innerHTML = '<h3><span id=\\\"dz-path\\\">KING-TOWER\\\\\\\\codice</span><span><button id=\\\"dz-up\\\">↑ Su</button> <button id=\\\"dz-x\\\">Chiudi</button></span></h3><div id=\\\"dz-grid\\\"></div>';\\r\\n  document.body.appendChild(DIR);\\r\\n  let dentro = null, gruppo = null;\\r\\n  function cartelle(on) {\\r\\n    DIR.classList.toggle('on', on); if (!on) return;\\r\\n    const gr = DIR.querySelector('#dz-grid'); gr.innerHTML = '';\\r\\n    DIR.querySelector('#dz-path').textContent = 'KING-TOWER\\\\\\\\codice' + (dentro ? '\\\\\\\\' + dentro : '') + (gruppo != null ? '\\\\\\\\' + pad(gruppo * 100 + 1, 4) + '-' + pad(gruppo * 100 + 100, 4) : '');\\r\\n    let voci;\\r\\n    if (!dentro) voci = CART.map(k => { const l = FILE.filter(f => f.c === k && !D.gone.has(f.id)); return { t: k, ico: '📁', imp: l.some(f => f.imp), sub: l.length + ' file', files: l, apri: () => { dentro = k; gruppo = null; } }; }).filter(x => x.files.length);\\r\\n    else { const tutti = FILE.filter(f => f.c === dentro);\\r\\n      if (tutti.length > 120 && gruppo == null) { voci = [];\\r\\n        for (let gi = 0; gi * 100 < tutti.length; gi++) { const l = tutti.slice(gi * 100, gi * 100 + 100).filter(f => !D.gone.has(f.id)); if (!l.length) continue;\\r\\n          voci.push({ t: pad(gi * 100 + 1, 4) + '-' + pad(Math.min(tutti.length, gi * 100 + 100), 4), ico: '📁', sub: l.length + ' file', files: l, apri: (x => () => { gruppo = x; })(gi) }); } }\\r\\n      else { const l = gruppo != null ? tutti.slice(gruppo * 100, gruppo * 100 + 100) : tutti;\\r\\n        voci = l.filter(f => !D.gone.has(f.id)).map(f => ({ t: f.id, ico: f.imp ? '⚙️' : f.speciale ? '👑' : '📄', imp: f.imp, sub: f.imp ? 'fondamentale' : 'file', files: [f] })); } }\\r\\n    if (!voci.length) gr.innerHTML = '<p style=\\\"color:#7a9\\\">Cartella vuota.</p>';\\r\\n    for (const v of voci) {\\r\\n      const d = document.createElement('div'); d.className = 'dz-it' + (v.imp ? ' imp' : ''); d.innerHTML = '<b></b><div></div><small></small>';\\r\\n      d.querySelector('b').textContent = v.ico; d.querySelector('div').textContent = v.t; d.querySelector('small').textContent = v.sub;\\r\\n      let clic = 0;\\r\\n      d.onclick = () => { if (v.apri) clic = setTimeout(() => { v.apri(); cartelle(true); }, 260); };\\r\\n      d.ondblclick = async e => { e.preventDefault(); clearTimeout(clic); d.classList.add('via'); apri(true);\\r\\n        await elimina(v.files); if (!D.fin) setTimeout(() => cartelle(true), 300); };\\r\\n      gr.appendChild(d);\\r\\n    }\\r\\n  }\\r\\n  DIR.querySelector('#dz-x').onclick = () => cartelle(false);\\r\\n  DIR.querySelector('#dz-up').onclick = () => { if (gruppo != null) gruppo = null; else dentro = null; cartelle(true); };\\r\\n\\r\\n  /* ---------- glitch ---------- */\\r\\n  const BARS = document.createElement('canvas'); BARS.id = 'dz-bars'; document.body.appendChild(BARS);\\r\\n  let gUntil = 0, gForza = 0;\\r\\n  function glitch(ms, forza) {\\r\\n    gUntil = Math.max(gUntil, performance.now() + ms); gForza = Math.max(gForza, forza || .2);\\r\\n    try { Snd.play && Snd.play('hurt'); } catch (e) {}\\r\\n    if (!glitch.on) { glitch.on = true; requestAnimationFrame(gTick); }\\r\\n  }\\r\\n  /* glitch tranquillo: niente lampi né colori invertiti, poche righe tenui, cambia ~8 volte al secondo */\\r\\n  let gLast = 0;\\r\\n  function gTick(now) {\\r\\n    if (now > gUntil && !D.fin) { glitch.on = false; gForza = 0; BARS.getContext('2d').clearRect(0, 0, BARS.width, BARS.height); cv.style.transform = ''; cv.style.filter = cv.style.filter.replace(/ hue-rotate\\\\([^)]*\\\\)/g, ''); return; }\\r\\n    requestAnimationFrame(gTick);\\r\\n    if (now - gLast < 120) return; gLast = now;\\r\\n    const b = BARS, g = b.getContext('2d'); b.width = innerWidth; b.height = innerHeight;\\r\\n    const f = Math.min(D.fin ? .6 : gForza, .6), n = 2 + f * 8;\\r\\n    for (let i = 0; i < n; i++) { g.fillStyle = ['#7a2a5a', '#2a5a6a', '#3a3a3a', '#000'][Math.random() * 4 | 0];\\r\\n      g.globalAlpha = .12 + Math.random() * .18; g.fillRect(Math.random() * b.width * .3, Math.random() * b.height, b.width * (.3 + Math.random() * .6), 2 + Math.random() * 8 * f); }\\r\\n    g.globalAlpha = 1;\\r\\n    const dx = (Math.random() - .5) * 14 * f, sk = (Math.random() - .5) * 4 * f; cv.style.transform = 'translate(' + dx + 'px,0) skewX(' + sk + 'deg)';\\r\\n    cv.style.filter = cv.style.filter.replace(/ hue-rotate\\\\([^)]*\\\\)/g, '') + ' hue-rotate(' + ((Math.random() - .5) * 50 * f | 0) + 'deg)';\\r\\n  }\\r\\n\\r\\n  /* ---------- finale ---------- */\\r\\n  async function finale() {\\r\\n    if (D.fin) return; D.fin = true; apri(false); cartelle(false);\\r\\n    if (window.KT3D_OPEN) { try { close3D(); } catch (e) {} }\\r\\n    glitch(99999, 1);\\r\\n    const F = document.createElement('div'); F.id = 'dz-fin'; F.innerHTML = '<h1>HAI DISTRUTTO IL GIOCO</h1><button>OK</button>'; document.body.appendChild(F);\\r\\n    const btn = F.querySelector('button');\\r\\n    await pausa(2200);\\r\\n    btn.style.transform = 'translateY(' + (innerHeight) + 'px) rotate(' + (200 + Math.random() * 200) + 'deg)';   // il pulsante cade\\r\\n    try { Snd.play && Snd.play('fall'); } catch (e) {}\\r\\n    await pausa(1400);\\r\\n    F.querySelector('h1').style.transition = 'transform 1.2s ease-in, opacity 1.2s';            // anche la scritta crolla\\r\\n    F.querySelector('h1').style.transform = 'translateY(' + innerHeight * .7 + 'px) rotate(-14deg)'; F.querySelector('h1').style.opacity = '0';\\r\\n    const sc = '█▓▒░#@%&?¿§¤01'; const tutti = [...document.querySelectorAll('h1,h2,h3,p,button,span,label,div')].filter(e => !e.closest('#dz-fin')).slice(0, 600);\\r\\n    for (let k = 0; k < 6; k++) { for (let i = 0; i < 30; i++) { const e = tutti[Math.random() * tutti.length | 0]; if (e && e.childNodes.length === 1 && e.firstChild.nodeType === 3) e.firstChild.nodeValue = e.firstChild.nodeValue.replace(/./g, ch => Math.random() < .4 ? sc[Math.random() * sc.length | 0] : ch); } await pausa(150); }\\r\\n    /* la finestra si rimpicciolisce a scatti, tremando */\\r\\n    document.documentElement.style.background = '#000'; document.body.style.transformOrigin = '50% 50%';\\r\\n    for (const s of [.92, .84, .78, .7, .64]) { for (let k = 0; k < 4; k++) { document.body.style.transform = 'scale(' + s + ') translate(' + ((Math.random() - .5) * 12) + 'px,' + ((Math.random() - .5) * 8) + 'px) rotate(' + ((Math.random() - .5) * 1.6) + 'deg)'; await pausa(60); }\\r\\n      try { Snd.play && Snd.play('hit'); } catch (e) {} await pausa(220); }\\r\\n    /* si crepa: righe spezzate che partono da un punto e si allargano */\\r\\n    const CR = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); CR.setAttribute('width', innerWidth); CR.setAttribute('height', innerHeight);\\r\\n    CR.style.cssText = 'position:fixed;inset:0;z-index:2147480003;pointer-events:none'; document.documentElement.appendChild(CR);\\r\\n    const ox = innerWidth * (.35 + Math.random() * .3), oy = innerHeight * (.35 + Math.random() * .3);\\r\\n    for (let r = 0; r < 14; r++) { let x = ox, y = oy, d = 'M' + x + ' ' + y; const a0 = r / 14 * Math.PI * 2 + Math.random() * .3;\\r\\n      for (let s = 0; s < 9; s++) { const a = a0 + (Math.random() - .5) * .7, l = 30 + Math.random() * 70; x += Math.cos(a) * l; y += Math.sin(a) * l; d += ' L' + x.toFixed(0) + ' ' + y.toFixed(0); }\\r\\n      const p = document.createElementNS('http://www.w3.org/2000/svg', 'path'); p.setAttribute('d', d); p.setAttribute('fill', 'none'); p.setAttribute('stroke', r % 3 ? '#ddd' : '#fff');\\r\\n      p.setAttribute('stroke-width', r % 3 ? 1.5 : 3); p.style.strokeDasharray = 2000; p.style.strokeDashoffset = 2000; p.style.transition = 'stroke-dashoffset .9s ease-out ' + (r * .05) + 's'; CR.appendChild(p);\\r\\n      requestAnimationFrame(() => requestAnimationFrame(() => { p.style.strokeDashoffset = 0; })); }\\r\\n    try { Snd.play && Snd.play('break'); } catch (e) {}\\r\\n    await pausa(1500);\\r\\n    /* va in pezzi: lo schermo del gioco si divide in tessere che cadono */\\r\\n    const sw = innerWidth, sh = innerHeight, cols = 7, rows = 5, PZ = document.createElement('div');\\r\\n    PZ.style.cssText = 'position:fixed;inset:0;z-index:2147480003;overflow:hidden;background:#000'; document.documentElement.appendChild(PZ);\\r\\n    const r0 = cv.getBoundingClientRect();\\r\\n    for (let i = 0; i < cols; i++) for (let j = 0; j < rows; j++) {\\r\\n      const w = Math.ceil(sw / cols), h = Math.ceil(sh / rows), t = document.createElement('canvas'); t.width = w; t.height = h;\\r\\n      try { t.getContext('2d').drawImage(cv, (i * w - r0.left) / r0.width * cv.width, (j * h - r0.top) / r0.height * cv.height, w / r0.width * cv.width, h / r0.height * cv.height, 0, 0, w, h); } catch (e) {}\\r\\n      t.style.cssText = 'position:absolute;left:' + i * w + 'px;top:' + j * h + 'px;outline:1px solid #222;transition:transform ' + (1 + Math.random() * .8) + 's cubic-bezier(.55,0,1,.45) ' + ((rows - j) * .12 + Math.random() * .3) + 's';\\r\\n      PZ.appendChild(t);\\r\\n      requestAnimationFrame(() => requestAnimationFrame(() => { t.style.transform = 'translate(' + ((Math.random() - .5) * 200) + 'px,' + (sh + 200) + 'px) rotate(' + ((Math.random() - .5) * 120) + 'deg)'; }));\\r\\n    }\\r\\n    document.body.style.visibility = 'hidden'; CR.remove(); F.remove();\\r\\n    await pausa(3000);\\r\\n    gUntil = 0; D.fin = 'fatto'; BARS.remove();\\r\\n    document.body.style.visibility = ''; document.body.style.transform = ''; PZ.remove();\\r\\n    await installatore();\\r\\n  }\\r\\n\\r\\n  /* ---------- finta disinstallazione (si rompe tutto) e reinstallazione (tutto torna al suo posto) ---------- */\\r\\n  function instBase() {\\r\\n    if (!document.getElementById('dz-s2')) { const s2 = document.createElement('style'); s2.id = 'dz-s2';\\r\\n    s2.textContent = `\\r\\n    #dz-inst{display:block;padding:0;font:14px \\\"Segoe UI\\\",Arial,sans-serif;overflow:hidden}\\r\\n    .dzw{position:absolute;left:50%;top:50%;width:min(560px,90vw);margin-left:calc(min(560px,90vw)/-2);margin-top:-170px;background:#1e1e1e;border:1px solid #555;box-shadow:0 12px 40px #000;color:#ddd}\\r\\n    .dzw .tb{background:#2d2d2d;padding:7px 12px;display:flex;justify-content:space-between;font-size:13px;color:#bbb}\\r\\n    .dzw .bd{padding:16px 18px;display:flex;flex-direction:column;gap:10px}\\r\\n    .dzw b{font-size:15px;color:#fff;display:block}\\r\\n    #dz-inst .dzw .bar{position:relative;height:20px;border:1px solid #777;background:#111;width:auto}\\r\\n    .dzw .bar i{position:absolute;left:0;top:0;bottom:0;width:0;background:#c33}\\r\\n    .dzw ul{list-style:none;margin:0;padding:0;height:150px;overflow:visible;position:relative;font:12px Consolas,monospace;color:#999}\\r\\n    .dzw li{height:16px;white-space:nowrap}\\r\\n    .dzp{position:absolute;transition:transform 1.4s cubic-bezier(.5,0,1,.5),opacity 1.4s}\\r\\n    .dzr{transition:transform .9s cubic-bezier(.2,.8,.3,1),opacity .9s}\\r\\n    #dz-splash{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:#f0d9a0;font-family:Georgia,serif;opacity:0;transition:opacity .8s}\\r\\n    #dz-splash h2{font-size:clamp(30px,6vw,64px);margin:0;letter-spacing:4px}`;\\r\\n    document.head.appendChild(s2); }\\r\\n    const I = document.getElementById('dz-inst') || document.createElement('div'); I.id = 'dz-inst'; document.body.appendChild(I);\\r\\n    const nomi = FILE.map(f => f.c + '\\\\\\\\' + f.id).concat(['KING TOWER.exe', 'resources\\\\\\\\game.html', 'resources\\\\\\\\icona.ico', 'addon\\\\\\\\KING TOWER 3D.kt3d']);\\r\\n    const rnd = (a, b) => a + Math.random() * (b - a);\\r\\n    const finestra = (titolo, testo) => { const w = document.createElement('div'); w.className = 'dzw';\\r\\n      w.innerHTML = '<div class=\\\"tb\\\"><span></span><span>✕</span></div><div class=\\\"bd\\\"><b></b><div class=\\\"bar\\\"><i></i></div><span class=\\\"pc\\\">0%</span><ul></ul></div>';\\r\\n      w.querySelector('.tb span').textContent = titolo; w.querySelector('b').textContent = testo; I.appendChild(w); return w; };\\r\\n    const via = (el, extra) => { el.style.transition = 'transform ' + rnd(1, 1.7) + 's cubic-bezier(.5,0,1,.5),opacity 1.5s';\\r\\n      el.style.transform = 'translate(' + rnd(-250, 250) + 'px,' + (innerHeight + 300) + 'px) rotate(' + rnd(-200, 200) + 'deg)' + (extra || ''); };\\r\\n    return { I, nomi, rnd, finestra, via };\\r\\n  }\\r\\n  async function installatore() {\\r\\n    const { I, nomi, rnd, finestra, via } = instBase();\\r\\n\\r\\n    /* 1. disinstallazione: i file scappano, la barra si spezza, la finestra va in pezzi */\\r\\n    let w = finestra('KING TOWER - Disinstallazione', 'Disinstallazione di KING TOWER…');\\r\\n    let bar = w.querySelector('.bar'), fill = bar.querySelector('i'), pc = w.querySelector('.pc'), ul = w.querySelector('ul'), rotta = false;\\r\\n    for (let i = 0; i <= 100; i += 2) {\\r\\n      pc.textContent = i + '%';\\r\\n      if (!rotta) fill.style.width = i + '%';\\r\\n      if (i % 4 === 0) {                                           // un file compare… e scappa via correndo\\r\\n        const li = document.createElement('li'); li.textContent = 'Rimosso: ' + nomi[(i / 4) % nomi.length]; ul.prepend(li);\\r\\n        setTimeout(() => { li.style.transition = 'transform 1.3s cubic-bezier(.4,0,1,.6),opacity 1.3s'; li.style.transform = 'translate(' + (Math.random() < .5 ? -1 : 1) * rnd(300, 700) + 'px,' + rnd(80, 400) + 'px) rotate(' + rnd(-90, 90) + 'deg)'; li.style.opacity = '.2'; setTimeout(() => li.remove(), 1500); }, 500);\\r\\n      }\\r\\n      if (i === 56 && !rotta) {                                    // la barra si crepa, si stacca e cade\\r\\n        rotta = true; const r = bar.getBoundingClientRect(), wr = w.getBoundingClientRect(), cut = rnd(.35, .6);\\r\\n        for (const [a, b] of [[0, cut], [cut, 1]]) {\\r\\n          const p = bar.cloneNode(true); p.className = 'bar dzp'; p.style.left = (r.left - wr.left) + 'px'; p.style.top = (r.top - wr.top) + 'px'; p.style.width = r.width + 'px';\\r\\n          p.style.clipPath = 'polygon(' + (a * 100) + '% 0,' + (b * 100 + (b < 1 ? 3 : 0)) + '% 0,' + (b * 100 - (b < 1 ? 2 : 0)) + '% 100%,' + (a * 100 - (a > 0 ? 3 : 0)) + '% 100%)';\\r\\n          p.style.transformOrigin = (a * 100) + '% 50%'; w.appendChild(p);\\r\\n          if (a === 0) { setTimeout(() => { p.style.transition = 'transform .5s ease-in'; p.style.transform = 'rotate(28deg)'; }, 50); setTimeout(() => via(p), 1500); }\\r\\n          else setTimeout(() => via(p), 80);\\r\\n        }\\r\\n        bar.style.visibility = 'hidden';\\r\\n        try { Snd.play && Snd.play('break'); } catch (e) {}\\r\\n      }\\r\\n      await pausa(70);\\r\\n    }\\r\\n    await pausa(600);\\r\\n    { const wr = w.getBoundingClientRect(), tagli = [[0, 0, 55, 0, 40, 100, 0, 100], [55, 0, 100, 0, 100, 60, 40, 100, 45, 45], [100, 60, 100, 100, 40, 100]];   // la finestra si rompe in 3\\r\\n      for (const t of tagli) { const c = w.cloneNode(true); c.style.margin = '0'; c.style.left = wr.left + 'px'; c.style.top = wr.top + 'px';\\r\\n        const pts = []; for (let k = 0; k < t.length; k += 2) pts.push(t[k] + '% ' + t[k + 1] + '%'); c.style.clipPath = 'polygon(' + pts.join(',') + ')'; I.appendChild(c); setTimeout(() => via(c), rnd(100, 600)); }\\r\\n      w.remove(); try { Snd.play && Snd.play('break'); } catch (e) {} }\\r\\n    await pausa(2200);\\r\\n\\r\\n    /* 2. il gioco si chiude DAVVERO e si riapre: sul PC (Windows, Linux) la finestra sparisce e torna,\\r\\n          su telefono (Android, iPhone) e nel browser il gioco riparte da zero. Dopo la riapertura parte la reinstallazione. */\\r\\n    I.innerHTML = ''; try { localStorage.setItem('dz_reinst', String(Date.now())); } catch (e) {}\\r\\n    await chiudiERiapri();\\r\\n  }\\r\\n  /* chiude davvero il gioco e lo riapre: Windows e Linux (programma nuovo) la finestra sparisce e torna; app Android si chiude e si riapre;\\r\\n     iPhone, browser e programmi vecchi: schermo nero e il gioco riparte da zero */\\r\\n  async function chiudiERiapri() {\\r\\n    const N = document.createElement('div'); N.style.cssText = 'position:fixed;inset:0;z-index:2147480005;background:#000'; document.documentElement.appendChild(N);\\r\\n    await pausa(600);\\r\\n    if (window.RNT_HOST && typeof window.RNT_HOST.restart === 'function') { try { window.RNT_HOST.restart(); await pausa(5000); } catch (e) {} }\\r\\n    try { const C = window.Capacitor, P = C && ((C.Plugins && C.Plugins.Riavvia) || (C.registerPlugin && C.registerPlugin('Riavvia')));\\r\\n      if (P && C.getPlatform && C.getPlatform() === 'android') { await P.riavvia(); await pausa(3000); } } catch (e) {}\\r\\n    const msg = document.createElement('div'); msg.style.cssText = 'position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#888;font:15px \\\"Segoe UI\\\",Arial'; msg.textContent = 'KING TOWER si è chiuso.'; N.appendChild(msg);\\r\\n    await pausa(1500); location.reload();\\r\\n  }\\r\\n  async function reinstallazione() {\\r\\n    const { I, nomi, rnd, finestra } = instBase(); let w, bar, fill, pc, ul;\\r\\n    await pausa(500);\\r\\n    const sp = document.createElement('div'); sp.id = 'dz-splash'; sp.innerHTML = '<h2>KING TOWER</h2><span>Avvio dell\\\\'installazione…</span>'; I.appendChild(sp);\